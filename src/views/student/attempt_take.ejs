  // Polling otomatis cek status kunci setiap 3 detik saat terkunci
  let lockPollInterval = null;
  function startLockPolling() {
    if (lockPollInterval) return;
    lockPollInterval = setInterval(async () => {
      try {
        const r = await fetch(`/student/attempts/${anti.attemptId}/lock-status`);
        const d = await r.json();
        if (d.ok && !d.locked) {
          // Guru sudah setujui - buka layar
          clearInterval(lockPollInterval);
          lockPollInterval = null;
          anti.locked = false;
          const msg = document.getElementById('unlockMsg');
          if (msg) {
            msg.textContent = 'Guru telah menyetujui. Silakan lanjutkan ujian!';
            msg.className = 'text-sm font-medium text-green-600';
            msg.classList.remove('hidden');
          }
          setTimeout(() => {
            document.getElementById('lockScreen').classList.add('hidden');
            if (msg) msg.classList.add('hidden');
          }, 1500);
        }
      } catch(_) {}
    }, 3000);
  }

  async function reportViolation(type, details) {
    if (anti.max === 0) return; // anti-cheat dinonaktifkan
    if (anti.locked) return;
    const key = type + '::' + (details || '');
    const last = anti.sentAt.get(key) || 0;
    if (nowMs() - last < 2000) return;
    anti.sentAt.set(key, nowMs());
    anti.localCount += 1;

    try {
      const r = await fetch(`/student/attempts/${anti.attemptId}/violation`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ type, details })
      });
      const j = await r.json().catch(() => ({}));
      const count = (typeof j.count === 'number') ? j.count : anti.localCount;
      const max = (typeof j.max === 'number') ? j.max : anti.max;

      if (j.locked) {
        anti.locked = true;
        // Tampilkan layar kunci — JANGAN redirect/submit
        showLockScreen(count, max);
        return;
      }
      toast(`${type}. Pelanggaran tercatat (${count}/${max}).`);
    } catch (e) {
      toast(`${type}. (Gagal kirim log, cek koneksi)`);
    }
  }

  // ══ DETEKSI BROWSER TRANSLATE (pelanggaran) ══════════════════════════════
  (function() {
    var translateReported = false; // Hindari spam laporan

    function handleTranslateDetected() {
      if (translateReported) return;
      translateReported = true;
      // Paksa kembali ke no-translate
      document.documentElement.setAttribute('translate', 'no');
      // Hapus class translate dari Chrome/Edge
      var html = document.documentElement;
      html.className = html.className.replace(/\btranslated-\S+/g, '').trim();
      // Laporkan sebagai pelanggaran
      if (typeof reportViolation === 'function') {
        reportViolation('Translate Otomatis Aktif', 'Siswa mengaktifkan browser translate (Google Translate / Edge Translate)');
      }
      // Reset flag setelah 10 detik agar bisa lapor lagi jika siswa coba ulang
      setTimeout(function() { translateReported = false; }, 10000);
    }

    // Observer untuk perubahan atribut class/translate di <html>
    var translateObserver = new MutationObserver(function(mutations) {
      for (var i = 0; i < mutations.length; i++) {
        var mutation = mutations[i];
        if (mutation.type === 'attributes') {
          var html = document.documentElement;
          var cls = html.className || '';
          var translateAttr = html.getAttribute('translate');
          // Chrome/Edge translate menambahkan class 'translated-ltr' atau 'translated-rtl'
          if (/\btranslated-/.test(cls)) {
            handleTranslateDetected();
            break;
          }
          // Jika atribut translate diubah ke 'yes'
          if (translateAttr === 'yes') {
            handleTranslateDetected();
            html.setAttribute('translate', 'no');
            break;
          }
        }
        // Deteksi elemen <font> yang ditambahkan Google Translate ke DOM
        if (mutation.type === 'childList' && mutation.addedNodes) {
          for (var j = 0; j < mutation.addedNodes.length; j++) {
            var node = mutation.addedNodes[j];
            if (node.nodeName === 'FONT' || (node.nodeType === 1 && node.querySelector && node.querySelector('font[face]'))) {
              handleTranslateDetected();
              break;
            }
          }
        }
      }
    });

    // Observe <html> untuk perubahan atribut class/translate
    translateObserver.observe(document.documentElement, {
      attributes: true,
      attributeFilter: ['class', 'translate', 'lang'],
      childList: false,
      subtree: false
    });

    // Observe <body> untuk penambahan elemen <font> (Google Translate wrapper)
    if (document.body) {
      translateObserver.observe(document.body, {
        childList: true,
        subtree: true,
        attributes: false
      });
    } else {
      document.addEventListener('DOMContentLoaded', function() {
        translateObserver.observe(document.body, {
          childList: true,
          subtree: true,
          attributes: false
        });
      });
    }
  })();

  // Fullscreen
  // ── Fullscreen — desktop & mobile ────────────────────────────────────────
  const fsBtn = document.getElementById('btnFullscreen');
  const antiCheatBar = document.getElementById('antiCheatBar');
  const fsOverlay = document.getElementById('fsOverlay');
  const btnStartFs = document.getElementById('btnStartFullscreen');
  // isMobile dan isIOS sudah dideklarasikan di atas

  // Sembunyikan/tampilkan popup fullscreen sesuai status layar
  function updateFsBanner() {
    if (!antiCheatBar) return;
    // iOS: selalu anggap fullscreen OK (Fullscreen API tidak didukung)
    if (isIOS) {
      antiCheatBar.style.display = 'none';
      return;
    }
    // Jika browser non-Chrome dan user sudah dismiss warning → jangan tampilkan popup fullscreen lagi
    if (_browserWarningDismissed && !_isChrome) {
      antiCheatBar.style.display = 'none';
      return;
    }
    if (isFullscreen()) {
      antiCheatBar.style.display = 'none';
    } else {
      antiCheatBar.style.display = 'flex';
    }
  }

  async function requestFullscreen() {
    try {
      const el = document.documentElement;
      if (isIOS) {
        // iOS tidak support Fullscreen API — cukup scroll untuk sembunyikan address bar
        window.scrollTo(0, 1);
        setTimeout(() => window.scrollTo(0, 0), 100);
        return;
      }
      if (el.requestFullscreen) {
        await el.requestFullscreen({ navigationUI: 'hide' });
      } else if (el.webkitRequestFullscreen) {
        el.webkitRequestFullscreen();
      } else if (isMobile) {
        window.scrollTo(0, 1);
        setTimeout(() => window.scrollTo(0, 0), 100);
      }
    } catch (e) {
      // Fullscreen ditolak browser — ujian tetap jalan
    }
  }

  // Sembunyikan overlay dan aktifkan fullscreen saat tombol diklik
  function dismissOverlayAndStart() {
    if (fsOverlay) {
      fsOverlay.style.opacity = '0';
      fsOverlay.style.transition = 'opacity 0.3s';
      setTimeout(() => { fsOverlay.style.display = 'none'; }, 300);
    }
    requestFullscreen().then(() => {
      setTimeout(updateFsBanner, 500);
    }).catch(() => {
      if (!isMobile) setTimeout(updateFsBanner, 500);
    });
    // Mobile & iOS: sembunyikan popup langsung
    if ((isMobile || isIOS) && antiCheatBar) antiCheatBar.style.display = 'none';
    window.scrollTo({ top: 0, behavior: 'smooth' });
  }

  if (btnStartFs) btnStartFs.addEventListener('click', dismissOverlayAndStart);
  if (btnStartFs) btnStartFs.addEventListener('touchend', function(e) {
    e.preventDefault();
    dismissOverlayAndStart();
  });

  // Tombol fullscreen di popup (re-enter fullscreen)
  if (fsBtn) fsBtn.addEventListener('click', function() {
    requestFullscreen().then(() => setTimeout(updateFsBanner, 500)).catch(()=>{});
    if ((isMobile || isIOS) && antiCheatBar) antiCheatBar.style.display = 'none';
  });
  if (fsBtn) fsBtn.addEventListener('touchend', function(e) {
    e.preventDefault();
    requestFullscreen().then(() => setTimeout(updateFsBanner, 500)).catch(()=>{});
    if ((isMobile || isIOS) && antiCheatBar) antiCheatBar.style.display = 'none';
  });

  // Auto-dismiss overlay setelah 15 detik (edge case)
  setTimeout(() => {
    if (fsOverlay && fsOverlay.style.display !== 'none') {
      dismissOverlayAndStart();
    }
  }, 15000);

  function isFullscreen() {
    // iOS selalu return true karena tidak support Fullscreen API
    if (isIOS) return true;
    return !!(document.fullscreenElement || document.webkitFullscreenElement);
  }

  document.addEventListener('fullscreenchange', () => {
    if (isIOS) return; // iOS tidak trigger event ini
    updateFsBanner();
    if (!isFullscreen()) {
      if (fullscreenExited === false) {
        fullscreenExited = true;
      } else {
        reportViolation('Keluar Fullscreen', 'fullscreenchange');
      }
    }
  });
  document.addEventListener('webkitfullscreenchange', () => {
    if (isIOS) return; // iOS tidak trigger event ini dengan benar
    updateFsBanner();
    if (!isFullscreen()) {
      if (fullscreenExited === false) {
        fullscreenExited = true;
      } else {
        reportViolation('Keluar Fullscreen', 'webkitfullscreenchange');
      }
    }
  });

  document.addEventListener('visibilitychange', () => {
    if (document.hidden) reportViolation('Pindah Tab/Aplikasi', 'visibilitychange');
  });

  // blur di HP sering terpicu saat keyboard virtual muncul/hilang — tidak laporkan
  const isMobileDevice = navigator.maxTouchPoints > 0 || /Android|iPhone|iPad/i.test(navigator.userAgent);
  if (!isMobileDevice) {
    window.addEventListener('blur', () => reportViolation('Pindah Tab/Aplikasi', 'blur'));
  }

  // ── Floating bar & Drawer soal — fungsi sudah didefinisikan di atas (global script)
  function syncDrawerButtons() {
    document.querySelectorAll('.drawerBtn').forEach(function(btn) {
      var no = btn.getAttribute('data-drawer-no');
      var section = document.getElementById('q-' + no);
      if (!section) return;
      var hasRadio    = section.querySelector('input[type=radio]:not(.tf-radio):checked');
      var hasTF       = section.querySelector('select.tf-select');
      var tfAnswered  = hasTF && hasTF.value;
      var hasComplex  = section.querySelector('input.complex-checkbox:checked');
      var hasCheckbox = section.querySelector('input.checkbox-answer:checked');
      var hasMultiTf  = section.querySelector('.multitf-btn.multitf-active');
      var done = !!(hasRadio || tfAnswered || hasComplex || hasCheckbox || hasMultiTf);
      var isActive = ONE_PER_PAGE && Number(no) === currentQ;
      btn.className = 'drawerBtn h-12 rounded-xl border-2 font-bold text-sm transition-all ' +
        (done
          ? 'border-emerald-400 bg-emerald-100 text-emerald-700'
          : 'border-slate-300 bg-white text-slate-600') +
        (isActive ? ' ring-2 ring-indigo-400 ring-offset-1' : '');
    });
  }

  document.addEventListener('contextmenu', (e) => {
    e.preventDefault();
    // Di HP/mobile, contextmenu bisa muncul dari long press (bukan kecurangan)
    // Hanya laporkan di desktop (bukan touchscreen)
    const isMobileCtx = navigator.maxTouchPoints > 0 || /Android|iPhone|iPad/i.test(navigator.userAgent);
    if (!isMobileCtx) {
      reportViolation('Klik Kanan', 'contextmenu');
    }
  });
  ['copy','cut','paste'].forEach(ev => {
    document.addEventListener(ev, (e) => {
      e.preventDefault();
      reportViolation('Copy/Cut/Paste', ev);
    });
  });
  document.addEventListener('keydown', (e) => {
    const k = (e.key || '').toLowerCase();
    const ctrl = e.ctrlKey || e.metaKey;
    if (ctrl && ['c','v','x','p','s','u'].includes(k)) {
      e.preventDefault();
      reportViolation('Shortcut Diblokir', `ctrl+${k}`);
    }
    if (k === 'printscreen') {
      reportViolation('PrintScreen', 'key');
    }
  });

  try { document.body.style.userSelect = 'none'; } catch (e) {}

  // Cek status kunci saat halaman pertama kali dimuat (misal setelah refresh)
  (async function checkInitialLockStatus() {
    try {
      const r = await fetch(`/student/attempts/${anti.attemptId}/lock-status`);
      const d = await r.json();
      if (d.ok && d.locked) {
        showLockScreen('?', anti.max);
      }
    } catch(_) {}
  })();
</script>

<!-- ══════════════════════════════════════════════════════════
     MODAL KONFIRMASI KUMPULKAN JAWABAN
══════════════════════════════════════════════════════════ -->
<div id="submitConfirmModal" class="fixed inset-0 z-[99999] items-center justify-center p-4" style="display:none;background:rgba(15,23,42,0.7);backdrop-filter:blur(6px);">
  <div class="relative bg-white rounded-3xl shadow-2xl max-w-sm w-full p-8" id="submitModalCard"
    style="animation:popInModal 0.3s cubic-bezier(0.34,1.56,0.64,1) both;">

    <!-- Icon animasi -->
    <div class="flex justify-center mb-5">
      <div class="w-20 h-20 rounded-full bg-gradient-to-br from-emerald-400 to-teal-500 flex items-center justify-center shadow-lg"
        style="animation:pulseModal 1.8s ease-in-out infinite;">
        <span style="font-size:2.2rem;">✅</span>
      </div>
    </div>

    <!-- Judul -->
    <h2 class="text-2xl font-black text-slate-800 text-center mb-2">Konfirmasi Ujian</h2>

    <!-- Info soal terjawab -->
    <div id="submitModalStats" class="flex justify-center gap-6 mb-4">
      <div class="text-center">
        <div class="text-2xl font-black text-emerald-600" id="modalAnsweredCount">0</div>
        <div class="text-xs text-slate-500 font-medium">Terjawab</div>
      </div>
      <div class="w-px bg-slate-200"></div>
      <div class="text-center">
        <div class="text-2xl font-black text-rose-500" id="modalUnansweredCount">0</div>
        <div class="text-xs text-slate-500 font-medium">Belum dijawab</div>
      </div>
    </div>

    <!-- Pesan -->
    <p class="text-sm text-slate-600 text-center leading-relaxed mb-6">
      Terimakasih telah menyelesaikan ujian ini.<br>
      Silahkan tekan tombol <span class="inline-block px-2 py-0.5 rounded bg-rose-500 text-white text-xs font-bold">SELESAI UJIAN</span> untuk mengakhiri ujian.<br>
      Atau tekan tombol <span class="inline-block px-2 py-0.5 rounded bg-emerald-600 text-white text-xs font-bold">KEMBALI</span> untuk kembali ke halaman ujian.
    </p>

    <!-- Tombol aksi -->
    <div class="flex gap-3">
      <button type="button" id="submitModalCancel"
        class="flex-1 py-4 rounded-2xl bg-gradient-to-r from-emerald-500 to-teal-600 hover:from-emerald-600 hover:to-teal-700 active:scale-95 text-white font-black text-base shadow-md transition-all tracking-wide">
        KEMBALI
      </button>
      <button type="button" id="submitModalConfirm"
        class="flex-1 py-4 rounded-2xl bg-gradient-to-r from-rose-500 to-red-600 hover:from-rose-600 hover:to-red-700 active:scale-95 text-white font-black text-base shadow-md transition-all tracking-wide">
        SELESAI UJIAN
      </button>
    </div>
  </div>
</div>

<style>
@keyframes popInModal {
  0%   { transform: scale(0.7) translateY(30px); opacity: 0; }
  100% { transform: scale(1) translateY(0);      opacity: 1; }
}
@keyframes pulseModal {
  0%, 100% { transform: scale(1);    box-shadow: 0 0 0 0 rgba(16,185,129,0.4); }
  50%       { transform: scale(1.07); box-shadow: 0 0 0 12px rgba(16,185,129,0); }
}
#submitModalCard { animation: popInModal 0.3s cubic-bezier(0.34,1.56,0.64,1) both; }
</style>

<script>
// Fungsi buka modal konfirmasi submit
function showSubmitConfirmModal(onConfirm) {
  // Hitung jumlah terjawab & belum — sama persis dengan updateAnswered()
  let answered = 0;
  document.querySelectorAll('input[type=radio]:not(.tf-radio):checked').forEach(() => answered++);
  document.querySelectorAll('select.tf-select').forEach(sel => { if (sel.value) answered++; });
  const complexQids = new Set(Array.from(document.querySelectorAll('input.complex-checkbox')).map(cb => cb.getAttribute('data-question')));
  complexQids.forEach(qid => { if (document.querySelector(`input.complex-checkbox[data-question="${qid}"]:checked`)) answered++; });
  const checkboxQids = new Set(Array.from(document.querySelectorAll('input.checkbox-answer')).map(cb => cb.getAttribute('data-question')));
  checkboxQids.forEach(qid => { if (document.querySelector(`input.checkbox-answer[data-question="${qid}"]:checked`)) answered++; });
  // MULTI_TF: soal dianggap dijawab jika minimal 1 pernyataan sudah dipilih
  const multiTfQids = new Set(Array.from(document.querySelectorAll('.multitf-btn.multitf-active')).map(btn => btn.getAttribute('data-multitf-qid')));
  multiTfQids.forEach(() => answered++);

  const total = <%= totalQ %>;
  const unanswered = total - answered;

  document.getElementById('modalAnsweredCount').textContent = answered;
  document.getElementById('modalUnansweredCount').textContent = unanswered;

  // Warna unanswered merah jika ada yang belum
  const unansweredEl = document.getElementById('modalUnansweredCount');
  unansweredEl.className = unanswered > 0
    ? 'text-2xl font-black text-rose-500'
    : 'text-2xl font-black text-slate-400';

  const modal = document.getElementById('submitConfirmModal');
  const card  = document.getElementById('submitModalCard');

  // Tampilkan modal dengan style langsung (hindari konflik Tailwind hidden)
  modal.style.display = 'flex';
  // Reset animasi card
  card.style.animation = 'none';
  card.offsetHeight; // reflow
  card.style.animation = '';

  // Tombol SELESAI UJIAN
  const confirmBtn = document.getElementById('submitModalConfirm');
  const cancelBtn  = document.getElementById('submitModalCancel');

  const doConfirm = () => {
    modal.style.display = 'none';
    confirmBtn.removeEventListener('click', doConfirm);
    cancelBtn.removeEventListener('click', doCancel);
    onConfirm();
  };
  const doCancel = () => {
    modal.style.display = 'none';
    confirmBtn.removeEventListener('click', doConfirm);
    cancelBtn.removeEventListener('click', doCancel);
  };

  confirmBtn.addEventListener('click', doConfirm);
  cancelBtn.addEventListener('click', doCancel);

  // Klik luar modal = tutup
  modal.addEventListener('click', function outsideClick(e) {
    if (e.target === modal) {
      doCancel();
      modal.removeEventListener('click', outsideClick);
    }
  });
}
</script>

