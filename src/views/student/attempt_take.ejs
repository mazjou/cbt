  <div class="bg-white rounded-3xl shadow-2xl max-w-md w-full p-8 text-center">
    <div class="text-6xl mb-4">🔒</div>
    <h2 class="text-2xl font-bold text-red-700 mb-2">Ujian Terkunci</h2>
    <p class="text-slate-600 text-sm mb-1">Layar dikunci karena terlalu banyak pelanggaran.</p>
    <p id="lockViolationInfo" class="text-red-600 font-semibold text-sm mb-6"></p>
    <div class="bg-amber-50 border border-amber-200 rounded-xl p-5 mb-6 text-center">
      <div class="text-3xl mb-2">⏳</div>
      <div class="text-sm font-semibold text-amber-800 mb-1">Menunggu persetujuan guru/pengawas</div>
      <div class="text-xs text-amber-700">Hubungi guru/pengawas ujian dan minta untuk membuka kunci. Layar akan terbuka otomatis setelah disetujui.</div>
    </div>
    <div id="unlockMsg" class="text-sm font-medium hidden mb-3"></div>
    <div class="text-xs text-slate-400">Jawaban kamu tersimpan dan tidak hilang.</div>
  </div>
</div>
  <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
    <div class="flex items-start gap-3">
      <span class="text-3xl">🔒</span>
      <div>
        <div class="font-bold text-amber-900">Mode Ujian Aktif</div>
        <div class="text-sm text-amber-700">Disarankan aktifkan fullscreen dan jangan pindah tab. Pelanggaran akan tercatat.</div>
      </div>
    </div>
    <button id="btnFullscreen" type="button" class="px-5 py-2.5 rounded-xl bg-gradient-to-r from-amber-500 to-orange-500 hover:from-amber-600 hover:to-orange-600 text-white font-bold shadow-md hover:shadow-lg transition-all whitespace-nowrap">
      🖥️ Fullscreen
    </button>
  </div>
</div>

<div class="space-y-6">
    <% questions.forEach((q, idx) => { 
      const colors = [
        { border: 'border-blue-200', bg: 'from-blue-50 to-cyan-50', text: 'text-blue-900', badge: 'bg-blue-100 text-blue-700' },
        { border: 'border-purple-200', bg: 'from-purple-50 to-pink-50', text: 'text-purple-900', badge: 'bg-purple-100 text-purple-700' },
        { border: 'border-rose-200', bg: 'from-rose-50 to-pink-50', text: 'text-rose-900', badge: 'bg-rose-100 text-rose-700' },
        { border: 'border-emerald-200', bg: 'from-emerald-50 to-teal-50', text: 'text-emerald-900', badge: 'bg-emerald-100 text-emerald-700' },
        { border: 'border-amber-200', bg: 'from-amber-50 to-orange-50', text: 'text-amber-900', badge: 'bg-amber-100 text-amber-700' },
        { border: 'border-indigo-200', bg: 'from-indigo-50 to-purple-50', text: 'text-indigo-900', badge: 'bg-indigo-100 text-indigo-700' }
      ];
      const color = colors[idx % colors.length];
    %>
      <section id="q-<%= q.no %>" class="rounded-2xl border-2 <%= color.border %> bg-gradient-to-br <%= color.bg %> p-6 shadow-lg scroll-mt-16">
        <div class="flex items-start justify-between gap-4 mb-4">
          <div class="flex items-center gap-3">
            <div class="flex items-center justify-center w-12 h-12 rounded-xl bg-white shadow-md">
              <span class="text-xl font-bold <%= color.text %>"><%= q.no %></span>
            </div>
            <div>
              <div class="text-xs font-semibold <%= color.text %> opacity-75">Soal <%= q.no %> dari <%= totalQ %></div>
              <div class="inline-flex items-center gap-1 px-3 py-1 rounded-full <%= color.badge %> text-xs font-bold mt-1">
                ⭐ <%= q.points %> poin
              </div>
            </div>
          </div>
        </div>

        <div class="bg-white rounded-xl p-5 shadow-md mb-4">
          <div class="text-slate-900 leading-relaxed prose prose-sm max-w-none"><%- q.text %></div>
          <% if (q.image) { %>
            <div class="mt-4">
              <img src="<%= q.image %>" alt="Gambar soal" class="max-w-full rounded-xl border-2 <%= color.border %> shadow-md" loading="lazy" />
            </div>
          <% } %>
          <% if (q.pdf) { %>
            <div class="mt-4">
              <div class="text-xs font-semibold <%= color.text %> mb-2">📄 PDF Soal:</div>
              <iframe src="<%= q.pdf %>" class="w-full h-96 rounded-xl border-2 <%= color.border %> shadow-md" frameborder="0"></iframe>
            </div>
          <% } %>
        </div>

        <div class="space-y-3">
          <% if (q.question_type === 'COMPLEX') { %>
            <div class="flex items-center gap-2 mb-2">
              <span class="text-sm font-bold <%= color.text %>">Pilih Jawaban (boleh lebih dari satu):</span>
              <span class="px-2 py-0.5 rounded-full bg-purple-100 text-purple-700 text-xs font-semibold">Kompleks TKA</span>
            </div>
            <p class="text-xs text-slate-500 mb-2">Poin parsial — semakin banyak jawaban benar yang dipilih, semakin tinggi poin.</p>
          <% } else if (q.question_type === 'CHECKBOX') { %>
            <div class="flex items-center gap-2 mb-2">
              <span class="text-sm font-bold <%= color.text %>">Pilih Jawaban (boleh lebih dari satu):</span>
              <span class="px-2 py-0.5 rounded-full bg-orange-100 text-orange-700 text-xs font-semibold">Checkbox</span>
            </div>
            <p class="text-xs text-slate-500 mb-2">Poin proporsional tanpa penalti — setiap jawaban benar yang dipilih menambah poin.</p>
          <% } else if (q.question_type === 'TRUE_FALSE') { %>
            <div class="flex items-center gap-2 mb-2">
              <span class="text-sm font-bold <%= color.text %>">Tentukan Benar atau Salah:</span>
              <span class="px-2 py-0.5 rounded-full bg-emerald-100 text-emerald-700 text-xs font-semibold">Benar/Salah</span>
            </div>
            <p class="text-xs text-slate-500 mb-2">Klik tombol di bawah untuk memilih jawaban.</p>
          <% } else { %>
            <div class="text-sm font-bold <%= color.text %> mb-2">Pilih Jawaban:</div>
          <% } %>

          <% if (q.question_type === 'TRUE_FALSE') { %>
            <!-- TRUE_FALSE: dropdown select ringkas -->
            <%
              const optA = q.options.find(o => o.option_label === 'A');
              const optB = q.options.find(o => o.option_label === 'B');
              const chosenTF = q.chosen_option_id;
            %>
            <div class="flex items-center gap-3 mt-2">
              <select
                id="tf_select_<%= q.id %>"
                data-question="<%= q.id %>"
                data-type="TRUE_FALSE"
                data-opta="<%= optA ? optA.id : '' %>"
                data-optb="<%= optB ? optB.id : '' %>"
                class="tf-select w-48 rounded-xl border-2 border-slate-200 bg-white px-4 py-2.5 text-sm font-semibold text-slate-700 focus:outline-none focus:border-emerald-400 focus:ring-2 focus:ring-emerald-200 transition-all cursor-pointer">
                <option value="" <%= !chosenTF ? 'selected' : '' %>>— Pilih jawaban —</option>
                <option value="<%= optA ? optA.id : '' %>" <%= chosenTF === (optA && optA.id) ? 'selected' : '' %>>✅ Benar</option>
                <option value="<%= optB ? optB.id : '' %>" <%= chosenTF === (optB && optB.id) ? 'selected' : '' %>>❌ Salah</option>
              </select>
              <!-- Hidden radio inputs agar autosave tetap jalan -->
              <% if (optA) { %>
                <input type="radio" name="ans_<%= q.id %>" value="<%= optA.id %>"
                  data-question="<%= q.id %>" data-type="TRUE_FALSE" class="sr-only tf-radio"
                  id="tf_radio_<%= q.id %>_a" <%= chosenTF === optA.id ? 'checked' : '' %> />
              <% } %>
              <% if (optB) { %>
                <input type="radio" name="ans_<%= q.id %>" value="<%= optB.id %>"
                  data-question="<%= q.id %>" data-type="TRUE_FALSE" class="sr-only tf-radio"
                  id="tf_radio_<%= q.id %>_b" <%= chosenTF === optB.id ? 'checked' : '' %> />
              <% } %>
              <% if (chosenTF) { %>
                <span class="text-sm font-semibold <%= chosenTF === (optA && optA.id) ? 'text-emerald-600' : 'text-rose-600' %>">
                  <%= chosenTF === (optA && optA.id) ? '✅ Terpilih: Benar' : '❌ Terpilih: Salah' %>
                </span>
              <% } %>
            </div>
          <% } else { %>
            <% q.options.forEach((o) => {
              const isChosen = q.question_type === 'COMPLEX'
                ? (q.chosen_option_ids && q.chosen_option_ids.includes(o.id))
                : (q.question_type === 'CHECKBOX'
                  ? (q.chosen_option_ids && q.chosen_option_ids.includes(o.id))
                  : (q.chosen_option_id === o.id));
            %>
              <label class="block rounded-xl border-2 <%= isChosen ? color.border + ' bg-white shadow-lg' : 'border-slate-200 bg-white/80' %> hover:shadow-lg px-5 py-4 cursor-pointer transition-all transform hover:scale-[1.02]">
                <div class="flex gap-4">
                  <% if (q.question_type === 'COMPLEX') { %>
                    <input type="checkbox"
                      name="ans_complex_<%= q.id %>"
                      value="<%= o.id %>"
                      data-question="<%= q.id %>"
                      data-type="COMPLEX"
                      class="mt-1 w-5 h-5 accent-purple-600 complex-checkbox"
                      <%= isChosen ? 'checked' : '' %> />
                  <% } else if (q.question_type === 'CHECKBOX') { %>
                    <input type="checkbox"
                      name="ans_checkbox_<%= q.id %>"
                      value="<%= o.id %>"
                      data-question="<%= q.id %>"
                      data-type="CHECKBOX"
                      class="mt-1 w-5 h-5 accent-orange-600 checkbox-answer"
                      <%= isChosen ? 'checked' : '' %> />
                  <% } else { %>
                    <input type="radio"
                      name="ans_<%= q.id %>"
                      value="<%= o.id %>"
                      data-question="<%= q.id %>"
                      data-type="<%= q.question_type || 'MCQ' %>"
                      class="mt-1 w-5 h-5 accent-<%= color.text.replace('text-', '') %>"
                      <%= isChosen ? 'checked' : '' %> />
                  <% } %>
                  <div class="flex-1">
                    <div class="inline-flex items-center justify-center w-8 h-8 rounded-lg <%= color.badge %> font-bold text-sm mb-2">
                      <%= o.option_label %>
                    </div>
                    <div class="text-slate-700 prose prose-sm max-w-none"><%- o.option_text %></div>
                  </div>
                </div>
              </label>
            <% }) %>
          <% } %>
        </div>
      </section>
    <% }) %>
  </div>
</div>

<script>
  // ===== CLIENT-SIDE BACKUP SYSTEM =====
  const BACKUP_KEY = 'exam_backup_<%= attempt.id %>';
  const SUBMISSION_RETRY_KEY = 'submission_retry_<%= attempt.id %>';
  
  // Save answers to LocalStorage
  function saveBackupToLocalStorage() {
    const answers = [];
    // MCQ — radio biasa (exclude tf-radio agar tidak duplikat)
    document.querySelectorAll('input[type=radio]:not(.tf-radio):checked').forEach(radio => {
      answers.push({
        question_id: Number(radio.getAttribute('data-question')),
        option_id: Number(radio.value),
        answered_at: new Date().toISOString()
      });
    });
    // TRUE_FALSE — dari dropdown select
    document.querySelectorAll('select.tf-select').forEach(sel => {
      if (sel.value) {
        answers.push({
          question_id: Number(sel.getAttribute('data-question')),
          option_id: Number(sel.value),
          answered_at: new Date().toISOString()
        });
      }
    });
    // COMPLEX — group checkbox per question
    const complexGroups = {};
    document.querySelectorAll('input.complex-checkbox').forEach(cb => {
      const qid = cb.getAttribute('data-question');
      if (!complexGroups[qid]) complexGroups[qid] = [];
      if (cb.checked) complexGroups[qid].push(Number(cb.value));
    });
    Object.entries(complexGroups).forEach(([qid, ids]) => {
      answers.push({
        question_id: Number(qid),
        option_ids: ids,
        type: 'COMPLEX',
        answered_at: new Date().toISOString()
      });
    });
    // CHECKBOX — group checkbox per question (separate class)
    const checkboxGroups = {};
    document.querySelectorAll('input.checkbox-answer').forEach(cb => {
      const qid = cb.getAttribute('data-question');
      if (!checkboxGroups[qid]) checkboxGroups[qid] = [];
      if (cb.checked) checkboxGroups[qid].push(Number(cb.value));
    });
    Object.entries(checkboxGroups).forEach(([qid, ids]) => {
      answers.push({
        question_id: Number(qid),
        option_ids: ids,
        type: 'CHECKBOX',
        answered_at: new Date().toISOString()
      });
    });

    const backup = {
      attempt_id: <%= attempt.id %>,
      student_id: <%= attempt.student_id %>,
      exam_id: <%= attempt.exam_id %>,
      answers: answers,
      backup_timestamp: new Date().toISOString()
    };

    try {
      localStorage.setItem(BACKUP_KEY, JSON.stringify(backup));
    } catch (e) {
      console.error('❌ Failed to save backup:', e);
    }
  }
  
  // Load backup from LocalStorage on page load
  function loadBackupFromLocalStorage() {
    try {
      const backupStr = localStorage.getItem(BACKUP_KEY);
      if (backupStr) {
        const backup = JSON.parse(backupStr);
        console.log('📦 Found backup in LocalStorage:', backup.answers.length, 'answers');
        return backup;
      }
    } catch (e) {
      console.error('❌ Failed to load backup:', e);
    }
    return null;
  }
  
  // Clear backup after successful submission
  function clearBackup() {
    try {
      localStorage.removeItem(BACKUP_KEY);
      localStorage.removeItem(SUBMISSION_RETRY_KEY);
      console.log('🗑️ Backup cleared from LocalStorage');
    } catch (e) {
      console.error('❌ Failed to clear backup:', e);
    }
  }
  
  // Timer — hitung endAt dengan benar
  // started_at tersimpan sebagai waktu lokal (WIB), parse dengan hati-hati
  const startedAtRaw = '<%= attempt.started_at instanceof Date ? attempt.started_at.toISOString() : String(attempt.started_at).replace(" ", "T") %>';
  const durationMinutes = Number('<%= attempt.duration_minutes %>');

  // Jika exam punya end_at (batas waktu absolut), gunakan yang lebih kecil
  <% const examEndAt = attempt.exam_end_at ? `new Date('${attempt.exam_end_at instanceof Date ? attempt.exam_end_at.toISOString() : String(attempt.exam_end_at).replace(" ", "T")}')` : 'null'; %>
  const examEndAt = <%- examEndAt %>;

  // Parse started_at — jika string tanpa timezone (dari DB WIB), tambahkan +07:00
  let startedAt;
  try {
    const raw = startedAtRaw.trim();
    // Jika sudah ada Z atau +, parse langsung
    if (/Z$|[+-]\d{2}:\d{2}$/.test(raw)) {
      startedAt = new Date(raw);
    } else {
      // Tidak ada timezone info — asumsikan WIB (+07:00)
      startedAt = new Date(raw + '+07:00');
    }
    // Sanity check: jika tahun tidak masuk akal, fallback ke now
    if (isNaN(startedAt.getTime()) || startedAt.getFullYear() < 2020) {
      startedAt = new Date();
    }
  } catch(_) {
    startedAt = new Date();
  }

  const endAtByDuration = new Date(startedAt.getTime() + durationMinutes * 60 * 1000);
  // Pakai yang lebih kecil antara durasi dan end_at ujian
  const endAt = examEndAt && examEndAt < endAtByDuration ? examEndAt : endAtByDuration;

  function formatMs(ms) {
    const totalSeconds = Math.max(0, Math.floor(ms / 1000));
    const m = Math.floor(totalSeconds / 60);
    const s = totalSeconds % 60;
    return String(m).padStart(2,'0') + ':' + String(s).padStart(2,'0');
  }

  let timeUpSubmitted = false;
  
  function tick() {
    const now = new Date();
    const remain = endAt - now;
    const timeStr = formatMs(remain);
    const timerEl = document.getElementById('timer');
    timerEl.textContent = timeStr;
    // Sync ke floating bar & drawer
    const tf = document.getElementById('timerFloat');
    const td = document.getElementById('timerDrawer');
    if (tf) tf.textContent = timeStr;
    if (td) td.textContent = timeStr;
    // Warna merah menyala saat <= 5 menit
    const urgent = remain <= 300000;
    [timerEl, tf, td].forEach(el => {
      if (!el) return;
      el.style.color = urgent ? '#dc2626' : '';
    });
    const floatBar = document.getElementById('floatingBar');
    if (floatBar) floatBar.style.borderBottomColor = urgent ? '#ef4444' : '#fca5a5';
    
    // Warning saat 5 menit tersisa
    if (remain <= 300000 && remain > 299000) {
      toast('⏰ Perhatian! Waktu tersisa 5 menit!');
    }
    
    // Warning saat 1 menit tersisa
    if (remain <= 60000 && remain > 59000) {
      toast('⚠️ Waktu tersisa 1 menit! Segera selesaikan!');
      timerEl.classList.add('animate-pulse');
    }
    
    // Auto-submit saat waktu habis
    if (remain <= 0 && !timeUpSubmitted) {
      timeUpSubmitted = true;
      timerEl.textContent = '00:00';
      
      // Tampilkan notifikasi
      const notification = document.createElement('div');
      notification.className = 'fixed inset-0 z-50 flex items-center justify-center bg-black/50 backdrop-blur-sm';
      notification.innerHTML = `
        <div class="rounded-2xl border-2 border-rose-300 bg-gradient-to-br from-rose-50 to-pink-50 p-8 shadow-2xl max-w-md mx-4 text-center">
          <div class="text-6xl mb-4">⏰</div>
          <h2 class="text-2xl font-bold text-rose-900 mb-2">Waktu Habis!</h2>
          <p class="text-rose-700 mb-4">Jawaban Anda sedang dikumpulkan secara otomatis...</p>
          <div class="flex items-center justify-center gap-2">
            <div class="w-3 h-3 bg-rose-500 rounded-full animate-bounce" style="animation-delay: 0s"></div>
            <div class="w-3 h-3 bg-rose-500 rounded-full animate-bounce" style="animation-delay: 0.1s"></div>
            <div class="w-3 h-3 bg-rose-500 rounded-full animate-bounce" style="animation-delay: 0.2s"></div>
          </div>
        </div>
      `;
      document.body.appendChild(notification);
      
      // Use retry mechanism for auto-submit
      setTimeout(() => {
        submitWithRetry();
      }, 1500);
    }
  }
  setInterval(tick, 500);
  tick();

  // Navigasi dengan highlight active
  const navButtons = document.querySelectorAll('.navBtn');
  const sections = document.querySelectorAll('section[id^="q-"]');
  
  // Scroll to question
  navButtons.forEach(btn => {
    btn.addEventListener('click', () => {
      const id = btn.getAttribute('data-jump');
      const el = document.getElementById(id);
      if (el) {
        el.scrollIntoView({ behavior: 'smooth', block: 'center' });
      }
    });
  });

  // Highlight active question in navigation
  function updateActiveNav() {
    const scrollPos = window.scrollY + window.innerHeight / 3;
    
    let activeSection = null;
    sections.forEach(section => {
      const rect = section.getBoundingClientRect();
      const sectionTop = rect.top + window.scrollY;
      const sectionBottom = sectionTop + rect.height;
      
      if (scrollPos >= sectionTop && scrollPos < sectionBottom) {
        activeSection = section;
      }
    });

    navButtons.forEach(btn => {
      const targetId = btn.getAttribute('data-jump');
      if (activeSection && targetId === activeSection.id) {
        btn.classList.add('ring-4', 'ring-purple-400', 'ring-offset-2');
      } else {
        btn.classList.remove('ring-4', 'ring-purple-400', 'ring-offset-2');
      }
    });
  }

  window.addEventListener('scroll', updateActiveNav);
  updateActiveNav();

  // Hitung answered (MCQ + COMPLEX + CHECKBOX)
  function updateAnswered() {
    // Hitung answered: radio biasa (MCQ) — exclude tf-radio agar tidak double count
    let answered = document.querySelectorAll('input[type=radio]:not(.tf-radio):checked').length;

