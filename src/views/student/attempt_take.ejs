<!-- Anti-translate meta (injected via layout head override jika tersedia, atau via JS di bawah) -->
<% const totalQ = questions.length; %>
<% const onePerPage = attempt.one_question_per_page === true; %>

<!-- Overlay Fullscreen — muncul saat halaman dimuat, siswa harus tap untuk masuk fullscreen -->
<div id="fsOverlay" style="
  position:fixed;top:0;left:0;width:100%;height:100%;
  background:linear-gradient(135deg,#1e3a5f 0%,#0f2027 100%);
  z-index:9999;display:flex;flex-direction:column;
  align-items:center;justify-content:center;
  padding:24px;box-sizing:border-box;
">
  <div style="text-align:center;color:#fff;max-width:360px;">
    <div style="font-size:56px;margin-bottom:16px;">📝</div>
    <div style="font-size:20px;font-weight:800;margin-bottom:8px;">Mode Ujian</div>
    <div style="font-size:13px;color:#94a3b8;margin-bottom:6px;"><%= attempt.exam_title || 'Ujian' %></div>
    <div style="font-size:13px;color:#cbd5e1;margin-bottom:28px;">
      Ujian akan berjalan dalam mode layar penuh.<br>
      Jangan pindah tab atau keluar dari halaman ini.
    </div>
    <button id="btnStartFullscreen"
      style="
        width:100%;padding:16px;border-radius:14px;border:none;cursor:pointer;
        background:linear-gradient(135deg,#f59e0b,#ef4444);
        color:#fff;font-size:17px;font-weight:800;
        box-shadow:0 4px 20px rgba(245,158,11,0.4);
        letter-spacing:0.3px;
      "
      ontouchstart="this.style.transform='scale(0.97)'"
      ontouchend="this.style.transform='scale(1)'"
    >
      🚀 Mulai Ujian — Aktifkan Layar Penuh
    </button>
    <div style="font-size:11px;color:#64748b;margin-top:14px;">
      Jika layar penuh tidak aktif, ujian tetap bisa dikerjakan.<br>
      Semua aktivitas layar dipantau.
    </div>
  </div>
</div>

<!-- Watermark identitas siswa -->
<div id="studentWatermark" style="position:fixed;top:0;left:0;width:100%;height:100%;pointer-events:none;z-index:20;"></div>
<script>
(function(){
  var name = "<%= user.full_name %>";
  var uname = "<%= user.username.split('@')[0] %>";
  var label = name + ' | ' + uname;
  var encoded = encodeURIComponent(label);
  var svg = '<svg xmlns="http://www.w3.org/2000/svg" width="400" height="300">'
    + '<text x="50%" y="50%" dominant-baseline="middle" text-anchor="middle"'
    + ' transform="rotate(-35,200,150)" font-size="18" font-family="sans-serif"'
    + ' fill="#555" opacity="0.05">' + label + '</text></svg>';
  var b64 = btoa(unescape(encodeURIComponent(svg)));
  document.getElementById('studentWatermark').style.backgroundImage =
    'url("data:image/svg+xml;base64,' + b64 + '")';
  document.getElementById('studentWatermark').style.backgroundRepeat = 'repeat';
  document.getElementById('studentWatermark').style.backgroundSize = '400px 300px';
})();
</script>

<script>
// ══ BLOKIR BROWSER TRANSLATE ═══════════════════════════════════════════════
(function() {
  // Set atribut translate=no dan lang=id ke <html>
  document.documentElement.setAttribute('translate', 'no');
  if (!document.documentElement.getAttribute('lang')) {
    document.documentElement.setAttribute('lang', 'id');
  }

  // Tambahkan meta notranslate ke <head> secara dinamis jika belum ada
  if (!document.querySelector('meta[name="google"][content="notranslate"]')) {
    var metaNoTranslate = document.createElement('meta');
    metaNoTranslate.name = 'google';
    metaNoTranslate.content = 'notranslate';
    document.head.appendChild(metaNoTranslate);
  }
})();

// Hide Google Translate toolbar
(function() {
  var style = document.createElement('style');
  style.textContent = [
    '.goog-te-banner-frame{display:none!important}',
    '.goog-te-menu-frame{display:none!important}',
    '#goog-gt-tt{display:none!important}',
    '.goog-tooltip{display:none!important}',
    '.goog-te-balloon-frame{display:none!important}',
    'body{top:0!important}',
    '.skiptranslate{display:none!important}'
  ].join('');
  document.head.appendChild(style);
})();
</script>

<!-- ══════════════════════════════════════════════════════════
     FLOATING BAR STICKY — Timer + Daftar Soal (selalu terlihat)
     ══════════════════════════════════════════════════════════ -->
<div id="floatingBar" class="fixed top-0 left-0 right-0 z-40 flex items-center justify-between gap-2 px-3 py-2 shadow-lg"
  style="background:rgba(255,255,255,0.97);backdrop-filter:blur(10px);border-bottom:2px solid #fca5a5;">

  <!-- Timer -->
  <div class="flex items-center gap-2 rounded-xl border-2 border-rose-400 bg-rose-50 px-3 py-1.5">
    <span class="text-lg">⏰</span>
    <div>
      <div class="text-xs font-semibold text-rose-600 leading-none">Sisa Waktu</div>
      <div id="timerFloat" class="text-xl font-black text-rose-600 tabular-nums leading-tight">--:--</div>
    </div>
  </div>

  <!-- Tengah: progress terjawab + indikator soal aktif (mode 1 per halaman) -->
  <div class="flex-1 flex items-center justify-center gap-2">
    <% if (onePerPage) { %>
      <span id="floatQIndicator" class="text-sm font-black text-indigo-600">Soal <span id="floatQCurrent">1</span>/<%= totalQ %></span>
    <% } else { %>
    <div class="text-xs text-slate-500 font-medium hidden sm:block">Terjawab:</div>
    <div class="flex items-center gap-1">
      <span id="floatAnswered" class="text-sm font-black text-emerald-600">0</span>
      <span class="text-xs text-slate-400">/<%= totalQ %></span>
    </div>
    <!-- Mini progress bar -->
    <div class="hidden sm:block w-24 h-2 bg-slate-200 rounded-full overflow-hidden">
      <div id="floatProgress" class="h-full bg-gradient-to-r from-emerald-400 to-teal-500 rounded-full transition-all duration-300" style="width:0%"></div>
    </div>
    <% } %>
  </div>

  <!-- Tombol Daftar Soal -->
  <button onclick="toggleSoalDrawer()" type="button"
    class="flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-gradient-to-r from-indigo-500 to-purple-600 text-white text-sm font-bold shadow-md hover:shadow-lg transition-all active:scale-95">
    <svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 10h16M4 14h16M4 18h16"/>
    </svg>
    <span>Daftar Soal</span>
  </button>
</div>

<!-- Spacer agar konten tidak tertutup floating bar -->
<div class="h-14"></div>
<!-- Timer hidden — nilai di-sync dari JS ke floating bar -->
<span id="timer" class="hidden"></span>
<span id="answeredCount" class="hidden">0</span>

<!-- Script global drawer — harus di-define SEBELUM tombol diklik -->
<script>
function toggleSoalDrawer() {
  var drawer = document.getElementById('soalDrawer');
  if (!drawer) return;
  if (drawer.classList.contains('hidden')) {
    drawer.classList.remove('hidden');
    // Sync status soal saat drawer dibuka
    document.querySelectorAll('.drawerBtn').forEach(function(btn) {
      var no = btn.getAttribute('data-drawer-no');
      var section = document.getElementById('q-' + no);
      if (!section) return;
      var hasRadio    = section.querySelector('input[type=radio]:not(.tf-radio):checked');
      var hasTF       = section.querySelector('select.tf-select');
      var tfAnswered  = hasTF && hasTF.value;
      var hasComplex  = section.querySelector('input.complex-checkbox:checked');
      var hasCheckbox = section.querySelector('input.checkbox-answer:checked');
      var hasMultiTf  = section.querySelector('.multitf-btn.multitf-active');
      var done = !!(hasRadio || tfAnswered || hasComplex || hasCheckbox || hasMultiTf);
      btn.className = 'drawerBtn h-12 rounded-xl border-2 font-bold text-sm transition-all ' +
        (done ? 'border-emerald-400 bg-emerald-100 text-emerald-700' : 'border-slate-300 bg-white text-slate-600');
    });
  } else {
    drawer.classList.add('hidden');
  }
}

const ONE_PER_PAGE = <%= onePerPage ? 'true' : 'false' %>;
let currentQ = 1;

function showQuestion(no) {
  if (!ONE_PER_PAGE) return;
  // Sembunyikan semua section soal dan nav
  document.querySelectorAll('.q-section').forEach(s => s.classList.add('hidden'));
  document.querySelectorAll('.q-nav').forEach(n => n.classList.add('hidden'));
  // Tampilkan soal yang dipilih
  const sec = document.querySelector('.q-section[data-q-no="' + no + '"]');
  const nav = document.querySelector('.q-nav[data-nav-no="' + no + '"]');
  if (sec) sec.classList.remove('hidden');
  if (nav) nav.classList.remove('hidden');
  currentQ = no;
  // Update floating bar indicator
  const floatQCurrent = document.getElementById('floatQCurrent');
  if (floatQCurrent) floatQCurrent.textContent = no;
  // Scroll ke atas soal
  window.scrollTo({ top: 0, behavior: 'smooth' });
  // Update highlight tombol drawer
  syncDrawerButtons();
}

function jumpAndClose(no) {
  toggleSoalDrawer();
  if (ONE_PER_PAGE) {
    setTimeout(function() { showQuestion(no); }, 200);
  } else {
    var target = document.getElementById('q-' + no);
    if (target) {
      setTimeout(function() {
        target.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }, 200);
    }
  }
}
</script>

<!-- ══════════════════════════════════════════════════════════
     DRAWER DAFTAR SOAL — muncul saat tombol diklik
     ══════════════════════════════════════════════════════════ -->
<div id="soalDrawer" class="hidden fixed inset-0 z-50 flex items-center justify-center p-4">
  <!-- Overlay -->
  <div class="absolute inset-0 bg-black/50" onclick="toggleSoalDrawer()"></div>
  <!-- Panel — tengah di semua ukuran layar -->
  <div class="relative w-full max-w-md bg-white rounded-2xl shadow-2xl overflow-hidden flex flex-col"
       style="max-height: min(85vh, 600px);">
    <!-- Header panel -->
    <div class="flex items-center justify-between px-5 py-4 border-b border-slate-100 bg-gradient-to-r from-indigo-50 to-purple-50 flex-shrink-0">
      <div class="flex items-center gap-3">
        <span class="text-xl">📋</span>
        <div>
          <div class="font-bold text-indigo-900">Daftar Soal</div>
          <div class="text-xs text-indigo-600"><span id="drawerAnswered">0</span> dari <%= totalQ %> soal terjawab</div>
        </div>
      </div>
      <!-- Timer di drawer -->
      <div class="flex items-center gap-2 rounded-xl border-2 border-rose-300 bg-rose-50 px-3 py-1.5">
        <span class="text-sm">⏰</span>
        <div id="timerDrawer" class="text-lg font-black text-rose-600 tabular-nums">--:--</div>
      </div>
      <button onclick="toggleSoalDrawer()" type="button" class="ml-2 p-1.5 rounded-lg hover:bg-slate-100 text-slate-500">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
        </svg>
      </button>
    </div>

    <!-- Legend -->
    <div class="flex items-center gap-4 px-5 py-2 bg-slate-50 border-b border-slate-100 flex-shrink-0">
      <div class="flex items-center gap-1.5">
        <div class="w-5 h-5 rounded-lg bg-emerald-100 border-2 border-emerald-400"></div>
        <span class="text-xs text-slate-600">Sudah dijawab</span>
      </div>
      <div class="flex items-center gap-1.5">
        <div class="w-5 h-5 rounded-lg bg-white border-2 border-slate-300"></div>
        <span class="text-xs text-slate-600">Belum dijawab</span>
      </div>
    </div>

    <!-- Grid soal -->
    <div class="overflow-y-auto p-3 flex-1" style="min-height:0;">
      <div class="grid grid-cols-5 gap-1.5" id="drawerGrid">
        <% questions.forEach((q) => { %>
          <button type="button"
            onclick="jumpAndClose(<%= q.no %>)"
            data-drawer-no="<%= q.no %>"
            class="drawerBtn h-10 rounded-xl border-2 font-bold text-sm transition-all <%= (q.question_type === 'MULTI_TF' ? (q.chosen_option_ids !== null && q.chosen_option_ids !== undefined) : !!q.chosen_option_id) ? 'border-emerald-400 bg-emerald-100 text-emerald-700' : 'border-slate-300 bg-white text-slate-600' %>">
            <%= q.no %>
          </button>
        <% }) %>
      </div>
    </div>

    <!-- Tombol kumpulkan — selalu terlihat di bawah -->
    <div class="px-4 py-3 border-t border-slate-100 bg-white flex-shrink-0">
      <form id="submitForm" action="/student/attempts/<%= attempt.id %>/submit" method="POST">
        <% const submitLocked = (attempt.submit_unlock_before > 0); %>
        <button type="submit" id="submitBtn"
          <%= submitLocked ? 'disabled' : '' %>
          class="w-full rounded-xl bg-gradient-to-r from-emerald-500 to-teal-600 hover:from-emerald-600 hover:to-teal-700 active:scale-95 text-white font-bold py-3 shadow-lg transition-all text-base"
          style="<%= submitLocked ? 'background:linear-gradient(to right,#94a3b8,#64748b);cursor:not-allowed;opacity:0.6;' : '' %>">
          <%= submitLocked ? 'Kirim Jawaban (Belum Aktif)' : 'Kumpulkan Jawaban' %>
        </button>
      </form>
    </div>
  </div>
</div>


<!-- Header ujian compact — dihapus agar tidak mengganggu tampilan -->
<%# (judul ujian sudah terlihat di floating bar dan drawer soal) %>

<!-- Overlay peringatan browser non-Chrome -->
<div id="browserWarningOverlay" style="display:none;
  position:fixed;top:0;left:0;width:100%;height:100%;
  z-index:9998;background:rgba(153,27,27,0.97);
  align-items:center;justify-content:center;padding:24px;box-sizing:border-box;">
  <div style="background:#fff;border-radius:20px;max-width:380px;width:100%;
    padding:28px 24px;text-align:center;box-shadow:0 20px 60px rgba(0,0,0,0.4);">
    <div style="font-size:48px;margin-bottom:12px;">⚠️</div>
    <div style="font-size:17px;font-weight:800;color:#dc2626;margin-bottom:8px;">Browser Tidak Didukung</div>
    <div style="font-size:13px;color:#374151;margin-bottom:6px;line-height:1.6;">
      Anda menggunakan <strong id="browserNameOverlay"></strong>.<br>
      Fitur keamanan ujian <strong>tidak bekerja optimal</strong> di browser ini.<br>
      Layar penuh dan anti-cheat mungkin tidak berfungsi.
    </div>
    <div style="font-size:12px;color:#6b7280;margin-bottom:20px;">
      Disarankan menggunakan <strong>Google Chrome</strong>.
    </div>
    <button id="btnOpenChrome" type="button" onclick="openInChrome()" style="
      width:100%;padding:14px;border-radius:12px;border:none;cursor:pointer;
      background:linear-gradient(135deg,#4285f4,#1a73e8);
      color:#fff;font-size:15px;font-weight:800;margin-bottom:10px;
      box-shadow:0 4px 16px rgba(66,133,244,0.4);">
      🌐 Buka di Google Chrome
    </button>
  </div>
</div>

<!-- Anti-cheat popup — muncul di tengah layar jika belum fullscreen -->
<div id="antiCheatBar" style="
  display:none;
  position:fixed;top:0;left:0;width:100%;height:100%;
  z-index:9000;
  background:rgba(0,0,0,0.55);
  align-items:center;justify-content:center;
  padding:20px;box-sizing:border-box;
">
  <div style="
    background:#fff;border-radius:20px;
    max-width:360px;width:100%;
    padding:28px 24px;
    box-shadow:0 20px 60px rgba(0,0,0,0.3);
    text-align:center;
    animation:popIn 0.25s ease;
  ">
    <div style="font-size:48px;margin-bottom:12px;">🖥️</div>
    <div style="font-size:17px;font-weight:800;color:#92400e;margin-bottom:8px;">Mode Ujian Aktif</div>
    <div style="font-size:13px;color:#78350f;margin-bottom:20px;line-height:1.6;">
      Aktifkan <strong>Layar Penuh</strong> untuk melanjutkan ujian.<br>
      Pelanggaran pindah tab akan tercatat.
    </div>
    <button id="btnFullscreen" type="button" style="
      width:100%;padding:14px;border-radius:12px;border:none;cursor:pointer;
      background:linear-gradient(135deg,#f59e0b,#ef4444);
      color:#fff;font-size:15px;font-weight:800;
      box-shadow:0 4px 16px rgba(245,158,11,0.4);
    ">
      🖥️ Aktifkan Layar Penuh
    </button>
  </div>
</div>
<style>
@keyframes popIn {
  from { transform:scale(0.85); opacity:0; }
  to   { transform:scale(1);    opacity:1; }
}
</style>


<!-- Layar Kunci Pelanggaran -->
<div id="lockScreen" class="hidden fixed inset-0 z-50 bg-red-900 bg-opacity-95 flex items-center justify-center p-4">
  <div class="bg-white rounded-3xl shadow-2xl max-w-md w-full p-8 text-center">
    <div class="text-6xl mb-4">🔒</div>
    <h2 class="text-2xl font-bold text-red-700 mb-2">Ujian Terkunci</h2>
    <p class="text-slate-600 text-sm mb-1">Layar dikunci karena terlalu banyak pelanggaran.</p>
    <p id="lockViolationInfo" class="text-red-600 font-semibold text-sm mb-6"></p>
    <div class="bg-amber-50 border border-amber-200 rounded-xl p-5 mb-6 text-center">
      <div class="text-3xl mb-2">⏳</div>
      <div class="text-sm font-semibold text-amber-800 mb-1">Menunggu persetujuan guru/pengawas</div>
      <div class="text-xs text-amber-700">Hubungi guru/pengawas ujian dan minta untuk membuka kunci. Layar akan terbuka otomatis setelah disetujui.</div>
    </div>
    <div id="unlockMsg" class="text-sm font-medium hidden mb-3"></div>
    <div class="text-xs text-slate-400">Jawaban kamu tersimpan dan tidak hilang.</div>
  </div>
</div>

<div class="<%= onePerPage ? '' : 'space-y-6' %>">
    <% questions.forEach((q, idx) => { 
      const colors = [
        { border: 'border-blue-200', bg: 'from-blue-50 to-cyan-50', text: 'text-blue-900', badge: 'bg-blue-100 text-blue-700' },
        { border: 'border-purple-200', bg: 'from-purple-50 to-pink-50', text: 'text-purple-900', badge: 'bg-purple-100 text-purple-700' },
        { border: 'border-rose-200', bg: 'from-rose-50 to-pink-50', text: 'text-rose-900', badge: 'bg-rose-100 text-rose-700' },
        { border: 'border-emerald-200', bg: 'from-emerald-50 to-teal-50', text: 'text-emerald-900', badge: 'bg-emerald-100 text-emerald-700' },
        { border: 'border-amber-200', bg: 'from-amber-50 to-orange-50', text: 'text-amber-900', badge: 'bg-amber-100 text-amber-700' },
        { border: 'border-indigo-200', bg: 'from-indigo-50 to-purple-50', text: 'text-indigo-900', badge: 'bg-indigo-100 text-indigo-700' }
      ];
      const color = colors[idx % colors.length];
    %>
      <section id="q-<%= q.no %>" data-q-no="<%= q.no %>" class="q-section rounded-2xl border-2 <%= color.border %> bg-gradient-to-br <%= color.bg %> p-6 shadow-lg scroll-mt-16<%= onePerPage && idx > 0 ? ' hidden' : '' %>">
        <div class="flex items-start justify-between gap-4 mb-4">
          <div class="flex items-center gap-3">
            <div class="flex items-center justify-center w-12 h-12 rounded-xl bg-white shadow-md">
              <span class="text-xl font-bold <%= color.text %>"><%= q.no %></span>
            </div>
            <div>
              <div class="text-xs font-semibold <%= color.text %> opacity-75">Soal <%= q.no %> dari <%= totalQ %></div>
              <div class="inline-flex items-center gap-1 px-3 py-1 rounded-full <%= color.badge %> text-xs font-bold mt-1">
                ⭐ <%= q.points %> poin
              </div>
            </div>
          </div>
        </div>

        <div class="bg-white rounded-xl p-5 shadow-md mb-4">
          <div class="text-slate-900 leading-relaxed prose prose-sm max-w-none"><%- q.text %></div>
          <% if (q.image) { %>
            <div class="mt-4">
              <img src="<%= q.image %>" alt="Gambar soal" class="max-w-full rounded-xl border-2 <%= color.border %> shadow-md" loading="lazy" />
            </div>
          <% } %>
          <% if (q.pdf) { %>
            <div class="mt-4">
              <div class="text-xs font-semibold <%= color.text %> mb-2">📄 PDF Soal:</div>
              <iframe src="<%= q.pdf %>" class="w-full h-96 rounded-xl border-2 <%= color.border %> shadow-md" frameborder="0"></iframe>
            </div>
          <% } %>
        </div>

        <div class="space-y-3">
          <% if (q.question_type === 'COMPLEX') { %>
            <div class="flex items-center gap-2 mb-2">
              <span class="text-sm font-bold <%= color.text %>">Pilih Jawaban (boleh lebih dari satu):</span>
              <span class="px-2 py-0.5 rounded-full bg-purple-100 text-purple-700 text-xs font-semibold">Kompleks TKA</span>
            </div>
            <p class="text-xs text-slate-500 mb-2">Poin parsial — semakin banyak jawaban benar yang dipilih, semakin tinggi poin.</p>
          <% } else if (q.question_type === 'CHECKBOX') { %>
            <div class="flex items-center gap-2 mb-2">
              <span class="text-sm font-bold <%= color.text %>">Pilih Jawaban (boleh lebih dari satu):</span>
              <span class="px-2 py-0.5 rounded-full bg-orange-100 text-orange-700 text-xs font-semibold">Checkbox</span>
            </div>
            <p class="text-xs text-slate-500 mb-2">Poin proporsional tanpa penalti — setiap jawaban benar yang dipilih menambah poin.</p>
          <% } else if (q.question_type === 'MULTI_TF') { %>
            <div class="flex items-center gap-2 mb-2">
              <span class="text-sm font-bold <%= color.text %>">Tentukan Benar atau Salah setiap pernyataan:</span>
              <span class="px-2 py-0.5 rounded-full bg-teal-100 text-teal-700 text-xs font-semibold">Multi B/S</span>
            </div>
            <p class="text-xs text-slate-500 mb-2">Poin parsial — setiap pernyataan yang dijawab benar menambah poin.</p>
          <% } else if (q.question_type === 'TRUE_FALSE') { %>
            <div class="flex items-center gap-2 mb-2">
              <span class="text-sm font-bold <%= color.text %>">Tentukan Benar atau Salah:</span>
              <span class="px-2 py-0.5 rounded-full bg-emerald-100 text-emerald-700 text-xs font-semibold">Benar/Salah</span>
            </div>
            <p class="text-xs text-slate-500 mb-2">Klik tombol di bawah untuk memilih jawaban.</p>
          <% } else { %>
            <div class="text-sm font-bold <%= color.text %> mb-2">Pilih Jawaban:</div>
          <% } %>

          <% if (q.question_type === 'TRUE_FALSE') { %>
            <!-- TRUE_FALSE: dropdown select ringkas -->
            <%
              const optA = q.options.find(o => o.option_label === 'A');
              const optB = q.options.find(o => o.option_label === 'B');
              const chosenTF = q.chosen_option_id;
            %>
            <div class="flex items-center gap-3 mt-2">
              <select
                id="tf_select_<%= q.id %>"
                data-question="<%= q.id %>"
                data-type="TRUE_FALSE"
                data-opta="<%= optA ? optA.id : '' %>"
                data-optb="<%= optB ? optB.id : '' %>"
                class="tf-select w-48 rounded-xl border-2 border-slate-200 bg-white px-4 py-2.5 text-sm font-semibold text-slate-700 focus:outline-none focus:border-emerald-400 focus:ring-2 focus:ring-emerald-200 transition-all cursor-pointer">
                <option value="" <%= !chosenTF ? 'selected' : '' %>>— Pilih jawaban —</option>
                <option value="<%= optA ? optA.id : '' %>" <%= chosenTF === (optA && optA.id) ? 'selected' : '' %>>✅ Benar</option>
                <option value="<%= optB ? optB.id : '' %>" <%= chosenTF === (optB && optB.id) ? 'selected' : '' %>>❌ Salah</option>
              </select>
              <!-- Hidden radio inputs agar autosave tetap jalan -->
              <% if (optA) { %>
                <input type="radio" name="ans_<%= q.id %>" value="<%= optA.id %>"
                  data-question="<%= q.id %>" data-type="TRUE_FALSE" class="sr-only tf-radio"
                  id="tf_radio_<%= q.id %>_a" <%= chosenTF === optA.id ? 'checked' : '' %> />
              <% } %>
              <% if (optB) { %>
                <input type="radio" name="ans_<%= q.id %>" value="<%= optB.id %>"
                  data-question="<%= q.id %>" data-type="TRUE_FALSE" class="sr-only tf-radio"
                  id="tf_radio_<%= q.id %>_b" <%= chosenTF === optB.id ? 'checked' : '' %> />
              <% } %>
              <% if (chosenTF) { %>
                <span class="text-sm font-semibold <%= chosenTF === (optA && optA.id) ? 'text-emerald-600' : 'text-rose-600' %>">
                  <%= chosenTF === (optA && optA.id) ? '✅ Terpilih: Benar' : '❌ Terpilih: Salah' %>
                </span>
              <% } %>
            </div>
          <% } else if (q.question_type === 'MULTI_TF') { %>
            <%# Data anchor for JS init — EJS renders neutral classes only; JS (H7) restores active state %>
            <span id="multitf_data_<%= q.id %>"
              data-ids="<%= q.chosen_option_ids !== null ? JSON.stringify(q.chosen_option_ids) : 'null' %>"
              class="hidden"></span>
            <div class="space-y-3">
              <% q.options.forEach((o) => { %>
              <div class="rounded-xl border-2 border-slate-200 bg-white p-4" id="multitf_row_<%= q.id %>_<%= o.id %>">
                <div class="flex items-start gap-3 mb-3">
                  <span class="w-7 h-7 rounded-lg bg-teal-100 text-teal-700 flex items-center justify-center font-bold text-sm flex-shrink-0">
                    <%= o.option_label %>
                  </span>
                  <div class="flex-1 text-slate-700 prose prose-sm max-w-none"><%- o.option_text %></div>
                </div>
                <div class="flex gap-3">
                  <button type="button"
                    data-multitf-qid="<%= q.id %>"
                    data-multitf-oid="<%= o.id %>"
                    data-multitf-val="benar"
                    class="multitf-btn flex-1 py-2 rounded-xl border-2 font-semibold text-sm transition-all border-slate-200 bg-white text-slate-500 hover:border-teal-300"
                    onclick="toggleMultiTf(this)">
                    Benar
                  </button>
                  <button type="button"
                    data-multitf-qid="<%= q.id %>"
                    data-multitf-oid="<%= o.id %>"
                    data-multitf-val="salah"
                    class="multitf-btn flex-1 py-2 rounded-xl border-2 font-semibold text-sm transition-all border-slate-200 bg-white text-slate-500 hover:border-rose-300"
                    onclick="toggleMultiTf(this)">
                    Salah
                  </button>
                </div>
              </div>
              <% }) %>
            </div>
          <% } else { %>
            <% q.options.forEach((o) => {
              const isChosen = q.question_type === 'COMPLEX'
                ? (q.chosen_option_ids && q.chosen_option_ids.includes(o.id))
                : (q.question_type === 'CHECKBOX'
                  ? (q.chosen_option_ids && q.chosen_option_ids.includes(o.id))
                  : (q.chosen_option_id === o.id));
            %>
              <label class="block rounded-xl border-2 <%= isChosen ? color.border + ' bg-white shadow-lg' : 'border-slate-200 bg-white/80' %> hover:shadow-lg px-5 py-4 cursor-pointer transition-all transform hover:scale-[1.02]">
                <div class="flex gap-4">
                  <% if (q.question_type === 'COMPLEX') { %>
                    <input type="checkbox"
                      name="ans_complex_<%= q.id %>"
                      value="<%= o.id %>"
                      data-question="<%= q.id %>"
                      data-type="COMPLEX"
                      class="mt-1 w-5 h-5 accent-purple-600 complex-checkbox"
                      <%= isChosen ? 'checked' : '' %> />
                  <% } else if (q.question_type === 'CHECKBOX') { %>
                    <input type="checkbox"
                      name="ans_checkbox_<%= q.id %>"
                      value="<%= o.id %>"
                      data-question="<%= q.id %>"
                      data-type="CHECKBOX"
                      class="mt-1 w-5 h-5 accent-orange-600 checkbox-answer"
                      <%= isChosen ? 'checked' : '' %> />
                  <% } else { %>
                    <input type="radio"
                      name="ans_<%= q.id %>"
                      value="<%= o.id %>"
                      data-question="<%= q.id %>"
                      data-type="<%= q.question_type || 'MCQ' %>"
                      class="mt-1 w-5 h-5 accent-<%= color.text.replace('text-', '') %>"
                      <%= isChosen ? 'checked' : '' %> />
                  <% } %>
                  <div class="flex-1">
                    <div class="inline-flex items-center justify-center w-8 h-8 rounded-lg <%= color.badge %> font-bold text-sm mb-2">
                      <%= o.option_label %>
                    </div>
                    <div class="text-slate-700 prose prose-sm max-w-none"><%- o.option_text %></div>
                    <% if (o.option_image) { %>
                      <img src="<%= o.option_image %>" alt="Opsi <%= o.option_label %>"
                        class="mt-2 max-w-full max-h-48 rounded-xl border border-slate-200 shadow-sm" loading="lazy" />
                    <% } %>
                  </div>
                </div>
              </label>
            <% }) %>
          <% } %>
        </div>
      </section>

      <% if (onePerPage) { %>
      <!-- Navigasi Prev/Next — hanya di mode 1 soal per halaman -->
      <div class="q-nav flex items-center justify-between gap-3 mt-4 mb-6<%= idx > 0 ? ' hidden' : '' %>" data-nav-no="<%= q.no %>">
        <% if (idx > 0) { %>
          <button type="button" onclick="showQuestion(<%= q.no - 1 %>)"
            class="flex items-center gap-2 px-5 py-3 rounded-xl border-2 border-slate-300 bg-white hover:bg-slate-50 text-slate-700 font-semibold transition-all shadow-sm">
            ← Sebelumnya
          </button>
        <% } else { %>
          <div></div>
        <% } %>
        <span class="text-sm font-semibold text-slate-500"><%= q.no %> / <%= totalQ %></span>
        <% if (idx < totalQ - 1) { %>
          <button type="button" onclick="showQuestion(<%= q.no + 1 %>)"
            class="flex items-center gap-2 px-5 py-3 rounded-xl bg-gradient-to-r from-indigo-500 to-purple-600 hover:from-indigo-600 hover:to-purple-700 text-white font-semibold transition-all shadow-md">
            Selanjutnya →
          </button>
        <% } else { %>
          <!-- Soal terakhir: tombol kumpulkan -->
          <button type="button" onclick="document.getElementById('submitForm').dispatchEvent(new Event('submit',{cancelable:true}))"
            class="flex items-center gap-2 px-5 py-3 rounded-xl bg-gradient-to-r from-emerald-500 to-teal-600 hover:from-emerald-600 hover:to-teal-700 text-white font-semibold transition-all shadow-md">
            ✅ Kumpulkan
          </button>
        <% } %>
      </div>
      <% } %>

    <% }) %>
  </div>
</div>

<script>
  // ===== CLIENT-SIDE BACKUP SYSTEM =====
  const BACKUP_KEY = 'exam_backup_<%= attempt.id %>';
  const SUBMISSION_RETRY_KEY = 'submission_retry_<%= attempt.id %>';
  
  // Save answers to LocalStorage
  function saveBackupToLocalStorage() {
    const answers = [];
    // MCQ — radio biasa (exclude tf-radio agar tidak duplikat)
    document.querySelectorAll('input[type=radio]:not(.tf-radio):checked').forEach(radio => {
      answers.push({
        question_id: Number(radio.getAttribute('data-question')),
        option_id: Number(radio.value),
        answered_at: new Date().toISOString()
      });
    });
    // TRUE_FALSE — dari dropdown select
    document.querySelectorAll('select.tf-select').forEach(sel => {
      if (sel.value) {
        answers.push({
          question_id: Number(sel.getAttribute('data-question')),
          option_id: Number(sel.value),
          answered_at: new Date().toISOString()
        });
      }
    });
    // COMPLEX — group checkbox per question
    const complexGroups = {};
    document.querySelectorAll('input.complex-checkbox').forEach(cb => {
      const qid = cb.getAttribute('data-question');
      if (!complexGroups[qid]) complexGroups[qid] = [];
      if (cb.checked) complexGroups[qid].push(Number(cb.value));
    });
    Object.entries(complexGroups).forEach(([qid, ids]) => {
      answers.push({
        question_id: Number(qid),
        option_ids: ids,
        type: 'COMPLEX',
        answered_at: new Date().toISOString()
      });
    });
    // CHECKBOX — group checkbox per question (separate class)
    const checkboxGroups = {};
    document.querySelectorAll('input.checkbox-answer').forEach(cb => {
      const qid = cb.getAttribute('data-question');
      if (!checkboxGroups[qid]) checkboxGroups[qid] = [];
      if (cb.checked) checkboxGroups[qid].push(Number(cb.value));
    });
    Object.entries(checkboxGroups).forEach(([qid, ids]) => {
      answers.push({
        question_id: Number(qid),
        option_ids: ids,
        type: 'CHECKBOX',
        answered_at: new Date().toISOString()
      });
    });
    // MULTI_TF — collect Benar IDs per question
    const multiTfQidsSet = new Set(
      Array.from(document.querySelectorAll('.multitf-btn'))
        .map(b => b.getAttribute('data-multitf-qid'))
    );
    multiTfQidsSet.forEach(qid => {
      const selectedIds = Array.from(
        document.querySelectorAll(`.multitf-btn.multitf-active[data-multitf-qid="${qid}"][data-multitf-val="benar"]`)
      ).map(b => Number(b.getAttribute('data-multitf-oid')));
      answers.push({
        question_id: Number(qid),
        option_ids: selectedIds,
        type: 'MULTI_TF',
        answered_at: new Date().toISOString()
      });
    });

    const backup = {
      attempt_id: <%= attempt.id %>,
      student_id: <%= attempt.student_id %>,
      exam_id: <%= attempt.exam_id %>,
      answers: answers,
      backup_timestamp: new Date().toISOString()
    };

    try {
      localStorage.setItem(BACKUP_KEY, JSON.stringify(backup));
    } catch (e) {
      console.error('Failed to save backup:', e);
    }
  }
  
  // Load backup from LocalStorage on page load
  function loadBackupFromLocalStorage() {
    try {
      const backupStr = localStorage.getItem(BACKUP_KEY);
      if (backupStr) {
        const backup = JSON.parse(backupStr);
        console.log('Found backup in LocalStorage:', backup.answers.length, 'answers');
        return backup;
      }
    } catch (e) {
      console.error('Failed to load backup:', e);
    }
    return null;
  }
  
  // Clear backup after successful submission
  function clearBackup() {
    try {
      localStorage.removeItem(BACKUP_KEY);
      localStorage.removeItem(SUBMISSION_RETRY_KEY);
      console.log('Backup cleared from LocalStorage');
    } catch (e) {
      console.error('Failed to clear backup:', e);
    }
  }
  
  // Timer — hitung endAt dengan benar
  // started_at tersimpan sebagai waktu lokal (WIB), parse dengan hati-hati
  const startedAtRaw = '<%= attempt.started_at instanceof Date ? attempt.started_at.toISOString() : String(attempt.started_at).replace(" ", "T") %>';
  const durationMinutes = Number('<%= attempt.duration_minutes %>');
  const submitUnlockBefore = Number('<%= attempt.submit_unlock_before || 0 %>');
  // unlockAfterMs = waktu dari mulai ujian sampai tombol submit aktif
  const unlockAfterMs = submitUnlockBefore > 0
    ? (durationMinutes - submitUnlockBefore) * 60 * 1000
    : 0;
  let submitUnlocked = submitUnlockBefore === 0; // jika 0, langsung aktif
  let submitUnlockToastShown = false;

  // Jika exam punya end_at (batas waktu absolut), gunakan yang lebih kecil
  <% const examEndAt = attempt.exam_end_at ? `new Date('${attempt.exam_end_at instanceof Date ? attempt.exam_end_at.toISOString() : String(attempt.exam_end_at).replace(" ", "T")}')` : 'null'; %>
  const examEndAt = <%- examEndAt %>;

  // Parse started_at — jika string tanpa timezone (dari DB WIB), tambahkan +07:00
  let startedAt;
  try {
    const raw = startedAtRaw.trim();
    // Jika sudah ada Z atau +, parse langsung
    if (/Z$|[+-]\d{2}:\d{2}$/.test(raw)) {
      startedAt = new Date(raw);
    } else {
      // Tidak ada timezone info — asumsikan WIB (+07:00)
      startedAt = new Date(raw + '+07:00');
    }
    // Sanity check: jika tahun tidak masuk akal, fallback ke now
    if (isNaN(startedAt.getTime()) || startedAt.getFullYear() < 2020) {
      startedAt = new Date();
    }
  } catch(_) {
    startedAt = new Date();
  }

  const endAtByDuration = new Date(startedAt.getTime() + durationMinutes * 60 * 1000);
  // Pakai yang lebih kecil antara durasi dan end_at ujian
  const endAt = examEndAt && examEndAt < endAtByDuration ? examEndAt : endAtByDuration;

  function formatMs(ms) {
    const totalSeconds = Math.max(0, Math.floor(ms / 1000));
    const m = Math.floor(totalSeconds / 60);
    const s = totalSeconds % 60;
    return String(m).padStart(2,'0') + ':' + String(s).padStart(2,'0');
  }

  let timeUpSubmitted = false;
  
  function tick() {
    const now = new Date();
    const remain = endAt - now;
    const timeStr = formatMs(remain);
    const timerEl = document.getElementById('timer');
    timerEl.textContent = timeStr;
    // Sync ke floating bar & drawer
    const tf = document.getElementById('timerFloat');

    // Submit lock: aktifkan tombol submit setelah unlockAfterMs berlalu
    if (submitUnlockBefore > 0 && !submitUnlocked) {
      // F1 fix: hitung elapsed dari startedAt, bukan dari sisa timer
      // (sisa timer bisa berbeda jika exam_end_at lebih pendek dari durasi penuh)
      const elapsed = new Date().getTime() - startedAt.getTime();
      if (elapsed >= unlockAfterMs) {
        submitUnlocked = true;
        const btn = document.getElementById('submitBtn');
        if (btn) {
          btn.disabled = false;
          btn.style.background = '';
          btn.style.cursor = '';
          btn.style.opacity = '';
          btn.textContent = 'Kumpulkan Jawaban';
        }
        if (!submitUnlockToastShown) {
          submitUnlockToastShown = true;
          toast('Tombol Kirim ujian sudah aktif!');
        }
      } else {
        // F3 fix: tampilkan menit DAN detik agar lebih informatif
        const msLeft = unlockAfterMs - elapsed;
        const btn = document.getElementById('submitBtn');
        if (btn && !submitUnlocked) {
          if (msLeft >= 60000) {
            const minsLeft = Math.ceil(msLeft / 60000);
            btn.textContent = 'Kirim aktif ' + minsLeft + ' menit lagi';
          } else {
            const secsLeft = Math.ceil(msLeft / 1000);
            btn.textContent = 'Kirim aktif ' + secsLeft + ' detik lagi';
          }
        }
      }
    }
    const td = document.getElementById('timerDrawer');
    if (tf) tf.textContent = timeStr;
    if (td) td.textContent = timeStr;
    // Warna merah menyala saat <= 5 menit
    const urgent = remain <= 300000;
    [timerEl, tf, td].forEach(el => {
      if (!el) return;
      el.style.color = urgent ? '#dc2626' : '';
    });
    const floatBar = document.getElementById('floatingBar');
    if (floatBar) floatBar.style.borderBottomColor = urgent ? '#ef4444' : '#fca5a5';
    
    // Warning saat 5 menit tersisa
    if (remain <= 300000 && remain > 299000) {
      toast('Perhatian! Waktu tersisa 5 menit!');
    }
    
    // Warning saat 1 menit tersisa
    if (remain <= 60000 && remain > 59000) {
      toast('Waktu tersisa 1 menit! Segera selesaikan!');
      timerEl.classList.add('animate-pulse');
    }
    
    // Auto-submit saat waktu habis
    if (remain <= 0 && !timeUpSubmitted) {
      timeUpSubmitted = true;
      timerEl.textContent = '00:00';
      
      // Tampilkan notifikasi
      const notification = document.createElement('div');
      notification.className = 'fixed inset-0 z-50 flex items-center justify-center bg-black/50 backdrop-blur-sm';
      notification.innerHTML = `
        <div class="rounded-2xl border-2 border-rose-300 bg-gradient-to-br from-rose-50 to-pink-50 p-8 shadow-2xl max-w-md mx-4 text-center">
          <div class="text-6xl mb-4">⏰</div>
          <h2 class="text-2xl font-bold text-rose-900 mb-2">Waktu Habis!</h2>
          <p class="text-rose-700 mb-4">Jawaban Anda sedang dikumpulkan secara otomatis...</p>
          <div class="flex items-center justify-center gap-2">
            <div class="w-3 h-3 bg-rose-500 rounded-full animate-bounce" style="animation-delay: 0s"></div>
            <div class="w-3 h-3 bg-rose-500 rounded-full animate-bounce" style="animation-delay: 0.1s"></div>
            <div class="w-3 h-3 bg-rose-500 rounded-full animate-bounce" style="animation-delay: 0.2s"></div>
          </div>
        </div>
      `;
      document.body.appendChild(notification);
      
      // Use retry mechanism for auto-submit
      setTimeout(() => {
        submitWithRetry(3, true); // isAutoSubmit = true → bypass validasi waktu server
      }, 1500);
    }
  }
  setInterval(tick, 500);
  tick();

  // Navigasi dengan highlight active
  const navButtons = document.querySelectorAll('.navBtn');
  const sections = document.querySelectorAll('section[id^="q-"]');
  
  // Scroll to question (atau show di mode onePerPage)
  navButtons.forEach(btn => {
    btn.addEventListener('click', () => {
      const id = btn.getAttribute('data-jump');
      const no = Number(id.replace('q-', ''));
      if (ONE_PER_PAGE) {
        showQuestion(no);
      } else {
        const el = document.getElementById(id);
        if (el) {
          el.scrollIntoView({ behavior: 'smooth', block: 'center' });
        }
      }
    });
  });

  // Highlight active question in navigation
  function updateActiveNav() {
    if (ONE_PER_PAGE) return; // mode 1-soal: highlight dihandle syncDrawerButtons
    const scrollPos = window.scrollY + window.innerHeight / 3;
    
    let activeSection = null;
    sections.forEach(section => {
      const rect = section.getBoundingClientRect();
      const sectionTop = rect.top + window.scrollY;
      const sectionBottom = sectionTop + rect.height;
      
      if (scrollPos >= sectionTop && scrollPos < sectionBottom) {
        activeSection = section;
      }
    });

    navButtons.forEach(btn => {
      const targetId = btn.getAttribute('data-jump');
      if (activeSection && targetId === activeSection.id) {
        btn.classList.add('ring-4', 'ring-purple-400', 'ring-offset-2');
      } else {
        btn.classList.remove('ring-4', 'ring-purple-400', 'ring-offset-2');
      }
    });
  }

  window.addEventListener('scroll', updateActiveNav);
  updateActiveNav();

  // Hitung answered (MCQ + COMPLEX + CHECKBOX)
  function updateAnswered() {
    // Hitung answered: radio biasa (MCQ) — exclude tf-radio agar tidak double count
    let answered = document.querySelectorAll('input[type=radio]:not(.tf-radio):checked').length;

    // Tambah soal TRUE_FALSE yang sudah dipilih via dropdown
    document.querySelectorAll('select.tf-select').forEach(sel => {
      if (sel.value) answered++;
    });

    // Tambah soal COMPLEX yang sudah dipilih minimal 1
    const complexQids = new Set(
      Array.from(document.querySelectorAll('input.complex-checkbox'))
        .map(cb => cb.getAttribute('data-question'))
    );
    complexQids.forEach(qid => {
      const anyChecked = document.querySelector(`input.complex-checkbox[data-question="${qid}"]:checked`);
      if (anyChecked) answered++;
    });

    // Tambah soal CHECKBOX yang sudah dipilih minimal 1
    const checkboxQids = new Set(
      Array.from(document.querySelectorAll('input.checkbox-answer'))
        .map(cb => cb.getAttribute('data-question'))
    );
    checkboxQids.forEach(qid => {
      const anyChecked = document.querySelector(`input.checkbox-answer[data-question="${qid}"]:checked`);
      if (anyChecked) answered++;
    });

    // Tambah soal MULTI_TF yang sudah dipilih minimal 1 pernyataan
    const multiTfQids = new Set(
      Array.from(document.querySelectorAll('.multitf-btn.multitf-active'))
        .map(btn => btn.getAttribute('data-multitf-qid'))
    );
    multiTfQids.forEach(qid => { answered++; });

    document.getElementById('answeredCount').textContent = answered;

    // Sync ke floating bar & drawer
    const fa = document.getElementById('floatAnswered');
    const da = document.getElementById('drawerAnswered');
    const fp = document.getElementById('floatProgress');
    if (fa) fa.textContent = answered;
    if (da) da.textContent = answered;
    if (fp) fp.style.width = (<%= totalQ %> > 0 ? (answered / <%= totalQ %> * 100) : 0) + '%';

    // Update tombol di drawer
    syncDrawerButtons();

    // Update nav button — MCQ radio biasa (bukan tf-radio)
    document.querySelectorAll('input[type=radio]:not(.tf-radio):checked').forEach(radio => {
      const section = radio.closest('section');
      if (!section) return;
      const qNo = section.id.replace('q-', '');
      const navBtn = document.querySelector(`[data-jump="q-${qNo}"]`);
      if (navBtn) {
        navBtn.classList.remove('border-slate-300', 'bg-white', 'text-slate-600');
        navBtn.classList.add('border-emerald-400', 'bg-gradient-to-br', 'from-emerald-100', 'to-teal-100', 'text-emerald-700', 'shadow-md');
      }
    });

    // Update nav button — TRUE_FALSE dropdown
    document.querySelectorAll('select.tf-select').forEach(sel => {
      if (!sel.value) return;
      const section = sel.closest('section');
      if (!section) return;
      const qNo = section.id.replace('q-', '');
      const navBtn = document.querySelector(`[data-jump="q-${qNo}"]`);
      if (navBtn) {
        navBtn.classList.remove('border-slate-300', 'bg-white', 'text-slate-600');
        navBtn.classList.add('border-emerald-400', 'bg-gradient-to-br', 'from-emerald-100', 'to-teal-100', 'text-emerald-700', 'shadow-md');
      }
    });

    // Update nav button — COMPLEX
    complexQids.forEach(qid => {
      const anyChecked = document.querySelector(`input.complex-checkbox[data-question="${qid}"]:checked`);
      const section = document.querySelector(`input.complex-checkbox[data-question="${qid}"]`)?.closest('section');
      if (!section) return;
      const qNo = section.id.replace('q-', '');
      const navBtn = document.querySelector(`[data-jump="q-${qNo}"]`);
      if (navBtn && anyChecked) {
        navBtn.classList.remove('border-slate-300', 'bg-white', 'text-slate-600');
        navBtn.classList.add('border-emerald-400', 'bg-gradient-to-br', 'from-emerald-100', 'to-teal-100', 'text-emerald-700', 'shadow-md');
      }
    });
    // Update nav button — CHECKBOX
    checkboxQids.forEach(qid => {
      const anyChecked = document.querySelector(`input.checkbox-answer[data-question="${qid}"]:checked`);
      const section = document.querySelector(`input.checkbox-answer[data-question="${qid}"]`)?.closest('section');
      if (!section) return;
      const qNo = section.id.replace('q-', '');
      const navBtn = document.querySelector(`[data-jump="q-${qNo}"]`);
      if (navBtn && anyChecked) {
        navBtn.classList.remove('border-slate-300', 'bg-white', 'text-slate-600');
