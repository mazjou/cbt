  function detectBrowser() {
    var ua = navigator.userAgent;
    if (/Edg\//.test(ua))          return 'Microsoft Edge';
    if (/OPR\/|Opera/.test(ua))    return 'Opera';
    if (/SamsungBrowser/.test(ua)) return 'Samsung Browser';
    if (/MiuiBrowser/.test(ua))    return 'Xiaomi Browser';
    if (/UCBrowser/.test(ua))      return 'UC Browser';
    if (/Firefox/.test(ua))        return 'Firefox';
    if (/CriOS/.test(ua))          return 'Chrome iOS';
    if (/Chrome\//.test(ua))       return 'Chrome';
    if (/Safari\//.test(ua))       return 'Safari';
    return 'Browser Lain';
  }
  function isChromeLike() {
    var b = detectBrowser();
    return b === 'Chrome' || b === 'Chrome iOS';
  }

  // Anti-cheat — gunakan max_violations dari ujian, bukan ENV
  const anti = {
