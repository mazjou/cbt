        toast('⚠️ Koneksi terputus. Jawaban tersimpan di perangkat Anda.');
      }
    });
  });

  // Autosave jawaban CHECKBOX
  document.querySelectorAll('input.checkbox-answer').forEach(cb => {
    cb.addEventListener('change', async () => {
      const qid = cb.getAttribute('data-question');
      const selectedIds = Array.from(
        document.querySelectorAll(`input.checkbox-answer[data-question="${qid}"]:checked`)
      ).map(el => Number(el.value));

      updateAnswered();
      saveBackupToLocalStorage();
      try {
        await fetch('/student/attempts/<%= attempt.id %>/answer', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ question_id: Number(qid), option_ids: selectedIds })
        });
      } catch (e) {
        console.error('Autosave CHECKBOX failed:', e);
        toast('⚠️ Koneksi terputus. Jawaban tersimpan di perangkat Anda.');
      }
    });
  });

  // ===== SUBMISSION WITH RETRY MECHANISM =====
  let isSubmitting = false;
  
  async function submitWithRetry(maxRetries = 3) {
    if (isSubmitting) {
      console.log('⏳ Submission already in progress');
      return;
    }
    
    isSubmitting = true;
    
    // Save final backup before submission
    saveBackupToLocalStorage();
    
    let retryCount = 0;
    let lastError = null;
    
    while (retryCount < maxRetries) {
      try {
        console.log(`🔄 Submission attempt ${retryCount + 1}/${maxRetries}`);
        
        const response = await fetch('/student/attempts/<%= attempt.id %>/submit', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'X-Retry-Count': retryCount.toString()
          },
          body: JSON.stringify({
            backup_data: loadBackupFromLocalStorage()
          })
        });
        
        if (response.ok || response.status === 302) {
          console.log('✅ Submission successful!');
          clearBackup();
          
          // Redirect to result page
          window.location.href = `/student/attempts/<%= attempt.id %>/result`;
          return;
        }
        
        // If server returns error, throw to trigger retry
        throw new Error(`Server returned ${response.status}`);
        
      } catch (error) {
        lastError = error;
        retryCount++;
        
        console.error(`❌ Submission attempt ${retryCount} failed:`, error);
        
        if (retryCount < maxRetries) {
          // Exponential backoff: 1s, 2s, 4s
          const delay = Math.pow(2, retryCount - 1) * 1000;
          console.log(`⏳ Retrying in ${delay}ms...`);
          
          toast(`Gagal submit, mencoba lagi... (${retryCount}/${maxRetries})`);
          
          await new Promise(resolve => setTimeout(resolve, delay));
        }
      }
    }
    
    // All retries failed
    console.error('❌ All submission attempts failed');
    isSubmitting = false;
    
    // Show error message with recovery instructions
    const errorDiv = document.createElement('div');
    errorDiv.className = 'fixed inset-0 z-50 flex items-center justify-center bg-black/50 backdrop-blur-sm';
    errorDiv.innerHTML = `
      <div class="rounded-2xl border-2 border-rose-300 bg-gradient-to-br from-rose-50 to-pink-50 p-8 shadow-2xl max-w-md mx-4">
        <div class="text-6xl mb-4 text-center">⚠️</div>
        <h2 class="text-2xl font-bold text-rose-900 mb-2 text-center">Submission Gagal</h2>
        <p class="text-rose-700 mb-4 text-center">
          Jawaban Anda telah tersimpan dengan aman di perangkat dan server. 
          Silakan hubungi guru atau admin untuk memulihkan jawaban Anda.
        </p>
        <div class="bg-white rounded-lg p-4 mb-4 text-sm">
          <div class="font-bold text-gray-900 mb-2">📋 Informasi untuk Admin:</div>
          <div class="text-gray-700">
            <div>Attempt ID: <span class="font-mono font-bold"><%= attempt.id %></span></div>
            <div>Backup tersimpan di LocalStorage</div>
            <div>Waktu: ${new Date().toLocaleString('id-ID')}</div>
          </div>
        </div>
        <button onclick="location.reload()" 
                class="w-full rounded-xl bg-gradient-to-r from-blue-500 to-indigo-600 hover:from-blue-600 hover:to-indigo-700 text-white font-bold py-3 shadow-lg">
          🔄 Coba Lagi
        </button>
        <button onclick="window.location.href='/student/exams'" 
                class="w-full mt-2 rounded-xl bg-gray-500 hover:bg-gray-600 text-white font-bold py-3 shadow-lg">
          ← Kembali ke Daftar Ujian
        </button>
      </div>
    `;
    document.body.appendChild(errorDiv);
  }
  
  // Override form submission to use retry mechanism
  const submitForm = document.getElementById('submitForm');
  const submitBtn  = document.getElementById('submitBtn');

  if (submitForm) {
    submitForm.addEventListener('submit', (e) => {
      e.preventDefault();

      // Jika sudah dalam proses submit, tampilkan info bukan diam
      if (isSubmitting) {
        toast('⏳ Sedang mengirim jawaban, harap tunggu...');
        return;
      }

      const confirmed = confirm('Yakin ingin mengumpulkan jawaban? Pastikan semua soal sudah dijawab.');
      if (!confirmed) return;

      // Feedback visual: tombol loading
      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.textContent = '⏳ Mengirim jawaban...';
        submitBtn.classList.add('opacity-75', 'cursor-not-allowed');
      }

      submitWithRetry().finally(() => {
        // Reset tombol jika gagal (sukses → redirect, tidak sampai sini)
        if (submitBtn) {
          submitBtn.disabled = false;
          submitBtn.textContent = '✅ Kumpulkan Jawaban';
          submitBtn.classList.remove('opacity-75', 'cursor-not-allowed');
        }
      });
    });
  }

  // Autosave jawaban
  document.querySelectorAll('input[type=radio]').forEach(r => {
    r.addEventListener('change', async () => {
      const qid = r.getAttribute('data-question');
      const oid = r.value;
      updateAnswered();

      try {
        await fetch('/student/attempts/<%= attempt.id %>/answer', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ question_id: Number(qid), option_id: Number(oid) })
        });
      } catch (e) {
        console.error('Autosave failed:', e);
      }
    });
  });

  // Anti-cheat — gunakan max_violations dari ujian, bukan ENV
  const anti = {
    attemptId: <%= attempt.id %>,
    max: Number('<%= attempt.max_violations || 0 %>'), // 0 = nonaktif
    sentAt: new Map(),
    localCount: 0,
    locked: false
  };

  function nowMs() { return Date.now(); }

  function toast(msg) {
    let box = document.getElementById('antiCheatToast');
    if (!box) {
      box = document.createElement('div');
      box.id = 'antiCheatToast';
      box.className = 'fixed bottom-4 right-4 z-50 max-w-md rounded-xl border-2 border-rose-300 bg-gradient-to-r from-rose-50 to-pink-50 shadow-2xl px-5 py-4 text-sm font-semibold text-rose-900';
      document.body.appendChild(box);
    }
    box.textContent = '⚠️ ' + msg;
    box.style.opacity = '1';
    clearTimeout(box._t);
    box._t = setTimeout(() => { box.style.opacity = '0'; }, 3000);
  }

  function showLockScreen(count, max) {
    anti.locked = true;
    const ls = document.getElementById('lockScreen');
    if (ls) {
      ls.classList.remove('hidden');
      const info = document.getElementById('lockViolationInfo');
      if (info) info.textContent = `Pelanggaran: ${count}/${max}`;
    }
    // Keluar fullscreen agar siswa bisa minta persetujuan ke guru
    try {
      if (document.exitFullscreen) document.exitFullscreen();
      else if (document.webkitExitFullscreen) document.webkitExitFullscreen();
    } catch(_) {}
    // Mulai polling otomatis menunggu persetujuan guru
    startLockPolling();
  }

  async function submitUnlockToken() {
    // Tidak digunakan lagi - unlock dilakukan oleh guru/admin
  }

  // Polling otomatis cek status kunci setiap 3 detik saat terkunci
  let lockPollInterval = null;
  function startLockPolling() {
    if (lockPollInterval) return;
    lockPollInterval = setInterval(async () => {
      try {
        const r = await fetch(`/student/attempts/${anti.attemptId}/lock-status`);
        const d = await r.json();
        if (d.ok && !d.locked) {
          // Guru sudah setujui - buka layar
          clearInterval(lockPollInterval);
          lockPollInterval = null;
          anti.locked = false;
          const msg = document.getElementById('unlockMsg');
          if (msg) {
            msg.textContent = '✅ Guru telah menyetujui. Silakan lanjutkan ujian!';
            msg.className = 'text-sm font-medium text-green-600';
            msg.classList.remove('hidden');
          }
          setTimeout(() => {
            document.getElementById('lockScreen').classList.add('hidden');
            if (msg) msg.classList.add('hidden');
          }, 1500);
        }
      } catch(_) {}
    }, 3000);
  }

  async function reportViolation(type, details) {
    if (anti.max === 0) return; // anti-cheat dinonaktifkan
    if (anti.locked) return;
    const key = type + '::' + (details || '');
    const last = anti.sentAt.get(key) || 0;
    if (nowMs() - last < 2000) return;
    anti.sentAt.set(key, nowMs());
    anti.localCount += 1;

    try {
      const r = await fetch(`/student/attempts/${anti.attemptId}/violation`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ type, details })
      });
      const j = await r.json().catch(() => ({}));
      const count = (typeof j.count === 'number') ? j.count : anti.localCount;
      const max = (typeof j.max === 'number') ? j.max : anti.max;

      if (j.locked) {
        anti.locked = true;
        // Tampilkan layar kunci — JANGAN redirect/submit
        showLockScreen(count, max);
        return;
      }
      toast(`${type}. Pelanggaran tercatat (${count}/${max}).`);
    } catch (e) {
      toast(`${type}. (Gagal kirim log, cek koneksi)`);
    }
  }

  // Fullscreen
  const fsBtn = document.getElementById('btnFullscreen');
  async function requestFullscreen() {
    try {
      const el = document.documentElement;
      if (el.requestFullscreen) await el.requestFullscreen();
      else if (el.webkitRequestFullscreen) el.webkitRequestFullscreen();
    } catch (e) {
      toast('Browser menolak fullscreen.');
    }
  }
  if (fsBtn) fsBtn.addEventListener('click', requestFullscreen);

  let firstInteract = true;
  window.addEventListener('pointerdown', () => {
    if (!firstInteract) return;
    firstInteract = false;
    requestFullscreen();
  }, { once: true });

  function isFullscreen() {
    return !!(document.fullscreenElement || document.webkitFullscreenElement);
  }
  document.addEventListener('fullscreenchange', () => {
    if (!isFullscreen()) reportViolation('Keluar Fullscreen', 'fullscreenchange');
  });
  document.addEventListener('webkitfullscreenchange', () => {
    if (!isFullscreen()) reportViolation('Keluar Fullscreen', 'webkitfullscreenchange');
  });

  document.addEventListener('visibilitychange', () => {
    if (document.hidden) reportViolation('Pindah Tab/Aplikasi', 'visibilitychange');
  });

  // blur di HP sering terpicu saat keyboard virtual muncul/hilang — tidak laporkan
  const isMobileDevice = navigator.maxTouchPoints > 0 || /Android|iPhone|iPad/i.test(navigator.userAgent);
  if (!isMobileDevice) {
    window.addEventListener('blur', () => reportViolation('Pindah Tab/Aplikasi', 'blur'));
  }

  // ── Floating bar & Drawer soal — fungsi sudah didefinisikan di atas (global script)
  function syncDrawerButtons() {
    document.querySelectorAll('.drawerBtn').forEach(function(btn) {
      var no = btn.getAttribute('data-drawer-no');
      var section = document.getElementById('q-' + no);
      if (!section) return;
      var hasRadio    = section.querySelector('input[type=radio]:not(.tf-radio):checked');
      var hasTF       = section.querySelector('select.tf-select');
      var tfAnswered  = hasTF && hasTF.value;
      var hasComplex  = section.querySelector('input.complex-checkbox:checked');
      var hasCheckbox = section.querySelector('input.checkbox-answer:checked');
      var done = !!(hasRadio || tfAnswered || hasComplex || hasCheckbox);
      btn.className = 'drawerBtn h-12 rounded-xl border-2 font-bold text-sm transition-all ' +
        (done ? 'border-emerald-400 bg-emerald-100 text-emerald-700' : 'border-slate-300 bg-white text-slate-600');
    });
  }

  document.addEventListener('contextmenu', (e) => {
    e.preventDefault();
    // Di HP/mobile, contextmenu bisa muncul dari long press (bukan kecurangan)
    // Hanya laporkan di desktop (bukan touchscreen)
    const isMobile = navigator.maxTouchPoints > 0 || /Android|iPhone|iPad/i.test(navigator.userAgent);
    if (!isMobile) {
      reportViolation('Klik Kanan', 'contextmenu');
    }
  });
  ['copy','cut','paste'].forEach(ev => {
    document.addEventListener(ev, (e) => {
      e.preventDefault();
      reportViolation('Copy/Cut/Paste', ev);
    });
  });
  document.addEventListener('keydown', (e) => {
    const k = (e.key || '').toLowerCase();
    const ctrl = e.ctrlKey || e.metaKey;
    if (ctrl && ['c','v','x','p','s','u'].includes(k)) {
      e.preventDefault();
      reportViolation('Shortcut Diblokir', `ctrl+${k}`);
    }
    if (k === 'printscreen') {
      reportViolation('PrintScreen', 'key');
    }
  });

  try { document.body.style.userSelect = 'none'; } catch (e) {}

  // Cek status kunci saat halaman pertama kali dimuat (misal setelah refresh)
  (async function checkInitialLockStatus() {
    try {
      const r = await fetch(`/student/attempts/${anti.attemptId}/lock-status`);
      const d = await r.json();
      if (d.ok && d.locked) {
        showLockScreen('?', anti.max);
      }
    } catch(_) {}
  })();
</script>

<!-- KaTeX: render rumus matematika (akar, pecahan, dll) -->
<link rel="stylesheet" href="/public/lib/katex/katex.min.css">
<script src="/public/lib/katex/katex.min.js"></script>
<script>
  // Render semua elemen .math-formula[data-latex] di soal & opsi jawaban
  document.querySelectorAll('.math-formula[data-latex]').forEach(function(el) {
    try {
      el.innerHTML = katex.renderToString(el.getAttribute('data-latex'), {
        throwOnError: false,
        displayMode: el.getAttribute('data-mode') === 'block'
      });
    } catch(e) {}
  });
</script>
