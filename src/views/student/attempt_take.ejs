  // Heartbeat setiap 60 detik + jitter random 0-30 detik
  // Jitter mencegah 1000 siswa kirim heartbeat di detik yang sama (thundering herd)
  (function startHeartbeat() {
    const BASE_INTERVAL = 60000;
    const JITTER = Math.floor(Math.random() * 30000); // 0-30 detik random
    function sendBeat() {
      fetch('/student/attempts/<%= attempt.id %>/heartbeat', {
        method: 'POST',
