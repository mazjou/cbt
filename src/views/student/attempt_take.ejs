    if (!row) return;
    var benarBtn = row.querySelector('[data-multitf-val="benar"]');
    var salahBtn = row.querySelector('[data-multitf-val="salah"]');

    var isAlreadyActive = btn.classList.contains('multitf-active');

    // Deactivate both buttons for this statement
    [benarBtn, salahBtn].forEach(function(b) {
      b.classList.remove('multitf-active',
        'border-teal-500','bg-teal-100','text-teal-700',
        'border-rose-500','bg-rose-100','text-rose-700');
      b.classList.add('border-slate-200','bg-white','text-slate-500');
