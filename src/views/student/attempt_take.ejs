<% const totalQ = questions.length; %>

<!-- ══════════════════════════════════════════════════════════
     FLOATING BAR STICKY — Timer + Daftar Soal (selalu terlihat)
     ══════════════════════════════════════════════════════════ -->
<div id="floatingBar" class="fixed top-0 left-0 right-0 z-40 flex items-center justify-between gap-2 px-3 py-2 shadow-lg"
  style="background:rgba(255,255,255,0.97);backdrop-filter:blur(10px);border-bottom:2px solid #fca5a5;">

  <!-- Timer -->
  <div class="flex items-center gap-2 rounded-xl border-2 border-rose-400 bg-rose-50 px-3 py-1.5">
    <span class="text-lg">⏰</span>
    <div>
      <div class="text-xs font-semibold text-rose-600 leading-none">Sisa Waktu</div>
      <div id="timerFloat" class="text-xl font-black text-rose-600 tabular-nums leading-tight">--:--</div>
    </div>
  </div>

  <!-- Tengah: progress terjawab -->
  <div class="flex-1 flex items-center justify-center gap-2">
    <div class="text-xs text-slate-500 font-medium hidden sm:block">Terjawab:</div>
    <div class="flex items-center gap-1">
      <span id="floatAnswered" class="text-sm font-black text-emerald-600">0</span>
      <span class="text-xs text-slate-400">/<%= totalQ %></span>
    </div>
    <!-- Mini progress bar -->
    <div class="hidden sm:block w-24 h-2 bg-slate-200 rounded-full overflow-hidden">
      <div id="floatProgress" class="h-full bg-gradient-to-r from-emerald-400 to-teal-500 rounded-full transition-all duration-300" style="width:0%"></div>
    </div>
  </div>

  <!-- Tombol Daftar Soal -->
  <button onclick="toggleSoalDrawer()" type="button"
    class="flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-gradient-to-r from-indigo-500 to-purple-600 text-white text-sm font-bold shadow-md hover:shadow-lg transition-all active:scale-95">
    <svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 10h16M4 14h16M4 18h16"/>
    </svg>
    <span>Daftar Soal</span>
  </button>
</div>

<!-- Spacer agar konten tidak tertutup floating bar -->
<div class="h-14"></div>
<!-- Timer hidden — nilai di-sync dari JS ke floating bar -->
<span id="timer" class="hidden"></span>
<span id="answeredCount" class="hidden">0</span>

<!-- Script global drawer — harus di-define SEBELUM tombol diklik -->
<script>
function toggleSoalDrawer() {
  var drawer = document.getElementById('soalDrawer');
  if (!drawer) return;
  if (drawer.classList.contains('hidden')) {
    drawer.classList.remove('hidden');
    // Sync status soal saat drawer dibuka
    document.querySelectorAll('.drawerBtn').forEach(function(btn) {
      var no = btn.getAttribute('data-drawer-no');
      var section = document.getElementById('q-' + no);
      if (!section) return;
      var hasRadio    = section.querySelector('input[type=radio]:not(.tf-radio):checked');
      var hasTF       = section.querySelector('select.tf-select');
      var tfAnswered  = hasTF && hasTF.value;
      var hasComplex  = section.querySelector('input.complex-checkbox:checked');
      var hasCheckbox = section.querySelector('input.checkbox-answer:checked');
      var done = !!(hasRadio || tfAnswered || hasComplex || hasCheckbox);
      btn.className = 'drawerBtn h-12 rounded-xl border-2 font-bold text-sm transition-all ' +
        (done ? 'border-emerald-400 bg-emerald-100 text-emerald-700' : 'border-slate-300 bg-white text-slate-600');
    });
  } else {
    drawer.classList.add('hidden');
  }
}

function jumpAndClose(no) {
  toggleSoalDrawer();
  var target = document.getElementById('q-' + no);
  if (target) {
    setTimeout(function() {
      target.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }, 200);
  }
}
</script>

<!-- ══════════════════════════════════════════════════════════
     DRAWER DAFTAR SOAL — muncul saat tombol diklik
     ══════════════════════════════════════════════════════════ -->
<div id="soalDrawer" class="hidden fixed inset-0 z-50 flex items-center justify-center p-4">
  <!-- Overlay -->
  <div class="absolute inset-0 bg-black/50" onclick="toggleSoalDrawer()"></div>
  <!-- Panel — tengah di semua ukuran layar -->
  <div class="relative w-full max-w-md bg-white rounded-2xl shadow-2xl overflow-hidden flex flex-col"
       style="max-height: min(85vh, 600px);">
    <!-- Header panel -->
    <div class="flex items-center justify-between px-5 py-4 border-b border-slate-100 bg-gradient-to-r from-indigo-50 to-purple-50 flex-shrink-0">
      <div class="flex items-center gap-3">
        <span class="text-xl">📋</span>
        <div>
          <div class="font-bold text-indigo-900">Daftar Soal</div>
          <div class="text-xs text-indigo-600"><span id="drawerAnswered">0</span> dari <%= totalQ %> soal terjawab</div>
        </div>
      </div>
      <!-- Timer di drawer -->
      <div class="flex items-center gap-2 rounded-xl border-2 border-rose-300 bg-rose-50 px-3 py-1.5">
        <span class="text-sm">⏰</span>
        <div id="timerDrawer" class="text-lg font-black text-rose-600 tabular-nums">--:--</div>
      </div>
      <button onclick="toggleSoalDrawer()" type="button" class="ml-2 p-1.5 rounded-lg hover:bg-slate-100 text-slate-500">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
        </svg>
      </button>
    </div>

    <!-- Legend -->
    <div class="flex items-center gap-4 px-5 py-2 bg-slate-50 border-b border-slate-100 flex-shrink-0">
      <div class="flex items-center gap-1.5">
        <div class="w-5 h-5 rounded-lg bg-emerald-100 border-2 border-emerald-400"></div>
        <span class="text-xs text-slate-600">Sudah dijawab</span>
      </div>
      <div class="flex items-center gap-1.5">
        <div class="w-5 h-5 rounded-lg bg-white border-2 border-slate-300"></div>
        <span class="text-xs text-slate-600">Belum dijawab</span>
      </div>
    </div>

    <!-- Grid soal -->
    <div class="overflow-y-auto p-3 flex-1" style="min-height:0;">
      <div class="grid grid-cols-5 gap-1.5" id="drawerGrid">
        <% questions.forEach((q) => { %>
          <button type="button"
            onclick="jumpAndClose('<%= q.no %>')"
            data-drawer-no="<%= q.no %>"
            class="drawerBtn h-10 rounded-xl border-2 font-bold text-sm transition-all <%= q.chosen_option_id ? 'border-emerald-400 bg-emerald-100 text-emerald-700' : 'border-slate-300 bg-white text-slate-600' %>">
            <%= q.no %>
          </button>
        <% }) %>
      </div>
    </div>

    <!-- Tombol kumpulkan — selalu terlihat di bawah -->
    <div class="px-4 py-3 border-t border-slate-100 bg-white flex-shrink-0">
      <form id="submitForm" action="/student/attempts/<%= attempt.id %>/submit" method="POST">
        <button type="submit" id="submitBtn"
          class="w-full rounded-xl bg-gradient-to-r from-emerald-500 to-teal-600 hover:from-emerald-600 hover:to-teal-700 active:scale-95 text-white font-bold py-3 shadow-lg transition-all text-base">
          ✅ Kumpulkan Jawaban
        </button>
      </form>
    </div>
  </div>
</div>


<!-- Header ujian compact -->
<div class="rounded-2xl border border-indigo-200 bg-gradient-to-br from-indigo-50 via-purple-50 to-pink-50 px-5 py-4 shadow-lg mb-4">
  <div class="flex items-center gap-3">
    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white/80 backdrop-blur-sm text-xs font-semibold text-indigo-600 flex-shrink-0">
      📝 Ujian
    </div>
    <div class="min-w-0">
      <h1 class="text-xl lg:text-2xl font-bold text-indigo-900 truncate"><%= attempt.title %></h1>
      <% if (attempt.description) { %>
        <p class="text-sm text-indigo-700 truncate"><%= attempt.description %></p>
      <% } %>
    </div>
  </div>
</div>

<!-- Anti-cheat bar -->
<div id="antiCheatBar" class="rounded-xl border border-amber-300 bg-gradient-to-r from-amber-50 to-yellow-50 px-5 py-4 mb-6 shadow-md">

<!-- Layar Kunci Pelanggaran -->
