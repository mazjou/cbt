    // Update nav button — COMPLEX
    complexQids.forEach(qid => {
      const anyChecked = document.querySelector(`input.complex-checkbox[data-question="${qid}"]:checked`);
      const section = document.querySelector(`input.complex-checkbox[data-question="${qid}"]`)?.closest('section');
      if (!section) return;
      const qNo = section.id.replace('q-', '');
      const navBtn = document.querySelector(`[data-jump="q-${qNo}"]`);
      if (navBtn && anyChecked) {
        navBtn.classList.remove('border-slate-300', 'bg-white', 'text-slate-600');
        navBtn.classList.add('border-emerald-400', 'bg-gradient-to-br', 'from-emerald-100', 'to-teal-100', 'text-emerald-700', 'shadow-md');
      }
    });
    // Update nav button — CHECKBOX
    checkboxQids.forEach(qid => {
      const anyChecked = document.querySelector(`input.checkbox-answer[data-question="${qid}"]:checked`);
      const section = document.querySelector(`input.checkbox-answer[data-question="${qid}"]`)?.closest('section');
      if (!section) return;
      const qNo = section.id.replace('q-', '');
      const navBtn = document.querySelector(`[data-jump="q-${qNo}"]`);
      if (navBtn && anyChecked) {
        navBtn.classList.remove('border-slate-300', 'bg-white', 'text-slate-600');
        navBtn.classList.add('border-emerald-400', 'bg-gradient-to-br', 'from-emerald-100', 'to-teal-100', 'text-emerald-700', 'shadow-md');
      }
    });
  }
  updateAnswered();

  // Autosave jawaban MCQ / TRUE_FALSE (radio biasa)
  document.querySelectorAll('input[type=radio]:not(.tf-radio)').forEach(r => {
    r.addEventListener('change', async () => {
      const qid = r.getAttribute('data-question');
      const oid = r.value;
      updateAnswered();
      saveBackupToLocalStorage();
      try {
        await fetch('/student/attempts/<%= attempt.id %>/answer', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ question_id: Number(qid), option_id: Number(oid) })
        });
      } catch (e) {
        console.error('Autosave failed:', e);
        toast('⚠️ Koneksi terputus. Jawaban tersimpan di perangkat Anda.');
      }
    });
  });

  // Autosave jawaban TRUE_FALSE via dropdown select
  document.querySelectorAll('select.tf-select').forEach(sel => {
    sel.addEventListener('change', async () => {
      const qid = sel.getAttribute('data-question');
      const oid = Number(sel.value);
      if (!oid) return; // pilih "— Pilih jawaban —"

      // Sync ke hidden radio input agar updateAnswered() bekerja
      const radios = document.querySelectorAll(`input.tf-radio[data-question="${qid}"]`);
      radios.forEach(r => { r.checked = (Number(r.value) === oid); });

      // Update label terpilih di sebelah dropdown
      const optA = Number(sel.getAttribute('data-opta'));
      const isBenar = (oid === optA);
      // Hapus span status lama lalu buat baru
      const existing = sel.parentElement.querySelector('.tf-status');
      if (existing) existing.remove();
      const span = document.createElement('span');
      span.className = 'tf-status text-sm font-semibold ' + (isBenar ? 'text-emerald-600' : 'text-rose-600');
      span.textContent = isBenar ? '✅ Terpilih: Benar' : '❌ Terpilih: Salah';
      sel.parentElement.appendChild(span);

      updateAnswered();
      saveBackupToLocalStorage();
      try {
        await fetch('/student/attempts/<%= attempt.id %>/answer', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ question_id: Number(qid), option_id: oid })
        });
      } catch (e) {
        console.error('Autosave TF failed:', e);
        toast('⚠️ Koneksi terputus. Jawaban tersimpan di perangkat Anda.');
      }
    });
  });

  // Autosave jawaban COMPLEX (checkbox)
  document.querySelectorAll('input.complex-checkbox').forEach(cb => {
    cb.addEventListener('change', async () => {
      const qid = cb.getAttribute('data-question');
      // Kumpulkan semua checkbox yang diceklis untuk soal ini
      const selectedIds = Array.from(
        document.querySelectorAll(`input.complex-checkbox[data-question="${qid}"]:checked`)
      ).map(el => Number(el.value));

      updateAnswered();
      saveBackupToLocalStorage();
      try {
        await fetch('/student/attempts/<%= attempt.id %>/answer', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ question_id: Number(qid), option_ids: selectedIds })
        });
      } catch (e) {
