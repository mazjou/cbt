<!doctype html>
<html lang="id" class="h-full">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover" />
    <meta name="theme-color" content="#4F46E5" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="LMS SMKN 1 Kras" />
    <title><%= title ? title + ' • ' : '' %>LMS SMKN 1 Kras</title>
    
    <!-- PWA Manifest -->
    <link rel="manifest" href="/public/manifest.json" />
    <link rel="icon" type="image/png" href="/public/images/logo.png" />
    <link rel="apple-touch-icon" href="/public/images/logo.png" />
    
    <!-- Tailwind CSS (pre-built static, bukan runtime JS) -->
    <link rel="stylesheet" href="/public/lib/tailwind.css" />
    <style>
      /* Fix Summernote list styles yang di-reset oleh Tailwind Preflight */
      .note-editable ul,
      .note-editable ol {
        padding-left: 1.5em !important;
        margin: 0.5em 0 !important;
      }
      .note-editable ul {
        list-style-type: disc !important;
      }
      .note-editable ol {
        list-style-type: decimal !important;
      }
      .note-editable ul li,
      .note-editable ol li {
        display: list-item !important;
      }
      .note-editable ul ul {
        list-style-type: circle !important;
      }
      .note-editable ul ul ul {
        list-style-type: square !important;
      }
      /* Fix list styles di area render konten HTML (prose) */
      .prose ul,
      .prose ol {
        padding-left: 1.5em !important;
        margin: 0.5em 0 !important;
      }
      .prose ul {
        list-style-type: disc !important;
      }
      .prose ol {
        list-style-type: decimal !important;
      }
      .prose ul li,
      .prose ol li {
        display: list-item !important;
      }
      .prose ul ul {
        list-style-type: circle !important;
      }
      .prose ul ul ul {
        list-style-type: square !important;
      }
    </style>
    
    <!-- Capacitor Core (only loads in native app) -->
    <script type="module">
      if (window.Capacitor) {
        import('https://cdn.jsdelivr.net/npm/@capacitor/core@latest/dist/index.js').then(module => {
          window.Capacitor = module.Capacitor;
        });
      }
    </script>
  </head>
  <body class="h-full bg-slate-100 text-slate-900">
    <div class="min-h-full">
      <%- include('partials/navbar') %>
      
      <main class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-8">
        <%- include('partials/flash') %>
        <%- body %>
      </main>
      <footer class="border-t border-slate-200">
        <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-6 text-sm text-slate-500 flex items-center justify-between">
          <div>LMS SMKN 1 Kras</div>
          <div class="opacity-80">&copy; <span id="footer-year-main"></span> MRIT. All rights reserved.</div>
          <script>document.getElementById('footer-year-main').textContent = new Date().getFullYear();</script>
        </div>
      </footer>
    </div>

    <!-- Service Worker Registration -->
    <script>
      if ('serviceWorker' in navigator) {
        window.addEventListener('load', () => {
          navigator.serviceWorker.register('/public/service-worker.js')
            .then(reg => console.log('Service Worker registered:', reg.scope))
            .catch(err => console.error('Service Worker registration failed:', err));
        });
      }
    </script>



    <!-- Capacitor Native Plugins -->
    <script src="/public/capacitor.js"></script>

    <!-- Notification Script (Only for Students) -->
    <% if (typeof user !== 'undefined' && user && user.role) { 
      const userRole = user.role.toLowerCase();
      if (userRole === 'student') { %>
    
    <!-- OLD NOTIFICATION SYSTEM - DISABLED
    <script>
      // Sistem notifikasi lama dinonaktifkan, diganti dengan modal notification system
    </script>
    -->

    <!-- Modal Notification System (Peringatan dari Guru/Admin) -->
    <script>
      (function() {
        // Key localStorage: simpan map { notifId: push_count } yang sudah ditutup siswa
        const storageKey = 'closedNotifs_v2';
        let closedMap = {};
        try {
          closedMap = JSON.parse(localStorage.getItem(storageKey) || '{}');
        } catch(e) { closedMap = {}; }

        function saveClosedMap() {
          try { localStorage.setItem(storageKey, JSON.stringify(closedMap)); } catch(e) {}
        }

        async function checkModalNotifications() {
          try {
            const response = await fetch('/notifications/active');
            const data = await response.json();
            if (data.notifications && data.notifications.length > 0) {
              for (const notif of data.notifications) {
                const pushCount = notif.push_count || 0;
                const closedCount = closedMap[notif.id];
                // Tampilkan jika: belum pernah ditutup, ATAU guru push ulang (push_count bertambah)
                if (closedCount === undefined || closedCount < pushCount) {
                  showModalNotification(notif, pushCount);
                  break; // tampilkan satu per satu
                }
              }
            }
          } catch (error) {
            console.error('[Notification] Error:', error);
          }
        }

        function showModalNotification(notif) {
          const colors = {
            info: { bg: 'from-blue-50 to-cyan-50', border: 'border-blue-300', text: 'text-blue-900', icon: 'ℹ️' },
            warning: { bg: 'from-orange-50 to-amber-50', border: 'border-orange-300', text: 'text-orange-900', icon: '⚠️' },
            success: { bg: 'from-green-50 to-emerald-50', border: 'border-green-300', text: 'text-green-900', icon: '✅' },
            error: { bg: 'from-red-50 to-rose-50', border: 'border-red-300', text: 'text-red-900', icon: '❌' },
            GENERAL: { bg: 'from-indigo-50 to-purple-50', border: 'border-indigo-300', text: 'text-indigo-900', icon: '📢' },
            EXAM: { bg: 'from-purple-50 to-violet-50', border: 'border-purple-300', text: 'text-purple-900', icon: '📝' },
            MATERIAL: { bg: 'from-cyan-50 to-teal-50', border: 'border-cyan-300', text: 'text-cyan-900', icon: '📚' },
            ASSIGNMENT: { bg: 'from-orange-50 to-amber-50', border: 'border-orange-300', text: 'text-orange-900', icon: '📋' },
            LIVE_CLASS: { bg: 'from-pink-50 to-rose-50', border: 'border-pink-300', text: 'text-pink-900', icon: '🎥' }
          };
          const color = colors[notif.type] || colors.GENERAL;

          const modal = document.createElement('div');
        function showModalNotification(notif, pushCount) {
          if (document.getElementById('modalNotification_' + notif.id)) return;
          const colors = {
            info: { border:'border-blue-200', bg:'from-blue-50 to-cyan-50', text:'text-blue-900', icon:'ℹ️' },
            warning: { border:'border-orange-200', bg:'from-orange-50 to-amber-50', text:'text-orange-900', icon:'⚠️' },
            success: { border:'border-green-200', bg:'from-green-50 to-emerald-50', text:'text-green-900', icon:'✅' },
            error: { border:'border-red-200', bg:'from-red-50 to-rose-50', text:'text-red-900', icon:'❌' },
            EXAM: { border:'border-purple-200', bg:'from-purple-50 to-indigo-50', text:'text-purple-900', icon:'📝' },
            MATERIAL: { border:'border-cyan-200', bg:'from-cyan-50 to-teal-50', text:'text-cyan-900', icon:'📚' },
            ASSIGNMENT: { border:'border-orange-200', bg:'from-orange-50 to-amber-50', text:'text-orange-900', icon:'📋' },
            GENERAL: { border:'border-slate-200', bg:'from-slate-50 to-gray-50', text:'text-slate-900', icon:'📢' }
          };
          const color = colors[notif.type] || colors.GENERAL;
          const modal = document.createElement('div');
          modal.id = 'modalNotification_' + notif.id;
          modal.setAttribute('data-push-count', pushCount);
          modal.className = 'fixed inset-0 z-50 flex items-center justify-center bg-black/50 backdrop-blur-sm animate-fadeIn';
          modal.innerHTML = `
            <div class="rounded-2xl border-2 ${color.border} bg-gradient-to-br ${color.bg} p-6 shadow-2xl max-w-md mx-4 animate-scaleIn">
              <div class="flex items-start justify-between gap-4 mb-4">
                <div class="flex items-center gap-3">
                  <span class="text-4xl">${color.icon}</span>
                  <h2 class="text-xl font-bold ${color.text}">${escapeHtml(notif.title)}</h2>
                </div>
                <button onclick="closeModalNotification(${notif.id},${pushCount})" class="text-slate-400 hover:text-slate-600 transition-colors">
                  <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                  </svg>
                </button>
              </div>
              <div class="bg-white/70 rounded-xl p-4 mb-4">
                <p class="${color.text} whitespace-pre-wrap">${escapeHtml(notif.message)}</p>
              </div>
              <div class="flex items-center justify-between text-xs text-slate-600 mb-4">
                <span>📅 ${new Date(notif.created_at).toLocaleString('id-ID')}</span>
              </div>
              <button onclick="closeModalNotification(${notif.id},${pushCount})" class="w-full px-6 py-3 rounded-xl bg-gradient-to-r from-indigo-600 to-purple-600 hover:from-indigo-700 hover:to-purple-700 text-white font-bold shadow-lg hover:shadow-xl transition-all transform hover:scale-105">
                ✓ Mengerti
              </button>
            </div>
          `;
          document.body.appendChild(modal);
        }

        window.closeModalNotification = async function(notifId, pushCount) {
          const modal = document.getElementById('modalNotification_' + notifId);
          if (modal) {
            modal.classList.add('animate-fadeOut');
            setTimeout(() => modal.remove(), 300);
          }
          // Simpan push_count saat ini ke localStorage
          closedMap[notifId] = pushCount || 0;
          saveClosedMap();
          // Tandai sudah baca di server
          try {
            await fetch(`/notifications/${notifId}/read`, { method: 'POST' });
          } catch (error) {}
        };

        function escapeHtml(text) {
          const div = document.createElement('div');
          div.textContent = text;
          return div.innerHTML;
        }

        checkModalNotifications();
        setInterval(checkModalNotifications, 15000);
      })();
    </script>

    <style>
      @keyframes fadeIn {
        from { opacity: 0; }
        to { opacity: 1; }
      }
      @keyframes fadeOut {
        from { opacity: 1; }
        to { opacity: 0; }
      }
      @keyframes scaleIn {
        from { transform: scale(0.9); opacity: 0; }
        to { transform: scale(1); opacity: 1; }
      }
      .animate-fadeIn {
        animation: fadeIn 0.3s ease-out;
      }
      .animate-fadeOut {
        animation: fadeOut 0.3s ease-out;
      }
      .animate-scaleIn {
        animation: scaleIn 0.3s ease-out;
      }
    </style>
    <% }} %>
  </body>
</html>
