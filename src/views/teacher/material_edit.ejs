<div class="flex items-center justify-between gap-4">
  <div>
    <h1 class="text-3xl font-semibold tracking-tight">Edit Materi</h1>
    <p class="mt-1 text-slate-600">Perbarui konten, embed, dan pengaturan kelas.</p>
  </div>
  <a href="/teacher/materials/<%= material.id %>" class="text-sm px-4 py-2 rounded-xl border border-rose-200 bg-gradient-to-br from-rose-50 to-pink-100 hover:from-rose-100 hover:to-pink-200 text-rose-800 font-medium transition-all">Kembali</a>
</div>

<!-- Quill (WYSIWYG) -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/quill@1.3.7/dist/quill.snow.css">
<script src="https://cdn.jsdelivr.net/npm/quill@1.3.7/dist/quill.min.js"></script>

<div class="mt-6 rounded-2xl border border-slate-200 bg-white p-5 shadow-soft">
  <form action="/teacher/materials/<%= material.id %>?_method=PUT" method="POST" enctype="multipart/form-data" class="space-y-4" id="materialForm">
    <div class="grid md:grid-cols-2 gap-4">
      <div>
        <label class="text-sm text-slate-600">Mapel</label>
        <select name="subject_id" required class="mt-1 w-full rounded-xl bg-white border border-slate-200 px-4 py-2">
          <% subjects.forEach(s => { %>
            <option value="<%= s.id %>" <%= String(s.id) === String(material.subject_id) ? 'selected' : '' %>><%= s.name %></option>
          <% }) %>
        </select>
      </div>
      <div>
        <label class="text-sm font-medium text-slate-700">Kelas (bisa pilih banyak)</label>
        <div class="mt-1 max-h-48 overflow-y-auto rounded-xl border border-slate-200 bg-white p-2 space-y-1">
          <label class="flex items-center gap-2 px-2 py-1 rounded hover:bg-teal-50 cursor-pointer text-sm font-semibold text-teal-700 border-b border-slate-100 pb-2 mb-1">
            <input type="checkbox" id="checkAllKelas" class="rounded border-slate-300 text-teal-600"> Semua Kelas
          </label>
          <% classes.forEach(c => { %>
            <label class="flex items-center gap-2 px-2 py-1 rounded hover:bg-indigo-50 cursor-pointer text-sm text-slate-700">
              <input type="checkbox" name="class_ids[]" value="<%= c.id %>" class="kelas-check rounded border-slate-300 text-indigo-600"
                <%= (selectedClassIds && selectedClassIds.map(String).includes(String(c.id))) ? 'checked' : '' %>>
              <%= c.name %>
            </label>
          <% }) %>
        </div>
        <p class="mt-1 text-xs text-slate-500">Pilih "Semua Kelas" = tampil ke semua siswa. Atau pilih kelas tertentu saja.</p>
      </div>
    </div>

    <div>
      <label class="text-sm text-slate-600">Judul</label>
      <input name="title" required value="<%= material.title %>" class="mt-1 w-full rounded-xl bg-white border border-slate-200 px-4 py-2" />
    </div>

    <div>
      <label class="text-sm text-slate-600">Deskripsi (opsional)</label>
      <textarea name="description" rows="2" class="mt-1 w-full rounded-xl bg-white border border-slate-200 px-4 py-2"><%= material.description || '' %></textarea>
    </div>

    <div>
      <label class="text-sm text-slate-600">Durasi Auto-Complete (menit)</label>
      <input type="number" name="auto_complete_minutes" value="<%= material.auto_complete_minutes || 5 %>" min="0" class="mt-1 w-full rounded-xl bg-white border border-slate-200 px-4 py-2" />
      <p class="mt-1 text-xs text-slate-500">Materi akan otomatis ditandai selesai setelah durasi ini. Isi 0 untuk menonaktifkan.</p>
    </div>

    <div class="grid md:grid-cols-2 gap-4">
      <div>
        <label class="text-sm text-slate-600">Ganti konten via Word (.docx) (opsional)</label>
        <input type="file" name="docx" accept=".docx" class="mt-1 w-full" />
        <p class="mt-2 text-xs text-slate-500">Jika diupload, konten editor akan diganti dari DOCX.</p>
      </div>
      <div>
        <label class="text-sm text-slate-600">Konten Materi</label>
        <div class="mt-1 rounded-xl border border-slate-200 overflow-hidden">
          <div id="editor" class="bg-white"></div>
        </div>
        <textarea id="content_html_initial" class="hidden"><%- material.content_html || '' %></textarea>
        <textarea name="content_html" id="content_html" class="hidden"></textarea>
      </div>
    </div>

    <div class="rounded-2xl border border-slate-200 bg-slate-50 p-4">
      <div class="font-semibold">Embed (opsional)</div>
      <p class="mt-1 text-xs text-slate-600">Embed YouTube, PDF, atau halaman web (Canva, Google Slides, dll).</p>

      <div class="mt-3 grid md:grid-cols-2 gap-4">
        <div>
          <label class="text-sm text-slate-600">Mode Embed</label>
          <select name="embed_mode" id="embed_mode" onchange="toggleEmbedFields()" class="mt-1 w-full rounded-xl bg-white border border-slate-200 px-4 py-2">
            <option value="" <%= (!material.embed_type) ? 'selected' : '' %>>Tidak ada</option>
            <option value="YOUTUBE" <%= material.embed_type === 'YOUTUBE' ? 'selected' : '' %>>YouTube</option>
            <option value="PDF" <%= material.embed_type === 'PDF' ? 'selected' : '' %>>PDF (link)</option>
            <option value="WEB" <%= material.embed_type === 'WEB' ? 'selected' : '' %>>🌐 Web URL (Canva, Google Slides, dll)</option>
          </select>
        </div>
        <div>
          <label class="text-sm text-slate-600">Upload PDF (opsional)</label>
          <input type="file" name="pdf" accept="application/pdf,.pdf" class="mt-1 w-full" />
          <p class="mt-2 text-xs text-slate-500">Upload PDF akan menimpa embed PDF/link.</p>
        </div>
      </div>

      <%# Field YouTube %>
      <div class="mt-3" id="field_youtube" style="display:none">
        <label class="text-sm text-slate-600">Link YouTube</label>
        <input name="youtube_url" value="<%= material.embed_type === 'YOUTUBE' ? material.embed_url : '' %>" placeholder="https://youtu.be/VIDEO_ID atau https://www.youtube.com/watch?v=VIDEO_ID" class="mt-1 w-full rounded-xl bg-white border border-slate-200 px-4 py-2" />
        <p class="mt-1 text-xs text-slate-500">Boleh paste URL biasa / embed. Sistem akan normalisasi otomatis.</p>
      </div>

      <%# Field PDF link %>
      <div class="mt-3" id="field_pdf" style="display:none">
        <label class="text-sm text-slate-600">Link PDF</label>
        <input name="pdf_url" value="<%= material.embed_type === 'PDF' ? material.embed_url : '' %>" placeholder="https://contoh.com/file.pdf atau /public/uploads/materials/file.pdf" class="mt-1 w-full rounded-xl bg-white border border-slate-200 px-4 py-2" />
      </div>

      <%# Field Web URL %>
      <div class="mt-3" id="field_web" style="display:none">
        <label class="text-sm text-slate-600 font-semibold">🌐 URL Website / Embed</label>
        <input name="web_url" value="<%= material.embed_type === 'WEB' ? material.embed_url : '' %>" placeholder="https://www.canva.com/... atau https://docs.google.com/presentation/..." class="mt-1 w-full rounded-xl bg-white border border-slate-200 px-4 py-2" />
        <p class="mt-1 text-xs text-slate-500">Tempel URL halaman web yang ingin ditampilkan. Cocok untuk Canva, Google Slides, Genially, dll. Pastikan website mengizinkan embed.</p>
      </div>
    </div>

    <button class="rounded-xl bg-indigo-500 hover:bg-indigo-400 text-white font-semibold px-5 py-2.5">Simpan Perubahan</button>
  </form>
</div>

<script>
  // ── Logika checkbox kelas ─────────────────────────────────────────────────
  const checkAllEl = document.getElementById('checkAllKelas');
  const getKelasCbs = () => [...document.querySelectorAll('.kelas-check')];

  // "Semua Kelas" dicentang = centang SEMUA kelas di bawah
  checkAllEl.addEventListener('change', function() {
    getKelasCbs().forEach(cb => { cb.checked = this.checked; });
  });

  // Sync state "Semua Kelas" berdasarkan kelas spesifik
  getKelasCbs().forEach(cb => {
    cb.addEventListener('change', function() {
      checkAllEl.checked = getKelasCbs().every(c => c.checked);
    });
  });

  // Inisialisasi: cek apakah semua kelas spesifik tercentang
  checkAllEl.checked = getKelasCbs().every(c => c.checked);

  // ── Toggle field embed ────────────────────────────────────────────────────
  function toggleEmbedFields() {
    const mode = (document.getElementById('embed_mode').value || '').toUpperCase();
    document.getElementById('field_youtube').style.display = (mode === 'YOUTUBE') ? 'block' : 'none';
    document.getElementById('field_pdf').style.display     = (mode === 'PDF')     ? 'block' : 'none';
    document.getElementById('field_web').style.display     = (mode === 'WEB')     ? 'block' : 'none';
  }
  toggleEmbedFields(); // init — tampilkan field sesuai embed_type yang tersimpan

  (function() {
    const quill = new Quill('#editor', {
      theme: 'snow',
      modules: {
        toolbar: [
          [{ header: [1, 2, 3, false] }],
          ['bold', 'italic', 'underline', 'strike'],
          [{ list: 'ordered' }, { list: 'bullet' }],
          [{ align: [] }],
          ['link', 'image'],
          ['clean']
        ]
      },
      placeholder: 'Tulis materi di sini...'
    });

    const initial = document.getElementById('content_html_initial');
    if (initial && initial.value) {
      quill.root.innerHTML = initial.value;
    }

    const form = document.getElementById('materialForm');
    const hidden = document.getElementById('content_html');
    form.addEventListener('submit', function() {
      hidden.value = quill.root.innerHTML;
    });
  })();
</script>
