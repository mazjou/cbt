<!-- KaTeX offline -->
<link rel="stylesheet" href="/public/lib/katex/katex.min.css">
<!-- Summernote offline -->
<link rel="stylesheet" href="/public/lib/summernote/summernote-lite.min.css">

<style>
@font-face {
  font-family: 'summernote';
  src: url('/public/lib/summernote/font/summernote.woff2') format('woff2'),
       url('/public/lib/summernote/font/summernote.woff') format('woff'),
       url('/public/lib/summernote/font/summernote.ttf') format('truetype');
  font-weight: normal;
  font-style: normal;
}
.note-editor.note-frame { border-radius: 12px !important; border: 2px solid #c7d2fe !important; }
.note-editor.note-frame.focus { border-color: #6366f1 !important; box-shadow: 0 0 0 3px rgba(99,102,241,0.15) !important; }
.note-toolbar { background: #f0f4ff !important; border-bottom: 1px solid #c7d2fe !important; border-radius: 10px 10px 0 0 !important; padding: 6px !important; }
.note-btn { border-radius: 6px !important; }
.note-editable { min-height: 120px !important; font-size: 15px !important; }
.math-formula { display: inline-block; vertical-align: middle; padding: 0 2px; cursor: pointer; }
.math-formula:hover { background: #ede9fe; border-radius: 4px; }
.math-formula-block { margin: 8px 0; }
.math-icon { font-style: normal; font-size: 16px; font-weight: bold; font-family: serif; }
</style>

<div class="flex items-center justify-between gap-4 mb-6">
  <div>
    <h1 class="text-3xl font-bold text-indigo-900">Edit Bank Soal</h1>
    <p class="mt-1 text-slate-600">Perbarui soal yang tersimpan di bank soal</p>
    <div class="mt-2">
      <% const qtBadge = question.question_type || 'MCQ'; %>
      <% if (qtBadge === 'CHECKBOX' || qtBadge === 'COMPLEX') { %>
        <span class="inline-flex items-center gap-1 px-3 py-1 rounded-full bg-orange-100 text-orange-700 text-xs font-semibold">☑ Tipe: Checkbox (multi-jawaban)</span>
      <% } else if (qtBadge === 'TRUE_FALSE') { %>
        <span class="inline-flex items-center gap-1 px-3 py-1 rounded-full bg-emerald-100 text-emerald-700 text-xs font-semibold">✓✗ Tipe: Benar/Salah</span>
      <% } else { %>
        <span class="inline-flex items-center gap-1 px-3 py-1 rounded-full bg-indigo-100 text-indigo-700 text-xs font-semibold">◉ Tipe: Pilihan Ganda (MCQ)</span>
      <% } %>
    </div>
  </div>
  <%
    const isAdminBack = typeof backUrl !== 'undefined' && backUrl && backUrl.startsWith('/admin');
    const backLink = isAdminBack ? '/admin/question-bank' : '/teacher/question-bank';
  %>
  <a href="<%= backLink %>" class="px-4 py-2 rounded-xl border border-rose-200 bg-gradient-to-br from-rose-50 to-pink-100 hover:from-rose-100 hover:to-pink-200 text-rose-800 font-medium transition-all">
    ← Kembali
  </a>
</div>

<%
  const isAdmin = typeof backUrl !== 'undefined' && backUrl && backUrl.startsWith('/admin');
  const formAction = isAdmin
    ? `/admin/question-bank/${question.id}/update`
    : `/teacher/question-bank/${question.id}?_method=PUT`;
%>
<form action="<%= formAction %>" method="POST" enctype="multipart/form-data" class="rounded-2xl border border-indigo-200 bg-gradient-to-br from-indigo-50 to-indigo-100 p-6 space-y-4" id="bankQuestionForm">

  <!-- Hidden question_type -->
  <input type="hidden" name="question_type" value="<%= question.question_type || 'MCQ' %>" />

  <div class="grid md:grid-cols-3 gap-4">
    <div>
      <label class="text-sm text-indigo-700 font-medium">Mata Pelajaran *</label>
      <select name="subject_id" required class="mt-1 w-full rounded-xl bg-white border border-indigo-200 px-4 py-3 focus:outline-none focus:ring-2 focus:ring-indigo-500">
        <option value="">Pilih Mata Pelajaran</option>
        <% subjects.forEach(s => { %>
          <option value="<%= s.id %>" <%= question.subject_id == s.id ? 'selected' : '' %>><%= s.name %></option>
        <% }) %>
      </select>
    </div>
    <div>
      <label class="text-sm text-indigo-700 font-medium">Tingkat Kelas</label>
      <select name="class_level" class="mt-1 w-full rounded-xl bg-white border border-indigo-200 px-4 py-3 focus:outline-none focus:ring-2 focus:ring-indigo-500">
        <option value="" <%= !question.class_level ? 'selected' : '' %>>Semua Tingkat</option>
        <option value="X"   <%= question.class_level === 'X'   ? 'selected' : '' %>>Kelas X</option>
        <option value="XI"  <%= question.class_level === 'XI'  ? 'selected' : '' %>>Kelas XI</option>
        <option value="XII" <%= question.class_level === 'XII' ? 'selected' : '' %>>Kelas XII</option>
      </select>
    </div>
    <div>
      <label class="text-sm text-indigo-700 font-medium">Tingkat Kesulitan *</label>
      <select name="difficulty" required class="mt-1 w-full rounded-xl bg-white border border-indigo-200 px-4 py-3 focus:outline-none focus:ring-2 focus:ring-indigo-500">
        <option value="EASY"   <%= question.difficulty === 'EASY'   ? 'selected' : '' %>>Mudah</option>
        <option value="MEDIUM" <%= question.difficulty === 'MEDIUM' ? 'selected' : '' %>>Sedang</option>
        <option value="HARD"   <%= question.difficulty === 'HARD'   ? 'selected' : '' %>>Sulit</option>
      </select>
    </div>
  </div>

  <div>
    <label class="text-sm text-indigo-700 font-medium">Bab/Materi (opsional)</label>
    <input type="text" name="chapter" value="<%= question.chapter || '' %>"
      placeholder="Contoh: Bab 1 - Trigonometri, Materi Persamaan Linear"
      class="mt-1 w-full rounded-xl bg-white border border-indigo-200 px-4 py-3 focus:outline-none focus:ring-2 focus:ring-indigo-500" />
  </div>

  <!-- Pertanyaan -->
  <div>
    <label class="text-sm text-indigo-700 font-medium">Pertanyaan *</label>
    <textarea id="editor_question" name="question_text" class="summernote-editor"><%- question.question_text %></textarea>
  </div>

  <!-- Gambar Soal -->
  <div>
    <label class="text-sm text-indigo-700 font-medium">Gambar Soal (opsional)</label>
    <% if (question.question_image) { %>
      <div class="mb-2 p-3 bg-white rounded-xl border border-indigo-200">
        <img src="<%= question.question_image %>" alt="Current" class="max-w-xs rounded-lg" />
        <label class="mt-2 flex items-center gap-2 text-sm text-rose-600">
          <input type="checkbox" name="remove_image" value="1" class="rounded" />
          Hapus gambar ini
        </label>
      </div>
    <% } %>
    <input type="file" name="image" accept="image/*"
      class="mt-1 w-full rounded-xl bg-white border border-indigo-200 px-4 py-3 file:mr-4 file:py-2 file:px-4 file:rounded-lg file:border-0 file:bg-indigo-100 file:text-indigo-700 hover:file:bg-indigo-200" />
    <div class="mt-1 text-xs text-indigo-600">Max 10MB</div>
  </div>

  <!-- PDF Soal -->
  <div>
    <label class="text-sm text-indigo-700 font-medium">PDF Soal (opsional)</label>
    <% if (question.question_pdf) { %>
      <div class="mb-2 p-3 bg-white rounded-xl border border-indigo-200">
        <a href="<%= question.question_pdf %>" target="_blank" class="text-purple-600 hover:underline">📄 Lihat PDF saat ini</a>
        <label class="mt-2 flex items-center gap-2 text-sm text-rose-600">
          <input type="checkbox" name="remove_pdf" value="1" class="rounded" />
          Hapus PDF ini
        </label>
      </div>
    <% } %>
    <input type="file" name="pdf" accept="application/pdf"
      class="mt-1 w-full rounded-xl bg-white border border-indigo-200 px-4 py-3 file:mr-4 file:py-2 file:px-4 file:rounded-lg file:border-0 file:bg-purple-100 file:text-purple-700 hover:file:bg-purple-200" />
    <div class="mt-1 text-xs text-indigo-600">Max 10MB</div>
  </div>

  <!-- Poin & Jawaban Benar -->
  <div class="grid md:grid-cols-2 gap-4">
    <div>
      <label class="text-sm text-indigo-700 font-medium">Poin *</label>
      <input type="number" name="points" value="<%= question.points %>" min="1" required
        class="mt-1 w-full rounded-xl bg-white border border-indigo-200 px-4 py-3 focus:outline-none focus:ring-2 focus:ring-indigo-500" />
    </div>
    <div id="edit_correct_single_wrap">
      <label class="text-sm text-indigo-700 font-medium">Jawaban Benar *</label>
      <select name="correct" required class="mt-1 w-full rounded-xl bg-white border border-indigo-200 px-4 py-3 focus:outline-none focus:ring-2 focus:ring-indigo-500">
        <% ;['A','B','C','D','E'].forEach(lbl => { %>
          <option value="<%= lbl %>" <%= correct_label === lbl ? 'selected' : '' %>><%= lbl %></option>
        <% }) %>
      </select>
    </div>
  </div>

  <!-- COMPLEX/CHECKBOX: multi-correct -->
  <div id="edit_correct_complex_wrap" class="hidden">
    <label class="text-sm text-orange-700 font-semibold mb-2 block">Pilih semua jawaban yang BENAR:</label>
    <div class="flex flex-wrap gap-3">
      <% ['A','B','C','D','E'].forEach(lbl => { %>
      <label class="flex items-center gap-2 px-4 py-2 rounded-xl border-2 border-orange-200 bg-white cursor-pointer hover:bg-orange-50 transition-all">
        <input type="checkbox" name="correct" value="<%= lbl %>" class="accent-orange-600 w-4 h-4"
          <%= (typeof correct_labels !== 'undefined' && correct_labels.includes(lbl)) ? 'checked' : '' %> />
        <span class="text-sm font-semibold text-orange-800">Opsi <%= lbl %></span>
      </label>
      <% }) %>
    </div>
    <p class="text-xs text-orange-500 mt-1">Poin proporsional berdasarkan jawaban benar yang dipilih siswa</p>
  </div>

  <!-- TRUE_FALSE panel -->
  <div id="edit_correct_trufalse_wrap" class="hidden">
    <label class="text-sm font-semibold text-emerald-700 mb-2 block">Jawaban Benar</label>
    <div class="flex gap-3">
      <label class="flex items-center gap-2 px-4 py-2 rounded-xl border-2 border-emerald-200 bg-white cursor-pointer hover:bg-emerald-50 transition-all">
        <input type="radio" name="correct" value="A" class="accent-emerald-600 w-4 h-4" <%= correct_label === 'A' ? 'checked' : '' %> />
        <span class="text-sm font-semibold text-emerald-800">✅ Benar (A)</span>
      </label>
      <label class="flex items-center gap-2 px-4 py-2 rounded-xl border-2 border-rose-200 bg-white cursor-pointer hover:bg-rose-50 transition-all">
        <input type="radio" name="correct" value="B" class="accent-rose-600 w-4 h-4" <%= correct_label === 'B' ? 'checked' : '' %> />
        <span class="text-sm font-semibold text-rose-800">❌ Salah (B)</span>
      </label>
    </div>
  </div>

  <!-- Tags -->
  <div>
    <label class="text-sm text-indigo-700 font-medium">Tags (opsional)</label>
    <input type="text" name="tags" value="<%= question.tags || '' %>"
      placeholder="Contoh: trigonometri,sudut,sin-cos"
      class="mt-1 w-full rounded-xl bg-white border border-indigo-200 px-4 py-3 focus:outline-none focus:ring-2 focus:ring-indigo-500" />
    <div class="mt-1 text-xs text-indigo-600">Pisahkan dengan koma untuk kategorisasi</div>
  </div>

  <!-- Opsi Jawaban -->
  <div class="space-y-3">
    <div class="text-sm font-semibold text-indigo-700">Opsi Jawaban</div>

    <div>
      <label class="text-sm text-indigo-700 font-medium">Opsi A *</label>
      <textarea id="editor_option_a" name="a" class="summernote-option"><%- options.A || '' %></textarea>
    </div>
    <div>
      <label class="text-sm text-indigo-700 font-medium">Opsi B *</label>
      <textarea id="editor_option_b" name="b" class="summernote-option"><%- options.B || '' %></textarea>
    </div>
    <div id="bank_edit_opt_c">
      <label class="text-sm text-indigo-700 font-medium">Opsi C *</label>
      <textarea id="editor_option_c" name="c" class="summernote-option"><%- options.C || '' %></textarea>
    </div>
    <div id="bank_edit_opt_d">
      <label class="text-sm text-indigo-700 font-medium">Opsi D *</label>
      <textarea id="editor_option_d" name="d" class="summernote-option"><%- options.D || '' %></textarea>
    </div>
    <div id="bank_edit_opt_e">
      <label class="text-sm text-indigo-700 font-medium">Opsi E (opsional)</label>
      <textarea id="editor_option_e" name="e" class="summernote-option"><%- options.E || '' %></textarea>
    </div>
  </div>

  <button type="submit" class="w-full rounded-xl bg-gradient-to-r from-indigo-500 to-purple-600 hover:from-indigo-600 hover:to-purple-700 text-white font-semibold py-3 transition-all">
    💾 Update Bank Soal
  </button>
</form>

<!-- jQuery + Summernote + KaTeX + Math Plugin (semua offline) -->
<script src="/public/lib/jquery/jquery.min.js"></script>
<script>var $sn = jQuery.noConflict(true);</script>
<script src="/public/lib/katex/katex.min.js"></script>
<script>window.$ = window.jQuery = $sn;</script>
<script src="/public/lib/summernote/summernote-lite.min.js"></script>
<script src="/public/lib/summernote/summernote-math.js"></script>

<script>
$sn(document).ready(function () {
  var $ = $sn;

  var toolbarQuestion = [
    ['style', ['bold', 'italic', 'underline', 'strikethrough', 'clear']],
    ['font', ['superscript', 'subscript']],
    ['color', ['color']],
    ['para', ['ul', 'ol']],
    ['insert', ['picture', 'math']],
    ['view', ['codeview']]
  ];

  var toolbarOption = [
    ['style', ['bold', 'italic', 'underline', 'clear']],
    ['font', ['superscript', 'subscript']],
    ['color', ['color']],
    ['insert', ['picture', 'math']]
  ];

  var commonConfig = {
    lang: 'en-US',
    disableDragAndDrop: false,
    callbacks: {
      onImageUpload: function (files) {
        var editor = this;
        Array.from(files).forEach(function (file) {
          var reader = new FileReader();
          reader.onload = function (e) {
            var img = $('<img>').attr('src', e.target.result)
              .css({ maxWidth: '100%', height: 'auto', borderRadius: '8px', margin: '4px 0' });
            $(editor).summernote('insertNode', img[0]);
          };
          reader.readAsDataURL(file);
        });
      }
    },
    plugins: ['math']
  };

  $('#editor_question').summernote($.extend({}, commonConfig, {
    height: 160,
    placeholder: 'Ketik pertanyaan... Klik ∑ untuk rumus matematika',
    toolbar: toolbarQuestion
  }));

  $('.summernote-option').summernote($.extend({}, commonConfig, {
    height: 90,
    placeholder: 'Ketik opsi jawaban...',
    toolbar: toolbarOption
  }));

  var qtype = '<%= question.question_type || "MCQ" %>';

  // Validasi & submit
  $('#bankQuestionForm').on('submit', function (e) {
    var fields = [
      { id: 'editor_question', name: 'Pertanyaan' },
      { id: 'editor_option_a', name: 'Opsi A' },
      { id: 'editor_option_b', name: 'Opsi B' }
    ];

    // Tambah C/D/E kecuali TRUE_FALSE
    if (qtype !== 'TRUE_FALSE') {
      fields.push({ id: 'editor_option_c', name: 'Opsi C' });
      fields.push({ id: 'editor_option_d', name: 'Opsi D' });
    }

    for (var i = 0; i < fields.length; i++) {
      var f = fields[i];
      var content = $('#' + f.id).summernote('code');
      var text = $('<div>').html(content).text().trim();
      var hasImg = content.indexOf('<img') !== -1;
      if (!text && !hasImg) {
        e.preventDefault();
        alert(f.name + ' tidak boleh kosong!');
        $('#' + f.id).summernote('focus');
        return false;
      }
    }

    if (qtype === 'COMPLEX' || qtype === 'CHECKBOX') {
      var checkedCount = document.querySelectorAll('input[name=correct]:checked').length;
      if (checkedCount < 1) {
        e.preventDefault();
        alert('Pilih minimal 1 jawaban benar!');
        return false;
      }
    }
  });

});
</script>

<script>
  (function() {
    var qtype = '<%= question.question_type || "MCQ" %>';
    var singleWrap  = document.getElementById('edit_correct_single_wrap');
    var complexWrap = document.getElementById('edit_correct_complex_wrap');
    var tfWrap      = document.getElementById('edit_correct_trufalse_wrap');
    var optC = document.getElementById('bank_edit_opt_c');
    var optD = document.getElementById('bank_edit_opt_d');
    var optE = document.getElementById('bank_edit_opt_e');

    if (qtype === 'COMPLEX' || qtype === 'CHECKBOX') {
      if (singleWrap) singleWrap.classList.add('hidden');
      if (complexWrap) complexWrap.classList.remove('hidden');
      var sel = singleWrap ? singleWrap.querySelector('select') : null;
      if (sel) { sel.disabled = true; sel.removeAttribute('required'); }
    } else if (qtype === 'TRUE_FALSE') {
      if (singleWrap) singleWrap.classList.add('hidden');
      if (tfWrap) tfWrap.classList.remove('hidden');
      var sel = singleWrap ? singleWrap.querySelector('select') : null;
      if (sel) { sel.disabled = true; sel.removeAttribute('required'); }
      if (optC) optC.classList.add('hidden');
      if (optD) optD.classList.add('hidden');
      if (optE) optE.classList.add('hidden');
    }
  })();
</script>
