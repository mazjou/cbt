<div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4">
  <div>
    <h1 class="text-3xl font-semibold tracking-tight">Daftar Nilai</h1>
    <p class="mt-1 text-slate-600">Semua hasil ujian siswa untuk ujian yang Anda buat. Gunakan filter untuk mempermudah.</p>
  </div>
  <a href="/teacher" class="text-sm px-4 py-2 rounded-xl border border-rose-200 bg-gradient-to-br from-rose-50 to-pink-100 hover:from-rose-100 hover:to-pink-200 text-rose-800 font-medium transition-all">Kembali</a>
</div>

<div class="mt-6 space-y-4">
  <!-- Card Filter -->
  <div class="rounded-2xl border border-indigo-200 bg-gradient-to-br from-indigo-50 to-indigo-100 p-5">
    <h2 class="text-lg font-semibold text-indigo-900 mb-4">Filter Daftar Nilai</h2>
    <form method="GET" action="/teacher/grades" id="gradesFilterForm" class="grid lg:grid-cols-6 gap-3">
      <!-- Hidden limit — otomatis 999 jika kelas dipilih -->
      <input type="hidden" name="limit" id="autoLimit" value="<%= filters.class_id ? 999 : (pagination.limit || 10) %>">

      <div>
        <label class="text-sm text-indigo-700 font-medium">Ujian</label>
        <select name="exam_id" onchange="submitGradesFilter()" class="mt-1 w-full rounded-xl bg-white border border-indigo-200 px-4 py-2 focus:outline-none focus:ring-2 focus:ring-indigo-500">
          <option value="">Semua</option>
          <% exams.forEach(e => { %>
            <option value="<%= e.id %>" <%= String(filters.exam_id||'')===String(e.id) ? 'selected' : '' %>><%= e.title %></option>
          <% }) %>
        </select>
      </div>

      <div>
        <label class="text-sm text-indigo-700 font-medium">Kelas <span class="text-xs text-indigo-400">(pilih = tampil semua)</span></label>
        <select name="class_id" id="classSelect" onchange="onClassChange(this)" class="mt-1 w-full rounded-xl bg-white border border-indigo-200 px-4 py-2 focus:outline-none focus:ring-2 focus:ring-indigo-500">
          <option value="">Semua</option>
          <% classes.forEach(c => { %>
            <option value="<%= c.id %>" <%= String(filters.class_id||'')===String(c.id) ? 'selected' : '' %>><%= c.name %></option>
          <% }) %>
        </select>
      </div>

      <div>
        <label class="text-sm text-indigo-700 font-medium">Status</label>
        <select name="status" onchange="submitGradesFilter()" class="mt-1 w-full rounded-xl bg-white border border-indigo-200 px-4 py-2 focus:outline-none focus:ring-2 focus:ring-indigo-500">
          <option value="">Semua Status</option>
          <option value="SUBMITTED" <%= filters.status === 'SUBMITTED' ? 'selected' : '' %>>Selesai</option>
          <option value="IN_PROGRESS" <%= filters.status === 'IN_PROGRESS' ? 'selected' : '' %>>Sedang Dikerjakan</option>
          <option value="ABANDONED" <%= filters.status === 'ABANDONED' ? 'selected' : '' %>>Ditinggalkan</option>
        </select>
      </div>

      <div>
        <label class="text-sm text-indigo-700 font-medium">Keterangan</label>
        <select name="result" onchange="submitGradesFilter()" class="mt-1 w-full rounded-xl bg-white border border-indigo-200 px-4 py-2 focus:outline-none focus:ring-2 focus:ring-indigo-500">
          <option value="">Semua</option>
          <option value="LULUS" <%= filters.result === 'LULUS' ? 'selected' : '' %>>Lulus</option>
          <option value="TIDAK_LULUS" <%= filters.result === 'TIDAK_LULUS' ? 'selected' : '' %>>Tidak Lulus</option>
        </select>
      </div>

      <div>
        <label class="text-sm text-indigo-700 font-medium">Cari nama/username</label>
        <input name="q" value="<%= filters.q || '' %>" placeholder="contoh: Budi"
          class="mt-1 w-full rounded-xl bg-white border border-indigo-200 px-4 py-2 focus:outline-none focus:ring-2 focus:ring-indigo-500" />
      </div>

      <div class="lg:col-span-6 flex items-end gap-2">
        <button class="flex-1 rounded-xl bg-indigo-600 hover:bg-indigo-700 text-white font-semibold py-2 transition-colors">Terapkan</button>
        <a href="/teacher/grades" class="px-4 py-2 rounded-xl border border-indigo-300 bg-white hover:bg-indigo-50 text-indigo-800 font-medium text-sm transition-colors">Reset</a>
      </div>
    </form>

    <script>
    function onClassChange(sel) {
      // Set limit 999 jika kelas dipilih, 10 jika tidak
      document.getElementById('autoLimit').value = sel.value ? 999 : 10;
      document.getElementById('gradesFilterForm').submit();
    }
    function submitGradesFilter() {
      document.getElementById('gradesFilterForm').submit();
    }
    </script>
  </div>

  <!-- ── STATISTIK UJIAN (muncul hanya jika filter ujian dipilih) ── -->
  <% if (examStats) { %>
  <div class="grid grid-cols-2 md:grid-cols-4 lg:grid-cols-7 gap-3">
    <div class="rounded-2xl bg-blue-50 border border-blue-200 p-4 text-center shadow-sm">
      <div class="text-2xl font-bold text-blue-700"><%= examStats.total_siswa %></div>
      <div class="text-xs text-blue-500 mt-1 font-medium">Total Siswa</div>
    </div>
    <div class="rounded-2xl bg-green-50 border border-green-200 p-4 text-center shadow-sm">
      <div class="text-2xl font-bold text-green-700"><%= examStats.sudah_submit %></div>
      <div class="text-xs text-green-500 mt-1 font-medium">Sudah Submit</div>
    </div>
    <div class="rounded-2xl bg-yellow-50 border border-yellow-200 p-4 text-center shadow-sm">
      <div class="text-2xl font-bold text-yellow-700"><%= examStats.sedang_kerjakan %></div>
      <div class="text-xs text-yellow-500 mt-1 font-medium">Sedang Kerjakan</div>
    </div>
    <div class="rounded-2xl bg-red-50 border border-red-200 p-4 text-center shadow-sm">
      <div class="text-2xl font-bold text-red-700"><%= examStats.belum_mengerjakan %></div>
      <div class="text-xs text-red-500 mt-1 font-medium">Belum Mengerjakan</div>
    </div>
    <div class="rounded-2xl bg-purple-50 border border-purple-200 p-4 text-center shadow-sm">
      <div class="text-2xl font-bold text-purple-700"><%= examStats.avg_nilai.toFixed(1) %></div>
      <div class="text-xs text-purple-500 mt-1 font-medium">Rata-rata Nilai</div>
    </div>
    <div class="rounded-2xl bg-emerald-50 border border-emerald-200 p-4 text-center shadow-sm">
      <div class="text-2xl font-bold text-emerald-700"><%= examStats.lulus %></div>
      <div class="text-xs text-emerald-500 mt-1 font-medium">Lulus</div>
    </div>
    <div class="rounded-2xl bg-rose-50 border border-rose-200 p-4 text-center shadow-sm">
      <div class="text-2xl font-bold text-rose-700"><%= examStats.tidak_lulus %></div>
      <div class="text-xs text-rose-500 mt-1 font-medium">Tidak Lulus</div>
    </div>
  </div>

  <!-- Tabel siswa belum mengerjakan -->
  <% if (notYetRows.length > 0) { %>
  <div class="rounded-2xl border-2 border-red-200 bg-red-50 p-5">
    <div class="flex items-center justify-between mb-3">
      <div class="flex items-center gap-2">
        <span class="text-lg">⚠️</span>
        <h3 class="font-bold text-red-800">Siswa Belum Mengerjakan</h3>
        <span class="px-2 py-0.5 rounded-full bg-red-200 text-red-800 text-xs font-bold"><%= notYetRows.length %> siswa</span>
      </div>
      <a href="/teacher/grades/download-not-yet?exam_id=<%= filters.exam_id %>&class_id=<%= filters.class_id||'' %>"
         class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-red-500 hover:bg-red-600 text-white text-xs font-semibold transition-all">
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/>
        </svg>
        Download Excel
      </a>
    </div>
    <div class="overflow-x-auto">
      <table class="min-w-full text-sm" id="notYetTable">
        <thead>
          <tr class="border-b border-red-200">
            <th class="text-left py-2 px-3 text-xs font-semibold text-red-700">No</th>
            <th class="text-left py-2 px-3 text-xs font-semibold text-red-700">Nama Siswa</th>
            <th class="text-left py-2 px-3 text-xs font-semibold text-red-700">Username</th>
            <th class="text-left py-2 px-3 text-xs font-semibold text-red-700">Kelas</th>
          </tr>
        </thead>
        <tbody id="notYetBody">
          <% notYetRows.forEach((s, i) => { %>
          <tr class="border-b border-red-100 hover:bg-red-100 transition-colors not-yet-row" data-index="<%= i %>">
            <td class="py-2 px-3 text-xs text-red-600 row-num"></td>
            <td class="py-2 px-3 font-semibold text-red-900"><%= s.full_name %></td>
            <td class="py-2 px-3 text-xs text-red-600 font-mono"><%= s.username %></td>
            <td class="py-2 px-3">
              <span class="px-2 py-0.5 rounded-full bg-red-200 text-red-800 text-xs font-semibold"><%= s.class_name || '-' %></span>
            </td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
    <!-- Pagination not-yet -->
    <div class="flex items-center justify-between mt-3 pt-3 border-t border-red-200">
      <span class="text-xs text-red-600" id="notYetInfo"></span>
      <div class="flex items-center gap-1" id="notYetPagination"></div>
    </div>
  </div>
  <script>
  (function() {
    const PAGE_SIZE = 10;
    const rows = document.querySelectorAll('.not-yet-row');
    const total = rows.length;
    let currentPage = 1;
    const totalPages = Math.ceil(total / PAGE_SIZE);

    function renderPage(page) {
      currentPage = page;
      const start = (page - 1) * PAGE_SIZE;
      const end   = start + PAGE_SIZE;
      rows.forEach((row, i) => {
        row.style.display = (i >= start && i < end) ? '' : 'none';
        if (i >= start && i < end) {
          row.querySelector('.row-num').textContent = i + 1;
        }
      });
      document.getElementById('notYetInfo').textContent =
        `Menampilkan ${start + 1}–${Math.min(end, total)} dari ${total} siswa`;
      const nav = document.getElementById('notYetPagination');
      nav.innerHTML = '';
      const btnClass = 'px-2.5 py-1 rounded-lg text-xs font-semibold transition-all';
      const activeClass = 'bg-red-500 text-white';
      const inactiveClass = 'bg-red-100 text-red-700 hover:bg-red-200';
      const prev = document.createElement('button');
      prev.textContent = '←';
      prev.className = btnClass + ' ' + (currentPage === 1 ? 'opacity-40 cursor-not-allowed bg-red-100 text-red-400' : inactiveClass);
      prev.disabled = currentPage === 1;
      prev.onclick = () => renderPage(currentPage - 1);
      nav.appendChild(prev);
      let start_p = Math.max(1, currentPage - 2);
      let end_p   = Math.min(totalPages, start_p + 4);
      if (end_p - start_p < 4) start_p = Math.max(1, end_p - 4);
      for (let p = start_p; p <= end_p; p++) {
        const btn = document.createElement('button');
        btn.textContent = p;
        btn.className = btnClass + ' ' + (p === currentPage ? activeClass : inactiveClass);
        btn.onclick = (function(pg){ return () => renderPage(pg); })(p);
        nav.appendChild(btn);
      }
      const next = document.createElement('button');
      next.textContent = '→';
      next.className = btnClass + ' ' + (currentPage === totalPages ? 'opacity-40 cursor-not-allowed bg-red-100 text-red-400' : inactiveClass);
      next.disabled = currentPage === totalPages;
      next.onclick = () => renderPage(currentPage + 1);
      nav.appendChild(next);
    }

    if (total > 0) renderPage(1);
  })();
  </script>
  <% } else { %>
  <div class="rounded-2xl border border-green-200 bg-green-50 p-4 text-center text-green-700 font-semibold text-sm">
    ✅ Semua siswa sudah mengerjakan ujian ini
  </div>
  <% } %>
  <% } %>

  <!-- Card Reset Hasil (hanya muncul jika ada filter exam_id) -->
  <% if (filters.exam_id) { %>
    <div class="rounded-2xl border border-rose-200 bg-gradient-to-br from-rose-50 to-rose-100 p-5 flex flex-col md:flex-row md:items-center md:justify-between gap-3">
      <div>
        <div class="text-sm text-rose-700 font-semibold">Aksi berisiko</div>
        <div class="text-sm text-rose-600">Reset akan menghapus <span class="font-semibold">semua</span> hasil (nilai & jawaban) untuk ujian yang dipilih di filter.</div>
      </div>
      <form action="/teacher/exams/<%= filters.exam_id %>/reset-results" method="POST" onsubmit="return confirm('Reset akan menghapus SEMUA hasil ujian (nilai & jawaban) untuk ujian ini. Lanjutkan?')">
        <button class="px-4 py-2 rounded-xl border border-rose-300 bg-rose-200 hover:bg-rose-300 text-rose-800 font-medium transition-colors">Reset Hasil Ujian Ini</button>
      </form>
    </div>
  <% } %>

  <!-- Card Tabel Daftar Nilai -->
  <div class="rounded-2xl border border-purple-200 bg-gradient-to-br from-purple-50 to-purple-100 p-5">
    <div class="flex items-center justify-between mb-4">
      <h2 class="text-lg font-semibold text-purple-900">Daftar Nilai</h2>
      <div class="flex items-center gap-3">
        <div class="text-sm text-purple-700">Total: <span class="font-semibold"><%= pagination.total %></span> data</div>
        <% if (rows.length > 0) { %>
          <div class="flex flex-col items-end gap-1">
            <a href="/teacher/grades/download?<%= new URLSearchParams(filters).toString() %>"
               class="inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-gradient-to-r from-emerald-500 to-green-600 hover:from-emerald-600 hover:to-green-700 text-white font-semibold text-sm transition-all shadow-md">
              📥 Download Excel
            </a>
            <div class="text-xs text-slate-500 text-right">
              Sheet: Daftar Nilai
              <% if (filters.exam_id) { %>
                · Statistik · Rekap Per Kelas · <span class="text-indigo-600 font-semibold">Analisis Soal</span>
              <% } %>
            </div>
          </div>
        <% } %>
      </div>
    </div>

    <!-- Bulk Actions Toolbar (sticky, muncul saat ada yang dicentang) -->
    <div id="bulkActionsBar" class="hidden sticky top-2 z-20 mb-4 rounded-xl border border-rose-200 bg-rose-50 shadow-lg px-5 py-3 flex items-center justify-between gap-4">
      <div class="flex items-center gap-3">
        <span class="text-sm font-bold text-rose-700"><span id="selectedCount">0</span> siswa dipilih</span>
        <button type="button" onclick="selectAllVisible()" class="text-xs px-3 py-1.5 rounded-lg bg-white border border-rose-200 text-rose-700 hover:bg-rose-100 font-medium transition-all">
          Pilih Semua (<%= rows.length %>)
        </button>
        <button type="button" onclick="clearSelection()" class="text-xs px-3 py-1.5 rounded-lg bg-white border border-slate-200 text-slate-600 hover:bg-slate-100 font-medium transition-all">
          Batal Pilih
        </button>
      </div>
      <button type="button" onclick="bulkReset()"
        class="flex items-center gap-2 px-4 py-2 rounded-xl bg-gradient-to-r from-rose-500 to-red-500 hover:from-rose-600 hover:to-red-600 text-white font-bold text-sm shadow transition-all">
        🔄 Reset Nilai Terpilih
      </button>
    </div>

    <div class="overflow-x-auto">
      <table class="w-full text-sm">
        <thead class="text-purple-700">
          <tr>
            <th class="text-left py-2">
              <input type="checkbox" id="selectAll" class="rounded border-purple-300 text-purple-600 focus:ring-purple-500" onchange="toggleSelectAll()">
            </th>
            <th class="text-left py-2">Ujian</th>
            <th class="text-left py-2">Siswa</th>
            <th class="text-left py-2">Kelas</th>
            <th class="text-left py-2">Status</th>
            <th class="text-right py-2">Nilai & Ket.</th>
            <th class="text-left py-2">Waktu</th>
            <th class="text-right py-2">Aksi</th>
          </tr>
        </thead>
        <tbody>
          <% if (!rows.length) { %>
            <tr><td colspan="8" class="py-8 text-center text-purple-600">Belum ada data untuk filter tersebut.</td></tr>
          <% } %>
          <% rows.forEach(r => { %>
            <tr class="border-t border-purple-200">
              <td class="py-3">
                <input type="checkbox" class="attempt-checkbox rounded border-purple-300 text-purple-600 focus:ring-purple-500" 
                       value="<%= r.id %>" data-student="<%= r.student_name %>" data-exam="<%= r.exam_title %>" 
                       onchange="updateBulkActions()">
              </td>
              <td class="py-3">
                <div class="font-medium text-purple-900"><%= r.exam_title %></div>
                <div class="text-xs text-purple-600">Passing: <%= r.pass_score %></div>
              </td>
              <td class="py-3">
                <div class="font-medium text-purple-900"><%= r.student_name %></div>
                <div class="text-xs text-purple-600"><%= r.username %></div>
              </td>
              <td class="py-3 text-purple-800"><%= r.class_name || '-' %></td>
              <td class="py-3"><span class="px-2 py-1 rounded-lg border border-purple-300 bg-white text-purple-800 font-medium"><%= r.status %></span></td>
              <td class="py-3 text-right">
                <div class="font-semibold text-purple-900 text-lg"><%= r.score %></div>
                <% if (r.status === 'SUBMITTED') { %>
                  <span class="inline-block px-2 py-1 rounded text-xs font-medium <%= r.is_pass ? 'bg-emerald-100 text-emerald-700' : 'bg-rose-100 text-rose-700' %>">
                    <%= r.is_pass ? 'LULUS' : 'TIDAK LULUS' %>
                  </span>
                <% } else { %>
                  <span class="text-purple-500 text-xs">-</span>
                <% } %>
              </td>
              <td class="py-3 text-purple-700 text-xs"><%= r.started_at ? new Date(r.started_at).toLocaleString('id-ID') : '-' %></td>
              <td class="py-3 text-right">
                <div class="flex justify-end gap-2">
                  <a href="/teacher/attempts/<%= r.id %>" class="px-3 py-2 rounded-xl border border-purple-300 bg-white hover:bg-purple-50 text-purple-800 font-medium text-xs transition-colors">Detail</a>
                  <form action="/teacher/attempts/<%= r.id %>/reset" method="POST" onsubmit="return confirm('Reset nilai <%= r.student_name %> untuk ujian <%= r.exam_title %>? Siswa dapat mengulang ujian.')">
                    <button class="px-3 py-2 rounded-xl border border-rose-300 bg-rose-100 hover:bg-rose-200 text-rose-700 font-medium text-xs transition-colors">Reset</button>
                  </form>
                </div>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>

    <!-- Pagination -->
    <% if (pagination.totalPages > 1) { %>
      <div class="mt-4 flex items-center justify-between border-t border-purple-200 pt-4">
        <div class="text-sm text-purple-700">
          Menampilkan <%= (pagination.page - 1) * pagination.limit + 1 %> - <%= Math.min(pagination.page * pagination.limit, pagination.total) %> dari <%= pagination.total %> data
        </div>
        <div class="flex gap-2">
          <% if (pagination.page > 1) { %>
            <a href="?page=<%= pagination.page - 1 %>&limit=<%= pagination.limit %>&exam_id=<%= filters.exam_id %>&class_id=<%= filters.class_id %>&status=<%= filters.status %>&result=<%= filters.result %>&q=<%= filters.q %>" 
               class="px-4 py-2 rounded-lg border border-purple-300 bg-white hover:bg-purple-50 text-purple-800 font-medium text-sm transition-colors">
              ← Sebelumnya
            </a>
          <% } %>
          
          <% 
            const startPage = Math.max(1, pagination.page - 2);
            const endPage = Math.min(pagination.totalPages, pagination.page + 2);
            for (let i = startPage; i <= endPage; i++) { 
          %>
            <a href="?page=<%= i %>&limit=<%= pagination.limit %>&exam_id=<%= filters.exam_id %>&class_id=<%= filters.class_id %>&status=<%= filters.status %>&result=<%= filters.result %>&q=<%= filters.q %>" 
               class="px-4 py-2 rounded-lg border <%= i === pagination.page ? 'border-purple-600 bg-purple-600 text-white' : 'border-purple-300 bg-white hover:bg-purple-50 text-purple-800' %> font-medium text-sm transition-colors">
              <%= i %>
            </a>
          <% } %>
          
          <% if (pagination.page < pagination.totalPages) { %>
            <a href="?page=<%= pagination.page + 1 %>&limit=<%= pagination.limit %>&exam_id=<%= filters.exam_id %>&class_id=<%= filters.class_id %>&status=<%= filters.status %>&result=<%= filters.result %>&q=<%= filters.q %>" 
               class="px-4 py-2 rounded-lg border border-purple-300 bg-white hover:bg-purple-50 text-purple-800 font-medium text-sm transition-colors">
              Selanjutnya →
            </a>
          <% } %>
        </div>
      </div>
    <% } %>
  </div>
</div>

<script>
function toggleSelectAll() {
  const selectAll = document.getElementById('selectAll');
  const checkboxes = document.querySelectorAll('.attempt-checkbox');
  checkboxes.forEach(cb => { cb.checked = selectAll.checked; });
  updateBulkActions();
}

function selectAllVisible() {
  document.querySelectorAll('.attempt-checkbox').forEach(cb => { cb.checked = true; });
  document.getElementById('selectAll').checked = true;
  updateBulkActions();
}

function updateBulkActions() {
  const checked = document.querySelectorAll('.attempt-checkbox:checked');
  const all     = document.querySelectorAll('.attempt-checkbox');
  const bar     = document.getElementById('bulkActionsBar');
  const countEl = document.getElementById('selectedCount');
  const selectAll = document.getElementById('selectAll');

  countEl.textContent = checked.length;
  bar.classList.toggle('hidden', checked.length === 0);

  selectAll.indeterminate = checked.length > 0 && checked.length < all.length;
  selectAll.checked       = all.length > 0 && checked.length === all.length;

  // Highlight baris yang dipilih
  all.forEach(cb => {
    cb.closest('tr').classList.toggle('bg-rose-50', cb.checked);
  });
}

function clearSelection() {
  document.querySelectorAll('.attempt-checkbox').forEach(cb => { cb.checked = false; });
  document.getElementById('selectAll').checked = false;
  document.getElementById('selectAll').indeterminate = false;
  updateBulkActions();
}

function bulkReset() {
  const checked = document.querySelectorAll('.attempt-checkbox:checked');
  if (checked.length === 0) { alert('Pilih minimal satu nilai untuk direset.'); return; }

  let msg = `Reset ${checked.length} nilai berikut?\n\n`;
  checked.forEach((cb, i) => {
    if (i < 6) msg += `• ${cb.dataset.student} — ${cb.dataset.exam}\n`;
  });
  if (checked.length > 6) msg += `... dan ${checked.length - 6} lainnya\n`;
  msg += '\nSiswa dapat mengulang ujian setelah direset. Lanjutkan?';

  if (!confirm(msg)) return;

  const form = document.createElement('form');
  form.method = 'POST';
  form.action = '/teacher/attempts/bulk-reset';
  checked.forEach(cb => {
    const inp = document.createElement('input');
    inp.type = 'hidden';
    inp.name = 'attempt_ids[]';
    inp.value = cb.value;
    form.appendChild(inp);
  });
  document.body.appendChild(form);
  form.submit();
}

document.addEventListener('DOMContentLoaded', updateBulkActions);
</script>