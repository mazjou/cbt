<!-- Header Banner -->
<div class="relative overflow-hidden rounded-2xl bg-gradient-to-r from-indigo-600 via-blue-600 to-cyan-600 shadow-xl mb-6">
  <div class="absolute inset-0 opacity-10">
    <div class="absolute top-0 right-0 w-64 h-64 bg-white rounded-full -mr-32 -mt-32"></div>
    <div class="absolute bottom-0 left-0 w-48 h-48 bg-white rounded-full -ml-24 -mb-24"></div>
  </div>
  <div class="relative px-6 py-8">
    <div class="flex items-center justify-between flex-wrap gap-4">
      <div class="flex items-center gap-4">
        <div class="bg-white/20 backdrop-blur-sm rounded-2xl p-4">
          <svg class="w-10 h-10 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
          </svg>
        </div>
        <div>
          <h1 class="text-2xl font-bold text-white tracking-tight">Input Nilai — <%= subject.subject_name %></h1>
          <p class="mt-1 text-blue-100">
            <%= subject.group_name %> &bull; <%= subject.period_name %> &bull;
            Sem. <%= subject.semester %> T.P. <%= subject.school_year %> &bull;
            <strong>Kelas <%= subject.class_name %></strong>
          </p>
        </div>
      </div>
      <a href="/teacher/raport" class="inline-flex items-center gap-2 px-4 py-2 bg-white/20 backdrop-blur-sm hover:bg-white/30 text-white font-semibold rounded-xl transition-all">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/></svg>
        Kembali
      </a>
    </div>
  </div>
</div>

<%- include('../partials/flash') %>

<!-- Panel Kelola KD -->
<div class="bg-white rounded-2xl shadow-lg border border-slate-100 mb-6">
  <div class="px-6 py-4 border-b border-slate-100 flex items-center justify-between">
    <div>
      <h2 class="text-lg font-bold text-slate-800">Kelola Kompetensi Dasar (KD)</h2>
      <p class="text-sm text-slate-500 mt-0.5">KD hanya tampil di form input, tidak di raport cetakan.</p>
    </div>
    <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-indigo-100 text-indigo-700">
      <%= (kdList || []).length %> KD
    </span>
  </div>

  <div class="px-6 py-4">
    <!-- Daftar KD yang sudah ada -->
    <% if (kdList && kdList.length > 0) { %>
      <div class="mb-4">
        <ul class="space-y-2" id="kd-list">
          <% kdList.forEach((kd, i) => { %>
            <li class="flex items-center justify-between px-4 py-2.5 bg-slate-50 rounded-xl" id="kd-item-<%= kd.id %>">
              <span class="text-sm text-slate-700">
                <span class="font-semibold text-indigo-600 mr-2">KD <%= i + 1 %>:</span>
                <%= kd.kd_name %>
              </span>
              <button type="button"
                onclick="hapusKD(<%= kd.id %>)"
                class="ml-3 inline-flex items-center gap-1 px-3 py-1 bg-red-50 hover:bg-red-100 text-red-600 text-xs font-semibold rounded-lg transition-all">
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
                Hapus
              </button>
            </li>
          <% }) %>
        </ul>
      </div>
    <% } else { %>
      <div class="mb-4 px-4 py-3 bg-amber-50 border border-amber-200 rounded-xl text-amber-700 text-sm">
        <strong>Belum ada KD</strong> — tambahkan KD terlebih dahulu untuk bisa input nilai.
      </div>
    <% } %>

    <!-- Form tambah KD baru -->
    <form method="POST" action="/teacher/raport/<%= period_id %>/<%= subject_id %>/kd" class="flex flex-wrap items-end gap-3">
      <input type="hidden" name="class_id" value="<%= class_id %>">
      <div class="flex-1 min-w-[200px]">
        <label class="block text-xs font-semibold text-slate-600 mb-1">Nama KD Baru</label>
        <input type="text" name="kd_name" required
          placeholder="contoh: Memahami konsep dasar..."
          class="w-full px-3 py-2 border-2 border-slate-200 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 text-sm transition-all">
      </div>
      <div class="w-28">
        <label class="block text-xs font-semibold text-slate-600 mb-1">Urutan</label>
        <input type="number" name="sort_order" value="<%= (kdList || []).length + 1 %>" min="0"
          class="w-full px-3 py-2 border-2 border-slate-200 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 text-sm transition-all">
      </div>
      <button type="submit"
        class="inline-flex items-center gap-2 px-5 py-2 bg-indigo-600 hover:bg-indigo-700 text-white font-semibold text-sm rounded-xl transition-all shadow-sm">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
        Tambah KD
      </button>
    </form>
  </div>
</div>

<!-- Panel Input Nilai -->
<div class="bg-white rounded-2xl shadow-lg border border-slate-100 overflow-hidden">
  <div class="px-6 py-4 border-b border-slate-100 flex items-center justify-between">
    <div>
      <h2 class="text-lg font-bold text-slate-800">Input Nilai Siswa — <%= students.length %> siswa</h2>
      <p class="text-sm text-indigo-600 font-medium mt-0.5">Kelas: <%= subject.class_name %></p>
    </div>
    <span class="text-sm text-slate-500">Kosongkan nilai jika belum diisi</span>
  </div>

  <!-- Bar Export -->
  <div class="px-6 py-3 bg-slate-50 border-b border-slate-100 flex flex-wrap items-center gap-3">
    <a href="/teacher/raport/<%= period_id %>/<%= subject_id %>/<%= class_id %>/export"
       class="inline-flex items-center gap-2 px-4 py-2 bg-green-600 hover:bg-green-700 text-white text-sm font-semibold rounded-xl transition-all shadow-sm">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3M3 17V7a2 2 0 012-2h6l2 2h6a2 2 0 012 2v8a2 2 0 01-2 2H5a2 2 0 01-2-2z"/>
      </svg>
      Download Template Excel
    </a>

    <% if (!kdList || kdList.length === 0) { %>
      <!-- Import hanya untuk mapel tanpa KD -->
      <form method="POST" action="/teacher/raport/<%= period_id %>/<%= subject_id %>/<%= class_id %>/import"
            enctype="multipart/form-data"
            class="flex items-center gap-2">
        <label class="inline-flex items-center gap-2 px-4 py-2 bg-blue-50 border-2 border-blue-200 hover:bg-blue-100 text-blue-700 text-sm font-semibold rounded-xl transition-all cursor-pointer">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12"/>
          </svg>
          <span id="import-file-label">Pilih File Excel</span>
          <input type="file" name="nilai_file" accept=".xlsx,.xls" class="hidden" id="import-file-input"
                 onchange="document.getElementById('import-file-label').textContent = this.files[0]?.name || 'Pilih File Excel'">
        </label>
        <button type="submit"
                class="px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white text-sm font-semibold rounded-xl transition-all shadow-sm">
          Import Nilai
        </button>
      </form>
      <span class="text-xs text-slate-400">Download template dulu, isi nilai di Excel, lalu import</span>
    <% } else { %>
      <span class="text-xs text-amber-600 bg-amber-50 px-3 py-1.5 rounded-lg border border-amber-200">
        &#x2139;&#xFE0F; Import Excel tidak tersedia untuk mapel dengan KD. Gunakan form di bawah.
      </span>
    <% } %>
  </div>

  <% if (!kdList || kdList.length === 0) { %>
    <!-- Belum ada KD -->
    <div class="px-6 py-10 text-center">
      <div class="inline-flex items-center justify-center w-16 h-16 bg-amber-100 rounded-2xl mb-4">
        <svg class="w-8 h-8 text-amber-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></svg>
      </div>
      <p class="text-slate-500 font-medium">Tambahkan KD di panel atas untuk mulai input nilai.</p>
    </div>
  <% } else { %>
    <!-- Form input nilai dengan KD dinamis -->
    <form method="POST" action="/teacher/raport/<%= period_id %>/<%= subject_id %>/<%= class_id %>">
      <div class="overflow-x-auto">
        <table class="w-full">
          <thead>
            <tr class="bg-slate-50 text-left text-xs font-semibold text-slate-500 uppercase tracking-wider">
              <th class="px-4 py-3 w-10">No</th>
              <th class="px-4 py-3">Nama Siswa</th>
              <th class="px-4 py-3">NISN</th>
              <% kdList.forEach((kd, i) => { %>
                <th class="px-3 py-3 w-24 text-center" title="<%= kd.kd_name %>">KD <%= i + 1 %></th>
              <% }) %>
              <th class="px-3 py-3 w-28 text-center">Rata-rata</th>
              <th class="px-4 py-3">Keterangan</th>
            </tr>
            <!-- Sub-header nama KD -->
            <tr class="bg-indigo-50 text-xs text-indigo-700">
              <td class="px-4 py-1" colspan="3"></td>
              <% kdList.forEach(kd => { %>
                <td class="px-3 py-1 text-center font-medium" style="max-width:96px;overflow:hidden;white-space:nowrap;text-overflow:ellipsis;" title="<%= kd.kd_name %>"><%= kd.kd_name %></td>
              <% }) %>
              <td class="px-3 py-1"></td>
              <td class="px-4 py-1"></td>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100">
            <% if (!students || !students.length) { %>
              <tr>
                <td colspan="<%= 4 + (kdList || []).length + 1 %>" class="px-6 py-10 text-center text-slate-400">Belum ada siswa aktif.</td>
              </tr>
            <% } %>
            <% (students || []).forEach((s, idx) => { %>
              <tr class="hover:bg-slate-50 transition-colors">
                <td class="px-4 py-3 text-slate-500 text-sm"><%= idx + 1 %></td>
                <td class="px-4 py-3 font-medium text-slate-800"><%= s.full_name %></td>
                <td class="px-4 py-3 text-slate-600 font-mono text-sm"><%= String(s.username || '').split('@')[0] %></td>
                <% kdList.forEach(kd => { %>
                  <td class="px-3 py-3">
                    <input type="number"
                      name="kd_scores[<%= s.id %>][<%= kd.id %>]"
                      data-student="<%= s.id %>"
                      data-type="kd"
                      value="<%= (kdScoreMap && kdScoreMap[s.id] && kdScoreMap[s.id][kd.id] !== undefined && kdScoreMap[s.id][kd.id] !== null) ? kdScoreMap[s.id][kd.id] : '' %>"
                      min="0" max="100" step="0.01"
                      placeholder="—"
                      oninput="hitungRataRata('<%= s.id %>')"
                      class="w-full px-2 py-1.5 border-2 border-slate-200 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-all text-sm text-center">
                  </td>
                <% }) %>
                <td class="px-3 py-3 text-center">
                  <span id="rata-<%= s.id %>" class="font-semibold text-indigo-700 text-sm">-</span>
                </td>
                <td class="px-4 py-3">
                  <input type="text"
                    name="notes[<%= s.id %>]"
                    value="<%= s.notes || '' %>"
                    placeholder="Keterangan (opsional)"
                    class="w-full px-3 py-2 border-2 border-slate-200 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-all text-sm">
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>

      <% if (students && students.length) { %>
        <div class="px-6 py-4 border-t border-slate-100 bg-slate-50 flex items-center justify-between">
          <p class="text-sm text-slate-500">Rata-rata dihitung otomatis dari KD yang diisi. Nilai akhir tersimpan sebagai rata-rata KD.</p>
          <button type="submit"
            class="inline-flex items-center gap-2 px-6 py-2.5 bg-gradient-to-r from-indigo-600 to-blue-600 text-white font-semibold rounded-xl hover:from-indigo-700 hover:to-blue-700 transition-all shadow-md whitespace-nowrap">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
            Simpan Semua Nilai
          </button>
        </div>
      <% } %>
    </form>
  <% } %>
</div>

<script>
function hitungRataRata(studentId) {
  const inputs = document.querySelectorAll('input[data-student="' + studentId + '"][data-type="kd"]');
  let total = 0, count = 0;
  inputs.forEach(function(inp) {
    const v = parseFloat(inp.value);
    if (!isNaN(v) && v >= 0 && v <= 100) { total += v; count++; }
  });
  const rataEl = document.getElementById('rata-' + studentId);
  if (rataEl) rataEl.textContent = count > 0 ? (total / count).toFixed(2) : '-';
}

// Hapus KD via AJAX DELETE
async function hapusKD(kdId) {
  if (!confirm('Hapus KD ini? Semua nilai KD yang sudah diinput akan ikut terhapus.')) return;
  try {
    const res = await fetch('/teacher/raport/kd/' + kdId, { method: 'DELETE' });
    const data = await res.json();
    if (data.ok) {
      window.location.reload();
    } else {
      alert('Gagal menghapus KD: ' + (data.message || 'Error tidak diketahui'));
    }
  } catch(e) {
    alert('Gagal menghapus KD: ' + e.message);
  }
}

// Hitung rata-rata untuk semua siswa saat halaman dimuat
document.addEventListener('DOMContentLoaded', function() {
  const studentIds = new Set();
  document.querySelectorAll('input[data-type="kd"]').forEach(function(inp) {
    if (inp.dataset.student) studentIds.add(inp.dataset.student);
  });
  studentIds.forEach(function(id) { hitungRataRata(id); });
});
</script>
