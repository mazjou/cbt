<!-- KaTeX offline -->
<link rel="stylesheet" href="/public/lib/katex/katex.min.css">
<!-- Summernote offline -->
<link rel="stylesheet" href="/public/lib/summernote/summernote-lite.min.css">

<style>
@font-face {
  font-family: 'summernote';
  src: url('/public/lib/summernote/font/summernote.woff2') format('woff2'),
       url('/public/lib/summernote/font/summernote.woff') format('woff'),
       url('/public/lib/summernote/font/summernote.ttf') format('truetype');
  font-weight: normal;
  font-style: normal;
}
.note-editor.note-frame { border-radius: 12px !important; border: 2px solid #c7d2fe !important; }
.note-editor.note-frame.focus { border-color: #6366f1 !important; box-shadow: 0 0 0 3px rgba(99,102,241,0.15) !important; }
.note-toolbar { background: #f0f4ff !important; border-bottom: 1px solid #c7d2fe !important; border-radius: 10px 10px 0 0 !important; padding: 6px !important; }
.note-btn { border-radius: 6px !important; }
.note-editable { min-height: 120px !important; font-size: 15px !important; }
.math-formula { display: inline-block; vertical-align: middle; padding: 0 2px; cursor: pointer; }
.math-formula:hover { background: #ede9fe; border-radius: 4px; }
.math-formula-block { margin: 8px 0; }
.math-icon { font-style: normal; font-size: 16px; font-weight: bold; font-family: serif; }
</style>

<!-- Header -->
<div class="flex items-center justify-between gap-4 mb-6">
  <div>
    <div class="text-sm text-slate-500 mb-1">Edit Soal</div>
    <h1 class="text-2xl font-bold bg-gradient-to-r from-violet-600 to-pink-500 bg-clip-text text-transparent"><%= exam.title %></h1>
    <p class="mt-1 text-slate-500 text-sm">Perbarui teks soal, gambar, poin, dan kunci jawaban.</p>
    <div class="mt-2">
      <% const qtBadge = question.question_type || 'MCQ'; %>
      <% if (qtBadge === 'CHECKBOX' || qtBadge === 'COMPLEX') { %>
        <span class="inline-flex items-center gap-1 px-3 py-1 rounded-full bg-orange-100 text-orange-700 text-xs font-semibold">☑ Tipe: Checkbox (multi-jawaban)</span>
      <% } else if (qtBadge === 'TRUE_FALSE') { %>
        <span class="inline-flex items-center gap-1 px-3 py-1 rounded-full bg-emerald-100 text-emerald-700 text-xs font-semibold">✓✗ Tipe: Benar/Salah</span>
      <% } else { %>
        <span class="inline-flex items-center gap-1 px-3 py-1 rounded-full bg-indigo-100 text-indigo-700 text-xs font-semibold">◉ Tipe: Pilihan Ganda (MCQ)</span>
      <% } %>
    </div>
  </div>
  <a href="/teacher/exams/<%= exam.id %>" class="text-sm px-4 py-2 rounded-xl border border-rose-200 bg-gradient-to-br from-rose-50 to-pink-100 hover:from-rose-100 hover:to-pink-200 text-rose-700 font-medium transition-all shadow-sm">Kembali</a>
</div>

<form action="/teacher/questions/<%= question.id %>?_method=PUT" method="POST" enctype="multipart/form-data" id="editQuestionForm" class="space-y-5">

  <!-- Pertanyaan -->
  <div class="rounded-2xl border border-violet-200 bg-gradient-to-br from-violet-50 to-purple-50 p-5 shadow-sm">
    <label class="flex items-center gap-2 text-sm font-semibold text-violet-700 mb-2">Pertanyaan</label>
    <textarea id="editor_question" name="question_text" class="summernote-editor"><%- question.question_text %></textarea>
  </div>

  <!-- Poin & Jawaban Benar -->
  <div class="grid grid-cols-2 gap-4">
    <div class="rounded-2xl border border-amber-200 bg-gradient-to-br from-amber-50 to-yellow-50 p-4 shadow-sm">
      <label class="flex items-center gap-2 text-sm font-semibold text-amber-700 mb-2">Poin</label>
      <input type="number" name="points" value="<%= question.points %>" min="1"
        class="w-full rounded-xl bg-white border-2 border-amber-200 px-4 py-2.5 focus:outline-none focus:border-amber-400 text-slate-800 font-semibold transition-all" />
    </div>
    <div id="correct_single_wrap" class="rounded-2xl border border-emerald-200 bg-gradient-to-br from-emerald-50 to-green-50 p-4 shadow-sm">
      <label class="flex items-center gap-2 text-sm font-semibold text-emerald-700 mb-2">Jawaban Benar</label>
      <select name="correct" required
        class="w-full rounded-xl bg-white border-2 border-emerald-200 px-4 py-2.5 focus:outline-none focus:border-emerald-400 text-slate-800 font-semibold transition-all">
        <% ;['A','B','C','D','E'].forEach((lbl)=>{ %>
          <option value="<%= lbl %>" <%= correct_label===lbl ? 'selected' : '' %>><%= lbl %></option>
        <% }) %>
      </select>
    </div>
  </div>

  <!-- COMPLEX/CHECKBOX: multi-correct panel -->
  <div id="correct_complex_wrap" class="hidden rounded-2xl border border-orange-200 bg-gradient-to-br from-orange-50 to-amber-50 p-4 shadow-sm">
    <label class="text-sm font-semibold text-orange-700 mb-2 block">Pilih semua jawaban yang BENAR:</label>
    <div class="flex flex-wrap gap-3">
      <% ['A','B','C','D','E'].forEach(lbl => { %>
      <label class="flex items-center gap-2 px-4 py-2 rounded-xl border-2 border-orange-200 bg-white cursor-pointer hover:bg-orange-50 transition-all">
        <input type="checkbox" name="correct" value="<%= lbl %>" class="accent-orange-600 w-4 h-4"
          <%= (typeof correct_labels !== 'undefined' && correct_labels.includes(lbl)) ? 'checked' : '' %> />
        <span class="text-sm font-semibold text-orange-800">Opsi <%= lbl %></span>
      </label>
      <% }) %>
    </div>
    <p class="text-xs text-orange-500 mt-1">Poin proporsional — tiap jawaban benar yang dipilih siswa menambah poin</p>
  </div>

  <!-- TRUE_FALSE: info panel -->
  <div id="correct_trufalse_wrap" class="hidden rounded-2xl border border-emerald-200 bg-gradient-to-br from-emerald-50 to-green-50 p-4 shadow-sm">
    <label class="text-sm font-semibold text-emerald-700 mb-2 block">Jawaban Benar</label>
    <div class="flex gap-3">
      <label class="flex items-center gap-2 px-4 py-2 rounded-xl border-2 border-emerald-200 bg-white cursor-pointer hover:bg-emerald-50 transition-all">
        <input type="radio" name="correct" value="A" class="accent-emerald-600 w-4 h-4"
          <%= correct_label === 'A' ? 'checked' : '' %> />
        <span class="text-sm font-semibold text-emerald-800">✅ Benar (A)</span>
      </label>
      <label class="flex items-center gap-2 px-4 py-2 rounded-xl border-2 border-rose-200 bg-white cursor-pointer hover:bg-rose-50 transition-all">
        <input type="radio" name="correct" value="B" class="accent-rose-600 w-4 h-4"
          <%= correct_label === 'B' ? 'checked' : '' %> />
        <span class="text-sm font-semibold text-rose-800">❌ Salah (B)</span>
      </label>
    </div>
  </div>

  <!-- Hidden question_type to preserve through edit -->
  <input type="hidden" name="question_type" value="<%= question.question_type %>">

  <!-- Gambar Soal -->
  <div class="rounded-2xl border border-sky-200 bg-gradient-to-br from-sky-50 to-cyan-50 p-5 shadow-sm">
    <label class="flex items-center gap-2 text-sm font-semibold text-sky-700 mb-3">
      Gambar Soal <span class="text-xs font-normal text-sky-400">(opsional)</span>
    </label>
    <% if (question.question_image) { %>
      <div class="mb-3 rounded-xl border border-sky-200 bg-white p-3">
        <div class="text-xs text-sky-600 font-medium mb-2">Gambar saat ini:</div>
        <img src="<%= question.question_image %>" alt="gambar_soal" class="max-h-48 rounded-xl border border-sky-200 shadow-sm" />
        <label class="mt-3 inline-flex items-center gap-2 text-sm cursor-pointer">
          <input type="checkbox" name="remove_image" value="1" class="accent-sky-500 w-4 h-4" />
          <span class="text-sky-700">Hapus gambar ini</span>
        </label>
      </div>
    <% } %>
    <input type="file" name="image" accept="image/*"
      class="w-full rounded-xl bg-white border-2 border-sky-200 px-4 py-2.5 text-sm text-slate-600 file:mr-3 file:py-1.5 file:px-3 file:rounded-lg file:border-0 file:bg-sky-100 file:text-sky-700 hover:file:bg-sky-200 transition-all" />
    <div class="mt-1.5 text-xs text-sky-500">Max 5MB. Format: JPG, PNG, GIF, WebP</div>
  </div>

  <!-- PDF Soal -->
  <div class="rounded-2xl border border-purple-200 bg-gradient-to-br from-purple-50 to-fuchsia-50 p-5 shadow-sm">
    <label class="flex items-center gap-2 text-sm font-semibold text-purple-700 mb-3">
      PDF Soal <span class="text-xs font-normal text-purple-400">(opsional)</span>
    </label>
    <% if (question.question_pdf) { %>
      <div class="mb-3 rounded-xl border border-purple-200 bg-white p-3">
        <div class="text-xs text-purple-600 font-medium mb-2">PDF saat ini:</div>
        <iframe src="<%= question.question_pdf %>" class="w-full h-56 rounded-xl border border-purple-200" frameborder="0"></iframe>
        <label class="mt-3 inline-flex items-center gap-2 text-sm cursor-pointer">
          <input type="checkbox" name="remove_pdf" value="1" class="accent-purple-500 w-4 h-4" />
          <span class="text-purple-700">Hapus PDF ini</span>
        </label>
      </div>
    <% } %>
    <input type="file" name="pdf" accept="application/pdf"
      class="w-full rounded-xl bg-white border-2 border-purple-200 px-4 py-2.5 text-sm text-slate-600 file:mr-3 file:py-1.5 file:px-3 file:rounded-lg file:border-0 file:bg-purple-100 file:text-purple-700 hover:file:bg-purple-200 transition-all" />
    <div class="mt-1.5 text-xs text-purple-500">Max 10MB. Format: PDF</div>
  </div>

  <!-- Opsi Jawaban -->
  <div class="space-y-3">
    <div class="text-sm font-semibold text-slate-600 flex items-center gap-2">Opsi Jawaban</div>

    <!-- Opsi A -->
    <div class="rounded-2xl border border-rose-200 bg-gradient-to-br from-rose-50 to-pink-50 p-4 shadow-sm">
      <label class="flex items-center gap-2 text-sm font-semibold text-rose-700 mb-2">
        <span class="w-6 h-6 rounded-full bg-rose-500 text-white text-xs flex items-center justify-center font-bold">A</span> Opsi A
      </label>
      <textarea id="editor_option_a" name="a" class="summernote-option"><%- options.A || '' %></textarea>
    </div>

    <!-- Opsi B -->
    <div class="rounded-2xl border border-orange-200 bg-gradient-to-br from-orange-50 to-amber-50 p-4 shadow-sm">
      <label class="flex items-center gap-2 text-sm font-semibold text-orange-700 mb-2">
        <span class="w-6 h-6 rounded-full bg-orange-500 text-white text-xs flex items-center justify-center font-bold">B</span> Opsi B
      </label>
      <textarea id="editor_option_b" name="b" class="summernote-option"><%- options.B || '' %></textarea>
    </div>

    <!-- Opsi C -->
    <div id="opt_wrap_c" class="rounded-2xl border border-lime-200 bg-gradient-to-br from-lime-50 to-green-50 p-4 shadow-sm">
      <label class="flex items-center gap-2 text-sm font-semibold text-lime-700 mb-2">
        <span class="w-6 h-6 rounded-full bg-lime-500 text-white text-xs flex items-center justify-center font-bold">C</span> Opsi C
      </label>
      <textarea id="editor_option_c" name="c" class="summernote-option"><%- options.C || '' %></textarea>
    </div>

    <!-- Opsi D -->
    <div id="opt_wrap_d" class="rounded-2xl border border-sky-200 bg-gradient-to-br from-sky-50 to-cyan-50 p-4 shadow-sm">
      <label class="flex items-center gap-2 text-sm font-semibold text-sky-700 mb-2">
        <span class="w-6 h-6 rounded-full bg-sky-500 text-white text-xs flex items-center justify-center font-bold">D</span> Opsi D
      </label>
      <textarea id="editor_option_d" name="d" class="summernote-option"><%- options.D || '' %></textarea>
    </div>

    <!-- Opsi E -->
    <div id="opt_wrap_e" class="rounded-2xl border border-violet-200 bg-gradient-to-br from-violet-50 to-purple-50 p-4 shadow-sm">
      <label class="flex items-center gap-2 text-sm font-semibold text-violet-700 mb-2">
        <span class="w-6 h-6 rounded-full bg-violet-500 text-white text-xs flex items-center justify-center font-bold">E</span> Opsi E
      </label>
      <textarea id="editor_option_e" name="e" class="summernote-option"><%- options.E || '' %></textarea>
    </div>
  </div>

  <!-- Tombol Aksi -->
  <div class="flex flex-col sm:flex-row gap-3 pt-2">
    <button type="submit"
      class="flex-1 rounded-xl bg-gradient-to-r from-violet-500 to-pink-500 hover:from-violet-600 hover:to-pink-600 text-white font-bold py-3 shadow-lg hover:shadow-xl transition-all transform hover:scale-[1.02]">
      Simpan Perubahan
    </button>
    <a href="/teacher/exams/<%= exam.id %>"
      class="flex-1 text-center rounded-xl border-2 border-slate-200 bg-white hover:bg-slate-50 text-slate-600 font-semibold py-3 transition-all">
      Batal
    </a>
  </div>

</form>

<!-- jQuery + Summernote + KaTeX + Math Plugin (semua offline) -->
<script src="/public/lib/jquery/jquery.min.js"></script>
<script>var $sn = jQuery.noConflict(true);</script>
<script src="/public/lib/katex/katex.min.js"></script>
<script>window.$ = window.jQuery = $sn;</script>
<script src="/public/lib/summernote/summernote-lite.min.js"></script>
<script src="/public/lib/summernote/summernote-math.js"></script>

<script>
$sn(document).ready(function () {
  var $ = $sn;

  var toolbarQuestion = [
    ['style', ['bold', 'italic', 'underline', 'strikethrough', 'clear']],
    ['font', ['superscript', 'subscript']],
    ['color', ['color']],
    ['para', ['ul', 'ol']],
    ['insert', ['picture', 'math']],
    ['view', ['codeview']]
  ];

  var toolbarOption = [
    ['style', ['bold', 'italic', 'underline', 'clear']],
    ['font', ['superscript', 'subscript']],
    ['color', ['color']],
    ['insert', ['picture', 'math']]
  ];

  var commonConfig = {
    lang: 'en-US',
    disableDragAndDrop: false,
    callbacks: {
      onImageUpload: function (files) {
        var editor = this;
        Array.from(files).forEach(function (file) {
          var reader = new FileReader();
          reader.onload = function (e) {
            var img = $('<img>').attr('src', e.target.result)
              .css({ maxWidth: '100%', height: 'auto', borderRadius: '8px', margin: '4px 0' });
            $(editor).summernote('insertNode', img[0]);
          };
          reader.readAsDataURL(file);
        });
      },
      onChange: function(contents, $editable) {
        // Sync ke textarea asli agar value terkirim saat submit native
        var $textarea = $(this).closest('.note-editor').prev('textarea');
        if ($textarea.length) $textarea.val(contents);
      }
    },
    plugins: ['math']
  };

  // Init editor pertanyaan
  $('#editor_question').summernote($.extend({}, commonConfig, {
    height: 160,
    placeholder: 'Ketik pertanyaan... Klik ∑ untuk rumus matematika',
    toolbar: toolbarQuestion
  }));

  // Init editor opsi A-E
  $('.summernote-option').summernote($.extend({}, commonConfig, {
    height: 90,
    placeholder: 'Ketik opsi jawaban...',
    toolbar: toolbarOption
  }));

  // Validasi & submit
  $('#editQuestionForm').on('submit', function (e) {
    var qtype = '<%= question.question_type || "MCQ" %>';

    // Cek isi editor question - ambil dari textarea asli ATAU dari Summernote
    var qContent = '';
    try { qContent = $('#editor_question').summernote('code') || ''; } catch(_) {}
    // Fallback: ambil dari note-editable (DOM Summernote)
    if (!qContent || qContent === '<p><br></p>' || qContent.trim() === '') {
      var noteEditable = document.querySelector('#editor_question').closest('.note-editor');
      if (noteEditable) {
        qContent = noteEditable.querySelector('.note-editable').innerHTML || '';
      }
    }
    // Fallback terakhir: ambil teks langsung dari .note-editable
    var qText = '';
    var noteEditableEl = document.querySelector('.note-editor .note-editable');
    if (noteEditableEl) qText = noteEditableEl.innerText.trim();

    if (!qText && !qContent.includes('<img')) {
      e.preventDefault();
      alert('Pertanyaan tidak boleh kosong!');
      return false;
    }

    // Validasi opsi A dan B (minimal harus ada)
    var optFields = [
      { id: 'editor_option_a', name: 'Opsi A' },
      { id: 'editor_option_b', name: 'Opsi B' }
    ];
    if (qtype !== 'TRUE_FALSE') {
      optFields.push({ id: 'editor_option_c', name: 'Opsi C' });
      optFields.push({ id: 'editor_option_d', name: 'Opsi D' });
    }

    for (var i = 0; i < optFields.length; i++) {
      var f = optFields[i];
      var content = '';
      try { content = $('#' + f.id).summernote('code') || ''; } catch(_) {}
      var txt = $('<div>').html(content).text().trim();
      var hasImg = content.indexOf('<img') !== -1;
      if (!txt && !hasImg) {
        e.preventDefault();
        alert(f.name + ' tidak boleh kosong!');
        try { $('#' + f.id).summernote('focus'); } catch(_) {}
        return false;
      }
    }

    // Validasi COMPLEX/CHECKBOX harus pilih minimal 1
    if (qtype === 'COMPLEX' || qtype === 'CHECKBOX') {
      var checkedCount = document.querySelectorAll('input[name=correct]:checked').length;
      if (checkedCount < 1) {
        e.preventDefault();
        alert('Pilih minimal 1 jawaban benar!');
        return false;
      }
    }
  });

});
</script>

<script>
  // Show/hide correct panels based on question type
  (function() {
    var qtype = '<%= question.question_type || "MCQ" %>';
    var singleWrap  = document.getElementById('correct_single_wrap');
    var complexWrap = document.getElementById('correct_complex_wrap');
    var tfWrap      = document.getElementById('correct_trufalse_wrap');
    var optC = document.getElementById('opt_wrap_c');
    var optD = document.getElementById('opt_wrap_d');
    var optE = document.getElementById('opt_wrap_e');

    if (qtype === 'COMPLEX' || qtype === 'CHECKBOX') {
      if (singleWrap) singleWrap.classList.add('hidden');
      if (complexWrap) complexWrap.classList.remove('hidden');
      var sel = singleWrap ? singleWrap.querySelector('select') : null;
      if (sel) { sel.disabled = true; sel.removeAttribute('required'); }
    } else if (qtype === 'TRUE_FALSE') {
      if (singleWrap) singleWrap.classList.add('hidden');
      if (tfWrap) tfWrap.classList.remove('hidden');
      var sel = singleWrap ? singleWrap.querySelector('select') : null;
      if (sel) { sel.disabled = true; sel.removeAttribute('required'); }
      if (optC) optC.classList.add('hidden');
      if (optD) optD.classList.add('hidden');
      if (optE) optE.classList.add('hidden');
    }
  })();
</script>
