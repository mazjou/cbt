<header class="sticky top-0 z-40 backdrop-blur bg-white/90 border-b border-slate-200">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="flex h-16 items-center justify-between">
      <div class="flex items-center gap-3">
        <% if (user) { %>
          <!-- Hamburger Menu Button (Mobile Only) -->
          <button id="sidebarToggle" class="lg:hidden p-2 rounded-xl border border-slate-200 bg-white hover:bg-slate-50 transition-all">
            <svg class="w-6 h-6 text-slate-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
            </svg>
          </button>
        <% } %>
        
        <a href="/" class="inline-flex items-center gap-3 font-semibold tracking-tight">
          <img src="/public/images/logo.png" alt="Logo SMK Negeri 1 Kras" class="h-12 w-12 object-contain">
          <span>LMS <span class="text-indigo-600">SMKN 1 Kras</span></span>
        </a>
        <span class="hidden md:inline text-xs text-white bg-gradient-to-r from-indigo-600 to-purple-600 rounded-full px-3 py-1.5 font-medium shadow-sm">Inovasi Kreasi Prestasi</span>
      </div>

      <nav class="flex items-center gap-2">
        <% if (!user) { %>
          <a href="/login" class="text-sm px-4 py-2 rounded-xl border border-indigo-200 bg-gradient-to-br from-indigo-50 to-indigo-100 hover:from-indigo-100 hover:to-indigo-200 text-indigo-800 font-medium transition-all">Login</a>
        <% } else { %>
          <!-- Notification Bell (Only for Students) -->
          <% if (user.role === 'STUDENT') { %>
            <div class="relative" id="notificationDropdown">
              <button id="notificationBell" class="relative p-2 rounded-xl border border-slate-200 bg-white hover:bg-slate-50 transition-all">
                <svg class="w-5 h-5 text-slate-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"></path>
                </svg>
                <span id="notificationBadge" class="hidden absolute -top-1 -right-1 bg-red-500 text-white text-xs font-bold rounded-full h-5 w-5 flex items-center justify-center">0</span>
              </button>
              
              <!-- Dropdown -->
              <div id="notificationPanel" class="hidden absolute right-0 mt-2 w-80 bg-white rounded-xl shadow-lg border border-slate-200 max-h-96 overflow-y-auto z-50">
                <div class="p-3 border-b border-slate-200 flex items-center justify-between">
                  <h3 class="font-semibold text-slate-800">Notifikasi</h3>
                  <button id="markAllRead" class="text-xs text-indigo-600 hover:text-indigo-800">Tandai semua dibaca</button>
                </div>
                <div id="notificationList" class="divide-y divide-slate-100">
                  <div class="p-4 text-center text-sm text-slate-500">Memuat notifikasi...</div>
                </div>
              </div>
            </div>
          <% } %>

          <% if (user.role === 'ADMIN') { %>
            <!-- No additional buttons for admin, they're already on dashboard -->
          <% } %>
          <% if (user.role === 'TEACHER') { %>
            <!-- No additional buttons for teacher, they're already on dashboard -->
          <% } %>
          <% if (user.role === 'PRINCIPAL') { %>
            <!-- No additional buttons for principal, they're already on dashboard -->
          <% } %>
          <% if (user.role === 'STUDENT') { %>
            <!-- No additional buttons for student, they're already on dashboard -->
          <% } %>

          <div class="hidden sm:flex items-center gap-2 pl-2">
            <!-- Profile Dropdown -->
            <div class="relative" id="profileDropdown">
              <button id="profileButton" class="flex items-center gap-3 px-3 py-2 rounded-xl border-2 border-slate-200 bg-white hover:bg-slate-50 transition-all">
                <% if (user.profile_photo) { %>
                  <img src="<%= user.profile_photo %>" alt="Profile" class="w-8 h-8 rounded-full object-cover border-2 border-indigo-200">
                <% } else { %>
                  <div class="w-8 h-8 rounded-full bg-gradient-to-br from-indigo-100 to-purple-100 border-2 border-indigo-200 flex items-center justify-center">
                    <svg class="w-5 h-5 text-indigo-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                    </svg>
                  </div>
                <% } %>
                <div class="text-left">
                  <div class="text-sm font-medium text-slate-900"><%= user.full_name %></div>
                  <div class="text-xs text-slate-500"><%= ({TEACHER:'Guru',STUDENT:'Siswa',ADMIN:'Admin',PRINCIPAL:'Kepala Sekolah'})[user.role] || user.role %><% if (user.class_name) { %> • <%= user.class_name %><% } %></div>
                </div>
                <svg class="w-4 h-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
                </svg>
              </button>

              <!-- Dropdown Menu -->
              <div id="profileMenu" class="hidden absolute right-0 mt-2 w-64 bg-white rounded-xl shadow-lg border-2 border-slate-200 z-50 overflow-hidden">
                <div class="p-3 border-b border-slate-200 bg-gradient-to-r from-indigo-50 to-purple-50">
                  <div class="flex items-center gap-3">
                    <% if (user.profile_photo) { %>
                      <img src="<%= user.profile_photo %>" alt="Profile" class="w-12 h-12 rounded-full object-cover border-2 border-indigo-200">
                    <% } else { %>
                      <div class="w-12 h-12 rounded-full bg-gradient-to-br from-indigo-100 to-purple-100 border-2 border-indigo-200 flex items-center justify-center">
                        <svg class="w-6 h-6 text-indigo-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                        </svg>
                      </div>
                    <% } %>
                    <div class="flex-1 min-w-0">
                      <div class="text-sm font-semibold text-slate-900 truncate"><%= user.full_name %></div>
                      <div class="text-xs text-slate-600"><%= ({TEACHER:'Guru',STUDENT:'Siswa',ADMIN:'Admin',PRINCIPAL:'Kepala Sekolah'})[user.role] || user.role %></div>
                    </div>
                  </div>
                </div>

                <div class="py-2">
                  <a href="/profile" class="flex items-center gap-3 px-4 py-2.5 hover:bg-indigo-50 transition-all">
                    <svg class="w-5 h-5 text-indigo-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                    </svg>
                    <span class="text-sm font-medium text-slate-700">Profil Saya</span>
                  </a>
                </div>

                <div class="border-t border-slate-200">
                  <form action="/logout" method="POST">
                    <button type="submit" class="w-full flex items-center gap-3 px-4 py-2.5 hover:bg-rose-50 transition-all text-left">
                      <svg class="w-5 h-5 text-rose-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"></path>
                      </svg>
                      <span class="text-sm font-medium text-rose-700">Keluar</span>
                    </button>
                  </form>
                </div>
              </div>
            </div>
          </div>

          <!-- Mobile Profile Button -->
          <div class="sm:hidden relative" id="profileDropdownMobile">
            <button id="profileButtonMobile" class="p-2 rounded-xl border-2 border-slate-200 bg-white hover:bg-slate-50 transition-all">
              <% if (user.profile_photo) { %>
                <img src="<%= user.profile_photo %>" alt="Profile" class="w-8 h-8 rounded-full object-cover border-2 border-indigo-200">
              <% } else { %>
                <div class="w-8 h-8 rounded-full bg-gradient-to-br from-indigo-100 to-purple-100 border-2 border-indigo-200 flex items-center justify-center">
                  <svg class="w-5 h-5 text-indigo-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                  </svg>
                </div>
              <% } %>
            </button>

            <!-- Mobile Dropdown Menu -->
            <div id="profileMenuMobile" class="hidden absolute right-0 mt-2 w-64 bg-white rounded-xl shadow-lg border-2 border-slate-200 z-50 overflow-hidden">
              <div class="p-3 border-b border-slate-200 bg-gradient-to-r from-indigo-50 to-purple-50">
                <div class="flex items-center gap-3">
                  <% if (user.profile_photo) { %>
                    <img src="<%= user.profile_photo %>" alt="Profile" class="w-12 h-12 rounded-full object-cover border-2 border-indigo-200">
                  <% } else { %>
                    <div class="w-12 h-12 rounded-full bg-gradient-to-br from-indigo-100 to-purple-100 border-2 border-indigo-200 flex items-center justify-center">
                      <svg class="w-6 h-6 text-indigo-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                      </svg>
                    </div>
                  <% } %>
                  <div class="flex-1 min-w-0">
                    <div class="text-sm font-semibold text-slate-900 truncate"><%= user.full_name %></div>
                    <div class="text-xs text-slate-600">
                      <%= ({TEACHER:'Guru',STUDENT:'Siswa',ADMIN:'Admin',PRINCIPAL:'Kepala Sekolah'})[user.role] || user.role %>
                      <% if (user.role === 'STUDENT' && user.class_name) { %>
                        <span class="text-indigo-600"> - <%= user.class_name %></span>
                      <% } %>
                    </div>
                  </div>
                </div>
              </div>

              <div class="py-2">
                <a href="/profile" class="flex items-center gap-3 px-4 py-2.5 hover:bg-indigo-50 transition-all">
                  <svg class="w-5 h-5 text-indigo-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                  </svg>
                  <span class="text-sm font-medium text-slate-700">Profil Saya</span>
                </a>
              </div>

              <div class="border-t border-slate-200">
                <form action="/logout" method="POST">
                  <button type="submit" class="w-full flex items-center gap-3 px-4 py-2.5 hover:bg-rose-50 transition-all text-left">
                    <svg class="w-5 h-5 text-rose-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"></path>
                    </svg>
                    <span class="text-sm font-medium text-rose-700">Keluar</span>
                  </button>
                </form>
              </div>
            </div>
          </div>
        <% } %>
      </nav>
    </div>
  </div>
</header>

<!-- Mobile Sidebar -->
<% if (user) { %>
  <!-- Overlay -->
  <div id="sidebarOverlay" class="hidden fixed inset-0 bg-black/50 z-50 lg:hidden transition-opacity"></div>
  
  <!-- Sidebar -->
  <aside id="mobileSidebar" class="fixed top-0 left-0 h-full w-80 bg-white shadow-2xl z-50 transform -translate-x-full transition-transform duration-300 ease-in-out lg:hidden">
    <div class="flex flex-col h-full">
      <!-- Sidebar Header -->
      <div class="flex items-center justify-between p-4 border-b border-slate-200 bg-gradient-to-r from-indigo-500 to-purple-600">
        <div class="flex items-center gap-3">
          <img src="/public/images/logo.png" alt="Logo" class="h-10 w-10 object-contain">
          <div class="text-white">
            <div class="font-semibold text-sm"><%= user.full_name %></div>
            <div class="text-xs opacity-90"><%= ({TEACHER:'Guru',STUDENT:'Siswa',ADMIN:'Admin',PRINCIPAL:'Kepala Sekolah'})[user.role] || user.role %><% if (user.class_name) { %> • <%= user.class_name %><% } %></div>
          </div>
        </div>
        <button id="sidebarClose" class="p-2 rounded-lg hover:bg-white/20 transition-all">
          <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
          </svg>
        </button>
      </div>

      <!-- Sidebar Menu -->
      <nav class="flex-1 overflow-y-auto p-4 space-y-1">

        <!-- HOME — semua role -->
        <% const homeUrl = user.role === 'ADMIN' ? '/admin' : user.role === 'TEACHER' ? '/teacher' : user.role === 'PRINCIPAL' ? '/principal' : '/student'; %>
        <a href="<%= homeUrl %>" class="flex items-center gap-3 px-4 py-3 rounded-xl bg-gradient-to-r from-indigo-500 to-purple-600 text-white font-semibold shadow-md transition-all hover:from-indigo-600 hover:to-purple-700">
          <svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/>
          </svg>
          <span>Beranda / Home</span>
        </a>

        <div class="pt-2 pb-1 px-1 text-xs font-bold text-slate-400 uppercase tracking-wider">Menu</div>

        <!-- ADMIN menu -->
        <% if (user.role === 'ADMIN') { %>
          <a href="/admin/users" class="flex items-center gap-3 px-4 py-2.5 rounded-xl hover:bg-indigo-50 text-slate-700 font-medium transition-all">
            <svg class="w-5 h-5 text-indigo-500 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"/></svg>
            <span>Kelola Pengguna</span>
          </a>
          <a href="/admin/exams" class="flex items-center gap-3 px-4 py-2.5 rounded-xl hover:bg-indigo-50 text-slate-700 font-medium transition-all">
            <svg class="w-5 h-5 text-purple-500 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
            <span>Kelola Ujian</span>
          </a>
          <a href="/admin/grades" class="flex items-center gap-3 px-4 py-2.5 rounded-xl hover:bg-indigo-50 text-slate-700 font-medium transition-all">
            <svg class="w-5 h-5 text-emerald-500 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/></svg>
            <span>Nilai</span>
          </a>
          <a href="/admin/classes" class="flex items-center gap-3 px-4 py-2.5 rounded-xl hover:bg-indigo-50 text-slate-700 font-medium transition-all">
            <svg class="w-5 h-5 text-amber-500 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/></svg>
            <span>Kelas</span>
          </a>
          <a href="/admin/materials" class="flex items-center gap-3 px-4 py-2.5 rounded-xl hover:bg-indigo-50 text-slate-700 font-medium transition-all">
            <svg class="w-5 h-5 text-teal-500 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/></svg>
            <span>Materi</span>
          </a>
          <a href="/admin/reports" class="flex items-center gap-3 px-4 py-2.5 rounded-xl hover:bg-indigo-50 text-slate-700 font-medium transition-all">
            <svg class="w-5 h-5 text-rose-500 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 17v-2m3 2v-4m3 4v-6m2 10H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
            <span>Laporan</span>
          </a>
        <% } %>

        <!-- TEACHER menu -->
        <% if (user.role === 'TEACHER') { %>
          <a href="/teacher/exams" class="flex items-center gap-3 px-4 py-2.5 rounded-xl hover:bg-indigo-50 text-slate-700 font-medium transition-all">
            <svg class="w-5 h-5 text-purple-500 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
            <span>Ujian Saya</span>
          </a>
          <a href="/teacher/grades" class="flex items-center gap-3 px-4 py-2.5 rounded-xl hover:bg-indigo-50 text-slate-700 font-medium transition-all">
            <svg class="w-5 h-5 text-emerald-500 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/></svg>
            <span>Nilai Siswa</span>
          </a>
          <a href="/teacher/materials" class="flex items-center gap-3 px-4 py-2.5 rounded-xl hover:bg-indigo-50 text-slate-700 font-medium transition-all">
            <svg class="w-5 h-5 text-teal-500 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/></svg>
            <span>Materi</span>
          </a>
          <a href="/teacher/assignments" class="flex items-center gap-3 px-4 py-2.5 rounded-xl hover:bg-indigo-50 text-slate-700 font-medium transition-all">
            <svg class="w-5 h-5 text-amber-500 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/></svg>
            <span>Tugas</span>
          </a>
          <a href="/teacher/live-classes" class="flex items-center gap-3 px-4 py-2.5 rounded-xl hover:bg-indigo-50 text-slate-700 font-medium transition-all">
            <svg class="w-5 h-5 text-rose-500 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 10l4.553-2.069A1 1 0 0121 8.868v6.264a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z"/></svg>
            <span>Live Class</span>
          </a>
          <a href="/teacher/agenda" class="flex items-center gap-3 px-4 py-2.5 rounded-xl hover:bg-indigo-50 text-slate-700 font-medium transition-all">
            <svg class="w-5 h-5 text-slate-500 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
            <span>Agenda</span>
          </a>
        <% } %>

        <!-- STUDENT menu -->
