<!-- Header Banner -->
<div class="relative rounded-2xl bg-gradient-to-r from-violet-600 via-purple-600 to-indigo-600 shadow-xl mb-6">
  <div class="absolute inset-0 opacity-10">
    <div class="absolute top-0 right-0 w-64 h-64 bg-white rounded-full -mr-32 -mt-32"></div>
    <div class="absolute bottom-0 left-0 w-48 h-48 bg-white rounded-full -ml-24 -mb-24"></div>
  </div>
  <div class="relative px-6 py-8">
    <div class="flex items-center justify-between flex-wrap gap-4">
      <div class="flex items-center gap-4">
        <div class="bg-white/20 backdrop-blur-sm rounded-2xl p-4">
          <svg class="w-10 h-10 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01"/>
          </svg>
        </div>
        <div>
          <h1 class="text-2xl font-bold text-white tracking-tight"><%= period.name %></h1>
          <p class="mt-1 text-purple-100">Semester <%= period.semester %> &bull; Tahun Pelajaran <%= period.school_year %> &bull;
            <% if (period.is_active) { %><span class="bg-green-400/30 text-green-100 px-2 py-0.5 rounded-full text-xs font-semibold">Aktif</span><% } else { %><span class="bg-white/20 text-white/80 px-2 py-0.5 rounded-full text-xs font-semibold">Tidak Aktif</span><% } %>
          </p>
        </div>
      </div>
      <div class="flex gap-3">
        <a href="/admin/raport" class="inline-flex items-center gap-2 px-4 py-2 bg-white/20 backdrop-blur-sm hover:bg-white/30 text-white font-semibold rounded-xl transition-all">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/></svg>
          Kembali
        </a>
        <!-- Dropdown cetak per kelas -->
        <div class="relative" id="cetakDropdown">
          <button id="cetakBtn" type="button"
            class="inline-flex items-center gap-2 px-4 py-2 bg-white text-violet-700 font-semibold rounded-xl hover:bg-violet-50 transition-all shadow-md">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z"/></svg>
            Cetak Raport
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
          </button>
          <!-- Dropdown Menu -->
          <div id="cetakMenu" class="hidden absolute right-0 top-full mt-2 w-64 bg-white rounded-xl shadow-xl border border-slate-100 z-20 py-2">
            <a href="/admin/raport/<%= period.id %>/print-all"
               class="flex items-center gap-2 px-4 py-2.5 text-sm text-slate-700 hover:bg-violet-50 hover:text-violet-700 transition-all">
              <svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
              Semua Kelas
            </a>
            <% if (printClasses && printClasses.length) { %>
              <div class="border-t border-slate-100 mt-1 pt-1">
                <p class="px-4 py-1 text-xs font-semibold text-slate-400 uppercase tracking-wider">Cetak per Kelas</p>
                <% printClasses.forEach(function(c) { %>
                  <a href="/admin/raport/<%= period.id %>/print-all?class_id=<%= c.id %>"
                     class="flex items-center gap-2 px-4 py-2.5 text-sm text-slate-700 hover:bg-violet-50 hover:text-violet-700 transition-all">
                    <svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-2 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/></svg>
                    Kelas <%= c.name %>
                  </a>
                <% }) %>
              </div>
            <% } %>
            <div class="border-t border-slate-100 mt-1 pt-1">
              <button onclick="document.getElementById('cetakMenu').classList.add('hidden'); document.getElementById('modalCariSiswa').classList.remove('hidden');"
                 class="w-full flex items-center gap-2 px-4 py-2.5 text-sm text-indigo-600 hover:bg-indigo-50 transition-all">
                <svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
                Cari &amp; Cetak per Siswa
              </button>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Flash Messages -->
<%- include('../partials/flash') %>

<!-- Tanggal Cetak Raport (admin) -->
<div class="bg-white rounded-2xl shadow-lg border border-slate-100 p-6 mb-6">
  <h3 class="text-base font-bold text-slate-800 mb-3 flex items-center gap-2">
    <span class="w-7 h-7 bg-violet-100 rounded-lg flex items-center justify-center">
      <svg class="w-4 h-4 text-violet-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
    </span>
    Tanggal Cetak Raport
  </h3>
  <p class="text-sm text-slate-600 mb-3">
    <% if (reportDateFormatted) { %>
      Tanggal saat ini: <span class="font-semibold text-slate-800"><%= reportDateFormatted %></span>
    <% } else { %>
      <span class="text-slate-400">Belum diatur &mdash; tanggal tidak akan tampil di cetak raport.</span>
    <% } %>
  </p>
  <form method="POST" action="/admin/raport/<%= period.id %>/report-settings" class="flex flex-col sm:flex-row sm:items-end gap-3">
    <div class="flex-1">
      <label for="report_city" class="block text-sm font-semibold text-slate-700 mb-1">Kota</label>
      <input type="text" id="report_city" name="report_city" value="<%= typeof reportCity !== 'undefined' ? reportCity : '' %>"
        placeholder="Contoh: Kediri"
        class="w-full px-3 py-2.5 border-2 border-slate-200 rounded-xl focus:ring-2 focus:ring-violet-500 focus:border-violet-500 transition-all text-sm">
    </div>
    <div class="flex-1">
      <label for="report_date" class="block text-sm font-semibold text-slate-700 mb-1">Tanggal</label>
      <input type="date" id="report_date" name="report_date" value="<%= reportDateValue %>"
        class="w-full px-3 py-2.5 border-2 border-slate-200 rounded-xl focus:ring-2 focus:ring-violet-500 focus:border-violet-500 transition-all text-sm">
    </div>
    <div class="flex-shrink-0">
      <span class="block text-sm mb-1 invisible">_</span>
      <button type="submit"
        class="px-5 py-2.5 bg-gradient-to-r from-violet-600 to-indigo-600 text-white font-semibold rounded-xl hover:from-violet-700 hover:to-indigo-700 transition-all shadow-md text-sm">
        Simpan
      </button>
    </div>
  </form>
  <p class="text-xs text-slate-400 mt-2">Kota &amp; tanggal tampil di atas tanda tangan pada cetak raport. Kosongkan tanggal untuk menyembunyikan baris tersebut.</p>
</div>

<!-- Ringkasan Kelas -->
<% if (printClasses && printClasses.length) { %>
<div class="bg-white rounded-2xl shadow-lg border border-slate-100 p-6 mb-6">
  <h3 class="text-base font-bold text-slate-800 mb-4 flex items-center gap-2">
    <span class="w-7 h-7 bg-indigo-100 rounded-lg flex items-center justify-center">
      <svg class="w-4 h-4 text-indigo-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/></svg>
    </span>
    Kelas Terdaftar di Periode Ini
  </h3>
  <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-3">
    <% printClasses.forEach(function(c) { %>
      <div class="border border-slate-200 rounded-xl p-3 hover:border-indigo-300 transition-all">
        <p class="text-sm font-bold text-slate-800 mb-2"><%= c.name %></p>
        <div class="flex gap-2 flex-wrap">
          <a href="/admin/raport/<%= period.id %>/print-all?class_id=<%= c.id %>"
             class="inline-flex items-center gap-1 px-2 py-1 bg-violet-100 text-violet-700 rounded-lg text-xs font-semibold hover:bg-violet-200 transition-all">
            <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z"/></svg>
            Cetak
          </a>
        </div>
      </div>
    <% }) %>
  </div>
</div>
<% } %>

<div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
  <!-- Kolom Kiri: Tambah Grup -->
  <div class="lg:col-span-1">
    <div class="bg-white rounded-2xl shadow-lg border border-slate-100 p-6 sticky top-20">
      <h3 class="text-lg font-bold text-slate-800 mb-4 flex items-center gap-2">
        <span class="w-8 h-8 bg-violet-100 rounded-lg flex items-center justify-center">
          <svg class="w-4 h-4 text-violet-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
        </span>
        Tambah Grup
      </h3>
      <form method="POST" action="/admin/raport/<%= period.id %>/groups" class="space-y-3">
        <div>
          <label class="block text-sm font-semibold text-slate-700 mb-1">Nama Grup <span class="text-red-500">*</span></label>
          <input type="text" name="name" required placeholder="Contoh: A. Muatan Nasional"
            class="w-full px-3 py-2.5 border-2 border-slate-200 rounded-xl focus:ring-2 focus:ring-violet-500 focus:border-violet-500 transition-all text-sm">
        </div>
        <div>
          <label class="block text-sm font-semibold text-slate-700 mb-1">Urutan</label>
          <input type="number" name="sort_order" value="0" min="0"
            class="w-full px-3 py-2.5 border-2 border-slate-200 rounded-xl focus:ring-2 focus:ring-violet-500 focus:border-violet-500 transition-all text-sm">
        </div>
        <button type="submit"
          class="w-full px-4 py-2.5 bg-gradient-to-r from-violet-600 to-indigo-600 text-white font-semibold rounded-xl hover:from-violet-700 hover:to-indigo-700 transition-all shadow-md text-sm">
          Tambah Grup
        </button>
      </form>
    </div>
  </div>

  <!-- Kolom Kanan: Daftar Grup -->
  <div class="lg:col-span-2 space-y-4">
    <% if (!groups.length) { %>
      <div class="bg-white rounded-2xl shadow-lg border border-slate-100 p-12 text-center text-slate-500">
        <svg class="w-16 h-16 mx-auto mb-4 text-slate-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"/>
        </svg>
        <p class="font-medium">Belum ada grup mata pelajaran</p>
        <p class="text-sm mt-1">Tambahkan grup di panel kiri untuk mulai mengatur mapel</p>
      </div>
    <% } else { %>
      <% groups.forEach(g => { %>
        <div class="bg-white rounded-2xl shadow-lg border border-slate-100 overflow-hidden">
          <!-- Grup Header -->
          <div class="px-6 py-4 bg-gradient-to-r from-violet-50 to-indigo-50 border-b border-violet-100 flex items-center justify-between">
            <div>
              <h4 class="font-bold text-slate-800"><%= g.name %></h4>
              <p class="text-xs text-slate-500 mt-0.5">Urutan: <%= g.sort_order %> &bull; <%= g.subjects.length %> mata pelajaran</p>
            </div>
            <div class="flex gap-2">
              <button onclick="editGrup(<%= g.id %>, '<%= g.name.replace(/'/g, "\\'") %>', <%= g.sort_order %>)"
                class="p-1.5 text-amber-500 hover:text-amber-700 hover:bg-amber-50 rounded-lg transition-all" title="Edit grup">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/></svg>
              </button>
              <form method="POST" action="/admin/raport/groups/<%= g.id %>/delete" class="inline"
                onsubmit="return confirm('Hapus grup ini beserta semua mapel dan nilai di dalamnya?')">
                <button type="submit" class="p-1.5 text-red-400 hover:text-red-600 hover:bg-red-50 rounded-lg transition-all" title="Hapus grup">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
                </button>
              </form>
            </div>
          </div>

          <!-- Daftar Mapel -->
          <div class="p-4">
            <% if (g.subjects.length) { %>
              <div class="space-y-2 mb-4">
                <% g.subjects.forEach((s, idx) => { %>
                  <div class="flex items-start justify-between p-3 bg-slate-50 rounded-xl border border-slate-100" id="subject-row-<%= s.id %>">
                    <div class="flex-1">
                      <div class="flex items-center gap-3 mb-2">
                        <span class="w-6 h-6 bg-indigo-100 text-indigo-700 rounded-full text-xs font-bold flex items-center justify-center flex-shrink-0"><%= idx + 1 %></span>
                        <p class="text-sm font-semibold text-slate-800"><%= s.name %></p>
                        <span class="text-xs text-slate-400">Guru default: <%= s.teacher_name || 'belum diset' %></span>
                      </div>

                      <%# Daftar kelas terdaftar %>
                      <div class="ml-9 space-y-1" id="classes-list-<%= s.id %>">
                        <% if (!s.classes || !s.classes.length) { %>
                          <p class="text-xs text-amber-600 italic">Belum ada kelas — tambahkan kelas agar guru bisa mengisi nilai</p>
                        <% } %>
                        <% (s.classes || []).forEach(sc => { %>
                          <div class="flex items-center gap-2 text-xs" id="sc-row-<%= sc.sc_id %>">
                            <span class="px-2 py-0.5 bg-indigo-100 text-indigo-700 rounded-full font-medium"><%= sc.class_name %></span>
                            <span class="text-slate-500"><%= sc.teacher_name || s.teacher_name || 'Guru default' %></span>
                            <button onclick="hapusSubjectClass(<%= sc.sc_id %>)"
                              class="ml-auto p-1 text-red-400 hover:text-red-600 rounded transition-all" title="Hapus kelas ini">
                              <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
                              </svg>
                            </button>
                          </div>
                        <% }) %>
                      </div>

                      <%# Tombol +Tambah Kelas %>
                      <div class="ml-9 mt-2">
                        <details class="group">
                          <summary class="cursor-pointer inline-flex items-center gap-1 text-xs font-semibold text-green-600 hover:text-green-800 list-none">
                            <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
                            +Tambah Kelas
                          </summary>
                          <form data-ajax-add-class data-subject-id="<%= s.id %>"
                            class="mt-2 p-3 bg-green-50 rounded-lg border border-green-100 flex flex-wrap gap-2 items-end">
                            <div>
                              <label class="block text-xs font-semibold text-slate-700 mb-1">Kelas <span class="text-red-500">*</span></label>
                              <select name="class_id" required
                                class="px-2 py-1.5 border-2 border-slate-200 rounded-lg focus:ring-2 focus:ring-green-500 focus:border-green-500 text-xs bg-white min-w-[140px]">
                                <option value="">-- Pilih Kelas --</option>
                                <% classes.forEach(c => { %>
                                  <option value="<%= c.id %>"><%= c.name %></option>
                                <% }) %>
                              </select>
                            </div>
                            <div>
                              <label class="block text-xs font-semibold text-slate-700 mb-1">Guru Pengampu</label>
                              <select name="teacher_id"
                                class="px-2 py-1.5 border-2 border-slate-200 rounded-lg focus:ring-2 focus:ring-green-500 focus:border-green-500 text-xs bg-white min-w-[160px]">
                                <option value="">-- Guru Default --</option>
                                <% teachers.forEach(t => { %>
                                  <option value="<%= t.id %>"><%= t.full_name %></option>
                                <% }) %>
                              </select>
                            </div>
                            <button type="submit"
                              class="px-3 py-1.5 bg-green-600 text-white font-semibold rounded-lg hover:bg-green-700 text-xs shadow">
                              Tambah
                            </button>
                          </form>
                        </details>
                      </div>
                    </div>

                    <%# Tombol edit/hapus mapel %>
                    <div class="flex gap-1 self-start ml-2">
                      <button onclick="editMapel(<%= s.id %>, '<%= s.name.replace(/'/g, "\\'") %>', <%= s.sort_order %>)"
                        class="p-1.5 text-amber-500 hover:text-amber-700 hover:bg-amber-50 rounded-lg transition-all" title="Edit mapel">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/></svg>
                      </button>
                      <button onclick="hapusMapel(<%= s.id %>)"
                        class="p-1.5 text-red-400 hover:text-red-600 hover:bg-red-50 rounded-lg transition-all" title="Hapus mapel">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
                      </button>
                    </div>
                  </div>
                <% }) %>
              </div>
            <% } else { %>
              <p class="text-sm text-slate-400 italic mb-4">Belum ada mata pelajaran di grup ini.</p>
            <% } %>

            <!-- Form Tambah Mapel -->
            <details class="group">
              <summary class="cursor-pointer flex items-center gap-2 text-sm font-semibold text-indigo-600 hover:text-indigo-800 transition-all list-none">
                <svg class="w-4 h-4 group-open:rotate-90 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
                Tambah Mata Pelajaran
              </summary>
              <form method="POST" action="/admin/raport/groups/<%= g.id %>/subjects" class="mt-3 p-4 bg-indigo-50 rounded-xl space-y-3 border border-indigo-100">
                <div>
                  <label class="block text-xs font-semibold text-slate-700 mb-1">Nama Mata Pelajaran <span class="text-red-500">*</span></label>
                  <input type="text" name="subject_name" required placeholder="Contoh: Matematika"
                    class="w-full px-3 py-2 border-2 border-slate-200 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-all text-sm bg-white">
                </div>
                <div class="grid grid-cols-2 gap-3">
                  <div>
                    <label class="block text-xs font-semibold text-slate-700 mb-1">Urutan</label>
                    <input type="number" name="sort_order" value="0" min="0"
                      class="w-full px-3 py-2 border-2 border-slate-200 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-all text-sm bg-white">
                  </div>
                  <div>
                    <label class="block text-xs font-semibold text-slate-700 mb-1">Guru Pengampu</label>
                    <select name="teacher_id"
                      class="w-full px-3 py-2 border-2 border-slate-200 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-all text-sm bg-white">
                      <option value="">-- Pilih Guru --</option>
                      <% teachers.forEach(t => { %>
                        <option value="<%= t.id %>"><%= t.full_name %></option>
                      <% }) %>
                    </select>
                  </div>
                </div>
                <div>
                  <label class="block text-xs font-semibold text-slate-700 mb-1">Kelas <span class="text-slate-400">(kosongkan = semua kelas)</span></label>
                  <select name="class_id"
                    class="w-full px-3 py-2 border-2 border-slate-200 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-all text-sm bg-white">
                    <option value="">-- Semua Kelas --</option>
                    <% classes.forEach(c => { %>
                      <option value="<%= c.id %>"><%= c.name %></option>
                    <% }) %>
                  </select>
                </div>
                <button type="submit"
                  class="w-full px-4 py-2 bg-indigo-600 text-white font-semibold rounded-lg hover:bg-indigo-700 transition-all text-sm shadow">
                  Simpan Mata Pelajaran
                </button>
              </form>
            </details>
          </div>
        </div>
      <% }) %>
    <% } %>
  </div>
</div>

<script>
// AJAX: Tambah kelas ke mapel tanpa reload halaman
document.addEventListener('submit', async function(e) {
  const form = e.target.closest('[data-ajax-add-class]');
  if (!form) return;
  e.preventDefault();
  const sid = form.dataset.subjectId;
  const classId = form.querySelector('[name=class_id]').value;
  const teacherId = form.querySelector('[name=teacher_id]').value;
  if (!classId) { alert('Pilih kelas terlebih dahulu.'); return; }

  const btn = form.querySelector('button[type=submit]');
  const origText = btn.textContent;
  btn.disabled = true; btn.textContent = '...';

  try {
    const body = new URLSearchParams({ class_id: classId, teacher_id: teacherId });
    const resp = await fetch(`/admin/raport/subjects/${sid}/classes`, {
      method: 'POST',
      headers: { 'X-Requested-With': 'XMLHttpRequest', 'Content-Type': 'application/x-www-form-urlencoded' },
      body: body.toString()
    });
    const data = await resp.json();
    if (!data.ok) { alert('Gagal: ' + data.message); btn.disabled = false; btn.textContent = origText; return; }

    // Cari container list kelas berdasarkan id yang sudah ada di DOM
    const classList = document.getElementById('classes-list-' + sid);
    if (classList) {
      // Hapus pesan "Belum ada kelas" jika ada
      const emptyMsg = classList.querySelector('p.text-amber-600');
      if (emptyMsg) emptyMsg.remove();

      // Buat row kelas baru persis seperti yang dirender server
      const row = document.createElement('div');
      row.className = 'flex items-center gap-2 text-xs';
      row.id = 'sc-row-' + data.scId;
      row.innerHTML =
        `<span class="px-2 py-0.5 bg-indigo-100 text-indigo-700 rounded-full font-medium">${data.className}</span>`
        + `<span class="text-slate-500">${data.teacherName || 'Guru default'}</span>`
        + `<button onclick="hapusSubjectClass(${data.scId})"
            class="ml-auto p-1 text-red-400 hover:text-red-600 rounded transition-all" title="Hapus kelas ini">
            <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
            </svg>
          </button>`;
      classList.appendChild(row);
    }

    // Reset form dan tutup details
    form.querySelector('[name=class_id]').value = '';
    form.querySelector('[name=teacher_id]').value = '';
    form.closest('details').removeAttribute('open');

    showToast('Kelas berhasil ditambahkan.');
  } catch(err) {
    alert('Terjadi kesalahan. Coba lagi.');
  }
  btn.disabled = false; btn.textContent = origText;
});

function showToast(msg) {
  let t = document.getElementById('ajaxToast');
  if (!t) {
    t = document.createElement('div');
    t.id = 'ajaxToast';
    t.style.cssText = 'position:fixed;bottom:24px;right:24px;background:#16a34a;color:white;padding:10px 18px;border-radius:10px;font-size:13px;font-weight:600;z-index:9999;box-shadow:0 4px 12px rgba(0,0,0,.15);transition:opacity .3s';
    document.body.appendChild(t);
  }
  t.textContent = msg; t.style.opacity = '1';
  clearTimeout(t._hide);
  t._hide = setTimeout(() => { t.style.opacity = '0'; }, 2500);
}

async function hapusMapel(subjectId) {
  if (!confirm('Hapus mata pelajaran ini? Semua nilai terkait juga akan dihapus.')) return;
  try {
    const resp = await fetch(`/admin/raport/subjects/${subjectId}`, { method: 'DELETE' });
    const data = await resp.json();
    if (data.ok) {
      const row = document.getElementById(`subject-row-${subjectId}`);
      if (row) row.remove();
    } else {
      alert('Gagal menghapus: ' + (data.message || 'Terjadi kesalahan.'));
    }
  } catch (e) {
    alert('Gagal menghapus mata pelajaran.');
  }
}

async function hapusSubjectClass(scId) {
  if (!confirm('Hapus kelas ini dari mata pelajaran?')) return;
  try {
    const resp = await fetch(`/admin/raport/subject-classes/${scId}`, { method: 'DELETE' });
    const data = await resp.json();
    if (data.ok) {
      const row = document.getElementById(`sc-row-${scId}`);
      if (row) row.remove();
    } else {
      alert('Gagal: ' + (data.message || 'Terjadi kesalahan.'));
    }
  } catch (e) {
    alert('Gagal menghapus kelas.');
  }
}

// Edit Mapel — hanya nama dan urutan, guru/kelas dikelola via +Tambah Kelas
function editMapel(id, name, sortOrder) {
  document.getElementById('editMapelName').value = name;
  document.getElementById('editMapelSortOrder').value = sortOrder;
  document.getElementById('formEditMapel').action = '/admin/raport/subjects/' + id + '/edit';
  document.getElementById('modalEditMapel').classList.remove('hidden');
}

// Edit Grup
function editGrup(id, name, sortOrder) {
  document.getElementById('editGrupName').value = name;
  document.getElementById('editGrupSortOrder').value = sortOrder;
  document.getElementById('formEditGrup').action = '/admin/raport/groups/' + id + '/edit';
  document.getElementById('modalEditGrup').classList.remove('hidden');
}
</script>

