<script>
// Toggle dropdown cetak
document.addEventListener('DOMContentLoaded', function() {
  const btn = document.getElementById('cetakBtn');
  const menu = document.getElementById('cetakMenu');
  if (btn && menu) {
    btn.addEventListener('click', function(e) {
      e.stopPropagation();
      menu.classList.toggle('hidden');
    });
    document.addEventListener('click', function() {
      menu.classList.add('hidden');
    });
  }

  // Modal cari siswa
  const inputCari = document.getElementById('inputCariSiswa');
  const hasilCari = document.getElementById('hasilCariSiswa');
  const periodId = '<%= period.id %>';
  let debounceTimer;

  if (inputCari) {
    inputCari.addEventListener('input', function() {
      clearTimeout(debounceTimer);
      const q = inputCari.value.trim();
      if (q.length < 1) {
        hasilCari.innerHTML = '<p class="text-sm text-slate-400 text-center py-4">Mulai ketik untuk mencari siswa...</p>';
        return;
      }
      debounceTimer = setTimeout(async function() {
        hasilCari.innerHTML = '<p class="text-sm text-slate-400 text-center py-4">Mencari...</p>';
        try {
          const res = await fetch('/admin/raport/' + periodId + '/students?q=' + encodeURIComponent(q));
          const data = await res.json();
          if (!data.length) {
            hasilCari.innerHTML = '<p class="text-sm text-slate-400 text-center py-4">Tidak ada siswa ditemukan.</p>';
            return;
          }
          hasilCari.innerHTML = data.map(function(s) {
            return '<div class="flex items-center justify-between p-2.5 rounded-xl hover:bg-slate-50 border border-transparent hover:border-slate-200 transition-all">'
              + '<div>'
              + '<p class="text-sm font-semibold text-slate-800">' + s.full_name + '</p>'
              + '<p class="text-xs text-slate-500">' + s.username + ' &bull; ' + (s.class_name || '-') + '</p>'
              + '</div>'
              + '<a href="/admin/raport/' + periodId + '/print/' + s.id + '" target="_blank"'
              + ' class="px-3 py-1.5 bg-violet-600 text-white text-xs font-semibold rounded-lg hover:bg-violet-700 transition-all">'
              + 'Cetak</a>'
              + '</div>';
          }).join('');
        } catch(e) {
          hasilCari.innerHTML = '<p class="text-sm text-red-500 text-center py-4">Gagal mengambil data.</p>';
        }
      }, 300);
    });
  }
});
</script>
