<!-- Header Banner -->
<div class="relative overflow-hidden rounded-2xl bg-gradient-to-r from-violet-600 via-purple-600 to-indigo-600 shadow-xl mb-6">
  <div class="absolute inset-0 opacity-10">
    <div class="absolute top-0 right-0 w-64 h-64 bg-white rounded-full -mr-32 -mt-32"></div>
    <div class="absolute bottom-0 left-0 w-48 h-48 bg-white rounded-full -ml-24 -mb-24"></div>
  </div>
  <div class="relative px-6 py-8">
    <div class="flex items-center justify-between flex-wrap gap-4">
      <div class="flex items-center gap-4">
        <div class="bg-white/20 backdrop-blur-sm rounded-2xl p-4">
          <svg class="w-10 h-10 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01"/>
          </svg>
        </div>
        <div>
          <h1 class="text-3xl font-bold text-white tracking-tight">Laporan Tengah Semester</h1>
          <p class="mt-1 text-purple-100">Kelola periode raport dan struktur mata pelajaran</p>
        </div>
      </div>
      <div class="flex gap-3">
        <a href="/admin" class="inline-flex items-center gap-2 px-4 py-2 bg-white/20 backdrop-blur-sm hover:bg-white/30 text-white font-semibold rounded-xl transition-all">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/></svg>
          Kembali
        </a>
        <button onclick="document.getElementById('modalBuatPeriode').classList.remove('hidden')"
          class="inline-flex items-center gap-2 px-4 py-2 bg-white text-violet-700 font-semibold rounded-xl hover:bg-violet-50 transition-all shadow-md">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
          Buat Periode Baru
        </button>
      </div>
    </div>
  </div>
</div>

<!-- Flash Messages -->
<%- include('../partials/flash') %>

<!-- Tabel Daftar Periode -->
<div class="bg-white rounded-2xl shadow-lg border border-slate-100 overflow-hidden">
  <div class="px-6 py-4 border-b border-slate-100 flex items-center justify-between">
    <h2 class="text-lg font-bold text-slate-800">Daftar Periode Raport</h2>
    <span class="text-sm text-slate-500"><%= periods.length %> periode</span>
  </div>

  <% if (!periods.length) { %>
    <div class="p-12 text-center text-slate-500">
      <svg class="w-16 h-16 mx-auto mb-4 text-slate-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/>
      </svg>
      <p class="text-lg font-medium">Belum ada periode raport</p>
      <p class="text-sm mt-1">Klik "Buat Periode Baru" untuk memulai</p>
    </div>
  <% } else { %>
    <div class="overflow-x-auto">
      <table class="w-full">
        <thead>
          <tr class="bg-slate-50 text-left text-xs font-semibold text-slate-500 uppercase tracking-wider">
            <th class="px-6 py-3">Nama Periode</th>
            <th class="px-6 py-3">Semester</th>
            <th class="px-6 py-3">Tahun Pelajaran</th>
            <th class="px-6 py-3">Grup / Mapel</th>
            <th class="px-6 py-3">Status</th>
            <th class="px-6 py-3 text-right">Aksi</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100">
          <% periods.forEach(p => { %>
            <tr class="hover:bg-slate-50 transition-colors">
              <td class="px-6 py-4 font-semibold text-slate-800"><%= p.name %></td>
              <td class="px-6 py-4 text-slate-600"><%= p.semester %></td>
              <td class="px-6 py-4 text-slate-600"><%= p.school_year %></td>
              <td class="px-6 py-4 text-slate-500 text-sm">
                <span class="inline-flex items-center gap-1">
                  <span class="font-medium text-violet-700"><%= p.group_count %></span> grup,
                  <span class="font-medium text-indigo-700"><%= p.subject_count %></span> mapel
                </span>
              </td>
              <td class="px-6 py-4">
                <% if (p.is_active) { %>
                  <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-xs font-semibold bg-green-100 text-green-700">
                    <span class="w-1.5 h-1.5 bg-green-500 rounded-full"></span> Aktif
                  </span>
                <% } else { %>
                  <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-xs font-semibold bg-slate-100 text-slate-500">
                    <span class="w-1.5 h-1.5 bg-slate-400 rounded-full"></span> Tidak Aktif
                  </span>
                <% } %>
              </td>
              <td class="px-6 py-4">
                <div class="flex items-center justify-end gap-2">
                  <a href="/admin/raport/<%= p.id %>"
                    class="inline-flex items-center gap-1 px-3 py-1.5 text-sm font-medium text-indigo-700 bg-indigo-50 hover:bg-indigo-100 rounded-lg transition-all">
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/></svg>
                    Detail
                  </a>
                  <button onclick="editPeriode(<%= p.id %>, '<%= p.name.replace(/'/g, "\\'") %>', '<%= p.semester %>', '<%= p.school_year %>')"
                    class="inline-flex items-center gap-1 px-3 py-1.5 text-sm font-medium text-amber-700 bg-amber-50 hover:bg-amber-100 rounded-lg transition-all">
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/></svg>
                    Edit
                  </button>
                  <form method="POST" action="/admin/raport/<%= p.id %>/delete" class="inline"
                    onsubmit="return confirm('Hapus periode ini beserta semua grup, mapel, dan nilai? Tindakan tidak bisa dibatalkan.')">
                    <button type="submit"
                      class="inline-flex items-center gap-1 px-3 py-1.5 text-sm font-medium text-red-700 bg-red-50 hover:bg-red-100 rounded-lg transition-all">
                      <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
                      Hapus
                    </button>
                  </form>
                  <% if (!p.is_active) { %>
                    <form method="POST" action="/admin/raport/<%= p.id %>/activate" class="inline">
                      <button type="submit"
                        class="inline-flex items-center gap-1 px-3 py-1.5 text-sm font-medium text-green-700 bg-green-50 hover:bg-green-100 rounded-lg transition-all">
                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                        Aktifkan
                      </button>
                    </form>
                  <% } %>
                </div>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% } %>
</div>

<!-- Modal Buat Periode Baru -->
<div id="modalBuatPeriode" class="hidden fixed inset-0 bg-black/50 z-50 flex items-center justify-center p-4">
  <div class="bg-white rounded-2xl shadow-2xl w-full max-w-md">
    <div class="flex items-center justify-between px-6 py-4 border-b border-slate-100">
      <h3 class="text-lg font-bold text-slate-800">Buat Periode Raport Baru</h3>
      <button onclick="document.getElementById('modalBuatPeriode').classList.add('hidden')"
        class="p-2 hover:bg-slate-100 rounded-lg transition-all text-slate-500">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
      </button>
    </div>
    <form method="POST" action="/admin/raport" class="px-6 py-4 space-y-4">
      <div>
        <label class="block text-sm font-semibold text-slate-700 mb-1.5">Nama Periode <span class="text-red-500">*</span></label>
        <input type="text" name="name" required placeholder="Contoh: Raport Tengah Semester 1 2024/2025"
          class="w-full px-4 py-2.5 border-2 border-slate-200 rounded-xl focus:ring-2 focus:ring-violet-500 focus:border-violet-500 transition-all">
      </div>
      <div>
        <label class="block text-sm font-semibold text-slate-700 mb-1.5">Semester <span class="text-red-500">*</span></label>
        <select name="semester" required
          class="w-full px-4 py-2.5 border-2 border-slate-200 rounded-xl focus:ring-2 focus:ring-violet-500 focus:border-violet-500 transition-all">
          <option value="">-- Pilih Semester --</option>
          <option value="Ganjil">Ganjil</option>
          <option value="Genap">Genap</option>
        </select>
      </div>
      <div>
        <label class="block text-sm font-semibold text-slate-700 mb-1.5">Tahun Pelajaran <span class="text-red-500">*</span></label>
        <input type="text" name="school_year" required placeholder="Contoh: 2024/2025"
          class="w-full px-4 py-2.5 border-2 border-slate-200 rounded-xl focus:ring-2 focus:ring-violet-500 focus:border-violet-500 transition-all">
      </div>
      <div class="flex gap-3 pt-2">
        <button type="button" onclick="document.getElementById('modalBuatPeriode').classList.add('hidden')"
          class="flex-1 px-4 py-2.5 border-2 border-slate-200 text-slate-700 font-semibold rounded-xl hover:bg-slate-50 transition-all">
          Batal
        </button>
        <button type="submit"
          class="flex-1 px-4 py-2.5 bg-gradient-to-r from-violet-600 to-indigo-600 text-white font-semibold rounded-xl hover:from-violet-700 hover:to-indigo-700 transition-all shadow-md">
          Buat Periode
        </button>
      </div>
    </form>
  </div>
</div>

<!-- Modal Edit Periode -->
<div id="modalEditPeriode" class="hidden fixed inset-0 bg-black/50 z-50 flex items-center justify-center p-4">
  <div class="bg-white rounded-2xl shadow-2xl w-full max-w-md">
    <div class="flex items-center justify-between px-6 py-4 border-b border-slate-100">
      <h3 class="text-lg font-bold text-slate-800">Edit Periode Raport</h3>
      <button onclick="document.getElementById('modalEditPeriode').classList.add('hidden')"
        class="p-2 hover:bg-slate-100 rounded-lg transition-all text-slate-500">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
      </button>
    </div>
    <form id="formEditPeriode" method="POST" action="" class="px-6 py-4 space-y-4">
      <div>
        <label class="block text-sm font-semibold text-slate-700 mb-1.5">Nama Periode <span class="text-red-500">*</span></label>
        <input type="text" id="editPeriodeName" name="name" required
          class="w-full px-4 py-2.5 border-2 border-slate-200 rounded-xl focus:ring-2 focus:ring-violet-500 focus:border-violet-500 transition-all">
      </div>
      <div>
        <label class="block text-sm font-semibold text-slate-700 mb-1.5">Semester <span class="text-red-500">*</span></label>
        <select id="editPeriodeSemester" name="semester" required
          class="w-full px-4 py-2.5 border-2 border-slate-200 rounded-xl focus:ring-2 focus:ring-violet-500 focus:border-violet-500 transition-all">
          <option value="Ganjil">Ganjil</option>
          <option value="Genap">Genap</option>
        </select>
      </div>
      <div>
        <label class="block text-sm font-semibold text-slate-700 mb-1.5">Tahun Pelajaran <span class="text-red-500">*</span></label>
        <input type="text" id="editPeriodeSchoolYear" name="school_year" required
          class="w-full px-4 py-2.5 border-2 border-slate-200 rounded-xl focus:ring-2 focus:ring-violet-500 focus:border-violet-500 transition-all">
      </div>
      <div class="flex gap-3 pt-2">
        <button type="button" onclick="document.getElementById('modalEditPeriode').classList.add('hidden')"
          class="flex-1 px-4 py-2.5 border-2 border-slate-200 text-slate-700 font-semibold rounded-xl hover:bg-slate-50 transition-all">Batal</button>
        <button type="submit"
          class="flex-1 px-4 py-2.5 bg-gradient-to-r from-amber-500 to-orange-500 text-white font-semibold rounded-xl hover:from-amber-600 hover:to-orange-600 transition-all shadow-md">Simpan</button>
      </div>
    </form>
  </div>
</div>

<script>
function editPeriode(id, name, semester, school_year) {
  document.getElementById('editPeriodeName').value = name;
  document.getElementById('editPeriodeSemester').value = semester;
  document.getElementById('editPeriodeSchoolYear').value = school_year;
  document.getElementById('formEditPeriode').action = '/admin/raport/' + id + '/edit';
  document.getElementById('modalEditPeriode').classList.remove('hidden');
}
</script>
