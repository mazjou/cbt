<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <title><%= title %></title>
  <style>
    *{margin:0;padding:0;box-sizing:border-box;}
    body{font-family:Arial,sans-serif;background:#d1d5db;}

    .no-print{background:white;padding:12px 20px;display:flex;align-items:center;
      justify-content:space-between;flex-wrap:wrap;gap:10px;
      box-shadow:0 2px 8px rgba(0,0,0,.12);margin-bottom:16px;}
    .no-print h2{font-size:15px;font-weight:700;color:#1e293b;}
    .ctrl{display:flex;gap:8px;}
    .btn{padding:8px 18px;border-radius:8px;font-weight:700;font-size:13px;
      cursor:pointer;border:none;text-decoration:none;display:inline-flex;align-items:center;gap:6px;}
    .btn-print{background:#4f46e5;color:white;}
    .btn-back{background:#f1f5f9;color:#475569;}

    /* ── Halaman A4 — 4 kartu (2×2) ────────────────────────────────────
       Kartu B3 dalam = 105×80mm
       A4 padding 10mm → area 190×277mm
       2 kolom: 80×2 + gap10 = 170mm < 190mm ✓
       2 baris: 105×2 + gap10 = 220mm < 277mm ✓
    ──────────────────────────────────────────────────────────────────── */
    .page{
      width:210mm;height:297mm;
      margin:0 auto 16px;
      background:#d1d5db;
      padding:10mm;
      display:grid;
      grid-template-columns:80mm 80mm;
      grid-template-rows:105mm 105mm;
      gap:10mm;
      justify-content:center;
      overflow:hidden;
    }

    /* ── Kartu — ukuran FIXED 80×105mm ─────────────────────────────── */
    .kartu{
      width:80mm;
      height:105mm;
      border-radius:5mm;
      overflow:hidden;
      display:flex;
      flex-direction:column;
      background:#2563eb;
      box-shadow:0 3px 12px rgba(0,0,0,.3);
    }

    /* Header biru: 35mm fixed */
    .k-header{
      height:35mm;
      flex-shrink:0;
      background:linear-gradient(160deg,#1d4ed8 0%,#2563eb 60%,#3b82f6 100%);
      display:flex;flex-direction:column;
      align-items:center;justify-content:center;
      padding:0 4mm;
      text-align:center;
      gap:1.5mm;
    }
    .k-hole{width:8mm;height:3mm;background:rgba(255,255,255,.3);
      border-radius:2mm;margin-bottom:1mm;}
    .k-judul{font-size:13pt;font-weight:900;text-transform:uppercase;
      color:white;letter-spacing:.5px;line-height:1.2;}
    .k-kota{font-size:6pt;font-weight:700;text-transform:uppercase;
      color:#bfdbfe;letter-spacing:.3px;}
    .k-tapel{font-size:6.5pt;color:#93c5fd;}

    /* Badge jabatan: 10mm fixed */
    .k-badge{
      height:10mm;
      flex-shrink:0;
      margin:0 4mm;
      background:#111;
      border-radius:2mm;
      display:flex;align-items:center;justify-content:center;
      font-size:11pt;font-weight:900;text-transform:uppercase;
      color:white;letter-spacing:2px;
    }

    /* Body putih: sisa tinggi = 105-35-10-2(gap atas)-2(gap bawah)-14(footer) = 42mm */
    .k-body{
      flex:1;
      background:white;
      margin:2mm 4mm 0;
      border-radius:2mm 2mm 0 0;
      display:flex;flex-direction:column;
      align-items:center;
      padding:3mm 4mm 2mm;
      gap:2mm;
      overflow:hidden;
    }

    /* Foto: 22×27mm */
    .k-foto{
      width:22mm;height:27mm;flex-shrink:0;
      border:1.5px solid #374151;
      background:#f1f5f9;
      display:flex;align-items:center;justify-content:center;
      overflow:hidden;
    }
    .k-foto img{width:100%;height:100%;object-fit:cover;}
    .k-foto-ph{display:flex;flex-direction:column;align-items:center;gap:.8mm;}
    .k-foto-ph svg{width:10mm;height:10mm;opacity:.35;}
    .k-foto-ph span{font-size:4pt;color:#94a3b8;font-weight:700;text-transform:uppercase;}

    /* Nama */
    .k-nama{
      font-size:8pt;font-weight:900;color:#1e293b;
      text-align:center;line-height:1.3;
      border-bottom:1px solid #374151;
      width:100%;padding-bottom:1mm;
    }

    /* NIP */
    .k-nip-wrap{width:100%;}
    .k-nip-label{font-size:5.5pt;font-weight:700;color:#374151;}
    .k-nip{font-size:6pt;font-family:'Courier New',monospace;color:#374151;
      border-bottom:1px solid #9ca3af;display:block;margin-top:.5mm;padding-bottom:.5mm;}

    /* Ruang opsional */
    .k-ruang-wrap{width:100%;display:flex;align-items:baseline;gap:2mm;}
    .k-ruang-label{font-size:5.5pt;font-weight:700;color:#374151;white-space:nowrap;}
    .k-ruang-val{font-size:7pt;font-weight:900;color:#1d4ed8;
      border-bottom:1px solid #9ca3af;flex:1;text-align:center;}

    /* Footer biru: 14mm fixed */
    .k-footer{
      height:14mm;
      flex-shrink:0;
      background:linear-gradient(90deg,#1d4ed8,#2563eb);
      margin:0 4mm;
      border-radius:0 0 2mm 2mm;
      display:flex;flex-direction:column;
      align-items:center;justify-content:center;
      gap:1mm;
    }
    .k-footer-name{font-size:7pt;font-weight:900;text-transform:uppercase;
      color:white;letter-spacing:.5px;text-align:center;}
    .k-footer-sub{font-size:5pt;color:#bfdbfe;text-align:center;}

    /* ── Print ──────────────────────────────────────────────────────── */
    @media print{
      body{background:white;}
      .no-print{display:none!important;}
      .page{
        margin:0;width:210mm;height:297mm;
        padding:10mm;background:white;
        page-break-after:always;overflow:hidden;
      }
      .page:last-child{page-break-after:auto;}
      .kartu{box-shadow:none;}
      @page{size:A4 portrait;margin:0;}
    }
  </style>
</head>
<body>

<div class="no-print">
  <div>
    <h2>🎫 Cetak ID Card Panitia Ujian</h2>
    <small style="color:#64748b"><%= panitia.length %> panitia &nbsp;·&nbsp; ID Card B3 (80×105mm) &nbsp;·&nbsp; 4 kartu/halaman</small>
  </div>
  <div class="ctrl">
    <button onclick="window.print()" class="btn btn-print">🖨️ Cetak / Save PDF</button>
    <a href="/admin/panitia" class="btn btn-back">← Kembali</a>
  </div>
</div>

<%
  var y   = new Date().getFullYear();
  var ta  = new Date().getMonth() >= 6 ? (y+'/'+(y+1)) : ((y-1)+'/'+y);
  var schoolName = schoolInfo.name || 'SMK Negeri 1 Kras';
  var schoolAddr = schoolInfo.address || 'Kediri, Jawa Timur';
  var PH = 4;
%>

<% for(var p = 0; p < panitia.length; p += PH){ %>
<div class="page">
  <% for(var j = p; j < Math.min(p+PH, panitia.length); j++){
       var pn  = panitia[j];
       var foto = pn.profile_photo && pn.profile_photo.startsWith('/public/') ? pn.profile_photo : null;
  %>
  <div class="kartu">

    <!-- Header 35mm -->
    <div class="k-header">
      <div class="k-hole"></div>
      <div class="k-judul"><%=schoolName%></div>
      <div class="k-kota"><%=schoolAddr%></div>
      <div class="k-tapel">Tahun Pelajaran <%=ta%></div>
    </div>

    <!-- Badge jabatan 10mm -->
    <div class="k-badge"><%=pn.jabatan%></div>

    <!-- Body putih -->
    <div class="k-body">
      <div class="k-foto">
        <% if(foto){ %>
          <img src="<%=foto%>" alt=""
            onerror="this.parentNode.innerHTML='<div class=\'k-foto-ph\'><svg viewBox=\'0 0 24 24\' fill=\'none\' stroke=\'#94a3b8\'><path stroke-linecap=\'round\' stroke-linejoin=\'round\' stroke-width=\'1.5\' d=\'M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z\'/></svg><span>FOTO</span></div>'">
        <% } else { %>
          <div class="k-foto-ph">
            <svg viewBox="0 0 24 24" fill="none" stroke="#94a3b8">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"
                d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
            </svg>
            <span>FOTO</span>
          </div>
        <% } %>
      </div>

      <div class="k-nama"><%=pn.full_name%></div>

      <div class="k-nip-wrap">
        <span class="k-nip-label">NIP</span>
        <span class="k-nip"><%=pn.username%></span>
      </div>

      <% if(pn.nomor_ruang){ %>
      <div class="k-ruang-wrap">
        <span class="k-ruang-label">Ruang</span>
        <span class="k-ruang-val"><%=pn.nomor_ruang%></span>
      </div>
      <% } %>
    </div>

    <!-- Footer 14mm -->
    <div class="k-footer">
      <div class="k-footer-name"><%=schoolName%></div>
      <div class="k-footer-sub">TP <%=ta%></div>
    </div>

  </div>
  <% } %>
</div>
<% } %>

</body>
</html>
