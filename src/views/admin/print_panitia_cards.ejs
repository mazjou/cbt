<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <title><%= title %></title>
  <style>
    *{margin:0;padding:0;box-sizing:border-box;}
    body{font-family:Arial,sans-serif;background:#d1d5db;}

    /* ── Kontrol bar ─────────────────────────────────────────────────── */
    .no-print{background:white;padding:12px 20px;display:flex;align-items:center;
      justify-content:space-between;flex-wrap:wrap;gap:10px;
      box-shadow:0 2px 8px rgba(0,0,0,.12);margin-bottom:16px;position:sticky;top:0;z-index:99;}
    .no-print h2{font-size:15px;font-weight:700;color:#1e293b;}
    .ctrl{display:flex;gap:8px;align-items:center;}
    .btn{padding:8px 18px;border-radius:8px;font-weight:700;font-size:13px;
      cursor:pointer;border:none;text-decoration:none;display:inline-flex;align-items:center;gap:6px;}
    .btn-print{background:#4f46e5;color:white;}
    .btn-back{background:#f1f5f9;color:#475569;}

    /* ── Halaman A4 — 4 ID Card B3 portrait (80×105mm) ──────────────── */
    .page{
      width:210mm;height:297mm;
      margin:0 auto 16px;
      background:#d1d5db;
      padding:8mm;
      display:grid;
      grid-template-columns:80mm 80mm;
      grid-template-rows:105mm 105mm;
      gap:9mm 10mm;
      justify-content:center;
      overflow:hidden;
    }

    /* ── Kartu 80×105mm ──────────────────────────────────────────────── */
    .kartu{
      width:80mm;height:105mm;
      border-radius:5mm;
      overflow:hidden;
      display:flex;flex-direction:column;
      box-shadow:0 3px 10px rgba(0,0,0,.25);
      background:#2563eb; /* biru dasar seluruh kartu */
      position:relative;
    }

    /* ── Header — judul besar seperti "ANBK 2021" ───────────────────── */
    .k-header{
      flex-shrink:0;
      background:linear-gradient(160deg,#1d4ed8 0%,#2563eb 50%,#3b82f6 100%);
      padding:5mm 4mm 3mm;
      text-align:center;
    }
    /* Lubang gantungan */
    .k-header::before{
      content:'';display:block;
      width:8mm;height:3mm;
      background:rgba(255,255,255,.3);
      border-radius:2mm;
      margin:0 auto 3mm;
    }
    .k-judul{
      font-size:14pt;font-weight:900;
      text-transform:uppercase;
      color:white;
      line-height:1.15;
      letter-spacing:.5px;
    }
    .k-subjudul{
      font-size:6pt;font-weight:700;
      text-transform:uppercase;
      color:#bfdbfe;
      line-height:1.4;
      margin-top:1.5mm;
      letter-spacing:.3px;
    }
    .k-tapel{
      font-size:7pt;font-weight:700;
      color:#93c5fd;
      margin-top:1mm;
    }

    /* ── Badge PANITIA — hitam bold seperti contoh ───────────────────── */
    .k-badge{
      flex-shrink:0;
      margin:3mm 4mm;
      background:#111;
      border-radius:2mm;
      padding:2mm 0;
      text-align:center;
      font-size:13pt;font-weight:900;
      text-transform:uppercase;
      color:white;
      letter-spacing:2px;
    }

    /* ── Area putih: foto + nama + NIP ──────────────────────────────── */
    .k-body{
      flex:1;
      background:white;
      margin:0 4mm 0;
      border-radius:2mm 2mm 0 0;
      display:flex;flex-direction:column;
      align-items:center;
      padding:3mm 3mm 2mm;
      gap:2mm;
    }

    /* Foto kotak seperti contoh */
    .k-foto{
      width:24mm;height:30mm;
      border:1.5px solid #374151;
      background:#f1f5f9;
      display:flex;align-items:center;justify-content:center;
      overflow:hidden;flex-shrink:0;
    }
    .k-foto img{width:100%;height:100%;object-fit:cover;}
    .k-foto-ph{display:flex;flex-direction:column;align-items:center;gap:1mm;}
    .k-foto-ph svg{width:11mm;height:11mm;opacity:.35;color:#94a3b8;}
    .k-foto-ph span{font-size:4pt;color:#94a3b8;font-weight:700;text-transform:uppercase;}

    /* Garis nama seperti contoh (titik-titik) */
    .k-nama-wrap{width:100%;border-bottom:1px solid #374151;padding-bottom:1mm;}
    .k-nama{
      font-size:8pt;font-weight:900;color:#1e293b;
      text-align:center;line-height:1.3;word-break:break-word;
    }
    .k-nip-row{width:100%;}
    .k-nip-label{font-size:6pt;font-weight:700;color:#374151;}
    .k-nip{font-size:6pt;color:#374151;font-family:'Courier New',monospace;
      border-bottom:1px solid #374151;display:block;margin-top:.5mm;}
    <% /* ruang */ %>
    .k-ruang-row{display:flex;align-items:center;gap:2mm;width:100%;}
    .k-ruang-label{font-size:5.5pt;color:#374151;font-weight:700;white-space:nowrap;}
    .k-ruang-val{font-size:7pt;font-weight:900;color:#1d4ed8;
      border-bottom:1px solid #374151;flex:1;text-align:center;}

    /* ── Footer biru: website/nama sekolah ───────────────────────────── */
    .k-footer{
      flex-shrink:0;
      background:linear-gradient(90deg,#1d4ed8,#2563eb);
      margin:0 4mm;
      border-radius:0 0 2mm 2mm;
      padding:2mm 3mm;
      display:flex;align-items:center;justify-content:space-between;gap:2mm;
    }
    .k-footer-text{
      font-size:6pt;font-weight:900;text-transform:uppercase;
      color:white;letter-spacing:.5px;line-height:1.4;
    }
    .k-footer-sub{font-size:4.5pt;color:#bfdbfe;font-weight:400;text-transform:none;letter-spacing:0;}
    .k-qr-wrap{
      width:10mm;height:10mm;flex-shrink:0;
      background:white;border-radius:1mm;overflow:hidden;
      display:flex;align-items:center;justify-content:center;
    }

    /* Celah bawah kartu (di luar body putih) */
    .k-gap{height:2mm;background:#2563eb;margin:0 4mm;}

    /* ── Print ──────────────────────────────────────────────────────── */
    @media print{
      body{background:white;}
      .no-print{display:none!important;}
      .page{
        margin:0;width:210mm;height:297mm;padding:8mm;
        background:white;
        page-break-after:always;overflow:hidden;
      }
      .page:last-child{page-break-after:auto;}
      .kartu{box-shadow:none;}
      @page{size:A4 portrait;margin:0;}
    }
  </style>
</head>
<body>

<!-- Kontrol bar -->
<div class="no-print">
  <div>
    <h2>🎫 Cetak ID Card Panitia Ujian</h2>
    <small style="color:#64748b"><%= panitia.length %> panitia &nbsp;·&nbsp; ID Card B3 (80×105mm) &nbsp;·&nbsp; 4 kartu/halaman</small>
  </div>
  <div class="ctrl">
    <button id="printBtn" onclick="window.print()" class="btn btn-print" disabled>⏳ Menyiapkan QR...</button>
    <a href="/admin/panitia" class="btn btn-back">← Kembali</a>
  </div>
</div>

<%
  var y   = new Date().getFullYear();
  var ta  = new Date().getMonth() >= 6 ? (y+'/'+(y+1)) : ((y-1)+'/'+y);
  var schoolName = schoolInfo.name || 'SMK Negeri 1 Kras';
  var schoolAddr = schoolInfo.address || 'Kediri, Jawa Timur';
  var PH  = 4;
%>

<% for(var p = 0; p < panitia.length; p += PH){ %>
<div class="page">
  <% for(var j = p; j < Math.min(p+PH, panitia.length); j++){
       var pn = panitia[j];
       var foto = pn.profile_photo && pn.profile_photo.startsWith('/public/') ? pn.profile_photo : null;
  %>
  <div class="kartu">

    <!-- Header judul besar -->
    <div class="k-header">
      <div class="k-judul"><%=schoolName%></div>
      <div class="k-subjudul"><%=schoolAddr%></div>
      <div class="k-tapel">Tahun Pelajaran <%=ta%></div>
    </div>

    <!-- Badge jabatan hitam bold -->
    <div class="k-badge"><%=pn.jabatan%></div>

    <!-- Body putih: foto + nama + NIP + ruang -->
    <div class="k-body">
      <div class="k-foto">
        <% if(foto){ %>
          <img src="<%=foto%>" alt=""
            onerror="this.parentNode.innerHTML='<div class=\'k-foto-ph\'><svg viewBox=\'0 0 24 24\' fill=\'none\' stroke=\'currentColor\'><path stroke-linecap=\'round\' stroke-linejoin=\'round\' stroke-width=\'1.5\' d=\'M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z\'/></svg><span>FOTO</span></div>'">
        <% } else { %>
          <div class="k-foto-ph">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"
                d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
            </svg>
            <span>FOTO</span>
          </div>
        <% } %>
      </div>

      <!-- Nama dengan garis bawah -->
      <div class="k-nama-wrap">
        <div class="k-nama"><%=pn.full_name%></div>
      </div>

      <!-- NIP seperti contoh -->
      <div class="k-nip-row">
        <span class="k-nip-label">NIP</span>
        <span class="k-nip"><%=pn.username%></span>
      </div>

      <!-- Nomor ruang jika ada -->
      <% if(pn.nomor_ruang){ %>
      <div class="k-ruang-row">
        <span class="k-ruang-label">Ruang</span>
        <span class="k-ruang-val"><%=pn.nomor_ruang%></span>
      </div>
      <% } %>
    </div>

    <div class="k-gap"></div>

    <!-- Footer biru: nama sekolah + QR -->
    <div class="k-footer">
      <div>
        <div class="k-footer-text"><%=schoolName%></div>
        <div class="k-footer-sub">TP <%=ta%></div>
      </div>
      <div class="k-qr-wrap" id="qr-<%=j%>"
           data-qr="<%=encodeURIComponent((process.env.APP_URL||'http://localhost:3000')+'|'+pn.username)%>"></div>
    </div>

  </div>
  <% } %>
</div>
<% } %>

<script>
(function(){
  var s = document.createElement('script');
  s.src = 'https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js';
  s.onload = function(){
    var els = document.querySelectorAll('[id^="qr-"]');
    var i = 0;
    function batch(){
      var end = Math.min(i + 10, els.length);
      for(; i < end; i++){
        var el  = els[i];
        var txt = decodeURIComponent(el.getAttribute('data-qr') || '');
        if(!txt) continue;
        try{
          new QRCode(el,{text:txt,width:38,height:38,
            colorDark:'#000',colorLight:'#fff',correctLevel:QRCode.CorrectLevel.M});
          var c = el.querySelector('canvas');
          if(c){c.style.width='100%';c.style.height='100%';}
        }catch(e){}
      }
      if(i < els.length) setTimeout(batch, 50);
      else{
        document.getElementById('printBtn').disabled = false;
        document.getElementById('printBtn').textContent = '🖨️ Cetak / Save PDF';
      }
    }
    batch();
  };
  s.onerror = function(){
    document.getElementById('printBtn').disabled = false;
    document.getElementById('printBtn').textContent = '🖨️ Cetak';
  };
  document.head.appendChild(s);
})();
</script>
</body>
</html>
