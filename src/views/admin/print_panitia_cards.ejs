<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <title><%= title %></title>
  <style>
    *{margin:0;padding:0;box-sizing:border-box;
      -webkit-print-color-adjust:exact !important;
      print-color-adjust:exact !important;
      color-adjust:exact !important;
    }
    body{font-family:Arial,sans-serif;background:#d1d5db;}

    /* ── Kontrol bar ─────────────────────────────────────────────────── */
    .no-print{background:white;padding:12px 20px;
      box-shadow:0 2px 8px rgba(0,0,0,.12);margin-bottom:14px;}
    .no-print-top{display:flex;align-items:center;justify-content:space-between;
      flex-wrap:wrap;gap:10px;margin-bottom:10px;}
    .no-print h2{font-size:15px;font-weight:700;color:#1e293b;}
    .ctrl{display:flex;gap:8px;align-items:center;}
    .btn{padding:8px 18px;border-radius:8px;font-weight:700;font-size:13px;
      cursor:pointer;border:none;text-decoration:none;display:inline-flex;align-items:center;gap:6px;}
    .btn-print{background:#4f46e5;color:white;}
    .btn-back{background:#f1f5f9;color:#475569;}
    .settings{background:#f8fafc;border:1px solid #e2e8f0;border-radius:10px;
      padding:12px 16px;display:grid;grid-template-columns:repeat(3,1fr);gap:10px;}
    .settings label{font-size:11px;font-weight:600;color:#475569;display:block;margin-bottom:3px;}
    .settings input{width:100%;border:1.5px solid #cbd5e1;border-radius:6px;
      padding:6px 10px;font-size:12px;color:#1e293b;outline:none;}
    .settings input:focus{border-color:#6366f1;}
    .settings-note{font-size:10px;color:#94a3b8;margin-top:6px;}

    /* ── Halaman A4 — 4 kartu (2×2) ─────────────────────────────────────
       ID Card B2 dalam: 65 × 105 mm (lebar × tinggi) portrait
       A4 padding 10mm → area 190 × 277mm
       2 kolom: 65×2 + gap10 = 140mm < 190mm ✓
       2 baris: 105×2 + gap10 = 220mm < 277mm ✓
    ──────────────────────────────────────────────────────────────────── */
    .page{
      width:210mm;height:297mm;
      margin:0 auto 16px;
      background:#d1d5db;
      padding:10mm;
      display:grid;
      grid-template-columns:65mm 65mm;
      grid-template-rows:105mm 105mm;
      gap:10mm;
      justify-content:center;
      align-content:center;
      overflow:hidden;
    }

    /* ── Kartu fixed 65×105mm ───────────────────────────────────────── */
    .kartu{
      width:65mm;height:105mm;
      border-radius:4mm;overflow:hidden;
      display:flex;flex-direction:column;
      background:#2563eb;
      box-shadow:0 3px 12px rgba(0,0,0,.3);
    }

    /* ── Header biru: 34mm ───────────────────────────────────────────── */
    .k-header{
      height:34mm;flex-shrink:0;
      background:linear-gradient(160deg,#1d4ed8 0%,#2563eb 60%,#3b82f6 100%);
      display:flex;flex-direction:column;
      align-items:center;justify-content:center;
      padding:0 3mm;text-align:center;gap:1.2mm;
    }
    .k-hole{width:7mm;height:2.8mm;background:rgba(255,255,255,.3);
      border-radius:1.5mm;margin-bottom:.8mm;}
    .k-line1{font-size:11pt;font-weight:900;text-transform:uppercase;
      color:white;letter-spacing:.4px;line-height:1.2;}
    .k-line2{font-size:7pt;font-weight:700;text-transform:uppercase;
      color:#bfdbfe;letter-spacing:.2px;line-height:1.3;}
    .k-line3{font-size:6pt;color:#93c5fd;line-height:1.3;}

    /* ── Badge jabatan kuning: 9mm ───────────────────────────────────── */
    .k-badge{
      height:9mm;flex-shrink:0;
      margin:0 3mm;
      background:linear-gradient(90deg,#d97706,#f59e0b,#fbbf24);
      border-radius:1.5mm;
      display:flex;align-items:center;justify-content:center;
      font-size:9.5pt;font-weight:900;text-transform:uppercase;
      color:white;letter-spacing:2px;
      text-shadow:0 1px 2px rgba(0,0,0,.25);
    }

    /* ── Body putih: sisa = 105-34-9-2(margin top)-11(footer web) = 49mm ── */
    .k-body{
      flex:1;background:white;
      margin:2mm 3mm 0;
      border-radius:2mm 2mm 0 0;
      display:flex;flex-direction:column;
      align-items:center;
      padding:3mm 3mm 2mm;
      gap:2mm;overflow:hidden;
    }

    /* Barcode/QR area — ganti foto */
    .k-barcode{
      width:28mm;height:28mm;flex-shrink:0;
      border:1px solid #e2e8f0;border-radius:1mm;
      background:white;
      display:flex;align-items:center;justify-content:center;
      overflow:hidden;
    }

    /* Nama bold biru */
    .k-nama{font-size:7.5pt;font-weight:900;color:#1e3a8a;
      text-align:center;line-height:1.3;
      border-bottom:1.5px solid #1e3a8a;
      width:100%;padding-bottom:1.2mm;}

    /* NIP */
    .k-nip{font-size:6pt;color:#374151;
      font-family:'Courier New',monospace;
      text-align:center;width:100%;}

    /* Jabatan kepanitiaan */
    .k-jabatan-row{
      width:100%;
      background:#eff6ff;border:1px solid #bfdbfe;
      border-radius:1.5mm;padding:1mm 2mm;
      text-align:center;
    }
    .k-jabatan-label{font-size:5pt;color:#3b82f6;font-weight:700;text-transform:uppercase;letter-spacing:.3px;}
    .k-jabatan-val{font-size:7pt;font-weight:700;color:#1e40af;}

    /* Unit kerja */
    .k-unit{font-size:5.5pt;color:#64748b;text-align:center;
      width:100%;font-style:italic;line-height:1.3;}

    /* ── Footer website: 11mm ────────────────────────────────────────── */
    .k-footer{
      height:11mm;flex-shrink:0;
      background:white;
      margin:0 3mm;
      border-radius:0 0 2mm 2mm;
      border-top:1.5px solid #e2e8f0;
      display:flex;align-items:center;justify-content:center;
    }
    .k-web{font-size:7pt;font-weight:900;color:#1d4ed8;
      letter-spacing:.3px;text-transform:lowercase;}

    /* ── Print ──────────────────────────────────────────────────────── */
    @media print{
      body{background:white;}
      .no-print{display:none!important;}
      .page{
        margin:0;width:210mm;height:297mm;
        padding:10mm;background:white;
        page-break-after:always;overflow:hidden;
      }
      .page:last-child{page-break-after:auto;}
      .kartu{box-shadow:none;}
      @page{size:A4 portrait;margin:0;}
    }
  </style>
</head>
<body>

<div class="no-print">
  <div class="no-print-top">
    <div>
      <h2>🎫 Cetak ID Card Panitia Ujian</h2>
      <small style="color:#64748b"><%= panitia.length %> panitia &nbsp;·&nbsp; ID Card B2 (65×105mm) &nbsp;·&nbsp; 4 kartu/halaman A4</small>
    </div>
    <div class="ctrl">
      <button onclick="applySettings(); window.print();" class="btn btn-print">🖨️ Cetak / Save PDF</button>
      <a href="/admin/panitia" class="btn btn-back">← Kembali</a>
    </div>
  </div>
  <div class="settings">
    <div>
      <label>Baris 1 — Judul Besar</label>
      <input id="set-line1" value="<%= schoolInfo.name %>" />
    </div>
    <div>
      <label>Baris 2 — Subjudul</label>
      <input id="set-line2" value="<%= schoolInfo.address %>" />
    </div>
    <div>
      <label>Baris 3 — Tahun / Keterangan</label>
      <%
        var y = new Date().getFullYear();
        var ta = new Date().getMonth() >= 6 ? (y+'/'+(y+1)) : ((y-1)+'/'+y);
      %>
      <input id="set-line3" value="Tahun Pelajaran <%= ta %>" />
    </div>
  </div>
  <div class="settings-note">💡 Ubah teks lalu klik Cetak — perubahan diterapkan ke semua kartu secara langsung</div>
</div>

<%
  var schoolName = schoolInfo.name || 'SMK Negeri 1 Kras';
  var schoolAddr = schoolInfo.address || 'Kediri, Jawa Timur';
  var webUrl = process.env.SCHOOL_WEB || 'www.smkn1kras.sch.id';
  var PH = 4;
%>

<% for(var p = 0; p < panitia.length; p += PH){ %>
<div class="page">
  <% for(var j = p; j < Math.min(p+PH, panitia.length); j++){
       var pn = panitia[j];
       var qrData = encodeURIComponent(pn.username + '|' + pn.full_name + '|' + (pn.jabatan||''));
  %>
  <div class="kartu">

    <!-- Header biru -->
    <div class="k-header">
      <div class="k-hole"></div>
      <div class="k-line1 hdr-line1"><%=schoolName%></div>
      <div class="k-line2 hdr-line2"><%=schoolAddr%></div>
      <div class="k-line3 hdr-line3">Tahun Pelajaran <%=ta%></div>
    </div>

    <!-- Badge kegiatan kuning -->
    <div class="k-badge"><%=pn.jabatan%></div>

    <!-- Body putih -->
    <div class="k-body">

      <!-- Barcode/QR menggantikan foto -->
      <div class="k-barcode" id="qr-<%=j%>" data-qr="<%=qrData%>"></div>

      <!-- Nama -->
      <div class="k-nama"><%=pn.full_name%></div>

      <!-- NIP -->
      <div class="k-nip">NIP. <%=pn.username%></div>

      <!-- Jabatan kepanitiaan -->
      <% if(pn.nomor_ruang){ %>
      <div class="k-jabatan-row">
        <div class="k-jabatan-label">Jabatan Kepanitiaan</div>
        <div class="k-jabatan-val"><%=pn.nomor_ruang%></div>
      </div>
      <% } %>

      <!-- Unit kerja -->
      <% if(pn.keterangan){ %>
      <div class="k-unit"><%=pn.keterangan%></div>
      <% } %>

    </div>

    <!-- Footer website -->
    <div class="k-footer">
      <div class="k-web ftr-web"><%=webUrl%></div>
    </div>

  </div>
  <% } %>
</div>
<% } %>

<script>
function applySettings() {
  var l1 = document.getElementById('set-line1').value;
  var l2 = document.getElementById('set-line2').value;
  var l3 = document.getElementById('set-line3').value;
  document.querySelectorAll('.hdr-line1').forEach(el => el.textContent = l1);
  document.querySelectorAll('.hdr-line2').forEach(el => el.textContent = l2);
  document.querySelectorAll('.hdr-line3').forEach(el => el.textContent = l3);
}
['set-line1','set-line2','set-line3'].forEach(id => {
  document.getElementById(id).addEventListener('input', applySettings);
});

// Generate QR/Barcode
(function(){
  var s = document.createElement('script');
  s.src = 'https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js';
  s.onload = function(){
    var els = document.querySelectorAll('[id^="qr-"]');
    var i = 0;
    function batch(){
      var end = Math.min(i+6, els.length);
      for(; i<end; i++){
        var el  = els[i];
        var txt = decodeURIComponent(el.getAttribute('data-qr')||'');
        if(!txt) continue;
        try{
          new QRCode(el,{text:txt,width:106,height:106,
            colorDark:'#000',colorLight:'#fff',
            correctLevel:QRCode.CorrectLevel.M});
          var c = el.querySelector('canvas');
          if(c){c.style.width='100%';c.style.height='100%';}
        }catch(e){}
      }
      if(i<els.length) setTimeout(batch,50);
    }
    batch();
  };
  document.head.appendChild(s);
})();
</script>
</body>
</html>
