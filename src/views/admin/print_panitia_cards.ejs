<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <title><%= title %></title>
  <style>
    *{margin:0;padding:0;box-sizing:border-box;}
    body{font-family:Arial,sans-serif;background:#e5e7eb;}

    /* ── Kontrol bar ─────────────────────────────────────────────────── */
    .no-print{background:white;padding:12px 20px;display:flex;align-items:center;
      justify-content:space-between;flex-wrap:wrap;gap:10px;
      box-shadow:0 2px 8px rgba(0,0,0,.12);margin-bottom:14px;}
    .no-print h2{font-size:15px;font-weight:700;color:#1e293b;}
    .ctrl{display:flex;gap:8px;align-items:center;}
    .btn{padding:8px 18px;border-radius:8px;font-weight:700;font-size:13px;
      cursor:pointer;border:none;text-decoration:none;display:inline-flex;align-items:center;gap:6px;}
    .btn-print{background:#4f46e5;color:white;}
    .btn-back{background:#f1f5f9;color:#475569;}

    /* ── Halaman A4 — 6 kartu (2×3) ────────────────────────────────────
       297mm - 10mm padding = 287mm area
       3 baris, gap 3mm×2 = 6mm → tinggi kartu = (287-6)/3 = 93.67mm → 93mm
    ──────────────────────────────────────────────────────────────────── */
    .page{
      width:210mm;height:297mm;
      margin:0 auto 16px;background:white;
      padding:5mm;
      display:grid;
      grid-template-columns:1fr 1fr;
      grid-template-rows:repeat(3,93mm);
      gap:3mm 4mm;
      overflow:hidden;
    }

    /* ── Kartu Panitia ──────────────────────────────────────────────── */
    .kartu{
      height:93mm;
      border:2px solid #1e3a8a;
      background:white;
      display:flex;flex-direction:column;
      overflow:hidden;border-radius:3px;
    }

    /* Header: logo | judul | QR */
    .k-head{
      height:22mm;flex-shrink:0;
      display:flex;align-items:center;
      border-bottom:2px solid #1e3a8a;
      padding:1.5mm 2mm;gap:2mm;
      background:linear-gradient(90deg,#1e3a8a,#1d4ed8);
    }
    .k-logo{flex-shrink:0;width:18mm;
      display:flex;align-items:center;justify-content:center;}
    .k-logo img{width:16mm;height:16mm;object-fit:contain;}
    .k-title{flex:1;text-align:center;display:flex;flex-direction:column;
      align-items:center;justify-content:center;}
    .k-title .t1{font-size:8pt;font-weight:900;text-transform:uppercase;
      color:white;letter-spacing:.5px;line-height:1.4;}
    .k-title .t2{font-size:7.5pt;font-weight:700;color:#bfdbfe;line-height:1.4;}
    .k-title .t3{font-size:6.5pt;color:#93c5fd;line-height:1.4;}
    .k-qr{flex-shrink:0;width:22mm;
      display:flex;flex-direction:column;align-items:center;justify-content:center;gap:.5mm;}
    .k-qr-wrap{width:20mm;height:20mm;display:flex;align-items:center;
      justify-content:center;background:white;overflow:hidden;}
    .k-qr-label{font-size:5pt;color:rgba(255,255,255,.7);font-weight:700;
      letter-spacing:.5px;text-transform:uppercase;}

    /* Badge jabatan */
    .k-badge{
      flex-shrink:0;
      background:linear-gradient(90deg,#f59e0b,#d97706);
      padding:2mm 3mm;
      text-align:center;
      font-size:8pt;font-weight:900;text-transform:uppercase;
      color:white;letter-spacing:1px;
    }

    /* Body: data panitia */
    .k-body{
      flex:1;padding:2mm 3mm 1mm;overflow:hidden;
      display:flex;align-items:center;
    }
    .dt{width:100%;border-collapse:collapse;}
    .dt td{font-size:8pt;padding:.7mm 0;vertical-align:middle;
      color:#111;line-height:1.3;border-bottom:1px solid #e5e7eb;}
    .dt tr:last-child td{border-bottom:none;}
    .dt .lb{width:26mm;color:#333;white-space:nowrap;font-weight:400;}
    .dt .sp{width:5mm;text-align:center;color:#333;}
    .dt .vl{font-weight:700;color:#111;font-size:8pt;}
    .dt .mono{font-family:'Courier New',monospace;font-size:7.5pt;font-weight:700;color:#1e40af;}

    /* Footer */
    .k-foot{
      height:6mm;flex-shrink:0;
      border-top:1px solid #ccc;
      display:flex;align-items:center;justify-content:center;
      font-size:5pt;color:#888;background:#fafafa;
    }

    /* ── Print ──────────────────────────────────────────────────────── */
    @media print{
      body{background:white;}
      .no-print{display:none;}
      .page{
        margin:0;width:210mm;height:297mm;padding:5mm;
        page-break-after:always;overflow:hidden;
      }
      .page:last-child{page-break-after:auto;}
      @page{size:A4 portrait;margin:0;}
    }
  </style>
</head>
<body>

<!-- Kontrol bar -->
<div class="no-print">
  <div>
    <h2>🖨️ Cetak Kartu Panitia Ujian</h2>
    <small style="color:#64748b"><%= panitia.length %> panitia &nbsp;·&nbsp; A4 Portrait &nbsp;·&nbsp; 6 kartu/halaman</small>
  </div>
  <div class="ctrl">
    <button onclick="window.print()" class="btn btn-print">
      <svg width="14" height="14" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5"
          d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z"/>
      </svg>
      Cetak / Save PDF
    </button>
    <a href="/admin/panitia" class="btn btn-back">← Kembali</a>
  </div>
</div>

<%
  var y   = new Date().getFullYear();
  var ta  = new Date().getMonth() >= 6 ? (y+'/'+(y+1)) : ((y-1)+'/'+y);
  var tgl = new Date().toLocaleDateString('id-ID',{day:'numeric',month:'long',year:'numeric'});
  var PH  = 6;
%>

<% for(var p = 0; p < panitia.length; p += PH){ %>
<div class="page">
  <% for(var j = p; j < Math.min(p+PH, panitia.length); j++){
       var pn = panitia[j];
  %>
  <div class="kartu">

    <!-- Header: logo | judul | QR -->
    <div class="k-head">
      <div class="k-logo">
        <img src="/public/images/logo.png" alt="" onerror="this.style.display='none'">
      </div>
      <div class="k-title">
        <div class="t1">Kartu Panitia Ujian</div>
        <div class="t2"><%=schoolInfo.name%></div>
        <div class="t3">TP <%=ta%></div>
      </div>
      <div class="k-qr">
        <div class="k-qr-wrap" id="qr-<%=j%>"></div>
        <div class="k-qr-label">Scan</div>
      </div>
    </div>

    <!-- Badge Jabatan -->
    <div class="k-badge"><%=pn.jabatan%></div>

    <!-- Body: data panitia -->
    <div class="k-body">
      <table class="dt">
        <tr>
          <td class="lb">Nama</td>
          <td class="sp">:</td>
          <td class="vl"><%=pn.full_name%></td>
        </tr>
        <tr>
          <td class="lb">Username</td>
          <td class="sp">:</td>
          <td class="vl mono"><%=pn.username%></td>
        </tr>
        <tr>
          <td class="lb">Password</td>
          <td class="sp">:</td>
          <td class="vl mono"><%=pn.plain_password||pn.username%></td>
        </tr>
        <% if(pn.nomor_ruang){ %>
        <tr>
          <td class="lb">Nomor Ruang</td>
          <td class="sp">:</td>
          <td class="vl"><%=pn.nomor_ruang%></td>
        </tr>
        <% } %>
        <% if(pn.keterangan){ %>
        <tr>
          <td class="lb">Keterangan</td>
          <td class="sp">:</td>
          <td class="vl"><%=pn.keterangan%></td>
        </tr>
        <% } %>
      </table>
    </div>

    <!-- Footer -->
    <div class="k-foot">Kartu ini bersifat rahasia — Jangan bagikan kepada yang tidak berkepentingan</div>

  </div>
  <% } %>
</div>
<% } %>

<script>
(function(){
  var s = document.createElement('script');
  s.src = 'https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js';
  s.onload = function(){
    <% for(var qi = 0; qi < panitia.length; qi++){
         var qp = panitia[qi];
         var qt = (process.env.APP_URL||'http://localhost:3000') + '|' + qp.username;
    %>
    try{
      new QRCode(document.getElementById('qr-<%=qi%>'),{
        text:'<%-qt.replace(/\\/g,"\\\\").replace(/'/g,"\\'")%>',
        width:76,height:76,
        colorDark:'#000',colorLight:'#fff',
        correctLevel:QRCode.CorrectLevel.M
      });
      var c=document.querySelector('#qr-<%=qi%> canvas');
      if(c){c.style.width='100%';c.style.height='100%';}
    }catch(e){}
    <% } %>
  };
  document.head.appendChild(s);
})();
</script>
</body>
</html>
