<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <title><%= title %></title>
  <style>
    *{margin:0;padding:0;box-sizing:border-box;}
    body{font-family:Arial,sans-serif;background:#d1d5db;}

    /* ── Kontrol bar ─────────────────────────────────────────────────── */
    .no-print{background:white;padding:12px 20px;display:flex;align-items:center;
      justify-content:space-between;flex-wrap:wrap;gap:10px;
      box-shadow:0 2px 8px rgba(0,0,0,.12);margin-bottom:16px;position:sticky;top:0;z-index:99;}
    .no-print h2{font-size:15px;font-weight:700;color:#1e293b;}
    .ctrl{display:flex;gap:8px;align-items:center;}
    .btn{padding:8px 18px;border-radius:8px;font-weight:700;font-size:13px;
      cursor:pointer;border:none;text-decoration:none;display:inline-flex;align-items:center;gap:6px;}
    .btn-print{background:#4f46e5;color:white;}
    .btn-back{background:#f1f5f9;color:#475569;}

    /* ── Layout cetak — ID Card B3 portrait: 105×80mm ───────────────────
       Susun 3 kolom × 4 baris = 12 kartu per A4
       Padding A4: 5mm semua sisi
       Area: 200mm × 287mm
       Gap: 2mm kolom, 2mm baris
       Lebar kartu: (200 - 2×2) / 3 = 65.3mm  → tapi kartu B3 = 80mm
       Karena 80mm × 3 = 240mm > 200mm, pakai 2 kolom × 4 baris = 8 kartu
       80mm × 2 + 2mm gap = 162mm < 200mm ✓
       105mm × 4 + 3mm × 3 gap = 429mm > 287mm → pakai 2 kolom × 2 baris = 4 per A4
       105mm × 2 + 3mm = 213mm ← OK (dalam 287mm) ... atau buat 1 per baris
       Coba 2 kolom × 2 baris (4 kartu/halaman): 105mm × 2 + 5mm gap = 215mm < 287mm ✓
       80mm × 2 + 5mm = 165mm < 200mm ✓
    ──────────────────────────────────────────────────────────────────── */
    .page{
      width:210mm;
      height:297mm;
      margin:0 auto 16px;
      background:#d1d5db;
      padding:10mm;
      display:grid;
      grid-template-columns:80mm 80mm;
      grid-template-rows:105mm 105mm;
      gap:7mm 10mm;
      overflow:hidden;
      justify-content:center;
    }

    /* ── ID Card 80×105mm ────────────────────────────────────────────── */
    .kartu{
      width:80mm;
      height:105mm;
      background:white;
      border-radius:4mm;
      overflow:hidden;
      display:flex;
      flex-direction:column;
      box-shadow:0 2px 8px rgba(0,0,0,.2);
      position:relative;
    }

    /* Stripe atas biru tebal */
    .k-top{
      height:28mm;
      flex-shrink:0;
      background:linear-gradient(135deg,#1e3a8a 0%,#1d4ed8 60%,#3b82f6 100%);
      display:flex;flex-direction:column;
      align-items:center;justify-content:center;
      gap:1mm;padding:2mm;
      position:relative;
    }
    /* Lubang gantungan simulasi */
    .k-top::before{
      content:'';
      position:absolute;top:2.5mm;
      width:8mm;height:3mm;
      background:rgba(255,255,255,.25);
      border-radius:2mm;
    }
    .k-sekolah{font-size:6pt;font-weight:900;text-transform:uppercase;
      color:white;letter-spacing:.5px;text-align:center;line-height:1.3;margin-top:4mm;}
    .k-kota{font-size:5.5pt;color:#bfdbfe;text-align:center;}
    .k-tahun{font-size:5pt;color:#93c5fd;}

    /* Stripe kuning-emas jabatan */
    .k-jabatan{
      height:9mm;flex-shrink:0;
      background:linear-gradient(90deg,#d97706,#f59e0b,#fbbf24);
      display:flex;align-items:center;justify-content:center;
      font-size:9pt;font-weight:900;text-transform:uppercase;
      color:white;letter-spacing:1.5px;
      text-shadow:0 1px 2px rgba(0,0,0,.3);
    }

    /* Foto area + nama */
    .k-mid{
      flex:1;
      display:flex;flex-direction:column;
      align-items:center;
      padding:3mm 3mm 2mm;
      gap:2mm;
      background:white;
    }
    .k-foto{
      width:22mm;height:28mm;
      border:2px solid #1e3a8a;
      border-radius:2mm;
      overflow:hidden;
      background:linear-gradient(135deg,#eff6ff,#dbeafe);
      display:flex;align-items:center;justify-content:center;
      flex-shrink:0;
    }
    .k-foto img{width:100%;height:100%;object-fit:cover;}
    .k-foto-ph{display:flex;flex-direction:column;align-items:center;gap:1mm;}
    .k-foto-ph svg{width:12mm;height:12mm;opacity:.4;color:#94a3b8;}
    .k-foto-ph span{font-size:4.5pt;color:#94a3b8;font-weight:700;text-transform:uppercase;}

    .k-nama{
      font-size:8pt;font-weight:900;color:#1e3a8a;
      text-align:center;line-height:1.3;word-break:break-word;
    }
    .k-nip{
      font-size:6pt;color:#64748b;
      font-family:'Courier New',monospace;text-align:center;
    }

    /* Stripe bawah biru */
    .k-bot{
      height:12mm;flex-shrink:0;
      background:linear-gradient(135deg,#1e3a8a,#1d4ed8);
      display:flex;flex-direction:column;
      align-items:center;justify-content:center;
      gap:.5mm;padding:1mm 3mm;
    }
    .k-bot-row{
      display:flex;align-items:center;justify-content:center;gap:2mm;
      width:100%;
    }
    .k-qr-wrap{
      width:9mm;height:9mm;
      display:flex;align-items:center;justify-content:center;
      background:white;border-radius:1mm;overflow:hidden;flex-shrink:0;
    }
    .k-ruang{
      font-size:6pt;font-weight:700;color:white;
      text-align:center;line-height:1.4;
    }
    .k-ruang-label{font-size:5pt;color:#bfdbfe;}
    .k-ta{font-size:5pt;color:rgba(255,255,255,.6);text-align:center;}

    /* ── Print ──────────────────────────────────────────────────────── */
    @media print{
      body{background:white;}
      .no-print{display:none!important;}
      .page{
        margin:0;
        width:210mm;height:297mm;
        padding:10mm;
        background:white;
        page-break-after:always;
        overflow:hidden;
      }
      .page:last-child{page-break-after:auto;}
      .kartu{box-shadow:none;border:0.3mm solid #cbd5e1;}
      @page{size:A4 portrait;margin:0;}
    }
  </style>
</head>
<body>

<!-- Kontrol bar -->
<div class="no-print">
  <div>
    <h2>🎫 Cetak ID Card Panitia Ujian</h2>
    <small style="color:#64748b"><%= panitia.length %> panitia &nbsp;·&nbsp; ID Card B3 (80×105mm) &nbsp;·&nbsp; 4 kartu/halaman</small>
  </div>
  <div class="ctrl">
    <button id="printBtn" onclick="window.print()" class="btn btn-print" disabled>⏳ Menyiapkan QR...</button>
    <a href="/admin/panitia" class="btn btn-back">← Kembali</a>
  </div>
</div>

<%
  var y   = new Date().getFullYear();
  var ta  = new Date().getMonth() >= 6 ? (y+'/'+(y+1)) : ((y-1)+'/'+y);
  var PH  = 4;
%>

<% for(var p = 0; p < panitia.length; p += PH){ %>
<div class="page">
  <% for(var j = p; j < Math.min(p+PH, panitia.length); j++){
       var pn = panitia[j];
       var foto = pn.profile_photo && pn.profile_photo.startsWith('/public/') ? pn.profile_photo : null;
  %>
  <div class="kartu">

    <!-- Header biru -->
    <div class="k-top">
      <div class="k-sekolah"><%=schoolInfo.name%></div>
      <div class="k-kota"><%=schoolInfo.address%></div>
      <div class="k-tahun">Tahun Pelajaran <%=ta%></div>
    </div>

    <!-- Badge jabatan -->
    <div class="k-jabatan"><%=pn.jabatan%></div>

    <!-- Foto + Nama -->
    <div class="k-mid">
      <div class="k-foto">
        <% if(foto){ %>
          <img src="<%=foto%>" alt=""
            onerror="this.parentNode.innerHTML='<div class=\'k-foto-ph\'><svg viewBox=\'0 0 24 24\' fill=\'none\' stroke=\'currentColor\'><path stroke-linecap=\'round\' stroke-linejoin=\'round\' stroke-width=\'1.5\' d=\'M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z\'/></svg><span>FOTO</span></div>'">
        <% } else { %>
          <div class="k-foto-ph">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"
                d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
            </svg>
            <span style="font-size:4pt;color:#94a3b8;font-weight:700;">FOTO</span>
          </div>
        <% } %>
      </div>
      <div class="k-nama"><%=pn.full_name%></div>
      <div class="k-nip"><%=pn.username%></div>
    </div>

    <!-- Footer biru: QR + nomor ruang -->
    <div class="k-bot">
      <div class="k-bot-row">
        <div class="k-qr-wrap" id="qr-<%=j%>" data-qr="<%=encodeURIComponent((process.env.APP_URL||'http://localhost:3000')+'|'+pn.username)%>"></div>
        <div>
          <% if(pn.nomor_ruang){ %>
            <div class="k-ruang-label">Nomor Ruang</div>
            <div class="k-ruang"><%=pn.nomor_ruang%></div>
          <% } else { %>
            <div class="k-ruang" style="font-size:5pt;opacity:.7;">Panitia Ujian</div>
          <% } %>
        </div>
      </div>
      <div class="k-ta"><%=schoolInfo.name%> &nbsp;·&nbsp; TP <%=ta%></div>
    </div>

  </div>
  <% } %>
</div>
<% } %>

<script>
(function(){
  var s = document.createElement('script');
  s.src = 'https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js';
  s.onload = function(){
    var els = document.querySelectorAll('[id^="qr-"]');
    var i = 0;
    function batch(){
      var end = Math.min(i + 10, els.length);
      for(; i < end; i++){
        var el  = els[i];
        var txt = decodeURIComponent(el.getAttribute('data-qr') || '');
        if(!txt) continue;
        try{
          new QRCode(el,{text:txt,width:34,height:34,
            colorDark:'#000',colorLight:'#fff',correctLevel:QRCode.CorrectLevel.M});
          var c = el.querySelector('canvas');
          if(c){c.style.width='100%';c.style.height='100%';}
        }catch(e){}
      }
      if(i < els.length){ setTimeout(batch, 50); }
      else {
        document.getElementById('printBtn').disabled = false;
        document.getElementById('printBtn').textContent = '🖨️ Cetak / Save PDF';
      }
    }
    batch();
  };
  s.onerror = function(){
    document.getElementById('printBtn').disabled = false;
    document.getElementById('printBtn').textContent = '🖨️ Cetak';
  };
  document.head.appendChild(s);
})();
</script>
</body>
</html>
