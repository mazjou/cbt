<!-- Header Banner -->
<div class="relative overflow-hidden rounded-2xl bg-gradient-to-r from-violet-600 via-purple-600 to-indigo-600 shadow-xl mb-6">
  <div class="absolute inset-0 opacity-10">
    <div class="absolute top-0 right-0 w-64 h-64 bg-white rounded-full -mr-32 -mt-32"></div>
    <div class="absolute bottom-0 left-0 w-48 h-48 bg-white rounded-full -ml-24 -mb-24"></div>
  </div>
  <div class="relative px-6 py-8">
    <div class="flex items-center justify-between flex-wrap gap-4">
      <div class="flex items-center gap-4">
        <div class="bg-white/20 backdrop-blur-sm rounded-2xl p-4">
          <svg class="w-10 h-10 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5a2 2 0 011.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A2 2 0 013 12V7a4 4 0 014-4z"/>
          </svg>
        </div>
        <div>
          <h1 class="text-2xl font-bold text-white tracking-tight">Edit Nama Kolom TP</h1>
          <p class="mt-1 text-purple-100"><%= period.name %> &bull; Semester <%= period.semester %> &bull; <%= period.school_year %></p>
        </div>
      </div>
      <div class="flex gap-3">
        <a href="/admin/raport" class="inline-flex items-center gap-2 px-4 py-2 bg-white/20 backdrop-blur-sm hover:bg-white/30 text-white font-semibold rounded-xl transition-all">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/></svg>
          Kembali
        </a>
      </div>
    </div>
  </div>
</div>

<!-- Flash Messages -->
<%- include('../partials/flash') %>

<!-- Kartu form nama kolom TP -->
<div class="bg-white rounded-2xl shadow-lg border border-slate-100 p-6 mb-6">
  <div class="flex items-center gap-3 mb-4">
    <div class="bg-teal-100 rounded-xl p-2">
      <svg class="w-5 h-5 text-teal-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5a2 2 0 011.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A2 2 0 013 12V7a4 4 0 014-4z"/>
      </svg>
    </div>
    <div>
      <h3 class="font-bold text-slate-800">Nama Kolom TP untuk Cetak Raport</h3>
      <p class="text-xs text-slate-500">Kosongkan kolom untuk memakai nama default ("TP 1", "TP 2", dst). Nama hanya berlaku untuk periode ini.</p>
    </div>
  </div>

  <% if (maxTp > 0) { %>
    <form method="POST" action="/admin/raport/<%= period.id %>/tp-labels" class="space-y-4">
      <div class="overflow-hidden rounded-xl border border-slate-200">
        <table class="w-full">
          <thead>
            <tr class="bg-slate-50 text-left text-xs font-semibold text-slate-500 uppercase tracking-wider">
              <th class="px-4 py-3 w-40">Nama Default</th>
              <th class="px-4 py-3">Nama Custom</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100">
            <% for (let i = 1; i <= maxTp; i++) { %>
              <tr>
                <td class="px-4 py-3 font-semibold text-slate-700">TP <%= i %></td>
                <td class="px-4 py-3">
                  <input type="text" name="labels[<%= i %>]" value="<%= labels[i] || '' %>" placeholder="TP <%= i %>"
                    class="w-full px-4 py-2.5 border-2 border-slate-200 rounded-xl focus:ring-2 focus:ring-violet-500 focus:border-violet-500 transition-all" maxlength="100" />
                </td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>

      <div class="flex items-center gap-3 pt-2">
        <button type="submit"
          class="inline-flex items-center gap-2 px-5 py-2.5 bg-gradient-to-r from-violet-600 to-indigo-600 text-white font-semibold rounded-xl hover:from-violet-700 hover:to-indigo-700 transition-all shadow-md">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
          Simpan Nama Kolom
        </button>
        <a href="/admin/raport"
          class="inline-flex items-center gap-2 px-5 py-2.5 text-slate-600 font-semibold rounded-xl hover:bg-slate-100 transition-all">
          Batal
        </a>
      </div>
    </form>
  <% } else { %>
    <div class="rounded-xl border-2 border-dashed border-slate-200 p-6 text-center">
      <svg class="w-10 h-10 mx-auto text-slate-300 mb-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01"/></svg>
      <p class="text-sm text-slate-500">Belum ada TP di periode ini. Nama kolom bisa diisi setelah guru menginput TP pada mapel.</p>
    </div>
  <% } %>
</div>
