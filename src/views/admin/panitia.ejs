<div class="flex items-center justify-between gap-4">
  <div>
    <h1 class="text-3xl font-semibold tracking-tight">Panitia Ujian</h1>
    <p class="mt-1 text-slate-600">Kelola daftar guru yang bertugas sebagai panitia ujian.</p>
  </div>
  <div class="flex gap-2">
    <% if (panitia && panitia.length > 0) { %>
    <a href="/admin/panitia/print-cards"
       class="px-4 py-2 rounded-xl bg-gradient-to-r from-pink-400 to-rose-400 hover:from-pink-500 hover:to-rose-500 text-white font-semibold transition-all shadow-md flex items-center gap-2">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
          d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z"/>
      </svg>
      Cetak Kartu Panitia
    </a>
    <% } %>
    <a href="/admin" class="px-4 py-2 rounded-xl border border-slate-200 hover:bg-slate-100 text-sm font-medium">← Kembali</a>
  </div>
</div>

<div class="mt-6 grid lg:grid-cols-3 gap-4">

  <!-- Form Tambah Panitia -->
  <div class="rounded-2xl border border-indigo-200 bg-gradient-to-br from-indigo-50 to-indigo-100 p-5">
    <h2 class="text-lg font-semibold text-indigo-900 mb-4">➕ Tambah Panitia</h2>
    <% if (guruBelum && guruBelum.length > 0) { %>
    <form action="/admin/panitia" method="POST" class="space-y-3">
      <div>
        <label class="text-sm font-medium text-indigo-800 block mb-1">Pilih Guru</label>
        <select name="user_id" required
          class="w-full rounded-xl bg-white border border-indigo-200 px-4 py-2 focus:outline-none focus:ring-2 focus:ring-indigo-400 text-sm">
          <option value="">-- Pilih Guru --</option>
          <% guruBelum.forEach(g => { %>
            <option value="<%= g.id %>"><%= g.full_name %></option>
          <% }) %>
        </select>
      </div>
      <div>
        <label class="text-sm font-medium text-indigo-800 block mb-1">Jabatan</label>
        <input name="jabatan" value="Panitia" required
          class="w-full rounded-xl bg-white border border-indigo-200 px-4 py-2 focus:outline-none focus:ring-2 focus:ring-indigo-400 text-sm"
          placeholder="Contoh: Ketua Panitia, Pengawas, Sekretaris" />
      </div>
      <div>
        <label class="text-sm font-medium text-indigo-800 block mb-1">Nomor Ruang (opsional)</label>
        <input name="nomor_ruang"
          class="w-full rounded-xl bg-white border border-indigo-200 px-4 py-2 focus:outline-none focus:ring-2 focus:ring-indigo-400 text-sm"
          placeholder="Contoh: R.01, Lab Komputer" />
      </div>
      <div>
        <label class="text-sm font-medium text-indigo-800 block mb-1">Keterangan (opsional)</label>
        <textarea name="keterangan" rows="2"
          class="w-full rounded-xl bg-white border border-indigo-200 px-4 py-2 focus:outline-none focus:ring-2 focus:ring-indigo-400 text-sm"
          placeholder="Catatan tambahan..."></textarea>
      </div>
      <button type="submit"
        class="w-full rounded-xl bg-gradient-to-r from-indigo-500 to-purple-500 hover:from-indigo-600 hover:to-purple-600 text-white font-semibold py-2.5 transition-all shadow-md">
        Tambahkan ke Panitia
      </button>
    </form>
    <% } else { %>
    <div class="text-center py-6 text-indigo-600 text-sm">
      <div class="text-3xl mb-2">✅</div>
      Semua guru sudah terdaftar sebagai panitia<br>atau tidak ada guru aktif tersisa.
    </div>
    <% } %>
  </div>

  <!-- Daftar Panitia -->
  <div class="lg:col-span-2 rounded-2xl border border-slate-200 bg-white p-5">
    <div class="flex items-center justify-between mb-4">
      <h2 class="text-lg font-semibold text-slate-800">
        Daftar Panitia
        <span class="ml-2 px-2 py-0.5 rounded-full bg-indigo-100 text-indigo-700 text-sm font-bold"><%= (panitia||[]).length %></span>
      </h2>
    </div>

    <% if (!panitia || panitia.length === 0) { %>
    <div class="text-center py-12 text-slate-400">
      <div class="text-4xl mb-3">📋</div>
      <div class="font-medium">Belum ada panitia yang ditunjuk</div>
      <div class="text-sm mt-1">Tambahkan guru dari form di sebelah kiri</div>
    </div>
    <% } else { %>
    <div class="overflow-x-auto">
      <table class="w-full text-sm">
        <thead class="text-slate-500 border-b border-slate-200">
          <tr>
            <th class="text-left py-2">Nama Guru</th>
            <th class="text-left py-2">Jabatan</th>
            <th class="text-left py-2">Ruang</th>
            <th class="text-left py-2">Status</th>
            <th class="text-right py-2">Aksi</th>
          </tr>
        </thead>
        <tbody>
          <% panitia.forEach(p => { %>
          <tr class="border-t border-slate-100 hover:bg-slate-50" id="panitia-row-<%= p.id %>">
            <td class="py-2">
              <div class="font-medium text-slate-800"><%= p.full_name %></div>
              <div class="text-xs text-slate-400 font-mono"><%= p.username %></div>
            </td>
            <td class="py-2 text-slate-700"><%= p.jabatan %></td>
            <td class="py-2 text-slate-600"><%= p.nomor_ruang || '-' %></td>
            <td class="py-2">
              <span class="px-2 py-0.5 rounded-full text-xs font-semibold <%= p.is_active ? 'bg-green-100 text-green-700' : 'bg-red-100 text-red-700' %>">
                <%= p.is_active ? 'Aktif' : 'Nonaktif' %>
              </span>
            </td>
            <td class="py-2">
              <div class="flex justify-end gap-1">
                <button onclick="openEditPanitia(<%= JSON.stringify(p) %>)"
                  class="px-2 py-1 rounded-lg bg-blue-500 hover:bg-blue-600 text-white text-xs font-medium">Edit</button>
                <form action="/admin/panitia/<%= p.id %>/delete" method="POST"
                  onsubmit="return confirm('Hapus <%= p.full_name %> dari panitia?')">
                  <button type="submit"
                    class="px-2 py-1 rounded-lg bg-rose-500 hover:bg-rose-600 text-white text-xs font-medium">Hapus</button>
                </form>
              </div>
            </td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
    <% } %>
  </div>
</div>

<!-- Modal Edit Panitia -->
<div id="editPanitiaModal" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/50 backdrop-blur-sm">
  <div class="bg-white rounded-2xl shadow-2xl w-full max-w-md mx-4 overflow-hidden">
    <div class="bg-gradient-to-r from-indigo-500 to-purple-500 px-6 py-4 flex items-center justify-between">
      <h3 class="text-white font-bold text-lg">Edit Data Panitia</h3>
      <button onclick="closeEditPanitia()" class="text-white/70 hover:text-white">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
        </svg>
      </button>
    </div>
    <form id="editPanitiaForm" method="POST" class="p-6 space-y-4">
      <div>
        <label class="text-sm font-semibold text-slate-700 block mb-1">Nama Guru</label>
        <input id="ep_nama" readonly
          class="w-full rounded-xl bg-slate-50 border border-slate-200 px-4 py-2.5 text-slate-500 text-sm" />
      </div>
      <div>
        <label class="text-sm font-semibold text-slate-700 block mb-1">Jabatan</label>
        <input name="jabatan" id="ep_jabatan" required
          class="w-full rounded-xl bg-white border-2 border-slate-200 px-4 py-2.5 focus:outline-none focus:border-indigo-400 text-sm" />
      </div>
      <div>
        <label class="text-sm font-semibold text-slate-700 block mb-1">Nomor Ruang</label>
        <input name="nomor_ruang" id="ep_ruang"
          class="w-full rounded-xl bg-white border-2 border-slate-200 px-4 py-2.5 focus:outline-none focus:border-indigo-400 text-sm"
          placeholder="Opsional" />
      </div>
      <div>
        <label class="text-sm font-semibold text-slate-700 block mb-1">Keterangan</label>
        <textarea name="keterangan" id="ep_ket" rows="2"
          class="w-full rounded-xl bg-white border-2 border-slate-200 px-4 py-2.5 focus:outline-none focus:border-indigo-400 text-sm"
          placeholder="Opsional"></textarea>
      </div>
      <div>
        <label class="text-sm font-semibold text-slate-700 block mb-1">Status</label>
        <select name="is_active" id="ep_active"
          class="w-full rounded-xl bg-white border-2 border-slate-200 px-4 py-2.5 focus:outline-none focus:border-indigo-400 text-sm">
          <option value="1">Aktif</option>
          <option value="0">Nonaktif</option>
        </select>
      </div>
      <div class="flex gap-3 pt-2">
        <button type="button" onclick="closeEditPanitia()"
          class="flex-1 px-4 py-2.5 rounded-xl border-2 border-slate-200 text-slate-600 font-semibold hover:bg-slate-50">Batal</button>
        <button type="submit"
          class="flex-1 px-4 py-2.5 rounded-xl bg-gradient-to-r from-indigo-500 to-purple-500 hover:from-indigo-600 hover:to-purple-600 text-white font-semibold">Simpan</button>
      </div>
    </form>
  </div>
</div>

<script>
function openEditPanitia(p) {
  document.getElementById('ep_nama').value    = p.full_name;
  document.getElementById('ep_jabatan').value = p.jabatan;
  document.getElementById('ep_ruang').value   = p.nomor_ruang || '';
  document.getElementById('ep_ket').value     = p.keterangan || '';
  document.getElementById('ep_active').value  = p.is_active ? '1' : '0';
  document.getElementById('editPanitiaForm').action = `/admin/panitia/${p.id}/update`;
  const m = document.getElementById('editPanitiaModal');
  m.classList.remove('hidden'); m.classList.add('flex');
}
function closeEditPanitia() {
  const m = document.getElementById('editPanitiaModal');
  m.classList.add('hidden'); m.classList.remove('flex');
}
document.getElementById('editPanitiaModal').addEventListener('click', function(e) {
  if (e.target === this) closeEditPanitia();
});
</script>
