        <div>
          <label class="text-sm text-orange-700 font-medium">Filter Kelas</label>
          <select name="class_filter"
            class="mt-1 w-full rounded-xl bg-white border border-orange-200 px-4 py-2 focus:outline-none focus:ring-2 focus:ring-orange-500">
            <option value="">Semua Kelas</option>
            <% classes.forEach(c => { %>
              <option value="<%= c.id %>"><%= c.name %></option>
