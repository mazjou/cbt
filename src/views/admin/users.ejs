          Simpan
        </button>
      </div>
    </form>
  </div>

  <!-- Card Reset Password Massal -->
  <div class="rounded-2xl border border-orange-200 bg-gradient-to-br from-orange-50 to-orange-100 p-5 mt-4">
    <h2 class="text-lg font-semibold text-orange-900 mb-1">🔑 Reset Password Massal</h2>
    <p class="text-xs text-orange-700 mb-4">Reset password banyak pengguna sekaligus. Password baru akan tersimpan dan tampil di kartu cetak.</p>
    <form action="/admin/users/bulk-reset-password" method="POST" class="space-y-3"
          onsubmit="return confirm('Yakin reset password? Tindakan ini tidak bisa dibatalkan!')">
      <div class="grid md:grid-cols-3 gap-3">
        <div>
          <label class="text-sm text-orange-700 font-medium">Tipe Password Baru</label>
          <select name="password_type" id="pwd_type" onchange="toggleCustomPwd(this.value)"
