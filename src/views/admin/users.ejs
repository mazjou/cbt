<div class="flex flex-col gap-3 mb-6">
  <div>
    <h1 class="text-2xl font-semibold tracking-tight">Kelola Pengguna</h1>
    <p class="mt-1 text-slate-600 text-sm">Buat admin/guru/siswa, reset password, aktif/nonaktif.</p>
  </div>
  <div class="grid grid-cols-2 sm:flex sm:flex-wrap gap-2">
    <!-- Cetak Kartu dengan dropdown -->
    <div class="relative">
      <button type="button" onclick="toggleDropdown('dropdownCetak')"
        class="w-full sm:w-auto px-3 py-2 rounded-xl bg-gradient-to-r from-pink-400 to-rose-400 hover:from-pink-500 hover:to-rose-500 text-white font-semibold transition-all shadow-md flex items-center justify-center gap-1 text-sm">
        <svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z" />
        </svg>
        Cetak Kartu ▾
      </button>
      <div id="dropdownCetak" class="absolute left-0 top-full mt-1 w-56 bg-white rounded-xl shadow-xl border border-rose-100 z-50" style="display:none">
        <a href="/admin/users/print-cards" target="_blank" class="block px-4 py-2.5 text-sm text-slate-700 hover:bg-rose-50 rounded-t-xl font-medium">🖨️ Cetak Semua</a>
        <div class="border-t border-slate-100 px-3 py-1 text-xs text-slate-400 font-semibold uppercase tracking-wider">Per Role</div>
        <a href="/admin/users/print-cards?role=STUDENT" target="_blank" class="block px-4 py-2 text-sm text-slate-700 hover:bg-rose-50">👨‍🎓 Semua Siswa</a>
        <a href="/admin/users/print-cards?role=TEACHER" target="_blank" class="block px-4 py-2 text-sm text-slate-700 hover:bg-rose-50">👨‍🏫 Semua Guru</a>
        <div class="border-t border-slate-100 px-3 py-1 text-xs text-slate-400 font-semibold uppercase tracking-wider">Per Kelas</div>
        <div class="max-h-48 overflow-y-auto">
          <% classes.forEach(c => { %>
            <a href="/admin/users/print-cards?role=STUDENT&class_id=<%= c.id %>" target="_blank" class="block px-4 py-2 text-sm text-slate-700 hover:bg-rose-50 truncate"><%= c.name %></a>
          <% }) %>
        </div>
      </div>
    </div>

    <!-- Download Excel dengan dropdown -->
    <div class="relative">
      <button type="button" onclick="toggleDropdown('dropdownExcel')"
        class="w-full sm:w-auto px-3 py-2 rounded-xl bg-gradient-to-r from-green-500 to-emerald-500 hover:from-green-600 hover:to-emerald-600 text-white font-semibold transition-all shadow-md flex items-center justify-center gap-1 text-sm">
        <svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
        </svg>
        Download Excel ▾
      </button>
      <div id="dropdownExcel" class="absolute left-0 top-full mt-1 w-56 bg-white rounded-xl shadow-xl border border-emerald-100 z-50" style="display:none">
        <a href="/admin/users/download" class="block px-4 py-2.5 text-sm text-slate-700 hover:bg-emerald-50 rounded-t-xl font-medium">📥 Download Semua</a>
        <div class="border-t border-slate-100 px-3 py-1 text-xs text-slate-400 font-semibold uppercase tracking-wider">Per Role</div>
        <a href="/admin/users/download?role=STUDENT" class="block px-4 py-2 text-sm text-slate-700 hover:bg-emerald-50">👨‍🎓 Semua Siswa</a>
        <a href="/admin/users/download?role=TEACHER" class="block px-4 py-2 text-sm text-slate-700 hover:bg-emerald-50">👨‍🏫 Semua Guru</a>
        <a href="/admin/users/download?role=ADMIN" class="block px-4 py-2 text-sm text-slate-700 hover:bg-emerald-50">🛡️ Semua Admin</a>
        <div class="border-t border-slate-100 px-3 py-1 text-xs text-slate-400 font-semibold uppercase tracking-wider">Per Kelas</div>
        <div class="max-h-48 overflow-y-auto">
          <% classes.forEach(c => { %>
            <a href="/admin/users/download?role=STUDENT&class_id=<%= c.id %>" class="block px-4 py-2 text-sm text-slate-700 hover:bg-emerald-50 truncate"><%= c.name %></a>
          <% }) %>
        </div>
      </div>
    </div>

    <script>
    function toggleDropdown(id) {
      const el = document.getElementById(id);
      const isOpen = el.style.display === 'block';
      document.querySelectorAll('#dropdownCetak, #dropdownExcel').forEach(d => d.style.display = 'none');
      el.style.display = isOpen ? 'none' : 'block';
    }
    document.addEventListener('click', function(e) {
      if (!e.target.closest('.relative')) {
        document.querySelectorAll('#dropdownCetak, #dropdownExcel').forEach(d => d.style.display = 'none');
      }
    });
    </script>

    <a href="/admin/users/import" class="w-full sm:w-auto px-3 py-2 rounded-xl bg-gradient-to-r from-violet-400 to-purple-500 hover:from-violet-500 hover:to-purple-600 text-white font-semibold transition-all shadow-md text-sm text-center">
      Import Pengguna
    </a>
    <a href="/admin/users/import-password" class="w-full sm:w-auto px-3 py-2 rounded-xl bg-gradient-to-r from-orange-400 to-red-400 hover:from-orange-500 hover:to-red-500 text-white font-semibold transition-all shadow-md text-sm text-center">
      🔑 Import Password
    </a>
    <button type="button" onclick="openDeleteByRoleModal()" class="w-full sm:w-auto px-3 py-2 rounded-xl bg-gradient-to-r from-red-600 to-rose-700 hover:from-red-700 hover:to-rose-800 text-white font-semibold transition-all shadow-md text-sm flex items-center justify-center gap-1">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
      Hapus Massal
    </button>
    <button type="button" onclick="document.getElementById('modalNonaktifDomain').classList.remove('hidden');document.getElementById('modalNonaktifDomain').style.display='flex';"
      class="w-full sm:w-auto px-3 py-2 rounded-xl text-white font-semibold transition-all shadow-md text-sm flex items-center justify-center gap-1"
      style="background: linear-gradient(135deg, #7c3aed, #6d28d9);">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18.364 18.364A9 9 0 005.636 5.636m12.728 12.728A9 9 0 015.636 5.636m12.728 12.728L5.636 5.636"/></svg>
      🚫 Nonaktifkan @domain
    </button>
    <a href="/admin" class="w-full sm:w-auto px-3 py-2 rounded-xl bg-gradient-to-r from-cyan-400 to-blue-400 hover:from-cyan-500 hover:to-blue-500 text-white font-medium transition-all shadow-md text-sm text-center col-span-2 sm:col-span-1">
      Kembali
    </a>
  </div>
</div>

<div class="mt-6 space-y-4">
  <!-- Card Daftar Pengguna -->
  <div class="rounded-2xl border border-teal-200 bg-gradient-to-br from-teal-50 to-teal-100 p-5">

    <!-- Bulk Action Bar — muncul saat ada yang dicentang, sticky di atas -->
    <div id="bulkActionBar" class="hidden mb-4 rounded-xl border border-teal-300 bg-white p-3 shadow-sm">
      <div class="flex flex-wrap gap-2 items-center">
        <span class="text-sm font-semibold text-teal-800 w-full sm:w-auto mb-1 sm:mb-0">
          <span id="selectedCount">0</span> dipilih
        </span>
        <button type="button" onclick="downloadSelectedExcel()"
          class="flex-1 sm:flex-none px-3 py-1.5 rounded-lg bg-gradient-to-r from-green-500 to-emerald-500 text-white font-semibold text-xs flex items-center justify-center gap-1 shadow">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
          </svg>
          Download Excel
        </button>
        <button type="button" onclick="printSelectedCards()"
          class="flex-1 sm:flex-none px-3 py-1.5 rounded-lg bg-gradient-to-r from-pink-400 to-rose-400 text-white font-semibold text-xs flex items-center justify-center gap-1 shadow">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z" />
          </svg>
          Cetak Kartu
        </button>
        <form action="/admin/users/bulk-delete" method="POST" onsubmit="return confirmBulkDelete()" class="flex-1 sm:flex-none">
          <button type="submit"
            class="w-full px-3 py-1.5 rounded-lg bg-gradient-to-r from-rose-500 to-red-500 text-white font-semibold text-xs flex items-center justify-center gap-1 shadow">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
            </svg>
            Hapus <span id="selectedCount2">0</span>
          </button>
          <input type="hidden" name="user_ids" id="bulkDeleteIds" value="[]" />
        </form>
        <div class="flex items-center gap-2 w-full sm:w-auto mt-1 sm:mt-0">
          <select id="bulkMoveClassSelect" class="flex-1 rounded-lg bg-white border border-indigo-200 px-2 py-1.5 focus:outline-none focus:ring-2 focus:ring-indigo-500 text-xs">
            <option value="">Pilih Kelas Tujuan</option>
            <% classes.forEach(c => { %>
              <option value="<%= c.id %>"><%= c.name %></option>
            <% }) %>
            <option value="null">Tanpa Kelas</option>
          </select>
          <button type="button" onclick="bulkMoveClass()"
            class="px-3 py-1.5 rounded-lg bg-gradient-to-r from-indigo-500 to-purple-500 text-white font-semibold text-xs flex items-center gap-1 shadow whitespace-nowrap">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4" />
            </svg>
            Pindah Kelas
          </button>
        </div>
      </div>
    </div>

    <div id="users-table-section">
    <div class="flex items-center justify-between mb-4" id="daftar-pengguna">
      <h2 class="text-lg font-semibold text-teal-900">Daftar Pengguna</h2>
      <div class="text-sm text-teal-700">Total: <span class="font-semibold"><%= pagination.total %></span> pengguna</div>
    </div>

    <%# Banner peringatan siswa bermasalah SDMS %>
    <% if ((sdmsMissingCount > 0 || sdmsInactiveCount > 0) && !filters.sdms_status) { %>
    <div class="mb-4 rounded-xl border border-orange-300 bg-orange-50 p-4">
      <div class="flex items-start gap-3">
        <span class="text-2xl flex-shrink-0">⚠️</span>
        <div class="flex-1">
          <div class="font-semibold text-orange-800 text-sm">Siswa Perlu Diperhatikan</div>
          <div class="mt-1 text-xs text-orange-700 space-y-1">
            <% if (sdmsMissingCount > 0) { %>
              <div>• <strong><%= sdmsMissingCount %> siswa</strong> tidak ditemukan di SDMS (mungkin salah input atau perlu sinkronisasi)</div>
            <% } %>
            <% if (sdmsInactiveCount > 0) { %>
              <div>• <strong><%= sdmsInactiveCount %> siswa</strong> sudah tidak aktif di SDMS (keluar/lulus/pindah) tapi masih aktif di LMS</div>
            <% } %>
          </div>
          <div class="mt-3 flex flex-wrap gap-2">
            <% if (sdmsMissingCount > 0) { %>
              <a href="?role=STUDENT&sdms_status=missing&limit=100" class="px-3 py-1.5 rounded-lg bg-amber-500 hover:bg-amber-600 text-white text-xs font-semibold transition">
                Lihat <%= sdmsMissingCount %> Tidak Ada di SDMS
              </a>
            <% } %>
            <% if (sdmsInactiveCount > 0) { %>
              <a href="?role=STUDENT&sdms_status=inactive&limit=100" class="px-3 py-1.5 rounded-lg bg-orange-500 hover:bg-orange-600 text-white text-xs font-semibold transition">
                Lihat <%= sdmsInactiveCount %> Tidak Aktif di SDMS
              </a>
              <form method="POST" action="/admin/users/bulk-deactivate-sdms"
                onsubmit="return confirm('Nonaktifkan <%= sdmsInactiveCount %> siswa yang sudah tidak aktif di SDMS?')">
                <input type="hidden" name="type" value="inactive">
                <button type="submit" class="px-3 py-1.5 rounded-lg bg-red-500 hover:bg-red-600 text-white text-xs font-semibold transition">
                  🚫 Nonaktifkan <%= sdmsInactiveCount %> Siswa
                </button>
              </form>
            <% } %>
          </div>
        </div>
      </div>
    </div>
    <% } %>

    <%# Banner aksi batch saat filter sdms_status aktif %>
    <% if (filters.sdms_status === 'inactive') { %>
    <div class="mb-4 rounded-xl border border-red-300 bg-red-50 p-3 flex items-center justify-between gap-3">
      <span class="text-sm text-red-800">Menampilkan siswa yang sudah <strong>tidak aktif di SDMS</strong> tapi masih aktif di LMS.</span>
      <form method="POST" action="/admin/users/bulk-deactivate-sdms"
        onsubmit="return confirm('Nonaktifkan semua siswa yang ditampilkan?')">
        <input type="hidden" name="type" value="inactive">
        <button type="submit" class="px-3 py-1.5 rounded-lg bg-red-600 hover:bg-red-700 text-white text-xs font-semibold whitespace-nowrap">
          🚫 Nonaktifkan Semua
        </button>
      </form>
    </div>
    <% } %>
    <% if (filters.sdms_status === 'missing') { %>
    <div class="mb-4 rounded-xl border border-amber-300 bg-amber-50 p-3">
      <span class="text-sm text-amber-800">Menampilkan siswa yang <strong>tidak ditemukan di SDMS</strong>. Pastikan sudah sinkronisasi terbaru dari SDMS, atau siswa ini memang dibuat manual.</span>
    </div>
    <% } %>
    
    <!-- Filter Section -->
    <form method="GET" action="/admin/users" class="mb-4 grid md:grid-cols-7 gap-3" id="filterForm">
      <input type="text" name="search" value="<%= filters.search %>" placeholder="Cari username/nama..." 
             class="rounded-xl bg-white border border-teal-200 px-4 py-2 focus:outline-none focus:ring-2 focus:ring-teal-500 text-sm">
      
      <select name="role" onchange="autoSubmitFilter()" class="rounded-xl bg-white border border-teal-200 px-4 py-2 focus:outline-none focus:ring-2 focus:ring-teal-500 text-sm">
        <option value="">Semua Role</option>
        <option value="STUDENT" <%= filters.role === 'STUDENT' ? 'selected' : '' %>>Siswa</option>
        <option value="TEACHER" <%= filters.role === 'TEACHER' ? 'selected' : '' %>>Guru</option>
        <option value="PRINCIPAL" <%= filters.role === 'PRINCIPAL' ? 'selected' : '' %>>Kepala Sekolah</option>
        <option value="ADMIN" <%= filters.role === 'ADMIN' ? 'selected' : '' %>>Admin</option>
      </select>
      
      <select name="class" onchange="autoSubmitWithLimit(this)" class="rounded-xl bg-white border border-teal-200 px-4 py-2 focus:outline-none focus:ring-2 focus:ring-teal-500 text-sm">
        <option value="">Semua Kelas</option>
        <% classes.forEach(c => { %>
          <option value="<%= c.id %>" <%= String(filters.class) === String(c.id) ? 'selected' : '' %>><%= c.name %></option>
        <% }) %>
      </select>
      
      <select name="status" onchange="autoSubmitFilter()" class="rounded-xl bg-white border border-teal-200 px-4 py-2 focus:outline-none focus:ring-2 focus:ring-teal-500 text-sm">
        <option value="">Semua Status</option>
        <option value="active" <%= filters.status === 'active' ? 'selected' : '' %>>Aktif</option>
        <option value="inactive" <%= filters.status === 'inactive' ? 'selected' : '' %>>Nonaktif</option>
      </select>

      <%# Filter status SDMS %>
      <select name="sdms_status" onchange="autoSubmitFilter()" class="rounded-xl bg-white border border-orange-200 px-4 py-2 focus:outline-none focus:ring-2 focus:ring-orange-500 text-sm">
        <option value="" <%= !filters.sdms_status ? 'selected' : '' %>>🔗 Semua Status SDMS</option>
        <option value="missing" <%= filters.sdms_status === 'missing' ? 'selected' : '' %>>
          ⚠️ Tidak Ada di SDMS <% if (sdmsMissingCount > 0) { %>(<%= sdmsMissingCount %>)<% } %>
        </option>
        <option value="inactive" <%= filters.sdms_status === 'inactive' ? 'selected' : '' %>>
          🚫 Tidak Aktif di SDMS <% if (sdmsInactiveCount > 0) { %>(<%= sdmsInactiveCount %>)<% } %>
        </option>
      </select>
      
      <select name="limit" id="limitSelect" class="rounded-xl bg-white border border-teal-200 px-4 py-2 focus:outline-none focus:ring-2 focus:ring-teal-500 text-sm">
        <option value="10" <%= pagination.limit == 10 ? 'selected' : '' %>>10 per halaman</option>
        <option value="20" <%= pagination.limit == 20 ? 'selected' : '' %>>20 per halaman</option>
        <option value="40" <%= pagination.limit == 40 ? 'selected' : '' %>>40 per halaman</option>
        <option value="50" <%= pagination.limit == 50 ? 'selected' : '' %>>50 per halaman</option>
        <option value="100" <%= pagination.limit == 100 ? 'selected' : '' %>>100 per halaman</option>
      </select>
      
      <div class="flex gap-2">
        <button type="submit" class="flex-1 rounded-xl bg-gradient-to-r from-teal-400 to-emerald-500 hover:from-teal-500 hover:to-emerald-600 text-white font-semibold py-2 text-sm transition-all duration-200 shadow-md hover:shadow-lg transform hover:scale-105">
          Filter
        </button>
        <a href="/admin/users" class="px-4 py-2 rounded-xl bg-gradient-to-r from-pink-400 to-rose-400 hover:from-pink-500 hover:to-rose-500 text-white font-medium text-sm transition-all duration-200 shadow-md hover:shadow-lg transform hover:scale-105 flex items-center justify-center">
          Reset
        </a>
      </div>
    </form>
    
    <!-- Table -->
    <!-- Desktop: tabel biasa | Mobile: card per baris -->
    <div class="hidden md:block overflow-x-auto">
      <table class="w-full text-sm">
        <thead class="text-teal-700">
          <tr>
            <th class="text-left py-2 w-8">
              <input type="checkbox" id="selectAll" class="w-4 h-4 rounded border-teal-300 text-teal-600 focus:ring-teal-500 cursor-pointer" />
            </th>
            <th class="text-left py-2 w-40">Username</th>
            <th class="text-left py-2">Nama</th>
            <th class="text-left py-2 w-24">Role</th>
            <th class="text-left py-2 w-20">Kelas</th>
            <th class="text-left py-2 w-16">Status</th>
            <th class="text-right py-2">Aksi</th>
          </tr>
        </thead>
        <tbody>
          <% if (users.length === 0) { %>
            <tr>
              <td colspan="7" class="py-8 text-center text-teal-600">Tidak ada data pengguna.</td>
            </tr>
          <% } %>
          <% users.forEach(u => { %>
            <tr id="user-row-<%= u.id %>" class="border-t border-teal-200">
              <td class="py-2">
                <input type="checkbox" class="user-checkbox w-4 h-4 rounded border-teal-300 text-teal-600 focus:ring-teal-500 cursor-pointer" data-user-id="<%= u.id %>" />
              </td>
              <td class="py-2 font-mono user-username text-teal-900"><%= u.username %></td>
              <td class="py-2 user-fullname text-teal-900"><%= u.full_name %></td>
              <td class="py-2 user-role"><span class="px-2 py-1 rounded-lg border border-teal-300 bg-white text-teal-800 font-medium"><%= ({TEACHER:'Guru',STUDENT:'Siswa',ADMIN:'Admin',PRINCIPAL:'Kepala Sekolah'})[u.role]||u.role %></span></td>
              <td class="py-2 text-teal-700 user-class"><%= u.class_name || '-' %></td>
              <td class="py-2 user-active text-teal-800">
                <%= u.is_active ? 'Aktif' : 'Nonaktif' %>
                <% if (u.sdms_status === 'missing') { %>
                  <span title="Tidak ditemukan di SDMS — cek sinkronisasi" class="ml-1 inline-flex items-center px-1.5 py-0.5 rounded-full text-xs font-semibold bg-amber-100 text-amber-800 border border-amber-300 cursor-help">⚠️ Tdk ada di SDMS</span>
                <% } else if (u.sdms_status === 'inactive') { %>
                  <span title="Sudah tidak aktif di SDMS: <%= u.sdms_status_text || 'tidak aktif' %>" class="ml-1 inline-flex items-center px-1.5 py-0.5 rounded-full text-xs font-semibold bg-red-100 text-red-800 border border-red-300 cursor-help">🚫 <%= u.sdms_status_text || 'Tdk aktif SDMS' %></span>
                <% } %>
              </td>
              <td class="py-2">
                <div class="flex justify-end items-center gap-1 flex-nowrap">
                  <button type="button" data-user-id="<%= u.id %>" class="btn-open-user-modal px-3 py-1.5 rounded-lg bg-gradient-to-r from-blue-400 to-blue-500 hover:from-blue-500 hover:to-blue-600 text-white font-medium transition-all duration-200 shadow-sm hover:shadow-md transform hover:scale-105">Edit</button>
                  <button type="button" onclick="toggleUser(<%= u.id %>, this)" data-active="<%= u.is_active ? '1' : '0' %>" class="btn-toggle px-3 py-1.5 rounded-lg text-white font-medium transition-all duration-200 shadow-sm hover:shadow-md transform hover:scale-105 <%= u.is_active ? 'bg-gradient-to-r from-yellow-400 to-orange-400 hover:from-yellow-500 hover:to-orange-500' : 'bg-gradient-to-r from-green-400 to-emerald-500 hover:from-green-500 hover:to-emerald-600' %>">
                    <%= u.is_active ? 'Nonaktifkan' : 'Aktifkan' %>
                  </button>
                  <form action="/admin/users/<%= u.id %>/reset" method="POST" class="flex gap-1">
                    <input name="new_password" placeholder="pwd baru" class="w-20 rounded-lg bg-white border-2 border-orange-300 px-2 py-1 text-orange-900 text-xs focus:outline-none focus:ring-2 focus:ring-orange-400 focus:border-transparent" />
                    <button type="submit" class="px-2 py-1.5 rounded-lg bg-gradient-to-r from-orange-400 to-orange-500 hover:from-orange-500 hover:to-orange-600 text-white font-medium text-xs transition-all duration-200 shadow-sm">Reset</button>
                  </form>
                  <form action="/admin/users/<%= u.id %>/delete" method="POST" onsubmit="return confirm('Yakin hapus pengguna <%= u.full_name %>?')">
                    <button type="submit" class="px-2 py-1.5 rounded-lg bg-gradient-to-r from-rose-400 to-rose-500 hover:from-rose-500 hover:to-rose-600 text-white font-medium text-xs transition-all duration-200 shadow-sm">Hapus</button>
                  </form>
                </div>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>

    <!-- Mobile: card per pengguna -->
    <div class="md:hidden space-y-3">
      <% if (users.length === 0) { %>
        <div class="py-8 text-center text-teal-600">Tidak ada data pengguna.</div>
      <% } %>
      <% users.forEach(u => { %>
        <div id="user-row-<%= u.id %>" class="bg-white rounded-xl border border-teal-200 p-4 shadow-sm">
          <!-- Baris atas: checkbox + nama + status -->
          <div class="flex items-start gap-3">
            <input type="checkbox" class="user-checkbox mt-1 w-4 h-4 rounded border-teal-300 text-teal-600 focus:ring-teal-500 cursor-pointer flex-shrink-0" data-user-id="<%= u.id %>" />
            <div class="flex-1 min-w-0">
              <div class="flex items-center gap-2 flex-wrap">
                <span class="font-semibold text-teal-900 user-fullname"><%= u.full_name %></span>
                <span class="px-2 py-0.5 rounded-lg border border-teal-300 bg-teal-50 text-teal-700 text-xs font-medium user-role"><%= ({TEACHER:'Guru',STUDENT:'Siswa',ADMIN:'Admin',PRINCIPAL:'Kepala Sekolah'})[u.role]||u.role %></span>
                <span class="px-2 py-0.5 rounded-lg text-xs font-medium user-active <%= u.is_active ? 'bg-green-100 text-green-700' : 'bg-red-100 text-red-700' %>"><%= u.is_active ? 'Aktif' : 'Nonaktif' %></span>
                <% if (u.sdms_status === 'missing') { %>
                  <span class="px-1.5 py-0.5 rounded-full text-xs font-semibold bg-amber-100 text-amber-800 border border-amber-300">⚠️ Tdk ada di SDMS</span>
                <% } else if (u.sdms_status === 'inactive') { %>
                  <span class="px-1.5 py-0.5 rounded-full text-xs font-semibold bg-red-100 text-red-800 border border-red-300">🚫 <%= u.sdms_status_text || 'Tdk aktif SDMS' %></span>
                <% } %>
              </div>
              <div class="mt-1 text-xs text-teal-600 font-mono user-username truncate"><%= u.username %></div>
              <% if (u.class_name) { %>
                <div class="mt-0.5 text-xs text-teal-500 user-class"><%= u.class_name %></div>
              <% } %>
            </div>
          </div>
          <!-- Baris bawah: tombol aksi -->
          <div class="mt-3 flex flex-wrap gap-2">
            <button type="button" data-user-id="<%= u.id %>" class="btn-open-user-modal flex-1 px-3 py-2 rounded-lg bg-gradient-to-r from-blue-400 to-blue-500 text-white font-medium text-sm text-center">Edit</button>
            <button type="button" onclick="toggleUser(<%= u.id %>, this)" data-active="<%= u.is_active ? '1' : '0' %>" class="btn-toggle flex-1 px-3 py-2 rounded-lg text-white font-medium text-sm <%= u.is_active ? 'bg-gradient-to-r from-yellow-400 to-orange-400' : 'bg-gradient-to-r from-green-400 to-emerald-500' %>">
              <%= u.is_active ? 'Nonaktifkan' : 'Aktifkan' %>
            </button>
            <form action="/admin/users/<%= u.id %>/delete" method="POST" onsubmit="return confirm('Yakin hapus pengguna <%= u.full_name %>?')" class="flex-1">
              <button type="submit" class="w-full px-3 py-2 rounded-lg bg-gradient-to-r from-rose-400 to-rose-500 text-white font-medium text-sm">Hapus</button>
            </form>
            <form action="/admin/users/<%= u.id %>/reset" method="POST" class="w-full flex gap-2 mt-1">
              <input name="new_password" placeholder="Password baru..." class="flex-1 rounded-lg bg-white border-2 border-orange-300 px-3 py-2 text-sm text-orange-900 focus:outline-none focus:ring-2 focus:ring-orange-400" />
              <button type="submit" class="px-4 py-2 rounded-lg bg-gradient-to-r from-orange-400 to-orange-500 text-white font-medium text-sm">Reset</button>
            </form>
          </div>
        </div>
      <% }) %>
    </div>
    
    <!-- Pagination -->
    <% if (pagination.totalPages > 1) { %>
      <div class="mt-4 flex items-center justify-between border-t border-teal-200 pt-4">
        <div class="text-sm text-teal-700">
          Menampilkan <%= (pagination.page - 1) * pagination.limit + 1 %> - <%= Math.min(pagination.page * pagination.limit, pagination.total) %> dari <%= pagination.total %> data
        </div>
        <div class="flex gap-2">
          <% if (pagination.page > 1) { %>
            <a href="?page=<%= pagination.page - 1 %>&limit=<%= pagination.limit %>&search=<%= filters.search %>&role=<%= filters.role %>&class=<%= filters.class %>&status=<%= filters.status %>#daftar-pengguna" 
               class="px-4 py-2 rounded-lg bg-gradient-to-r from-blue-400 to-cyan-400 hover:from-blue-500 hover:to-cyan-500 text-white font-medium text-sm transition-all duration-200 shadow-sm hover:shadow-md transform hover:scale-105">
              ← Sebelumnya
            </a>
          <% } %>
          
          <% 
            const startPage = Math.max(1, pagination.page - 2);
            const endPage = Math.min(pagination.totalPages, pagination.page + 2);
            for (let i = startPage; i <= endPage; i++) { 
          %>
            <a href="?page=<%= i %>&limit=<%= pagination.limit %>&search=<%= filters.search %>&role=<%= filters.role %>&class=<%= filters.class %>&status=<%= filters.status %>#daftar-pengguna" 
               class="px-4 py-2 rounded-lg <%= i === pagination.page ? 'bg-gradient-to-r from-teal-500 to-emerald-500 text-white shadow-md' : 'bg-gradient-to-r from-gray-200 to-gray-300 hover:from-gray-300 hover:to-gray-400 text-gray-700' %> font-medium text-sm transition-all duration-200 hover:shadow-md transform hover:scale-105">
              <%= i %>
            </a>
          <% } %>
          
          <% if (pagination.page < pagination.totalPages) { %>
            <a href="?page=<%= pagination.page + 1 %>&limit=<%= pagination.limit %>&search=<%= filters.search %>&role=<%= filters.role %>&class=<%= filters.class %>&status=<%= filters.status %>#daftar-pengguna" 
               class="px-4 py-2 rounded-lg bg-gradient-to-r from-blue-400 to-cyan-400 hover:from-blue-500 hover:to-cyan-500 text-white font-medium text-sm transition-all duration-200 shadow-sm hover:shadow-md transform hover:scale-105">
              Selanjutnya →
            </a>
          <% } %>
        </div>
      </div>
    <% } %>
    </div><!-- /users-table-section -->
  </div>

  <!-- Card Tambah Pengguna -->
  <div class="rounded-2xl border border-indigo-200 bg-gradient-to-br from-indigo-50 to-indigo-100 p-5">
