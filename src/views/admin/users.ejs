            onclick="return validateDeleteByRole()"
            class="flex-1 px-4 py-2.5 rounded-xl bg-gradient-to-r from-red-600 to-rose-700 hover:from-red-700 hover:to-rose-800 text-white font-semibold text-sm shadow-md transition-all flex items-center justify-center gap-2">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
            </svg>
            Hapus Semua
          </button>
        </div>
      </form>
    </div>

  </div>
</div>

<script>
  function toggleCustomPwd(val) {
    const wrap = document.getElementById('custom_pwd_wrap');
    if (val === 'custom') {
      wrap.classList.remove('hidden');
    } else {
      wrap.classList.add('hidden');
    }
  }

  // Bulk delete functionality
  function initCheckboxes() {
    const selectAllCheckbox = document.getElementById('selectAll');
    const userCheckboxes = document.querySelectorAll('.user-checkbox');
    const bulkActionBar = document.getElementById('bulkActionBar');
    const selectedCountSpan = document.getElementById('selectedCount');
    const bulkDeleteIdsInput = document.getElementById('bulkDeleteIds');

    if (!selectAllCheckbox || !bulkActionBar) return;

    // Karena setiap user punya 2 checkbox (desktop + mobile), gunakan Set untuk deduplikasi
    function getSelectedIds() {
      const seen = new Set();
      return Array.from(userCheckboxes)
        .filter(cb => cb.checked)
        .map(cb => cb.getAttribute('data-user-id'))
        .filter(id => {
          if (seen.has(id)) return false;
          seen.add(id);
          return true;
        });
    }

    function updateBulkActionBar() {
      const selectedIds = getSelectedIds();
      
      if (selectedIds.length > 0) {
        bulkActionBar.classList.remove('hidden');
        selectedCountSpan.textContent = selectedIds.length;
        // Sync ke tombol hapus juga
        const sc2 = document.getElementById('selectedCount2');
        if (sc2) sc2.textContent = selectedIds.length;
        bulkDeleteIdsInput.value = JSON.stringify(selectedIds);
      } else {
        bulkActionBar.classList.add('hidden');
      }
      
      // Update select all checkbox state — hitung berdasarkan unique user ID
      const totalUsers = new Set(Array.from(userCheckboxes).map(cb => cb.getAttribute('data-user-id'))).size;
      const allChecked = totalUsers > 0 && selectedIds.length === totalUsers;
      const someChecked = selectedIds.length > 0 && !allChecked;
      selectAllCheckbox.checked = allChecked;
      selectAllCheckbox.indeterminate = someChecked;
    }

    selectAllCheckbox.addEventListener('change', function() {
      userCheckboxes.forEach(cb => {
        cb.checked = this.checked;
      });
      updateBulkActionBar();
    });

    // Sync pasangan checkbox desktop↔mobile saat salah satu diubah
    userCheckboxes.forEach(cb => {
      cb.addEventListener('change', function() {
        const userId = this.getAttribute('data-user-id');
        document.querySelectorAll(`.user-checkbox[data-user-id="${userId}"]`).forEach(pair => {
          pair.checked = this.checked;
        });
        updateBulkActionBar();
      });
    });

    window.confirmBulkDelete = function() {
      const count = selectedCountSpan.textContent;
      return confirm(`Anda yakin ingin menghapus ${count} pengguna?\n\nPeringatan: Data terkait (ujian, tugas, notifikasi) juga akan dihapus!`);
    };

    // Bulk move class functionality - moved inside to access userCheckboxes
    window.bulkMoveClass = function() {
      const selectedIds = getSelectedIds();
      
      if (selectedIds.length === 0) {
        alert('Pilih pengguna yang ingin dipindah kelas terlebih dahulu.');
        return;
      }
      
      const targetClassId = document.getElementById('bulkMoveClassSelect').value;
      if (!targetClassId) {
        alert('Pilih kelas tujuan terlebih dahulu.');
        return;
      }
      
      const targetClassName = targetClassId === 'null' ? 'Tanpa Kelas' : 
        document.querySelector(`#bulkMoveClassSelect option[value="${targetClassId}"]`).textContent;
      
      if (!confirm(`Anda yakin ingin memindahkan ${selectedIds.length} pengguna ke kelas "${targetClassName}"?`)) {
        return;
      }
      
      // Create and submit form
      const form = document.createElement('form');
      form.method = 'POST';
      form.action = '/admin/users/bulk-move-class';
      
      const userIdsInput = document.createElement('input');
      userIdsInput.type = 'hidden';
      userIdsInput.name = 'user_ids';
      userIdsInput.value = JSON.stringify(selectedIds);
      form.appendChild(userIdsInput);
      
      const classIdInput = document.createElement('input');
      classIdInput.type = 'hidden';
      classIdInput.name = 'class_id';
      classIdInput.value = targetClassId === 'null' ? '' : targetClassId;
      form.appendChild(classIdInput);
      
      document.body.appendChild(form);
      form.submit();
    };
    
    // Print selected cards functionality
    window.printSelectedCards = function() {
      const selectedIds = getSelectedIds();
      
      if (selectedIds.length === 0) {
        alert('Pilih pengguna yang ingin dicetak kartunya terlebih dahulu.');
        return;
      }
      
      // Open print page with selected IDs
      window.open(`/admin/users/print-cards?ids=${selectedIds.join(',')}`, '_blank');
    };
    
    // Download selected excel functionality
    window.downloadSelectedExcel = function() {
      const selectedIds = getSelectedIds();
      
      if (selectedIds.length === 0) {
        alert('Pilih pengguna yang ingin didownload terlebih dahulu.');
        return;
      }
      
      // Download excel with selected IDs
      window.location.href = `/admin/users/download?ids=${selectedIds.join(',')}`;
    };
  } // end initCheckboxes
  initCheckboxes();

  // Modal edit functionality
  (function () {
    const modal = document.getElementById('userModal');
    const form = document.getElementById('userModalForm');
    const btnSave = document.getElementById('um_save');
    const elErr = document.getElementById('um_error');
    const elOk = document.getElementById('um_success');

    const elId = document.getElementById('um_id');
    const elUsername = document.getElementById('um_username');
    const elFullName = document.getElementById('um_full_name');
    const elNoPeserta = document.getElementById('um_nomor_peserta');
    const elTempatLahir = document.getElementById('um_tempat_lahir');
    const elTanggalLahir = document.getElementById('um_tanggal_lahir');
    const elRole = document.getElementById('um_role');
    const elClassId = document.getElementById('um_class_id');
    const elActive = document.getElementById('um_is_active');
    const elNewPwd = document.getElementById('um_new_password');

    function showModal() {
      modal.classList.remove('hidden');
      modal.setAttribute('aria-hidden', 'false');
    }
    function hideModal() {
      modal.classList.add('hidden');
      modal.setAttribute('aria-hidden', 'true');
      elErr.classList.add('hidden');
      elOk.classList.add('hidden');
      elErr.textContent = '';
      elOk.textContent = '';
      elNewPwd.value = '';
    }
    function setLoading(on) {
      btnSave.disabled = on;
      btnSave.textContent = on ? 'Menyimpan...' : 'Simpan';
    }
    function showError(msg) {
      elOk.classList.add('hidden');
      elErr.textContent = msg || 'Terjadi kesalahan.';
      elErr.classList.remove('hidden');
    }
    function showSuccess(msg) {
      elErr.classList.add('hidden');
      elOk.textContent = msg || 'Berhasil.';
      elOk.classList.remove('hidden');
    }

    async function openForUser(userId) {
      setLoading(true);
      try {
        const r = await fetch(`/admin/users/${userId}/json`, { headers: { 'Accept': 'application/json' } });
        const j = await r.json();
        if (!r.ok || !j.ok) throw new Error(j && j.message ? j.message : 'Gagal memuat data pengguna.');

        elId.value = j.user.id;
        elUsername.value = j.user.username || '';
        elFullName.value = j.user.full_name || '';
        elNoPeserta.value = j.user.nomor_peserta || '';
        elTempatLahir.value = j.user.tempat_lahir || '';
        // Format tanggal: ambil YYYY-MM-DD saja
        elTanggalLahir.value = j.user.tanggal_lahir ? String(j.user.tanggal_lahir).substring(0, 10) : '';
        elRole.value = j.user.role || 'STUDENT';
        elClassId.value = (j.user.class_id === null || j.user.class_id === undefined) ? '' : String(j.user.class_id);
        elActive.value = String(j.user.is_active ? 1 : 0);
        showModal();
      } catch (e) {
        alert(e.message || 'Gagal memuat data pengguna.');
      } finally {
        setLoading(false);
      }
    }

    document.querySelectorAll('.btn-open-user-modal').forEach(btn => {
      btn.addEventListener('click', () => openForUser(btn.getAttribute('data-user-id')));
    });
    modal.querySelectorAll('[data-close-user-modal]').forEach(el => el.addEventListener('click', hideModal));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !modal.classList.contains('hidden')) hideModal();
    });

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const id = elId.value;
      setLoading(true);
      try {
        const payload = {
          username: elUsername.value,
          full_name: elFullName.value,
          nomor_peserta: elNoPeserta.value,
          tempat_lahir: elTempatLahir.value,
          tanggal_lahir: elTanggalLahir.value,
          role: elRole.value,
          class_id: elClassId.value,
          is_active: elActive.value,
          new_password: elNewPwd.value
        };
        const r = await fetch(`/admin/users/${id}/ajax-update`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
          body: JSON.stringify(payload)
        });
        const j = await r.json();
        if (!r.ok || !j.ok) throw new Error(j && j.message ? j.message : 'Gagal menyimpan perubahan.');

        // Update row in table without reload
        const row = document.getElementById(`user-row-${id}`);
        if (row && j.user) {
          const roleLabels = {TEACHER:'Guru',STUDENT:'Siswa',ADMIN:'Admin',PRINCIPAL:'Kepala Sekolah'};
          const roleLabel = roleLabels[j.user.role] || j.user.role || '';
          row.querySelector('.user-username').textContent = j.user.username || '';
          row.querySelector('.user-fullname').textContent = j.user.full_name || '';
          row.querySelector('.user-role').innerHTML = `<span class="px-2 py-1 rounded-lg border border-teal-300 bg-white text-teal-800 font-medium">${roleLabel}</span>`;
          row.querySelector('.user-class').textContent = j.user.class_name || '-';
          row.querySelector('.user-active').textContent = j.user.is_active ? 'Aktif' : 'Nonaktif';
        }

        showSuccess('Perubahan tersimpan.');
        setTimeout(hideModal, 650);
      } catch (err) {
        showError(err.message || 'Gagal menyimpan perubahan.');
      } finally {
        setLoading(false);
      }
    });
  })();

  // Toggle aktif/nonaktif tanpa pindah halaman
  async function toggleUser(userId, btn) {
    btn.disabled = true;
    btn.style.opacity = '0.6';
    try {
      const res = await fetch(`/admin/users/${userId}/toggle`, {
        method: 'POST',
        headers: { 'X-Requested-With': 'XMLHttpRequest' }
      });
      const data = await res.json();
      if (data.success) {
        const isActive = data.is_active;
        // Update tombol
        btn.setAttribute('data-active', isActive ? '1' : '0');
        // Teks tanpa icon untuk semua tampilan
        btn.textContent = isActive ? 'Nonaktifkan' : 'Aktifkan';
        // Update class tombol
        const isMobileCard = !!btn.closest('[id^="user-row-"]') && !btn.closest('tr');
        const baseClass = isMobileCard
          ? 'btn-toggle flex-1 px-3 py-2 rounded-lg text-white font-medium text-sm'
          : 'btn-toggle px-3 py-1.5 rounded-lg text-white font-medium transition-all duration-200 shadow-sm hover:shadow-md transform hover:scale-105';
        btn.className = `${baseClass} ${
          isActive
            ? 'bg-gradient-to-r from-yellow-400 to-orange-400 hover:from-yellow-500 hover:to-orange-500'
            : 'bg-gradient-to-r from-green-400 to-emerald-500 hover:from-green-500 hover:to-emerald-600'
        }`;
        // Update status di baris/card yang sama
        const row = btn.closest('tr') || btn.closest('[id^="user-row-"]');
        if (row) {
          const statusCell = row.querySelector('.user-active');
          if (statusCell) {
            statusCell.textContent = isActive ? 'Aktif' : 'Nonaktif';
            // Update warna badge di card mobile
            if (statusCell.tagName === 'SPAN') {
              statusCell.className = `px-2 py-0.5 rounded-lg text-xs font-medium user-active ${isActive ? 'bg-green-100 text-green-700' : 'bg-red-100 text-red-700'}`;
            }
          }
        }
      } else {
        alert(data.message || 'Gagal mengubah status.');
      }
    } catch (e) {
      alert('Terjadi kesalahan. Coba lagi.');
    } finally {
      btn.disabled = false;
      btn.style.opacity = '1';
    }
  }
</script>

<script>
  // ── Hapus Massal berdasarkan Role ──────────────────────────────────────
  const ROLE_CONFIRM_MAP = {
    STUDENT:   'HAPUS SISWA',
    TEACHER:   'HAPUS GURU',
    PRINCIPAL: 'HAPUS KEPSEK'
  };

  function openDeleteByRoleModal() {
    const modal = document.getElementById('deleteByRoleModal');
    modal.classList.remove('hidden');
    modal.classList.add('flex');
    document.getElementById('deleteRoleSelect').value = '';
    document.getElementById('deleteConfirmInput').value = '';
    document.getElementById('confirmHintText').textContent = 'HAPUS SISWA';
  }

  function closeDeleteByRoleModal() {
    const modal = document.getElementById('deleteByRoleModal');
    modal.classList.add('hidden');
    modal.classList.remove('flex');
  }

  function updateDeleteConfirmHint() {
    const role = document.getElementById('deleteRoleSelect').value;
    const hint = ROLE_CONFIRM_MAP[role] || 'HAPUS SISWA';
    document.getElementById('confirmHintText').textContent = hint;
    document.getElementById('deleteConfirmInput').value = '';
  }

  function validateDeleteByRole() {
    const role = document.getElementById('deleteRoleSelect').value;
    const typed = document.getElementById('deleteConfirmInput').value.trim();
    const expected = ROLE_CONFIRM_MAP[role];
    if (!role) { alert('Pilih role terlebih dahulu.'); return false; }
    if (typed !== expected) { alert('Teks konfirmasi salah. Ketik persis: ' + expected); return false; }
    return confirm('⚠️ KONFIRMASI TERAKHIR\n\nAnda akan menghapus SEMUA pengguna dengan role "' + role + '".\nData ini TIDAK DAPAT dikembalikan!\n\nLanjutkan?');
  }

  document.getElementById('deleteByRoleModal').addEventListener('click', function(e) {
    if (e.target === this) closeDeleteByRoleModal();
  });
</script>

