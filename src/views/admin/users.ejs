<script>
// Saat pilih kelas, otomatis set limit ke 40 lalu submit form
function autoSubmitWithLimit(selectEl) {
  const form = selectEl.closest('form');
  if (!form) return;
  const limitSel = form.querySelector('#limitSelect');
  // Kalau pilih kelas tertentu (bukan "Semua Kelas"), set limit 40
  if (selectEl.value && limitSel) {
    limitSel.value = '40';
  }
  form.submit();
}

// Saat pilih role atau status, langsung submit form
function autoSubmitFilter() {
  const form = document.getElementById('filterForm');
  if (form) form.submit();
}

// ── Pagination AJAX — ganti halaman tanpa scroll ke atas ──────────────────
(function() {
  function loadPage(url) {
    fetch(url, { headers: { 'X-Requested-With': 'XMLHttpRequest' } })
      .then(r => r.text())
      .then(html => {
        // Parse HTML response
        const parser = new DOMParser();
        const doc = parser.parseFromString(html, 'text/html');
        const newSection = doc.getElementById('users-table-section');
        const curSection = document.getElementById('users-table-section');
        if (newSection && curSection) {
          curSection.innerHTML = newSection.innerHTML;
          // Re-attach event listeners setelah replace konten
          initCheckboxes();
        }
        // Update URL di browser tanpa reload
        history.pushState({}, '', url.replace('#daftar-pengguna', ''));
      })
      .catch(() => {
        // Fallback: navigasi biasa
        window.location.href = url;
      });
  }

  document.addEventListener('click', function(e) {
    const link = e.target.closest('a[href*="page="]');
    if (!link) return;
    e.preventDefault();
    loadPage(link.href);
  });
})();
</script>

<script>
async function submitNonaktifDomain() {
  const konfirmasi = document.getElementById('confirmDomainInput').value.trim();
  if (konfirmasi !== 'NONAKTIFKAN') {
    alert('Ketik NONAKTIFKAN untuk konfirmasi.');
    return;
  }
  const domain_type = document.querySelector('input[name="domain_type"]:checked')?.value || 'student_domain';
  const btn = document.getElementById('btnNonaktifkanSubmit');
  btn.disabled = true;
  btn.textContent = '⏳ Memproses...';

  try {
    const res = await fetch('/admin/users/bulk-deactivate-domain', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest' },
      body: JSON.stringify({ domain_type })
    });
    const data = await res.json();
    if (data.ok) {
      document.getElementById('modalNonaktifDomain').classList.add('hidden');
      document.getElementById('modalNonaktifDomain').style.display = '';
      // Tampilkan toast sukses
      showDomainToast('✅ ' + data.message, 'green');
      // Reload tabel setelah 1.5 detik
      setTimeout(() => window.location.reload(), 1500);
    } else {
      showDomainToast('❌ ' + (data.message || 'Gagal menonaktifkan akun.'), 'red');
    }
  } catch (e) {
    showDomainToast('❌ Terjadi kesalahan: ' + e.message, 'red');
  } finally {
    btn.disabled = false;
    btn.textContent = '🚫 Nonaktifkan Sekarang';
  }
}

function showDomainToast(msg, color) {
  let t = document.getElementById('domainToast');
  if (!t) {
    t = document.createElement('div');
    t.id = 'domainToast';
    t.style.cssText = 'position:fixed;bottom:24px;right:24px;z-index:9999;padding:12px 20px;border-radius:12px;font-size:14px;font-weight:600;box-shadow:0 4px 16px rgba(0,0,0,.2);transition:opacity .3s;max-width:360px;';
    document.body.appendChild(t);
  }
  t.textContent = msg;
  t.style.background = color === 'green' ? '#16a34a' : '#dc2626';
  t.style.color = '#fff';
  t.style.opacity = '1';
  clearTimeout(t._hide);
  t._hide = setTimeout(() => { t.style.opacity = '0'; }, 4000);
}
</script>
