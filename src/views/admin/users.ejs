            <option value="username">Sama dengan Username (default)</option>
            <option value="custom">Password Khusus (semua sama)</option>
          </select>
        </div>
        <div id="custom_pwd_wrap" class="hidden">
          <label class="text-sm text-orange-700 font-medium">Password Baru</label>
          <input name="custom_password" placeholder="Min. 4 karakter"
            class="mt-1 w-full rounded-xl bg-white border border-orange-200 px-4 py-2 focus:outline-none focus:ring-2 focus:ring-orange-500" />
        </div>
        <div>
          <label class="text-sm text-orange-700 font-medium">Filter Role</label>
          <select name="role_filter"
            class="mt-1 w-full rounded-xl bg-white border border-orange-200 px-4 py-2 focus:outline-none focus:ring-2 focus:ring-orange-500">
            <option value="">Semua Role</option>
            <option value="STUDENT">Siswa</option>
            <option value="TEACHER">Guru</option>
