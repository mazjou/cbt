<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <title><%= title %></title>
  <style>
    *{margin:0;padding:0;box-sizing:border-box;}
    body{font-family:Arial,sans-serif;background:#e5e7eb;}

    /* ── Kontrol bar ─────────────────────────────────────────────────── */
    .no-print{background:white;padding:12px 20px;display:flex;align-items:center;
      justify-content:space-between;flex-wrap:wrap;gap:10px;
      box-shadow:0 2px 8px rgba(0,0,0,.12);margin-bottom:14px;}
    .no-print h2{font-size:15px;font-weight:700;color:#1e293b;}
    .no-print small{font-size:12px;color:#64748b;}
    .ctrl{display:flex;gap:8px;align-items:center;flex-wrap:wrap;}
    .btn{padding:8px 18px;border-radius:8px;font-weight:700;font-size:13px;
      cursor:pointer;border:none;text-decoration:none;display:inline-flex;
      align-items:center;gap:6px;}
    .btn-print{background:linear-gradient(135deg,#4f46e5,#7c3aed);color:white;}
    .btn-back{background:#f1f5f9;color:#475569;}
    select.fs{padding:6px 10px;border-radius:7px;border:2px solid #e2e8f0;
      font-size:13px;color:#475569;background:white;}

    /* ── Halaman A4 portrait — 10 kartu (2 × 5) ────────────────────────
       Halaman: 210 × 297mm. Padding: 6mm semua sisi.
       Area cetak: 198 × 285mm.
       Gap kolom: 4mm. Gap baris: 3mm × 4 = 12mm.
       Tinggi per kartu: (285 - 12) / 5 = 54.6mm → 54mm.
       Lebar per kartu: (198 - 4) / 2 = 97mm.
    ──────────────────────────────────────────────────────────────────── */
    .page{
      width:210mm;
      height:297mm;
      margin:0 auto 16px;
      background:white;
      padding:6mm;
      display:grid;
      grid-template-columns:1fr 1fr;
      grid-template-rows:repeat(5,54mm);
      gap:3mm 4mm;
      overflow:hidden;
    }

    /* ── Kartu ──────────────────────────────────────────────────────── */
    .kartu{
      height:54mm;
      border:1px solid #555;
      background:white;
      display:flex;
      flex-direction:column;
      overflow:hidden;
    }

    /* Header: logo | judul | QR — setinggi 18mm */
    .k-head{
      height:18mm;
      flex-shrink:0;
      display:flex;
      align-items:center;
      border-bottom:1px solid #555;
      padding:1mm 2mm;
      gap:2mm;
      background:white;
    }
    .k-logo{
      flex-shrink:0;
      width:14mm;
      display:flex;align-items:center;justify-content:center;
    }
    .k-logo img{width:13mm;height:13mm;object-fit:contain;}
    .k-title{
      flex:1;
      text-align:center;
      display:flex;flex-direction:column;align-items:center;justify-content:center;
    }
    .k-title .t1{font-size:7pt;font-weight:900;text-transform:uppercase;
      color:#111;letter-spacing:.3px;line-height:1.3;}
    .k-title .t2{font-size:6.5pt;font-weight:700;color:#1e3a8a;margin-top:.5mm;
      line-height:1.3;}
    .k-title .t3{font-size:5.5pt;color:#374151;margin-top:.3mm;}
    .k-qr{
      flex-shrink:0;
      width:16mm;
      display:flex;flex-direction:column;align-items:center;justify-content:center;
      gap:.5mm;
    }
    .k-qr-wrap{
      width:15mm;height:15mm;
      display:flex;align-items:center;justify-content:center;
      background:white;
      overflow:hidden;
    }
    .k-qr-label{font-size:4pt;color:#555;text-align:center;font-weight:600;
      letter-spacing:.3px;text-transform:uppercase;}

    /* Body: tabel data — sisa ruang */
    .k-body{
      flex:1;
      padding:1.5mm 3mm;
      overflow:hidden;
      display:flex;
      align-items:flex-start;
    }
    .dt{width:100%;border-collapse:collapse;}
    .dt td{
      font-size:6pt;
      padding:.4mm 0;
      vertical-align:middle;
      color:#111;
      line-height:1.25;
    }
    .dt .lb{width:24mm;color:#444;white-space:nowrap;font-weight:400;}
    .dt .sp{width:4mm;text-align:center;color:#444;}
    .dt .vl{font-weight:700;font-size:6pt;word-break:break-all;color:#111;}
    .dt .mono{font-family:'Courier New',monospace;font-size:5.8pt;
      font-weight:700;color:#1e3a8a;}

    /* Footer: 5mm */
    .k-foot{
      height:5mm;
      flex-shrink:0;
      border-top:1px solid #ccc;
      display:flex;align-items:center;justify-content:center;
      font-size:4pt;color:#888;background:#f9fafb;
      letter-spacing:.2px;
    }

    /* ── Print ──────────────────────────────────────────────────────── */
    @media print{
      body{background:white;}
      .no-print{display:none;}
      .page{
        margin:0;
        width:210mm;height:297mm;
        padding:6mm;
        page-break-after:always;
        overflow:hidden;
      }
      .page:last-child{page-break-after:auto;}
      @page{size:A4 portrait;margin:0;}
    }
  </style>
</head>
<body>

<!-- Kontrol bar -->
<div class="no-print">
  <div>
    <h2>🖨️ Cetak Kartu Peserta</h2>
    <small><%= users.length %> kartu &nbsp;·&nbsp; A4 Portrait &nbsp;·&nbsp; 10 kartu/halaman (5 kiri · 5 kanan)</small>
  </div>
  <div class="ctrl">
    <form method="GET" action="/admin/users/print-cards" style="display:flex;gap:8px;align-items:center;">
      <select name="role" class="fs" onchange="this.form.submit()">
        <option value="">Semua Role</option>
        <option value="TEACHER" <%=role==='TEACHER'?'selected':''%>>Guru</option>
        <option value="STUDENT" <%=role==='STUDENT'?'selected':''%>>Siswa</option>
      </select>
      <select name="class_id" class="fs" onchange="this.form.submit()">
        <option value="">Semua Kelas</option>
        <% classes.forEach(function(c){ %>
          <option value="<%=c.id%>" <%=String(class_id)===String(c.id)?'selected':''%>><%=c.name%></option>
        <% }); %>
      </select>
    </form>
    <button onclick="window.print()" class="btn btn-print">
      <svg width="14" height="14" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5"
          d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z"/>
      </svg>
      Cetak
    </button>
    <a href="/admin/users" class="btn btn-back">← Kembali</a>
  </div>
</div>

<%
  var y   = new Date().getFullYear();
  var ta  = new Date().getMonth() >= 6 ? (y+'/'+(y+1)) : ((y-1)+'/'+y);
  var tgl = new Date().toLocaleDateString('id-ID',{day:'numeric',month:'long',year:'numeric'});
  var PH  = 10;
%>

<% for(var p = 0; p < users.length; p += PH){ %>
<div class="page">
  <% for(var j = p; j < Math.min(p+PH, users.length); j++){
       var u   = users[j];
       var np  = u.nomor_peserta || null;
  %>
  <div class="kartu">

    <!-- Header: logo | judul | QR -->
    <div class="k-head">
      <div class="k-logo">
        <img src="/public/images/logo.png" alt="" onerror="this.style.display='none'">
      </div>
      <div class="k-title">
        <div class="t1">Kartu Peserta Ujian</div>
        <div class="t2"><%=schoolInfo.name%></div>
        <div class="t3">TP <%=ta%></div>
      </div>
      <div class="k-qr">
        <div class="k-qr-wrap" id="qr-<%=j%>"></div>
        <div class="k-qr-label">Scan</div>
      </div>
    </div>

    <!-- Body: data siswa -->
    <div class="k-body">
      <table class="dt">
        <% if(np){ %>
        <tr>
          <td class="lb">No. Peserta</td>
          <td class="sp">:</td>
          <td class="vl mono"><%=np%></td>
        </tr>
        <% } %>
        <tr>
          <td class="lb">Nama</td>
          <td class="sp">:</td>
          <td class="vl"><%=u.full_name%></td>
        </tr>
        <% if(u.class_name){ %>
        <tr>
          <td class="lb">Kelas</td>
          <td class="sp">:</td>
          <td class="vl"><%=u.class_name%></td>
        </tr>
        <% } %>
        <tr>
          <td class="lb">Username</td>
          <td class="sp">:</td>
          <td class="vl mono"><%=u.username%></td>
        </tr>
        <tr>
          <td class="lb">Password</td>
          <td class="sp">:</td>
          <td class="vl mono"><%=u.plain_password||u.username%></td>
        </tr>
      </table>
    </div>

    <!-- Footer -->
    <div class="k-foot">Simpan kartu ini — Jangan bagikan kepada orang lain</div>

  </div>
  <% } %>
</div>
<% } %>

<script>
(function(){
  var s = document.createElement('script');
  s.src = 'https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js';
  s.onload = function(){
    <% for(var qi = 0; qi < users.length; qi++){
         var qu = users[qi];
         var qt = (process.env.APP_URL||'http://localhost:3000') + '|' + qu.username;
    %>
    try{
      new QRCode(document.getElementById('qr-<%=qi%>'),{
        text:'<%-qt.replace(/\\/g,"\\\\").replace(/'/g,"\\'")%>',
        width:56,height:56,
        colorDark:'#000',colorLight:'#fff',
        correctLevel:QRCode.CorrectLevel.M
      });
      var c=document.querySelector('#qr-<%=qi%> canvas');
      if(c){c.style.width='100%';c.style.height='100%';}
    }catch(e){}
    <% } %>
  };
  document.head.appendChild(s);
})();
</script>
</body>
</html>
