<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <title><%= title %></title>
  <style>
    *{margin:0;padding:0;box-sizing:border-box;}
    body{font-family:Arial,sans-serif;background:#e5e7eb;}
    .no-print{background:white;padding:12px 20px;display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:10px;box-shadow:0 2px 6px rgba(0,0,0,.12);margin-bottom:14px;}
    .no-print h2{font-size:15px;color:#1e293b;}
    .ctrl{display:flex;gap:8px;align-items:center;flex-wrap:wrap;}
    .btn{padding:7px 16px;border-radius:7px;font-weight:600;font-size:13px;cursor:pointer;border:none;text-decoration:none;}
    .btn-print{background:#4f46e5;color:white;}
    .btn-back{background:#f1f5f9;color:#475569;}
    select.fs{padding:6px 12px;border-radius:7px;border:2px solid #e2e8f0;font-size:13px;color:#475569;background:white;}
    .page{width:210mm;height:297mm;margin:0 auto 16px;background:white;padding:4mm;display:grid;grid-template-columns:repeat(2,1fr);grid-template-rows:repeat(5,1fr);gap:2mm;}
    .kartu{border:1px solid #1e3a8a;display:flex;flex-direction:column;overflow:hidden;background:white;}
    .k-head{display:flex;align-items:stretch;border-bottom:1px solid #1e3a8a;background:linear-gradient(135deg,#eff6ff,#dbeafe);flex-shrink:0;height:10mm;}
    .k-logo{width:10mm;flex-shrink:0;display:flex;align-items:center;justify-content:center;border-right:1px solid #1e3a8a;padding:1mm;}
    .k-logo img{width:7.5mm;height:7.5mm;object-fit:contain;}
    .k-title{flex:1;display:flex;flex-direction:column;align-items:center;justify-content:center;padding:0 1mm;text-align:center;}
    .k-title .t1{font-size:6.5pt;font-weight:bold;text-transform:uppercase;color:#1e3a8a;}
    .k-title .t2{font-size:6pt;font-weight:bold;color:#1e3a8a;}
    .k-title .t3{font-size:5.5pt;color:#374151;}
    .k-panitia{width:10mm;flex-shrink:0;border-left:1px solid #1e3a8a;display:flex;align-items:center;justify-content:center;font-size:5.5pt;font-weight:bold;color:#1e3a8a;writing-mode:vertical-rl;transform:rotate(180deg);}
    .k-body{flex:1;display:flex;flex-direction:row;padding:1.5mm 2mm 1mm;overflow:hidden;gap:2mm;min-height:0;}
    .k-left{flex:1;display:flex;flex-direction:column;min-width:0;}
    .dt{width:100%;border-collapse:collapse;}
    .dt td{font-size:6.5pt;padding:0.4mm 0;vertical-align:top;color:#111827;line-height:1.25;}
    .dt .lb{width:16mm;color:#374151;white-space:nowrap;}
    .dt .sp{width:3mm;text-align:center;}
    .dt .vl{font-weight:600;font-size:6.5pt;word-break:break-all;}
    .dt .mono{font-family:'Courier New',monospace;font-size:6pt;font-weight:700;color:#1e3a8a;}
    .k-right{display:flex;flex-direction:column;align-items:center;gap:1mm;flex-shrink:0;width:22mm;}
    .foto-box{width:14mm;height:17mm;border:1px solid #374151;display:flex;align-items:center;justify-content:center;background:#f9fafb;overflow:hidden;}
    .foto-box img{width:100%;height:100%;object-fit:cover;}
    .foto-ph{font-size:4.5pt;color:#9ca3af;text-align:center;line-height:1.3;}
    .qr-wrap{width:14mm;height:14mm;display:flex;align-items:center;justify-content:center;}
    .qr-label{font-size:4pt;color:#6b7280;text-align:center;}
    .k-ttd{border-top:1px dashed #cbd5e1;padding:0.8mm 2mm;display:flex;align-items:center;flex-shrink:0;background:#f8fafc;}
    .ttd-left{font-size:5.5pt;color:#374151;line-height:1.5;}
    .ttd-garis{border-bottom:1px solid #374151;width:22mm;margin:2mm 0 0.5mm;}
    .ttd-nama{font-weight:bold;font-size:5.5pt;color:#111827;}
    .ttd-nip{font-size:5pt;color:#374151;}
    .k-foot{border-top:1px solid #e5e7eb;padding:0.5mm 2mm;text-align:center;font-size:4.5pt;color:#9ca3af;background:#f9fafb;flex-shrink:0;}
    @media print{body{background:white;}.no-print{display:none;}.page{margin:0;padding:4mm;width:210mm;height:297mm;page-break-after:always;}.page:last-child{page-break-after:auto;}@page{size:A4 portrait;margin:0;}}
  </style>
</head>
<body>
<div class="no-print">
  <div><h2>Cetak Kartu Peserta</h2><small><%= users.length %> kartu - A4 Portrait - 10 kartu/halaman</small></div>
  <div class="ctrl">
    <form method="GET" action="/admin/users/print-cards" style="display:flex;gap:8px;">
      <select name="role" class="fs" onchange="this.form.submit()">
        <option value="">Semua Role</option>
        <option value="TEACHER" <%=role==='TEACHER'?'selected':''%>>Guru</option>
        <option value="STUDENT" <%=role==='STUDENT'?'selected':''%>>Siswa</option>
      </select>
      <select name="class_id" class="fs" onchange="this.form.submit()">
        <option value="">Semua Kelas</option>
        <% classes.forEach(function(c){ %>
          <option value="<%=c.id%>" <%=class_id==c.id?'selected':''%>><%=c.name%></option>
        <% }); %>
      </select>
    </form>
    <button onclick="window.print()" class="btn btn-print">Cetak</button>
    <a href="/admin/users" class="btn btn-back">Kembali</a>
  </div>
</div>
<% var y=new Date().getFullYear(); var ta=new Date().getMonth()>=6?(y+'/'+(y+1)):((y-1)+'/'+y); var tgl=new Date().toLocaleDateString('id-ID',{day:'numeric',month:'long',year:'numeric'}); var PH=10; %>
<% for(var p=0;p<users.length;p+=PH){ %>
<div class="page">
<% for(var j=p;j<Math.min(p+PH,users.length);j++){ var u=users[j]; var np=u.nomor_peserta||null; var fs2=u.profile_photo&&u.profile_photo.startsWith('/public/')?u.profile_photo:null; %>
<div class="kartu">
  <div class="k-head">
    <div class="k-logo"><img src="/public/images/logo.png" alt="" onerror="this.style.display='none'"></div>
    <div class="k-title"><div class="t1">Kartu Peserta Ujian</div><div class="t2"><%=schoolInfo.name%></div><div class="t3">TP <%=ta%></div></div>
    <div class="k-panitia">Panitia</div>
  </div>
  <div class="k-body">
    <div class="k-left">
      <table class="dt">
        <% if(np){ %><tr><td class="lb">No. Peserta</td><td class="sp">:</td><td class="vl mono"><%=np%></td></tr><% } %>
        <tr><td class="lb">Nama</td><td class="sp">:</td><td class="vl"><%=u.full_name%></td></tr>
        <% if(u.class_name){ %><tr><td class="lb">Kelas</td><td class="sp">:</td><td class="vl"><%=u.class_name%></td></tr><% } %>
        <tr><td class="lb">Username</td><td class="sp">:</td><td class="vl mono"><%=u.username%></td></tr>
        <tr><td class="lb">Password</td><td class="sp">:</td><td class="vl mono"><%=u.plain_password||u.username%></td></tr>
      </table>
    </div>
    <div class="k-right">
      <div class="foto-box"><% if(fs2){ %><img src="<%=fs2%>" alt="" onerror="this.style.display='none'"><% }else{ %><div class="foto-ph">Foto</div><% } %></div>
      <div class="qr-wrap" id="qr-<%=j%>"></div>
      <div class="qr-label">Scan</div>
    </div>
  </div>
  <div class="k-ttd"><div class="ttd-left"><div><%=schoolInfo.address%>, <%=tgl%></div><div>Kepala Sekolah,</div><div class="ttd-garis"></div><div class="ttd-nama"><%=process.env.PRINCIPAL_NAME||'Kepala Sekolah'%></div><div class="ttd-nip">NIP. <%=process.env.PRINCIPAL_NIP||'-'%></div></div></div>
  <div class="k-foot">Simpan kartu ini - Jangan bagikan kepada orang lain</div>
</div>
<% } %>
</div>
<% } %>
<script>
(function(){
  var s=document.createElement('script');
  s.src='https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js';
  s.onload=function(){
    <% for(var qi=0;qi<users.length;qi++){ var qu=users[qi]; var qt=(process.env.APP_URL||'http://localhost:3000')+'|'+qu.username; %>
    try{new QRCode(document.getElementById('qr-<%=qi%>'),{text:'<%-qt.replace(/\\/g,"\\\\").replace(/'/g,"\\'")%>',width:50,height:50,colorDark:'#000',colorLight:'#fff',correctLevel:QRCode.CorrectLevel.M});}catch(e){}
    <% } %>
  };
  document.head.appendChild(s);
})();
</script>
</body>
</html>
