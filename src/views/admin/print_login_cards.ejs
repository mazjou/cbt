<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <title><%= title %></title>
  <style>
    *{margin:0;padding:0;box-sizing:border-box;}
    body{font-family:'Arial',sans-serif;background:#e5e7eb;}

    /* ── Kontrol bar (tidak ikut cetak) ─────────────────────────────────────── */
    .no-print{background:white;padding:12px 20px;display:flex;align-items:center;
      justify-content:space-between;flex-wrap:wrap;gap:10px;
      box-shadow:0 2px 8px rgba(0,0,0,.12);margin-bottom:14px;}
    .no-print h2{font-size:15px;font-weight:700;color:#1e293b;}
    .no-print small{font-size:12px;color:#64748b;}
    .ctrl{display:flex;gap:8px;align-items:center;flex-wrap:wrap;}
    .btn{padding:8px 18px;border-radius:8px;font-weight:700;font-size:13px;
      cursor:pointer;border:none;text-decoration:none;display:inline-flex;align-items:center;gap:6px;}
    .btn-print{background:linear-gradient(135deg,#4f46e5,#7c3aed);color:white;}
    .btn-back{background:#f1f5f9;color:#475569;}
    select.fs{padding:6px 10px;border-radius:7px;border:2px solid #e2e8f0;
      font-size:13px;color:#475569;background:white;}

    /* ── Halaman A4 — 4 kartu per halaman (2 kolom × 2 baris) ─────────────── */
    .page{
      width:210mm;min-height:297mm;
      margin:0 auto 16px;background:white;
      padding:6mm;
      display:grid;
      grid-template-columns:repeat(2,1fr);
      grid-auto-rows:min-content;
      gap:5mm;
    }

    /* ── Kartu ──────────────────────────────────────────────────────────────── */
    .kartu{
      border:2px solid #1e3a8a;
      border-radius:4px;
      overflow:hidden;
      background:white;
      display:flex;
      flex-direction:column;
    }

    /* Header kartu */
    .k-head{
      display:flex;align-items:stretch;
      background:linear-gradient(135deg,#1e3a8a,#1d4ed8);
      flex-shrink:0;
      min-height:14mm;
    }
    .k-logo{
      width:14mm;flex-shrink:0;
      display:flex;align-items:center;justify-content:center;
      border-right:1px solid rgba(255,255,255,.25);
      padding:2mm;
      background:rgba(0,0,0,.15);
    }
    .k-logo img{width:10mm;height:10mm;object-fit:contain;}
    .k-title{
      flex:1;display:flex;flex-direction:column;
      align-items:center;justify-content:center;
      padding:1.5mm 2mm;text-align:center;
    }
    .k-title .t1{font-size:8pt;font-weight:900;text-transform:uppercase;
      color:white;letter-spacing:.5px;}
    .k-title .t2{font-size:7.5pt;font-weight:700;color:#bfdbfe;margin-top:.5mm;}
    .k-title .t3{font-size:6.5pt;color:#93c5fd;margin-top:.3mm;}
    .k-panitia{
      width:10mm;flex-shrink:0;
      border-left:1px solid rgba(255,255,255,.25);
      display:flex;align-items:center;justify-content:center;
      font-size:5.5pt;font-weight:700;color:rgba(255,255,255,.8);
      writing-mode:vertical-rl;transform:rotate(180deg);
      background:rgba(0,0,0,.1);letter-spacing:1px;
    }

    /* Body kartu */
    .k-body{
      flex:1;display:flex;flex-direction:row;
      padding:3mm 3mm 2mm;gap:3mm;
    }
    .k-left{flex:1;display:flex;flex-direction:column;min-width:0;gap:0;}

    /* Tabel data */
    .dt{width:100%;border-collapse:collapse;}
    .dt td{font-size:7pt;padding:.6mm .2mm;vertical-align:middle;color:#111827;line-height:1.3;}
    .dt .lb{width:18mm;color:#4b5563;white-space:nowrap;font-weight:500;}
    .dt .sp{width:3mm;text-align:center;color:#4b5563;}
    .dt .vl{font-weight:700;font-size:7pt;word-break:break-all;color:#111827;}
    .dt .mono{font-family:'Courier New',monospace;font-size:6.5pt;
      font-weight:700;color:#1e40af;letter-spacing:.3px;}

    /* Kolom kanan: foto + QR */
    .k-right{
      display:flex;flex-direction:column;
      align-items:center;gap:2mm;
      flex-shrink:0;width:30mm;
    }

    /* Foto 3×3 cm */
    .foto-box{
      width:28mm;height:28mm;
      border:1.5px solid #94a3b8;
      border-radius:3px;
      display:flex;align-items:center;justify-content:center;
      background:linear-gradient(135deg,#f1f5f9,#e2e8f0);
      overflow:hidden;
      flex-shrink:0;
      position:relative;
    }
    .foto-box img{width:100%;height:100%;object-fit:cover;}
    .foto-ph{
      display:flex;flex-direction:column;align-items:center;
      justify-content:center;gap:1.5mm;
      color:#94a3b8;text-align:center;width:100%;height:100%;
    }
    .foto-ph svg{width:10mm;height:10mm;opacity:.5;}
    .foto-ph .ph-txt{font-size:5pt;color:#94a3b8;font-weight:600;
      text-transform:uppercase;letter-spacing:.5px;}
    .foto-ph .ph-sub{font-size:4.5pt;color:#cbd5e1;margin-top:.5mm;}

    /* QR code */
    .qr-wrap{
      width:22mm;height:22mm;
      display:flex;align-items:center;justify-content:center;
      background:white;border:1px solid #e2e8f0;border-radius:2px;
    }
    .qr-label{font-size:5pt;color:#6b7280;text-align:center;font-weight:600;
      letter-spacing:.5px;text-transform:uppercase;}

    /* TTD */
    .k-ttd{
      border-top:1px dashed #cbd5e1;
      padding:1.5mm 3mm;
      display:flex;align-items:flex-end;justify-content:space-between;
      flex-shrink:0;background:#f8fafc;
    }
    .ttd-left{font-size:6pt;color:#374151;line-height:1.7;}
    .ttd-garis{border-bottom:1px solid #374151;width:28mm;margin:3mm 0 .5mm;}
    .ttd-nama{font-weight:700;font-size:6pt;color:#111827;}
    .ttd-nip{font-size:5.5pt;color:#4b5563;}

    /* Footer kartu */
    .k-foot{
      border-top:1px solid #e5e7eb;
      padding:.8mm 3mm;text-align:center;
      font-size:5pt;color:#94a3b8;background:#f9fafb;
      flex-shrink:0;letter-spacing:.3px;
    }

    /* ── Print ─────────────────────────────────────────────────────────────── */
    @media print{
      body{background:white;}
      .no-print{display:none;}
      .page{
        margin:0;padding:6mm;
        width:210mm;min-height:297mm;
        page-break-after:always;
      }
      .page:last-child{page-break-after:auto;}
      @page{size:A4 portrait;margin:0;}
    }
  </style>
</head>
<body>

<!-- Kontrol bar -->
<div class="no-print">
  <div>
    <h2>🖨️ Cetak Kartu Peserta</h2>
    <small><%= users.length %> kartu &nbsp;·&nbsp; A4 Portrait &nbsp;·&nbsp; 4 kartu/halaman</small>
  </div>
  <div class="ctrl">
    <form method="GET" action="/admin/users/print-cards" style="display:flex;gap:8px;align-items:center;">
      <select name="role" class="fs" onchange="this.form.submit()">
        <option value="">Semua Role</option>
        <option value="TEACHER" <%=role==='TEACHER'?'selected':''%>>Guru</option>
        <option value="STUDENT" <%=role==='STUDENT'?'selected':''%>>Siswa</option>
      </select>
      <select name="class_id" class="fs" onchange="this.form.submit()">
        <option value="">Semua Kelas</option>
        <% classes.forEach(function(c){ %>
          <option value="<%=c.id%>" <%=String(class_id)===String(c.id)?'selected':''%>><%=c.name%></option>
        <% }); %>
      </select>
    </form>
    <button onclick="window.print()" class="btn btn-print">
      <svg width="14" height="14" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z"/></svg>
      Cetak
    </button>
    <a href="/admin/users" class="btn btn-back">← Kembali</a>
  </div>
</div>

<%
  var y   = new Date().getFullYear();
  var ta  = new Date().getMonth() >= 6 ? (y+'/'+(y+1)) : ((y-1)+'/'+y);
  var tgl = new Date().toLocaleDateString('id-ID',{day:'numeric',month:'long',year:'numeric'});
  var PH  = 4; /* 4 kartu per halaman */
%>

<% for(var p = 0; p < users.length; p += PH){ %>
<div class="page">
  <% for(var j = p; j < Math.min(p+PH, users.length); j++){
       var u  = users[j];
       var np = u.nomor_peserta || null;
       var fs2= u.profile_photo && u.profile_photo.startsWith('/public/') ? u.profile_photo : null;
  %>
  <div class="kartu">

    <!-- Header -->
    <div class="k-head">
      <div class="k-logo">
        <img src="/public/images/logo.png" alt="" onerror="this.style.display='none'">
      </div>
      <div class="k-title">
        <div class="t1">Kartu Peserta Ujian</div>
        <div class="t2"><%=schoolInfo.name%></div>
        <div class="t3">TP <%=ta%></div>
      </div>
      <div class="k-panitia">Panitia</div>
    </div>

    <!-- Body -->
    <div class="k-body">

      <!-- Kiri: data siswa -->
      <div class="k-left">
        <table class="dt">
          <% if(np){ %>
          <tr>
            <td class="lb">No. Peserta</td>
            <td class="sp">:</td>
            <td class="vl mono"><%=np%></td>
          </tr>
          <% } %>
          <tr>
            <td class="lb">Nama</td>
            <td class="sp">:</td>
            <td class="vl"><%=u.full_name%></td>
          </tr>
          <% if(u.class_name){ %>
          <tr>
            <td class="lb">Kelas</td>
            <td class="sp">:</td>
            <td class="vl"><%=u.class_name%></td>
          </tr>
          <% } %>
          <tr>
            <td class="lb">Username</td>
            <td class="sp">:</td>
            <td class="vl mono"><%=u.username%></td>
          </tr>
          <tr>
            <td class="lb">Password</td>
            <td class="sp">:</td>
            <td class="vl mono"><%=u.plain_password||u.username%></td>
          </tr>
        </table>
      </div>

      <!-- Kanan: foto 3×3 + QR -->
      <div class="k-right">

        <!-- Foto 3×3 cm (28mm × 28mm di layar/cetak) -->
        <div class="foto-box">
          <% if(fs2){ %>
            <img src="<%=fs2%>" alt="Foto <%=u.full_name%>"
                 onerror="this.parentNode.innerHTML='<div class=\'foto-ph\'><svg viewBox=\'0 0 24 24\' fill=\'none\' stroke=\'currentColor\'><path stroke-linecap=\'round\' stroke-linejoin=\'round\' stroke-width=\'1.5\' d=\'M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z\'/></svg><div class=\'ph-txt\'>No User</div><div class=\'ph-sub\'><%=u.username%></div></div>'">
          <% } else { %>
            <div class="foto-ph">
              <!-- ikon silhouette -->
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"
                  d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
              </svg>
              <div class="ph-txt">No User</div>
              <div class="ph-sub"><%=u.username%></div>
            </div>
          <% } %>
        </div>

        <!-- QR Code -->
        <div class="qr-wrap" id="qr-<%=j%>"></div>
        <div class="qr-label">Scan</div>

      </div>
    </div>

    <!-- TTD Kepala Sekolah -->
    <div class="k-ttd">
      <div class="ttd-left">
        <div><%=schoolInfo.address%>, <%=tgl%></div>
        <div>Kepala Sekolah,</div>
        <div class="ttd-garis"></div>
        <div class="ttd-nama"><%=process.env.PRINCIPAL_NAME||'Kepala Sekolah'%></div>
        <div class="ttd-nip">NIP. <%=process.env.PRINCIPAL_NIP||'-'%></div>
      </div>
    </div>

    <!-- Footer -->
    <div class="k-foot">🔒 Simpan kartu ini &nbsp;·&nbsp; Jangan bagikan kepada orang lain</div>

  </div>
  <% } %>
</div>
<% } %>

<!-- QR Code generator -->
<script>
(function(){
  var s = document.createElement('script');
  s.src = 'https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js';
  s.onload = function(){
    <% for(var qi = 0; qi < users.length; qi++){
         var qu = users[qi];
         var qt = (process.env.APP_URL||'http://localhost:3000') + '|' + qu.username;
    %>
    try{
      new QRCode(document.getElementById('qr-<%=qi%>'),{
        text: '<%-qt.replace(/\\/g,"\\\\").replace(/'/g,"\\'")%>',
        width: 80, height: 80,
        colorDark: '#000', colorLight: '#fff',
        correctLevel: QRCode.CorrectLevel.M
      });
      /* Skala QR agar pas di kotak 22mm */
      var c = document.querySelector('#qr-<%=qi%> canvas');
      if(c){ c.style.width='100%'; c.style.height='100%'; }
    }catch(e){}
    <% } %>
  };
  document.head.appendChild(s);
})();
</script>
</body>
</html>
