<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    body { font-family: 'Times New Roman', Times, serif; font-size: 11pt; color: #000; background: #d0d0d0; padding: 20px 0; }

    /* Control bar — hide on print */
    .no-print { background: #fff; padding: 12px 20px; box-shadow: 0 2px 8px rgba(0,0,0,.12); margin-bottom: 12px; display: flex; align-items: center; gap: 12px; flex-wrap: wrap; }
    .btn { padding: 8px 18px; border-radius: 8px; font-weight: 700; font-size: 13px; cursor: pointer; border: none; text-decoration: none; display: inline-flex; align-items: center; gap: 6px; }
    .btn-print { background: #4f46e5; color: #fff; }
    .btn-back { background: #f1f5f9; color: #475569; }

    /* Satu div per siswa di layar — lebar A4, min-height A4, konten bebas mengalir */
    .raport-page {
      background: #fff;
      width: 210mm;
      min-height: 297mm;
      margin: 0 auto 24px;
      padding: 1.5cm;
      box-shadow: 0 4px 24px rgba(0,0,0,.18);
      position: relative;
    }

    /* Watermark di layar — tengah div */
    .watermark {
      position: absolute;
      left: 50%;
      top: 50%;
      transform: translate(-50%, -50%);
      width: 380px;
      height: 380px;
      opacity: 0.07;
      pointer-events: none;
      z-index: 0;
      object-fit: contain;
    }
    /* Semua konten di atas watermark */
    .raport-page > *:not(.watermark) { position: relative; z-index: 1; }

    /* Watermark saat print — fixed agar muncul di SETIAP halaman, posisi tengah */
    .watermark-print {
      display: none;
    }

    /* Kop surat */
    .kop { display: flex; align-items: flex-start; gap: 12px; }
    .kop-logo { width: 100px; height: 100px; object-fit: contain; flex-shrink: 0; }
    .kop-logo-placeholder { width: 100px; height: 100px; border: 2px solid #999; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 10pt; color: #999; flex-shrink: 0; }
    .kop-text { text-align: center; flex: 1; }
    .kop-text p { margin: 0; padding: 0; line-height: 1.15; }
    .kop-text .provinsi  { font-size: 10pt; font-weight: normal; }
    .kop-text .dinas     { font-size: 10pt; font-weight: normal; }
    .kop-text .sekolah   { font-size: 13pt; font-weight: bold; text-transform: uppercase; }
    .kop-text .kota-nama { font-size: 13pt; font-weight: bold; letter-spacing: 4px; text-transform: uppercase; }
    .kop-text .alamat    { font-size: 8pt; display: block; width: 100%; }
    .kop-text .postel    { font-size: 8pt; display: block; width: 100%; }

    /* Judul */
    .judul { text-align: center; margin: 14px 0 16px; }
    .judul h2 { font-size: 13pt; font-weight: bold; text-transform: uppercase; letter-spacing: 1px; text-decoration: underline; }
    .judul p  { font-size: 10pt; margin-top: 3px; }

    /* Data siswa */
    .data-siswa { margin-bottom: 14px; }
    .data-siswa table { width: 100%; border-collapse: collapse; }
    .data-siswa td { padding: 2px 4px; font-size: 10.5pt; vertical-align: top; }
    .data-siswa td:first-child { width: 160px; }
    .data-siswa td:nth-child(2) { width: 12px; text-align: center; }

    /* Tabel nilai */
    .tabel-nilai { width: 100%; border-collapse: collapse; margin-bottom: 14px; font-size: 10pt; }
    .tabel-nilai th { background: #f0f0f0; border: 1px solid #555; padding: 5px 8px; text-align: center; font-weight: bold; vertical-align: middle; }
    .tabel-nilai td { border: 1px solid #555; padding: 4px 8px; vertical-align: top; }
    .tabel-nilai td.no { text-align: center; width: 32px; }
    .tabel-nilai td.nilai { text-align: center; width: 37px; }
    .tabel-nilai th.nilai { white-space: nowrap; font-size: 8pt; }
    .tabel-nilai tr.group-header td { background: #e8e8e8; font-weight: bold; font-style: italic; padding: 4px 8px; }
    .tabel-nilai tr.summary td { font-weight: bold; background: #f8f8f8; }

    /* Tanda tangan */
    .ttd-section { display: flex; justify-content: space-between; margin-top: 20px; }
    .ttd-box { text-align: left; min-width: 180px; }
    .ttd-box p { font-size: 10pt; margin-bottom: 2px; }
    .ttd-box .ttd-garis { height: 55px; }
    .ttd-box .ttd-nama { font-weight: bold; margin-top: 4px; text-decoration: underline; font-size: 10pt; }
    .ttd-box .ttd-nip  { font-size: 10pt; }

    /* Cegah baris tabel terpotong di tengah saat print */
    .tabel-nilai tr { page-break-inside: avoid; break-inside: avoid; }
    .tabel-nilai thead { display: table-header-group; }

    @media print {
      @page { size: A4 portrait; margin: 1.5cm; }
      body { background: #fff; padding: 0; }
      .no-print { display: none !important; }

      /* Watermark di layar disembunyikan saat print */
      .watermark { display: none !important; }

      /* Watermark print: fixed = muncul di tengah SETIAP halaman cetak */
      .watermark-print {
        display: block;
        position: fixed;
        left: 50%;
        top: 50%;
        transform: translate(-50%, -50%);
        width: 380px;
        height: 380px;
        opacity: 0.07;
        pointer-events: none;
        z-index: 0;
        object-fit: contain;
      }

      /* Setiap siswa mulai di halaman baru */
      .raport-page {
        width: 100%;
        min-height: auto;
        margin: 0;
        padding: 0;
        box-shadow: none;
        page-break-after: always;
        break-after: page;
        position: static;
      }
      .raport-page > *:not(.watermark) { position: static; z-index: auto; }
    }
  </style>
</head>
<body>

<div class="no-print">
  <button class="btn btn-print" onclick="window.print()">
    <svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z"/></svg>
    Cetak
  </button>
  <a href="javascript:history.back()" class="btn btn-back">Kembali</a>
  <span style="font-size:12px;color:#64748b;"><%= multiStudent ? allStudents.length + ' siswa' : (student ? student.full_name : '') %></span>
</div>

<%
  // watermark path untuk fixed print (ambil dari siswa pertama)
  const _firstWm = (multiStudent && allStudents.length > 0 && allStudents[0])
    ? (schoolInfo && schoolInfo.watermarkPath)
    : (schoolInfo && schoolInfo.watermarkPath);
%>
<% if (_firstWm) { %>
  <img src="<%= _firstWm %>" alt="" class="watermark-print" />
<% } %>

<%
  // Helper: format tanggal lahir
  function formatTTL(d) {
    if (!d) return '-';
    try {
      const dt = new Date(d);
      const months = ['Januari','Februari','Maret','April','Mei','Juni','Juli','Agustus','September','Oktober','November','Desember'];
      return dt.getDate() + ' ' + months[dt.getMonth()] + ' ' + dt.getFullYear();
    } catch(e) { return '-'; }
  }

  // Helper: format nilai — bulat tanpa angka di belakang koma
  function formatNilai(n) {
    if (n === null || n === undefined || n === '') return '-';
    const num = parseFloat(n);
    if (isNaN(num)) return '-';
    return Math.round(num).toString();
  }

  // Data yang akan dicetak
  const students = multiStudent ? allStudents : [{ ...student, groups: groups }];
%>

<% students.forEach(function(stu) { %>
  <%
    const stuGroups = stu.groups || groups || [];
    let totalScore = 0;
    let scoreCount = 0;
    stuGroups.forEach(function(g) {
      (g.subjects || []).forEach(function(s) {
        if (s.score !== null && s.score !== undefined && s.score !== '') {
          totalScore += parseFloat(s.score);
          scoreCount++;
        }
      });
    });
    const avgScore = scoreCount > 0 ? Math.round(totalScore / scoreCount).toString() : '-';
    let noUrut = 0;
  %>

  <div class="raport-page">
    <% const wmLogo = schoolInfo && schoolInfo.watermarkPath ? schoolInfo.watermarkPath : null; %>
    <% if (wmLogo) { %>
      <img src="<%= wmLogo %>" alt="" class="watermark" />
    <% } %>
    <!-- Kop Surat -->
    <div class="kop">
      <% if (schoolInfo && schoolInfo.logoPath) { %>
        <img src="<%= schoolInfo.logoPath %>" alt="Logo" class="kop-logo" style="margin-top:2mm;">
      <% } else { %>
        <div class="kop-logo-placeholder">LOGO</div>
      <% } %>
      <div class="kop-text">
        <p class="provinsi"><%= schoolInfo && schoolInfo.headerLine1 ? schoolInfo.headerLine1 : 'PEMERINTAH PROVINSI JAWA TIMUR' %></p>
        <p class="dinas"><%= schoolInfo && schoolInfo.headerLine2 ? schoolInfo.headerLine2 : 'DINAS PENDIDIKAN' %></p>
        <p class="sekolah"><%= schoolInfo && schoolInfo.headerLine3 ? schoolInfo.headerLine3 : 'SEKOLAH MENENGAH KEJURUAN NEGERI 1 KRAS' %></p>
        <p class="kota-nama">KABUPATEN KEDIRI</p>
        <p class="alamat">Alamat : <%= schoolInfo && schoolInfo.address ? schoolInfo.address : '' %></p>
        <%
          const email = (schoolInfo && schoolInfo.email) ? schoolInfo.email : (process.env.SCHOOL_EMAIL || '');
          const web   = (schoolInfo && (schoolInfo.website || schoolInfo.web)) ? (schoolInfo.website || schoolInfo.web) : (process.env.SCHOOL_WEB || '');
        %>
        <% if (email || web) { %>
        <p class="postel">Pos.el : <u><%= email %></u>&nbsp;&nbsp;&nbsp; Laman : <u><%= web %></u></p>
        <% } %>
        <p style="font-size:12pt;font-weight:bold;letter-spacing:5px;margin:3px 0 0 0;padding:0;"><%= (schoolInfo && schoolInfo.city ? schoolInfo.city.toUpperCase() : 'KEDIRI').split('').join(' ') %></p>
      </div>
    </div>
    <div style="border-top:1px solid #000; margin:2px 0 1px 0;"></div>
    <div style="border-top:3px solid #000; margin:0 0 12px 0;"></div>

    <!-- Judul -->
    <div class="judul">
      <h2>Laporan Hasil Belajar Murid</h2>
      <p>Semester <%= period.semester %> Tahun Pelajaran <%= period.school_year %></p>
    </div>

    <!-- Data Siswa -->
    <div class="data-siswa">
      <table>
        <tr>
          <td width="80">Nama Siswa</td><td width="8">:</td>
          <td><strong><%= stu.full_name %></strong></td>
          <td width="15"></td>
          <td width="50">Kelas</td><td width="8">:</td>
          <td><%= stu.class_name || '-' %></td>
        </tr>
        <tr>
          <td>TTL</td><td>:</td>
          <td><%= (stu.tempat_lahir || stu.tanggal_lahir) ? ((stu.tempat_lahir ? stu.tempat_lahir + ', ' : '') + (stu.tanggal_lahir ? formatTTL(stu.tanggal_lahir) : '')) : '-' %></td>
          <td></td>
          <td>NISN</td><td>:</td>
          <td><%= stu.username ? stu.username.split('@')[0] : '-' %></td>
        </tr>
      </table>
    </div>

    <!-- Tabel Nilai -->
    <%
      const maxKd = stuGroups.reduce((max, g) =>
        (g.subjects || []).reduce((m, s) => Math.max(m, (s.kdScores || []).length), max), 0);
      const hasKd = maxKd > 0;
      const totalCols = hasKd ? 3 + maxKd + 1 : 4;
      const safeKdNames = [];
      for (let ki = 0; ki < maxKd; ki++) {
        safeKdNames.push((typeof kdNames !== 'undefined' && kdNames[ki]) ? kdNames[ki] : ('TP' + (ki + 1)));
      }
    %>
    <table class="tabel-nilai">
      <thead>
        <% if (hasKd) { %>
        <tr>
          <th class="no" rowspan="2">No</th>
          <th rowspan="2">Mata Pelajaran</th>
          <th colspan="<%= maxKd %>" style="text-align:center;">Nilai</th>
          <th class="nilai" rowspan="2">Rata-rata</th>
          <th rowspan="2">Keterangan</th>
        </tr>
        <tr>
          <% for (var ki = 0; ki < maxKd; ki++) { %>
            <th class="nilai"><%= safeKdNames[ki] %></th>
          <% } %>
        </tr>
        <% } else { %>
        <tr>
          <th class="no">No</th><th>Mata Pelajaran</th>
          <th class="nilai">Nilai</th><th>Keterangan</th>
        </tr>
        <% } %>
      </thead>
      <tbody>
        <% if (!stuGroups || stuGroups.length === 0) { %>
          <tr><td colspan="<%= totalCols %>" style="text-align:center;padding:12px;color:#888;font-style:italic;">Belum ada nilai.</td></tr>
        <% } %>
        <% stuGroups.forEach(function(g) { noUrut = 0; %>
          <tr class="group-header"><td colspan="<%= totalCols %>"><%= g.name %></td></tr>
          <% (g.subjects || []).forEach(function(s) { noUrut++; %>
            <tr>
              <td class="no"><%= noUrut %></td>
              <td><%= s.name %></td>
              <% if (hasKd) { %>
                <% for (var ki2 = 0; ki2 < maxKd; ki2++) { %>
                  <td class="nilai"><%= (s.kdScores && s.kdScores[ki2] && s.kdScores[ki2].score !== null && s.kdScores[ki2].score !== undefined) ? Math.round(parseFloat(s.kdScores[ki2].score)).toString() : '-' %></td>
                <% } %>
                <td class="nilai"><%= formatNilai(s.score) %></td>
              <% } else { %>
                <td class="nilai"><%= formatNilai(s.score) %></td>
              <% } %>
              <td><%= s.notes || '' %></td>
            </tr>
          <% }) %>
        <% }) %>
        <% if (scoreCount > 0) { %>
          <tr class="summary">
            <td colspan="<%= hasKd ? 2 + maxKd : 2 %>" style="text-align:right;">Jumlah Nilai</td>
            <td class="nilai"><%= Math.round(totalScore) %></td><td></td>
          </tr>
          <tr class="summary">
            <td colspan="<%= hasKd ? 2 + maxKd : 2 %>" style="text-align:right;">Rata-rata</td>
            <td class="nilai"><%= avgScore %></td><td></td>
          </tr>
        <% } %>
      </tbody>
    </table>

    <!-- Tanda Tangan -->
    <% var hasDate = typeof reportDateFormatted !== 'undefined' && reportDateFormatted; %>
    <div class="ttd-section">
      <div class="ttd-box" style="padding-left:2cm;">
        <% if (hasDate) { %><p style="visibility:hidden;">&nbsp;</p><% } %>
        <p>Orang Tua / Wali Murid,</p>
        <div class="ttd-garis"></div>
        <p class="ttd-nama">.................................</p>
      </div>
      <div class="ttd-box">
        <% if (hasDate) { %>
          <p style="font-size:10pt;margin-bottom:4px;"><%= schoolCity %>, <%= reportDateFormatted %></p>
        <% } %>
        <p>Wali Kelas,</p>
        <div class="ttd-garis"></div>
        <p class="ttd-nama"><%= stu.homeroom_teacher_name || '.................................' %></p>
        <p class="ttd-nip">NIP. <%= stu.homeroom_teacher_nip || '-' %></p>
      </div>
    </div>

    <div style="text-align:center; margin-top:18px;">
      <p style="font-size:10pt;margin-bottom:2px;">Mengetahui,</p>
      <p style="font-size:10pt;margin-bottom:2px;">Kepala SMK Negeri 1 Kras</p>
      <% if (schoolInfo && schoolInfo.principalSignPath) { %>
        <div style="height:55px;display:flex;align-items:center;justify-content:center;margin:0 auto;">
          <img src="<%= schoolInfo.principalSignPath %>" alt="TTD Kepala Sekolah"
            style="max-height:119px;max-width:259px;object-fit:contain;display:block;margin-left:-10mm;margin-top:5mm;">
        </div>
      <% } else { %>
        <div style="height:55px;"></div>
      <% } %>
      <p class="ttd-nama" style="text-align:center;font-weight:bold;text-decoration:underline;"><%= schoolInfo && schoolInfo.principalName ? schoolInfo.principalName : '.................................' %></p>
      <p class="ttd-nip" style="text-align:center;">NIP. <%= schoolInfo && schoolInfo.principalNip ? schoolInfo.principalNip : '-' %></p>
    </div>

  </div><!-- end raport-page -->

<% }) %>

</body>
</html>

</body>
</html>
