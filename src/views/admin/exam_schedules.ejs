<div class="flex items-center justify-between gap-4 mb-6">
  <div>
    <h1 class="text-2xl font-semibold tracking-tight">Jadwal Ujian per Tingkat Kelas</h1>
    <p class="mt-1 text-slate-600 text-sm">Kelola jadwal ujian berdasarkan tingkat kelas dan sesi.</p>
  </div>
  <a href="/admin/users" class="px-4 py-2 rounded-xl border border-slate-200 hover:bg-slate-100 text-sm font-medium">Kembali ke Pengguna</a>
</div>

<% if (messages.success && messages.success.length) { %>
  <div class="mb-4 rounded-xl bg-green-50 border border-green-200 px-4 py-3 text-green-800 text-sm font-medium"><%= messages.success[0] %></div>
<% } %>
<% if (messages.error && messages.error.length) { %>
  <div class="mb-4 rounded-xl bg-red-50 border border-red-200 px-4 py-3 text-red-800 text-sm font-medium"><%= messages.error[0] %></div>
<% } %>

<!-- Form Tambah Jadwal -->
<div class="rounded-2xl border border-orange-200 bg-gradient-to-br from-orange-50 to-amber-50 p-5 mb-6">
  <h2 class="font-semibold text-orange-900 mb-4">Tambah Jadwal Ujian</h2>
  <form action="/admin/exam-schedules" method="POST" class="grid grid-cols-2 md:grid-cols-4 gap-3">
    <div>
      <label class="text-sm text-orange-700 font-medium block mb-1">Tingkat *</label>
      <select name="level" required class="w-full rounded-xl bg-white border border-orange-200 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-orange-400">
        <option value="">Pilih</option>
        <option value="X">X</option>
        <option value="XI">XI</option>
        <option value="XII">XII</option>
      </select>
    </div>
    <div>
      <label class="text-sm text-orange-700 font-medium block mb-1">Sesi *</label>
      <input type="number" name="sesi" min="1" max="10" required placeholder="1, 2, 3 ..."
        class="w-full rounded-xl bg-white border border-orange-200 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-orange-400" />
    </div>
    <div>
      <label class="text-sm text-orange-700 font-medium block mb-1">Hari</label>
      <select name="hari" class="w-full rounded-xl bg-white border border-orange-200 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-orange-400">
        <option value="">- Pilih Hari -</option>
        <option value="Senin">Senin</option>
        <option value="Selasa">Selasa</option>
        <option value="Rabu">Rabu</option>
        <option value="Kamis">Kamis</option>
        <option value="Jumat">Jumat</option>
        <option value="Sabtu">Sabtu</option>
      </select>
    </div>
    <div>
      <label class="text-sm text-orange-700 font-medium block mb-1">Tanggal</label>
      <input type="date" name="tanggal"
        class="w-full rounded-xl bg-white border border-orange-200 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-orange-400" />
    </div>
    <div>
      <label class="text-sm text-orange-700 font-medium block mb-1">Jam Mulai *</label>
      <input type="time" name="jam_mulai" required
        class="w-full rounded-xl bg-white border border-orange-200 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-orange-400" />
    </div>
    <div>
      <label class="text-sm text-orange-700 font-medium block mb-1">Jam Selesai *</label>
      <input type="time" name="jam_selesai" required
        class="w-full rounded-xl bg-white border border-orange-200 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-orange-400" />
    </div>
    <div>
      <label class="text-sm text-orange-700 font-medium block mb-1">Mata Pelajaran *</label>
      <input type="text" name="mata_pelajaran" required placeholder="Misal: Matematika"
        class="w-full rounded-xl bg-white border border-orange-200 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-orange-400" />
    </div>
    <div>
      <label class="text-sm text-orange-700 font-medium block mb-1">Keterangan</label>
      <input type="text" name="keterangan" placeholder="Opsional"
        class="w-full rounded-xl bg-white border border-orange-200 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-orange-400" />
    </div>
    <div class="col-span-2 md:col-span-4 flex justify-end">
      <button type="submit"
        class="px-5 py-2 rounded-xl bg-gradient-to-r from-orange-400 to-amber-400 hover:from-orange-500 hover:to-amber-500 text-white font-semibold text-sm shadow-md transition-all">
        Tambah Jadwal
      </button>
    </div>
  </form>
</div>

<!-- Tabel per Tingkat -->
<% ['X', 'XI', 'XII'].forEach(function(lvl) { %>
  <div class="mb-6">
    <h2 class="text-lg font-semibold text-slate-700 mb-3">Tingkat <%= lvl %></h2>
    <% if (!byLevel[lvl] || byLevel[lvl].length === 0) { %>
      <div class="rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 text-slate-500 text-sm">
        Belum ada jadwal untuk tingkat <%= lvl %>.
      </div>
    <% } else { %>
      <div class="overflow-x-auto rounded-2xl border border-slate-200 shadow-sm">
        <table class="min-w-full text-sm">
          <thead class="bg-slate-100 text-slate-600 font-semibold">
            <tr>
              <th class="px-3 py-3 text-left">Sesi</th>
              <th class="px-3 py-3 text-left">Hari</th>
              <th class="px-3 py-3 text-left">Tanggal</th>
              <th class="px-3 py-3 text-left">Jam Mulai</th>
              <th class="px-3 py-3 text-left">Jam Selesai</th>
              <th class="px-3 py-3 text-left">Mata Pelajaran</th>
              <th class="px-3 py-3 text-left">Keterangan</th>
              <th class="px-3 py-3 text-left">Aksi</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100">
            <% byLevel[lvl].forEach(function(row) { %>
              <tr class="hover:bg-slate-50">
                <td class="px-3 py-3 font-medium">Sesi <%= row.sesi %></td>
                <td class="px-3 py-3"><%= row.hari || '-' %></td>
                <td class="px-3 py-3"><%= row.tanggal ? String(row.tanggal).substring(0,10) : '-' %></td>
                <td class="px-3 py-3"><%= row.jam_mulai ? String(row.jam_mulai).substring(0,5) : '' %></td>
                <td class="px-3 py-3"><%= row.jam_selesai ? String(row.jam_selesai).substring(0,5) : '' %></td>
                <td class="px-3 py-3 font-medium"><%= row.mata_pelajaran %></td>
                <td class="px-3 py-3 text-slate-500"><%= row.keterangan || '-' %></td>
                <td class="px-3 py-3">
                  <div class="flex gap-2">
                    <button type="button"
                      onclick="openEdit(<%= row.id %>,'<%= row.level %>',<%= row.sesi %>,'<%= row.hari||'' %>','<%= row.tanggal?String(row.tanggal).substring(0,10):'' %>','<%= row.jam_mulai?String(row.jam_mulai).substring(0,5):'' %>','<%= row.jam_selesai?String(row.jam_selesai).substring(0,5):'' %>','<%= row.mata_pelajaran.replace(/'/g,"\\'") %>','<%= (row.keterangan||'').replace(/'/g,"\\'") %>')"
                      class="px-3 py-1 rounded-lg bg-blue-50 hover:bg-blue-100 text-blue-600 font-medium text-xs border border-blue-200 transition-all">
                      Edit
                    </button>
                    <form action="/admin/exam-schedules/<%= row.id %>/delete" method="POST"
                      onsubmit="return confirm('Hapus jadwal ini?');">
                      <button type="submit"
                        class="px-3 py-1 rounded-lg bg-red-50 hover:bg-red-100 text-red-600 font-medium text-xs border border-red-200 transition-all">
                        Hapus
                      </button>
                    </form>
                  </div>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    <% } %>
  </div>
<% }); %>

<!-- Modal Edit Jadwal -->
<div id="editModal" class="fixed inset-0 z-50 hidden">
  <div class="absolute inset-0 bg-black/40" onclick="closeEdit()"></div>
  <div class="relative mx-auto mt-20 w-[92%] max-w-2xl rounded-2xl bg-white shadow-xl">
    <div class="p-5 border-b border-slate-200 flex items-center justify-between">
      <h3 class="text-lg font-semibold text-orange-900">Edit Jadwal Ujian</h3>
      <button type="button" onclick="closeEdit()" class="rounded-xl bg-gradient-to-r from-red-400 to-pink-400 text-white font-bold px-3 py-1.5">X</button>
    </div>
    <form id="editForm" method="POST" class="p-5">
      <input type="hidden" name="_method" value="PUT" />
      <div class="grid grid-cols-2 md:grid-cols-4 gap-3">
        <div>
          <label class="text-sm text-orange-700 font-medium block mb-1">Tingkat *</label>
          <select name="level" id="e_level" required class="w-full rounded-xl bg-white border border-orange-200 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-orange-400">
            <option value="X">X</option>
            <option value="XI">XI</option>
            <option value="XII">XII</option>
          </select>
        </div>
        <div>
          <label class="text-sm text-orange-700 font-medium block mb-1">Sesi *</label>
          <input type="number" name="sesi" id="e_sesi" min="1" max="10" required
            class="w-full rounded-xl bg-white border border-orange-200 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-orange-400" />
        </div>
        <div>
          <label class="text-sm text-orange-700 font-medium block mb-1">Hari</label>
          <select name="hari" id="e_hari" class="w-full rounded-xl bg-white border border-orange-200 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-orange-400">
            <option value="">- Pilih Hari -</option>
            <option value="Senin">Senin</option>
            <option value="Selasa">Selasa</option>
            <option value="Rabu">Rabu</option>
            <option value="Kamis">Kamis</option>
            <option value="Jumat">Jumat</option>
            <option value="Sabtu">Sabtu</option>
          </select>
        </div>
        <div>
          <label class="text-sm text-orange-700 font-medium block mb-1">Tanggal</label>
          <input type="date" name="tanggal" id="e_tanggal"
            class="w-full rounded-xl bg-white border border-orange-200 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-orange-400" />
        </div>
        <div>
          <label class="text-sm text-orange-700 font-medium block mb-1">Jam Mulai *</label>
          <input type="time" name="jam_mulai" id="e_jam_mulai" required
            class="w-full rounded-xl bg-white border border-orange-200 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-orange-400" />
        </div>
        <div>
          <label class="text-sm text-orange-700 font-medium block mb-1">Jam Selesai *</label>
          <input type="time" name="jam_selesai" id="e_jam_selesai" required
            class="w-full rounded-xl bg-white border border-orange-200 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-orange-400" />
        </div>
        <div>
          <label class="text-sm text-orange-700 font-medium block mb-1">Mata Pelajaran *</label>
          <input type="text" name="mata_pelajaran" id="e_mapel" required
            class="w-full rounded-xl bg-white border border-orange-200 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-orange-400" />
        </div>
        <div>
          <label class="text-sm text-orange-700 font-medium block mb-1">Keterangan</label>
          <input type="text" name="keterangan" id="e_ket"
            class="w-full rounded-xl bg-white border border-orange-200 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-orange-400" />
        </div>
      </div>
      <div class="mt-4 flex justify-end gap-2">
        <button type="button" onclick="closeEdit()" class="px-4 py-2 rounded-xl border border-slate-300 bg-white hover:bg-slate-50 text-slate-700 font-medium text-sm">Batal</button>
        <button type="submit" class="px-5 py-2 rounded-xl bg-gradient-to-r from-orange-400 to-amber-400 hover:from-orange-500 hover:to-amber-500 text-white font-semibold text-sm shadow-md">Simpan</button>
      </div>
    </form>
  </div>
</div>

<script>
function openEdit(id, level, sesi, hari, tanggal, jamMulai, jamSelesai, mapel, ket) {
  document.getElementById('editForm').action = '/admin/exam-schedules/' + id + '/update';
  document.getElementById('e_level').value = level;
  document.getElementById('e_sesi').value = sesi;
  document.getElementById('e_hari').value = hari;
  document.getElementById('e_tanggal').value = tanggal;
  document.getElementById('e_jam_mulai').value = jamMulai;
  document.getElementById('e_jam_selesai').value = jamSelesai;
  document.getElementById('e_mapel').value = mapel;
  document.getElementById('e_ket').value = ket;
  document.getElementById('editModal').classList.remove('hidden');
}
function closeEdit() {
  document.getElementById('editModal').classList.add('hidden');
}
</script>