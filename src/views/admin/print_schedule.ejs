<html lang="id">
<head>
  <meta charset="UTF-8">
  <title>Jadwal Ujian</title>
  <style>
    *{margin:0;padding:0;box-sizing:border-box;}
    body{font-family:Arial,sans-serif;background:#e5e7eb;}
    .no-print{background:white;padding:12px 20px;display:flex;align-items:center;
      justify-content:space-between;gap:10px;box-shadow:0 2px 8px rgba(0,0,0,.12);
      margin-bottom:14px;position:sticky;top:0;z-index:99;}
    .btn{padding:8px 18px;border-radius:8px;font-weight:700;font-size:13px;
      cursor:pointer;border:none;text-decoration:none;display:inline-flex;align-items:center;gap:6px;}
    .btn-print{background:#4f46e5;color:white;}
    .btn-back{background:#f1f5f9;color:#475569;text-decoration:none;}
    .page{
      width:210mm;height:297mm;
      margin:0 auto 16px;background:white;padding:4mm;
      display:grid;
      grid-template-columns:1fr 1fr;
      grid-template-rows:repeat(5,56mm);
      gap:2mm 3mm;overflow:hidden;
    }
    .slot{
      height:56mm;border:1px solid #444;background:white;
      display:flex;flex-direction:column;overflow:hidden;
    }
    .slot-head{
      height:10mm;min-height:10mm;max-height:10mm;flex-shrink:0;
      display:flex;align-items:center;justify-content:center;
      border-bottom:1px solid #cbd5e1;padding:1mm 2mm;
      background:#ffffff;
    }
    .s-title-simple{font-size:9pt;font-weight:900;color:#1e293b;letter-spacing:1px;text-transform:uppercase;}
    .slot-body{flex:1;padding:0.8mm 1.5mm;overflow:hidden;display:flex;flex-direction:column;justify-content:flex-start;gap:0.3mm;}
    .lv-head{font-size:6pt;font-weight:800;background:#f1f5f9;color:#1e293b;border:1px solid #cbd5e1;padding:0.3mm 2mm;border-radius:2px;margin-bottom:0.3mm;}
    .sched-table{width:100%;border-collapse:collapse;font-size:5.5pt;}
    .sched-table td{border:1px solid #e2e8f0;padding:0.2mm 0.8mm;}
    @media print{
      body{background:white;}
      .no-print{display:none!important;}
      .page{margin:0;page-break-after:always;}
      .page:last-child{page-break-after:auto;}
      @page{size:A4 portrait;margin:0;}
    }
  </style>
</head>
<body>
<div class="no-print">
  <div>
    <strong>Jadwal Ujian</strong> &nbsp;·&nbsp; Cetak 1 lembar, gunakan sebagai balik kartu ujian
  </div>
  <div style="display:flex;gap:8px;">
    <button onclick="window.print()" class="btn btn-print">Cetak</button>
    <a href="/admin/users" class="btn btn-back">Kembali</a>
  </div>
</div>

<%
  var y = new Date().getFullYear();
  var ta = new Date().getMonth() >= 6 ? (y+'/'+(y+1)) : ((y-1)+'/'+y);
  var levels = Object.keys(schedByLevel).sort();
%>

<!-- 1 halaman = 10 slot, semua isi jadwal yang sama -->
<div class="page">
  <% for (var slot = 0; slot < 10; slot++) { %>
  <div class="slot">
    <div class="slot-head">
      <span class="s-title-simple">Jadwal Ujian</span>
    </div>
    <div class="slot-body">
      <% levels.forEach(function(lv) { %>
      <div>
        <div class="lv-head">KELAS <%=lv%></div>
        <table class="sched-table">
          <% schedByLevel[lv].forEach(function(s, i) { %>
          <tr style="background:<%=i%2===1?'#f8fafc':'#fff'%>;">
            <td style="font-weight:700;width:7mm;text-align:center;white-space:nowrap;">S<%=s.sesi%></td>
            <% if(s.hari){ %><td style="white-space:nowrap;width:11mm;"><%=s.hari%></td><% } %>
            <% if(s.tanggalFmt){ %><td style="white-space:nowrap;width:11mm;"><%=s.tanggalFmt%></td><% } %>
            <td style="font-weight:600;white-space:nowrap;width:20mm;"><%=s.jamMulai%>-<%=s.jamSelesai%></td>
            <td style="font-weight:600;"><%=s.mapel%></td>
          </tr>
          <% }); %>
        </table>
      </div>
      <% }); %>
    </div>
  </div>
  <% } %>
</div>

</body>
</html>
